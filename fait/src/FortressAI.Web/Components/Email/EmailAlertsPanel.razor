@using FortressAI.Shared.Models
@inject IHttpClientFactory HttpFactory
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (_alerts.Any())
{
    <MudText Typo="Typo.h6" Class="mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Email" Style="vertical-align: middle; margin-right: 8px; color: #dc2626;" />
        Email Alerts
        <MudChip T="string" Size="Size.Small" Color="Color.Error">@_alerts.Count</MudChip>
    </MudText>

    @foreach (var alert in _alerts)
    {
        <EmailAlertCard Alert="alert" OnDismissed="HandleDismiss" OnReplySent="HandleReplySent" />
    }
}

@code {
    [Parameter] public Guid UserId { get; set; }

    private List<EmailAlert> _alerts = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadAlerts();
    }

    public async Task LoadAlerts()
    {
        try
        {
            var http = HttpFactory.CreateClient();
            var baseUrl = Nav.BaseUri.TrimEnd('/');
            var response = await http.GetFromJsonAsync<List<EmailAlert>>(
                $"{baseUrl}/api/email/alerts/{UserId}");
            _alerts = response ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Failed to load email alerts: {ex.Message}");
        }
    }

    public void AddAlert(EmailAlert alert)
    {
        // Insert at beginning (newest first)
        _alerts.Insert(0, alert);
        StateHasChanged();
    }

    private async Task HandleDismiss(int alertId)
    {
        try
        {
            var http = HttpFactory.CreateClient();
            var baseUrl = Nav.BaseUri.TrimEnd('/');
            await http.PostAsync($"{baseUrl}/api/email/alerts/{alertId}/dismiss?userId={UserId}", null);
            _alerts.RemoveAll(a => a.Id == alertId);
            Snackbar.Add("Alert dismissed", Severity.Info);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to dismiss: {ex.Message}", Severity.Error);
        }
    }

    private async Task HandleReplySent((int AlertId, string Reply) args)
    {
        try
        {
            var alert = _alerts.FirstOrDefault(a => a.Id == args.AlertId);
            if (alert == null) return;

            var http = HttpFactory.CreateClient();
            var baseUrl = Nav.BaseUri.TrimEnd('/');
            var response = await http.PostAsJsonAsync($"{baseUrl}/api/email/send", new
            {
                UserId = UserId.ToString(),
                alert.MessageId,
                ReplyBody = args.Reply,
                AlertId = args.AlertId
            });

            if (response.IsSuccessStatusCode)
            {
                _alerts.RemoveAll(a => a.Id == args.AlertId);
                Snackbar.Add("Reply sent!", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to send reply: {error}", Severity.Error);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }
}
