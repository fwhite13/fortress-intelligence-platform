@using FortressAI.Shared.Models

<MudCard Class="email-alert-card mb-3" Elevation="2" Style="border-left: 4px solid #dc2626;">
    <MudCardHeader>
        <CardHeaderContent>
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" Style="color: #dc2626;" />
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">High-Priority Email</MudText>
                <MudChip T="string" Size="Size.Small" Color="Color.Error" Variant="Variant.Filled">@Alert.Importance</MudChip>
            </div>
        </CardHeaderContent>
        <CardHeaderActions>
            <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);">
                @Alert.CreatedAt.ToString("h:mm tt")
            </MudText>
        </CardHeaderActions>
    </MudCardHeader>
    <MudCardContent>
        <MudText><strong>From:</strong> @Alert.SenderEmail</MudText>
        <MudText><strong>Subject:</strong> @Alert.Subject</MudText>

        @if (!string.IsNullOrEmpty(Alert.Summary))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Summary</MudText>
            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@Alert.Summary</MudText>
        }

        @if (!string.IsNullOrEmpty(Alert.SuggestedResponse))
        {
            <MudDivider Class="my-2" />
            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">Suggested Response</MudText>

            @if (_editing)
            {
                <MudTextField @bind-Value="_editableResponse" Lines="5" Variant="Variant.Outlined"
                              FullWidth="true" Class="mt-1" />
                <div class="d-flex gap-2 mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Send" OnClick="SendResponse"
                               Disabled="_sending">
                        @if (_sending)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <span>Sending...</span>
                        }
                        else
                        {
                            <span>Send Reply</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="() => _editing = false">
                        Cancel
                    </MudButton>
                </div>
            }
            else
            {
                <MudText Typo="Typo.body2" Style="white-space: pre-wrap; background: rgba(255,255,255,0.05); padding: 8px; border-radius: 4px; margin-top: 4px;">
                    @Alert.SuggestedResponse
                </MudText>
                <div class="d-flex gap-2 mt-2">
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Edit" OnClick="StartEditing">
                        Edit & Send
                    </MudButton>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                               OnClick="Dismiss">
                        Dismiss
                    </MudButton>
                </div>
            }
        }
        else
        {
            <div class="d-flex gap-2 mt-2">
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Default"
                           OnClick="Dismiss">
                    Dismiss
                </MudButton>
            </div>
        }
    </MudCardContent>
</MudCard>

@code {
    [Parameter] public EmailAlert Alert { get; set; } = null!;
    [Parameter] public EventCallback<int> OnDismissed { get; set; }
    [Parameter] public EventCallback<(int AlertId, string Reply)> OnReplySent { get; set; }

    private bool _editing = false;
    private bool _sending = false;
    private string _editableResponse = "";

    private void StartEditing()
    {
        _editableResponse = Alert.SuggestedResponse ?? "";
        _editing = true;
    }

    private async Task SendResponse()
    {
        _sending = true;
        StateHasChanged();

        try
        {
            await OnReplySent.InvokeAsync((Alert.Id, _editableResponse));
            _editing = false;
        }
        finally
        {
            _sending = false;
            StateHasChanged();
        }
    }

    private async Task Dismiss()
    {
        await OnDismissed.InvokeAsync(Alert.Id);
    }
}
