@inject ChatLayoutState LayoutState
@inject IWorkspaceFileService WorkspaceFileSvc
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@using System.IO
@implements IAsyncDisposable

<div class="artifact-sidebar">
    <div class="artifact-sidebar__drag-handle" @ref="_dragHandle"></div>
    <div class="artifact-sidebar__header">
        @if (_selectedArtifact == null)
        {
            <MudText Typo="Typo.subtitle2" Class="artifact-sidebar__title">Artifacts (@Artifacts.Count)</MudText>
            <MudIconButton Icon="@(_isMaximized ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)"
                           Size="Size.Small"
                           Title="@(_isMaximized ? "Restore" : "Maximize")"
                           OnClick="ToggleMaximize" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           OnClick="@(() => LayoutState.CloseArtifactSidebar())" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                           Size="Size.Small"
                           OnClick="@(() => { _selectedArtifact = null; _previewUrl = null; _previewError = null; _officeOnlineRawUrl = null; })"
                           Title="Back to list" />
            <MudText Typo="Typo.subtitle2" Class="artifact-sidebar__title artifact-sidebar__title--detail">@_selectedArtifact.Filename</MudText>
            <MudIconButton Icon="@(_isMaximized ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)"
                           Size="Size.Small"
                           Title="@(_isMaximized ? "Restore" : "Maximize")"
                           OnClick="ToggleMaximize" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           OnClick="@(() => LayoutState.CloseArtifactSidebar())" />
        }
    </div>

    @if (_selectedArtifact == null)
    {
        <div class="artifact-sidebar__list">
            @foreach (var artifact in Artifacts)
            {
                <div class="artifact-sidebar__item" @onclick="@(() => SelectArtifact(artifact))">
                    <MudIcon Icon="@GetFileIcon(artifact.MimeType)" Size="Size.Small" Class="artifact-sidebar__item-icon" />
                    <div class="artifact-sidebar__item-meta">
                        <span class="artifact-sidebar__item-name">@artifact.Filename</span>
                        <span class="artifact-sidebar__item-type">@GetTypeLabel(artifact.MimeType)</span>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="artifact-sidebar__item-chevron" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="artifact-sidebar__detail">
            <div class="artifact-sidebar__preview">
                @if (IsPreviewable(_selectedArtifact))
                {
                    @if (_previewLoading)
                    {
                        <div class="artifact-sidebar__preview-loading">
                            <MudProgressCircular Indeterminate="true" />
                        </div>
                    }
                    else if (_previewUrl != null)
                    {
                        <iframe src="@_previewUrl" class="artifact-sidebar__iframe"
                                sandbox="allow-scripts allow-same-origin allow-popups allow-forms" />
                    }
                    else if (_previewError != null)
                    {
                        <div class="artifact-sidebar__no-preview">
                            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_previewError</MudText>
                        </div>
                    }
                    else if (_officeOnlineRawUrl != null)
                    {
                        <div class="artifact-sidebar__no-preview">
                            <MudIcon Icon="@GetFileIcon(_selectedArtifact.MimeType)" Size="Size.Large" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Preview requires Office Online access</MudText>
                            <a href="@($"https://view.officeapps.live.com/op/embed.aspx?src={Uri.EscapeDataString(_officeOnlineRawUrl)}")"
                               target="_blank"
                               class="artifact-sidebar__office-link">
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Outlined.OpenInNew"
                                           Class="mt-2">
                                    Open in Office Online
                                </MudButton>
                            </a>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Outlined.Download"
                                       Disabled="@_downloadLoading"
                                       OnClick="DownloadAsync"
                                       Class="mt-2">
                                @if (_downloadLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                }
                                Download
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <div class="artifact-sidebar__no-preview">
                        <MudIcon Icon="@GetFileIcon(_selectedArtifact.MimeType)" Size="Size.Large" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Preview not available for this file type</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Download"
                                   Disabled="@_downloadLoading"
                                   OnClick="DownloadAsync"
                                   Class="mt-2">
                            @if (_downloadLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Download file
                        </MudButton>
                    </div>
                }
            </div>

            <div class="artifact-sidebar__actions">
                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Download"
                           Disabled="@_downloadLoading"
                           OnClick="DownloadAsync">
                    @if (_downloadLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Download
                </MudButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<WorkspaceUpload> Artifacts { get; set; } = new();
    [Parameter] public int PanelWidth { get; set; } = 320;
    [Parameter] public EventCallback<int> OnWidthChanged { get; set; }

    private WorkspaceUpload? _selectedArtifact;
    private string? _previewUrl;
    private string? _previewError;
    private string? _officeOnlineRawUrl;
    private bool _previewLoading;
    private bool _downloadLoading;
    private bool _isMaximized = false;
    private int _preMaximizeWidth = 320;
    private ElementReference _dragHandle;
    private DotNetObjectReference<ArtifactSidebarPanel>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("fortressChat.initSidebarResize", _dragHandle, _dotNetRef);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JSRuntime.InvokeVoidAsync("fortressChat.disposeSidebarResize", _dragHandle);
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public async Task UpdateSidebarWidth(int newWidth)
    {
        if (_isMaximized)
            _isMaximized = false;
        PanelWidth = newWidth;
        await OnWidthChanged.InvokeAsync(newWidth);
        StateHasChanged();
    }

    private async Task ToggleMaximize()
    {
        if (_isMaximized)
        {
            _isMaximized = false;
            await OnWidthChanged.InvokeAsync(_preMaximizeWidth);
            PanelWidth = _preMaximizeWidth;
        }
        else
        {
            _preMaximizeWidth = PanelWidth;
            _isMaximized = true;
            var maxWidth = (int)(await JSRuntime.InvokeAsync<double>("eval", "window.innerWidth * 0.6"));
            PanelWidth = Math.Max(maxWidth, 400);
            await OnWidthChanged.InvokeAsync(PanelWidth);
        }
        StateHasChanged();
    }

    private async Task SelectArtifact(WorkspaceUpload artifact)
    {
        _selectedArtifact = artifact;
        _previewUrl = null;
        _previewError = null;
        _officeOnlineRawUrl = null;

        if (IsPreviewable(artifact))
        {
            _previewLoading = true;
            StateHasChanged();
            try
            {
                var rawUrl = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(artifact.S3Key, expiryMinutes: 30);
                var ext = Path.GetExtension(artifact.Filename);
                if (ext.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    _previewUrl = rawUrl;
                }
                else
                {
                    // Office Online requires a publicly accessible URL.
                    // Presigned S3 URLs are private and rejected by Microsoft's servers.
                    // Store the rawUrl for the "Open in Office Online" link, set _previewUrl to null.
                    _officeOnlineRawUrl = rawUrl;
                    _previewUrl = null;
                }
            }
            catch
            {
                _previewUrl = null;
                _previewError = "Preview unavailable. Try downloading the file.";
            }
            finally
            {
                _previewLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task DownloadAsync()
    {
        if (_selectedArtifact == null) return;
        _downloadLoading = true;
        StateHasChanged();
        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(_selectedArtifact.S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch
        {
            Snackbar.Add("Download failed.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    private static readonly HashSet<string> PreviewableExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".doc", ".docx", ".ppt", ".pptx"
    };

    private static bool IsPreviewable(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return PreviewableExtensions.Contains(ext);
    }

    private static string GetFileIcon(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Material.Filled.Description,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => Icons.Material.Filled.TableChart,
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => Icons.Material.Filled.Slideshow,
        "application/pdf" => Icons.Material.Filled.PictureAsPdf,
        "text/markdown" or "text/plain" => Icons.Material.Filled.Article,
        "text/html" => Icons.Material.Filled.Code,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private static string GetTypeLabel(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "Word Document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "Spreadsheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => "Presentation",
        "application/pdf" => "PDF",
        "text/markdown" => "Markdown",
        "text/plain" => "Text",
        "text/html" => "HTML",
        "application/json" => "JSON",
        _ => "File"
    };
}

<style>
.artifact-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
}
.artifact-sidebar__drag-handle {
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    cursor: col-resize;
    z-index: 10;
    background: transparent;
    transition: background 150ms ease;
}
.artifact-sidebar__drag-handle:hover {
    background: var(--color-primary, #1976d2);
    opacity: 0.3;
}
.artifact-sidebar__header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    gap: 8px;
}
.artifact-sidebar__title {
    font-weight: 600;
}
.artifact-sidebar__title--detail {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 8px;
}
.artifact-sidebar__list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
}
.artifact-sidebar__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    cursor: pointer;
    transition: background 150ms ease;
}
.artifact-sidebar__item:hover {
    background: var(--color-surface-sunken);
}
.artifact-sidebar__item-icon {
    flex-shrink: 0;
}
.artifact-sidebar__item-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.artifact-sidebar__item-name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.artifact-sidebar__item-type {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
}
.artifact-sidebar__item-chevron {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
}
.artifact-sidebar__detail {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
}
.artifact-sidebar__preview {
    flex: 1;
    overflow: hidden;
    position: relative;
}
.artifact-sidebar__iframe {
    width: 100%;
    height: 100%;
    border: none;
}
.artifact-sidebar__preview-loading,
.artifact-sidebar__no-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 16px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.artifact-sidebar__actions {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
}
.artifact-sidebar__office-link {
    text-decoration: none;
}
</style>
