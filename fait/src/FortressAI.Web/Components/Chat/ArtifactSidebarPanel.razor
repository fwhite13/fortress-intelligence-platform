@inject ChatLayoutState LayoutState
@inject IWorkspaceFileService WorkspaceFileSvc
@inject ArtifactPreviewService PreviewSvc
@inject UserSessionService Session
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject IHttpClientFactory HttpClientFactory
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@using System.IO
@implements IAsyncDisposable

<div class="artifact-sidebar">
    <div class="artifact-sidebar__drag-handle" @ref="_dragHandle"></div>
    <div class="artifact-sidebar__header">
        @if (_selectedArtifact == null)
        {
            <MudText Typo="Typo.subtitle2" Class="artifact-sidebar__title">Artifacts (@Artifacts.Count)</MudText>
            <MudIconButton Icon="@(_isMaximized ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)"
                           Size="Size.Small"
                           Title="@(_isMaximized ? "Restore" : "Maximize")"
                           OnClick="ToggleMaximize" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           OnClick="@(() => LayoutState.CloseArtifactSidebar())" />
        }
        else
        {
            <MudIconButton Icon="@Icons.Material.Outlined.ArrowBack"
                           Size="Size.Small"
                           OnClick="@(() => { _selectedArtifact = null; _previewUrl = null; _previewError = null; _textPreviewContent = null; })"
                           Title="Back to list" />
            <MudText Typo="Typo.subtitle2" Class="artifact-sidebar__title artifact-sidebar__title--detail">@_selectedArtifact.Filename</MudText>
            <MudIconButton Icon="@(_isMaximized ? Icons.Material.Outlined.CloseFullscreen : Icons.Material.Outlined.OpenInFull)"
                           Size="Size.Small"
                           Title="@(_isMaximized ? "Restore" : "Maximize")"
                           OnClick="ToggleMaximize" />
            <MudIconButton Icon="@Icons.Material.Outlined.Close"
                           Size="Size.Small"
                           OnClick="@(() => LayoutState.CloseArtifactSidebar())" />
        }
    </div>

    @if (_selectedArtifact == null)
    {
        <div class="artifact-sidebar__list">
            @foreach (var artifact in Artifacts)
            {
                <div class="artifact-sidebar__item" @onclick="@(() => SelectArtifact(artifact))">
                    <MudIcon Icon="@GetFileIcon(artifact.MimeType)" Size="Size.Small" Class="artifact-sidebar__item-icon" />
                    <div class="artifact-sidebar__item-meta">
                        <span class="artifact-sidebar__item-name">@artifact.Filename</span>
                        <span class="artifact-sidebar__item-type">@GetTypeLabel(artifact.MimeType)</span>
                    </div>
                    <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Class="artifact-sidebar__item-chevron" />
                </div>
            }
        </div>
    }
    else
    {
        <div class="artifact-sidebar__detail">
            <div class="artifact-sidebar__preview">
                @if (IsPreviewable(_selectedArtifact))
                {
                    @if (IsXlsxType(_selectedArtifact))
                    {
                        <XlsxPreviewPanel ArtifactId="@_selectedArtifact.Id" Filename="@_selectedArtifact.Filename" MimeType="@_selectedArtifact.MimeType" />
                    }
                    else if (_previewLoading)
                    {
                        <div class="artifact-sidebar__preview-loading">
                            <MudProgressCircular Indeterminate="true" />
                        </div>
                    }
                    else if (_textPreviewContent != null)
                    {
                        <div class="artifact-sidebar__text-preview">
                            <pre><code class="@GetHighlightClass(_selectedArtifact.Filename)">@_textPreviewContent</code></pre>
                        </div>
                    }
                    else if (IsDocxType(_selectedArtifact))
                    {
                        <DocxPreviewPanel Artifact="@_selectedArtifact" />
                    }
                    else if (IsPptxType(_selectedArtifact))
                    {
                        <PptxPreviewPanel ArtifactId="@_selectedArtifact.Id"
                                          S3Key="@_selectedArtifact.S3Key"
                                          ExistingPreviewS3Key="@_selectedArtifact.PreviewS3Key" />
                    }
                    else if (_previewUrl != null)
                    {
                        <iframe src="@_previewUrl" class="artifact-sidebar__iframe"
                                sandbox="allow-scripts allow-popups allow-forms" />
                    }
                    else if (_previewError != null)
                    {
                        <div class="artifact-sidebar__no-preview">
                            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@_previewError</MudText>
                        </div>
                    }
                    else if (IsOfficeDocType(_selectedArtifact))
                    {
                        <div class="artifact-sidebar__no-preview">
                            <MudIcon Icon="@GetFileIcon(_selectedArtifact.MimeType)" Size="Size.Large" />
                            <MudText Typo="Typo.body2" Color="Color.Secondary">Preview not available</MudText>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Outlined.Download"
                                       Disabled="@_downloadLoading"
                                       OnClick="DownloadAsync"
                                       Class="mt-2">
                                @if (_downloadLoading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                }
                                Download
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <div class="artifact-sidebar__no-preview">
                        <MudIcon Icon="@GetFileIcon(_selectedArtifact.MimeType)" Size="Size.Large" />
                        <MudText Typo="Typo.body2" Color="Color.Secondary">Preview not available for this file type</MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Download"
                                   Disabled="@_downloadLoading"
                                   OnClick="DownloadAsync"
                                   Class="mt-2">
                            @if (_downloadLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            }
                            Download file
                        </MudButton>
                    </div>
                }
            </div>

            <div class="artifact-sidebar__actions">
                <MudButton Size="Size.Small" Variant="Variant.Outlined"
                           StartIcon="@Icons.Material.Outlined.Download"
                           Disabled="@_downloadLoading"
                           OnClick="DownloadAsync">
                    @if (_downloadLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                    }
                    Download
                </MudButton>
            </div>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public List<WorkspaceUpload> Artifacts { get; set; } = new();
    [Parameter] public int PanelWidth { get; set; } = 320;
    [Parameter] public EventCallback<int> OnWidthChanged { get; set; }

    private WorkspaceUpload? _selectedArtifact;
    private string? _previewUrl;
    private string? _previewError;
    private string? _textPreviewContent;
    private bool _previewLoading;
    private bool _downloadLoading;
    private bool _isMaximized = false;
    private int _preMaximizeWidth = 320;
    private ElementReference _dragHandle;
    private DotNetObjectReference<ArtifactSidebarPanel>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JSRuntime.InvokeVoidAsync("fortressChat.initSidebarResize", _dragHandle, _dotNetRef);
        }
        if (_textPreviewContent != null)
        {
            try { await JSRuntime.InvokeVoidAsync("fortressChat.highlightCode"); } catch { }
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JSRuntime.InvokeVoidAsync("fortressChat.disposeSidebarResize", _dragHandle);
        _dotNetRef?.Dispose();
    }

    [JSInvokable]
    public async Task UpdateSidebarWidth(int newWidth)
    {
        if (_isMaximized)
            _isMaximized = false;
        PanelWidth = newWidth;
        await OnWidthChanged.InvokeAsync(newWidth);
        StateHasChanged();
    }

    private async Task ToggleMaximize()
    {
        if (_isMaximized)
        {
            _isMaximized = false;
            await OnWidthChanged.InvokeAsync(_preMaximizeWidth);
            PanelWidth = _preMaximizeWidth;
        }
        else
        {
            _preMaximizeWidth = PanelWidth;
            _isMaximized = true;
            var maxWidth = (int)(await JSRuntime.InvokeAsync<double>("eval", "window.innerWidth * 0.6"));
            PanelWidth = Math.Max(maxWidth, 400);
            await OnWidthChanged.InvokeAsync(PanelWidth);
        }
        StateHasChanged();
    }

    private async Task SelectArtifact(WorkspaceUpload artifact)
    {
        _selectedArtifact = artifact;
        _previewUrl = null;
        _previewError = null;
        _textPreviewContent = null;

        if (IsPreviewable(artifact))
        {
            _previewLoading = true;
            StateHasChanged();
            try
            {
                if (IsXlsxType(artifact))
                {
                    // XlsxPreviewPanel handles its own loading
                    _previewLoading = false;
                    StateHasChanged();
                    return;
                }

                if (IsDocxType(artifact))
                {
                    // DocxPreviewPanel handles its own loading — no presign needed
                    _previewLoading = false;
                    StateHasChanged();
                    return;
                }

                if (IsPptxType(artifact))
                {
                    // PptxPreviewPanel handles its own loading — no presign needed
                    _previewLoading = false;
                    StateHasChanged();
                    return;
                }

                var rawUrl = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(artifact.S3Key, expiryMinutes: 30);
                var ext = Path.GetExtension(artifact.Filename);
                if (IsTextPreviewable(artifact))
                {
                    try
                    {
                        using var http = HttpClientFactory.CreateClient();
                        var content = await http.GetStringAsync(rawUrl);
                        _textPreviewContent = content.Length > 200_000
                            ? content[..200_000] + "\n\n[... truncated at 200KB ...]"
                            : content;
                    }
                    catch (Exception ex)
                    {
                        _textPreviewContent = null;
                        _previewError = "Could not load preview. Try downloading.";
                    }
                }
                else if (ext.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    _previewUrl = await GetProxyPreviewUrlAsync(artifact);
                }
                else
                {
                    // Office preview removed — Epic 12 will provide native DOCX/XLSX/PPTX previews
                    _previewUrl = null;
                    _previewError = null;
                }
            }
            catch
            {
                _previewUrl = null;
                _previewError = "Preview unavailable. Try downloading the file.";
            }
            finally
            {
                _previewLoading = false;
                StateHasChanged();
            }
        }
    }

    private async Task DownloadAsync()
    {
        if (_selectedArtifact == null) return;
        _downloadLoading = true;
        StateHasChanged();
        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(_selectedArtifact.S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch
        {
            Snackbar.Add("Download failed.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetProxyPreviewUrlAsync(WorkspaceUpload artifact)
    {
        var userId = Session.UserId;
        if (userId == Guid.Empty) return "";
        var (token, expires) = PreviewSvc.GenerateToken(artifact.Id, userId);
        return $"/api/artifacts/{artifact.Id}/preview?token={Uri.EscapeDataString(token)}&expires={expires}";
    }

    private static readonly HashSet<string> PreviewableExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".doc", ".docx", ".ppt", ".pptx", ".xls", ".xlsx"
    };

    private static readonly HashSet<string> TextPreviewableExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".txt", ".py", ".js", ".ts", ".cs", ".json", ".csv", ".md",
        ".html", ".xml", ".yaml", ".yml", ".sh", ".bash", ".sql",
        ".css", ".scss", ".java", ".rb", ".go", ".rs", ".toml", ".ini", ".cfg"
    };

    private static bool IsPreviewable(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return PreviewableExtensions.Contains(ext) || TextPreviewableExtensions.Contains(ext);
    }

    private static bool IsTextPreviewable(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return TextPreviewableExtensions.Contains(ext);
    }

    private static bool IsDocxType(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return ext.Equals(".docx", StringComparison.OrdinalIgnoreCase)
            || artifact.MimeType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
    }

    private static bool IsXlsxType(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return ext.Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
            || artifact.MimeType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    }

    private static bool IsPptxType(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return ext.Equals(".pptx", StringComparison.OrdinalIgnoreCase)
            || artifact.MimeType == "application/vnd.openxmlformats-officedocument.presentationml.presentation";
    }

    private static bool IsOfficeDocType(WorkspaceUpload artifact)
    {
        var ext = Path.GetExtension(artifact.Filename);
        return ext.Equals(".docx", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".pptx", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".doc", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".xls", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".ppt", StringComparison.OrdinalIgnoreCase);
    }

    private static string GetHighlightClass(string filename)
    {
        var ext = Path.GetExtension(filename).ToLowerInvariant();
        return ext switch
        {
            ".py" => "language-python",
            ".js" or ".ts" => "language-javascript",
            ".cs" => "language-csharp",
            ".json" => "language-json",
            ".md" => "language-markdown",
            ".html" => "language-html",
            ".xml" => "language-xml",
            ".yaml" or ".yml" => "language-yaml",
            ".sh" or ".bash" => "language-bash",
            ".sql" => "language-sql",
            ".css" or ".scss" => "language-css",
            ".java" => "language-java",
            ".rb" => "language-ruby",
            ".go" => "language-go",
            _ => "language-plaintext"
        };
    }

    private static string GetFileIcon(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Material.Filled.Description,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => Icons.Material.Filled.TableChart,
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => Icons.Material.Filled.Slideshow,
        "application/pdf" => Icons.Material.Filled.PictureAsPdf,
        "text/markdown" or "text/plain" => Icons.Material.Filled.Article,
        "text/html" => Icons.Material.Filled.Code,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private static string GetTypeLabel(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => "Word Document",
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => "Spreadsheet",
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => "Presentation",
        "application/pdf" => "PDF",
        "text/markdown" => "Markdown",
        "text/plain" => "Text",
        "text/html" => "HTML",
        "application/json" => "JSON",
        _ => "File"
    };
}

<style>
.artifact-sidebar {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--color-surface);
    border-left: 1px solid var(--color-border);
}
.artifact-sidebar__drag-handle {
    position: absolute;
    left: 0;
    top: 0;
    width: 6px;
    height: 100%;
    cursor: col-resize;
    z-index: 10;
    background: transparent;
    transition: background 150ms ease;
}
.artifact-sidebar__drag-handle:hover {
    background: var(--color-primary, #1976d2);
    opacity: 0.3;
}
.artifact-sidebar__header {
    display: flex;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--color-border);
    flex-shrink: 0;
    gap: 8px;
}
.artifact-sidebar__title {
    font-weight: 600;
}
.artifact-sidebar__title--detail {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    margin: 0 8px;
}
.artifact-sidebar__list {
    flex: 1;
    overflow-y: auto;
    padding: 8px 0;
}
.artifact-sidebar__item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    cursor: pointer;
    transition: background 150ms ease;
}
.artifact-sidebar__item:hover {
    background: var(--color-surface-sunken);
}
.artifact-sidebar__item-icon {
    flex-shrink: 0;
}
.artifact-sidebar__item-meta {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 2px;
}
.artifact-sidebar__item-name {
    font-size: var(--text-sm);
    font-weight: var(--font-medium);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
.artifact-sidebar__item-type {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
}
.artifact-sidebar__item-chevron {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
}
.artifact-sidebar__detail {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
}
.artifact-sidebar__preview {
    flex: 1;
    overflow: hidden;
    position: relative;
}
.artifact-sidebar__iframe {
    width: 100%;
    height: 100%;
    border: none;
}
.artifact-sidebar__preview-loading,
.artifact-sidebar__no-preview {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 16px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.artifact-sidebar__actions {
    display: flex;
    gap: 8px;
    padding: 12px 16px;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
}
.artifact-sidebar__text-preview {
    height: 100%;
    overflow: auto;
    padding: 8px;
    background: var(--mud-palette-background-grey, #f5f5f5);
    border-radius: 4px;
}

.artifact-sidebar__text-preview pre {
    margin: 0;
    white-space: pre-wrap;
    word-break: break-word;
    font-size: 12px;
    font-family: 'Consolas', 'Courier New', monospace;
    line-height: 1.5;
}
</style>
