@page "/chat"
@page "/chat/{ConversationId:guid}"
<PageTitle>Chat — FAIT</PageTitle>
@inject UserSessionService Session
@inject ChatService ChatSvc
@inject ProjectService ProjectSvc
@inject BedrockService BedrockSvc
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject AssistantConfigService ConfigSvc
@inject ForgeService ForgeSvc
@inject DocumentService DocumentSvc
@inject ChatAttachmentService AttachmentSvc
@inject IMcpToolService McpToolSvc
@inject IDbContextFactory<FortressAI.Web.Data.AppDbContext> DbFactory
@inject IServiceScopeFactory ScopeFactory
@inject ILogger<ChatView> Logger
@inject MicrosoftTokenService M365TokenSvc
@inject IUserAgentRuntime AgentRuntime
@inject IWorkspaceFileService WorkspaceFileSvc
@inject IWorkspaceUploadService UploadSvc
@inject ChatLayoutState LayoutState
@inject IDialogService DialogService
@using Amazon.S3
@using Amazon.S3.Model
@inject IAmazonS3 S3
@inject IConfiguration Config
@inject Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage.ProtectedSessionStorage SessionStorage
@implements IAsyncDisposable
@using FortressAI.Web.Services
@using FortressAI.Web.Services.Mcp
@using Microsoft.EntityFrameworkCore
@using Microsoft.Extensions.DependencyInjection
@using FortressAI.Shared.Models

@if (_checkingAgent || !_agentReady)
{
    <AssistantLoadingState UserId="@Session.UserId.ToString()" OnReady="HandleAgentReady" OnRetry="HandleAgentRetry" />
}
else
{
<div style="display: flex; height: 100%; overflow: hidden; transition: all 0.2s ease;">

    <div style="flex: 1; min-width: 0; overflow: hidden; display: flex; flex-direction: column; transition: all 0.2s ease;">
        <div class="chat-container">
    <FeedbackModal @ref="_feedbackModal" />
    <div class="chat-header">
        <div class="chat-header-left">
            <div class="chat-header-identity">
                @if (!string.IsNullOrWhiteSpace(_avatarPreviewUrl))
                {
                    <img src="@_avatarPreviewUrl" alt="@(_assistantConfig?.AssistantName ?? "Assistant")" class="chat-header-avatar" />
                }
                else if (_assistantConfig != null)
                {
                    <MudIcon Icon="@GetAvatarIconForHeader(_assistantConfig.AvatarId)"
                             Size="Size.Small"
                             Style="@($"color: {_assistantConfig.ColorHex ?? "#6366f1"}")" />
                }
                @if (!string.IsNullOrWhiteSpace(_assistantConfig?.AssistantName))
                {
                    <span class="chat-header-name">@_assistantConfig.AssistantName</span>
                }
            </div>
            @if (conversation?.Project != null)
            {
                <div class="chat-project-badge" @onclick="NavigateToProject">
                    <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /> @conversation.Project.Name
                </div>
            }
            @if (_taskModeActive)
            {
                <div class="chat-task-indicator">
                    @if (_ccTaskActive)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy"
                                 Class="chat-task-indicator__cc-icon cc-agent-icon--pulse" />
                    }
                    else
                    {
                        <i class="fas fa-tasks"></i>
                    }
                    <span>⚡ Task Mode · <span id="task-timer-display">00:00</span></span>
                    <button class="chat-task-indicator__cancel" @onclick="CancelTask" title="Cancel task">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            }
        </div>
        <div class="chat-header-actions">
            @if (_conversationArtifacts.Any())
            {
                <button class="artifact-indicator-btn @(LayoutState.ArtifactSidebarOpen ? "artifact-indicator-btn--active" : "")"
                        @onclick="ToggleArtifactSidebarWithExclusion"
                        title="@(_conversationArtifacts.Count == 1 ? "1 artifact" : $"{_conversationArtifacts.Count} artifacts")">
                    <MudIcon Icon="@Icons.Material.Outlined.Folder" Class="artifact-indicator-btn__icon" />
                    <span>@_conversationArtifacts.Count</span>
                </button>
            }
            <button class="chat-feedback-btn chat-feedback-btn--desktop" @onclick="OpenFeedbackModal" title="Report a Bug or Suggest a Feature">
                <i class="fas fa-bug"></i>
                <span class="chat-feedback-btn__label">Report a Bug</span>
            </button>
            <button class="chat-feedback-btn chat-feedback-btn--mobile" @onclick="OpenFeedbackModal" title="Report a Bug or Suggest a Feature">
                <i class="fas fa-bug"></i>
            </button>
        </div>
    </div>

    @if (_agentReady && _hasFailedTasks && !_failedTaskBannerDismissed)
    {
        <MudAlert Severity="Severity.Warning" Dense="true"
                  Style="cursor: pointer;"
                  ShowCloseIcon="true" CloseIconClicked="@(() => _failedTaskBannerDismissed = true)"
                  @onclick="@(() => _debugInfoDialogOpen = true)"
                  Class="mx-2 mt-2">
            One or more scheduled tasks have failed.
            <MudLink Href="/tasks" @onclick:stopPropagation="true" Class="ml-1">View tasks →</MudLink>
        </MudAlert>
    }

    <MudDialog @bind-IsVisible="_debugInfoDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true })">
        <TitleContent>
            <MudText Typo="Typo.h6">Debug Info</MudText>
        </TitleContent>
        <DialogContent>
            <MudStack Spacing="2">
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Build</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: monospace; word-break: break-all;">@BuildVersion</MudText>
                </div>
                <MudDivider />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Conversation ID</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@(ConversationId?.ToString() ?? "none")</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Harness Session ID</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@(_currentHarnessSessionId ?? "none")</MudText>
                </div>
                <MudDivider />
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">User ID</MudText>
                    <MudText Typo="Typo.body2" Style="font-family: monospace;">@Session.UserId.ToString()</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Active Iteration / Assistant</MudText>
                    <MudText Typo="Typo.body2">@(_assistantConfig?.AssistantName ?? "default")</MudText>
                </div>
                <div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Environment</MudText>
                    <MudText Typo="Typo.body2">@(Config["ASPNETCORE_ENVIRONMENT"] ?? Config["Environment"] ?? "unknown")</MudText>
                </div>
            </MudStack>
        </DialogContent>
        <DialogActions>
            <MudButton OnClick="@(() => _debugInfoDialogOpen = false)" Color="Color.Primary">Close</MudButton>
        </DialogActions>
    </MudDialog>

    <div class="chat-messages-wrapper">
        <div class="chat-messages" id="chat-messages">
            @if (conversation == null || !messages.Any())
            {
                <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 65%; padding-top: 10%;">
                    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" style="color: var(--color-gold); margin-bottom: var(--space-4);">
                        <path d="M12 2L3 7v5c0 5.25 3.75 10.15 9 11.5C17.25 22.15 21 17.25 21 12V7L12 2z" fill="currentColor" opacity="0.9"/>
                        <path d="M9 12l2 2 4-4" stroke="white" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                    <MudText Typo="Typo.h4" Style="font-weight: var(--font-bold); color: var(--color-text-primary); margin-bottom: var(--space-2); text-align: center;">
                        @GetWelcomeTitle()
                    </MudText>
                    <MudText Typo="Typo.body1" Style="color: var(--color-text-secondary); text-align: center;">
                        @GetWelcomeSubtitle()
                    </MudText>
                </div>
            }
            else
            {
                @if (wasSummarized)
                {
                    <div class="context-summary-indicator">
                        <MudIcon Icon="@Icons.Material.Filled.CloseFullscreen" Size="Size.Small" />
                        <span>Earlier messages were summarized to stay within context limits</span>
                    </div>
                }

                @foreach (var msg in messages.Where(m => !m.IsResumptionBrief))
                {
                    <MessageBubble Message="msg" AssistantConfig="@_assistantConfig" AvatarPreviewUrl="@_avatarPreviewUrl" UserInitial="@UserInitial" />
                }
                @* Resumption brief renders AFTER message history — ADO#3155 Bug 2 fix *@
                @if (_isBriefStreaming || messages.Any(m => m.IsResumptionBrief) || _briefContent.Length > 0)
                {
                    <div class="resumption-brief-card">
                        <div class="resumption-brief-content">@(_isBriefStreaming ? _briefContent.ToString() : messages.FirstOrDefault(m => m.IsResumptionBrief)?.Content ?? (_briefContent.Length > 0 ? _briefContent.ToString() : ""))</div>
                        @if (_isBriefStreaming)
                        {
                            <div class="resumption-brief-loading">
                                <span class="streaming-cursor">▊</span>
                            </div>
                        }
                    </div>
                }
            }

            @if (_toolCallInProgress)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="my-1" Style="max-width: 600px; margin: 8px auto;">
                    🔍 @(_currentToolName ?? "Calling tool")...
                </MudAlert>
            }
            @if (isStreaming)
            {
                <MessageBubble Message="@streamingMessage" IsStreaming="true" AssistantConfig="@_assistantConfig" AvatarPreviewUrl="@_avatarPreviewUrl" UserInitial="@UserInitial" />
            }
            @if (_activeToolCalls.Any() || _toolCallsFading)
            {
                <div class="tool-call-indicator-list @(_toolCallsFading ? "tool-call-list-fading" : "")">
                    @foreach (var tc in _activeToolCalls)
                    {
                        <div class="tool-call-indicator @(tc.Status == "calling" ? "tool-call-active" : tc.Status == "error" ? "tool-call-error" : "tool-call-done")">
                            <MudIcon Icon="@ChipIconToMudIcon(tc.ChipIcon ?? GetChipIconKeyFromToolName(tc.ToolName))"
                                     Class="@("tool-call-mud-icon" + (tc.Status == "calling" ? " tool-call-mud-icon-pulse" : ""))"
                                     Style="width: 16px; height: 16px; flex-shrink: 0;" />
                            <span class="tool-call-summary">@TruncChip(GetToolLabel(tc.ToolName, tc.Server, tc.Summary))</span>
                        </div>
                    }
                </div>
            }

            @if (_currentFileSummary != null && _currentFileSummary.Files.Count > 0)
            {
                <div class="file-summary-block">
                    <div class="file-summary-block__folder">📁 /@_currentFileSummary.FolderName</div>
                    @foreach (var f in _currentFileSummary.Files)
                    {
                        <div class="file-summary-block__file">
                            <span class="file-summary-block__icon">@(f.Action == "created" ? "✅" : "📝")</span>
                            <a href="@f.PresignedUrl" target="_blank" class="file-summary-block__link">@f.Filename</a>
                            <span class="file-summary-block__meta">(@f.Action@(f.Version > 1 ? $", v{f.Version}" : ""))</span>
                        </div>
                    }
                </div>
            }
        </div>

        <button id="jump-to-bottom-pill" class="jump-to-bottom" @onclick="JumpToBottom">
            <MudIcon Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" /> Jump to latest
        </button>
    </div>

    <!-- Sticky input bar -->
    <div style="position: sticky; bottom: 0; background: var(--color-bg-page); box-shadow: 0 -1px 0 var(--color-border); padding: var(--space-3) var(--space-4);">
        <!-- Top row: KB toggles (left) + Model selector (right) -->
        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-2); padding-bottom: var(--space-2); border-bottom: 1px solid var(--color-border);">
            <!-- KB Toggles -->
            <div style="display: flex; gap: var(--space-2);">
                <!-- Fortress KB toggle — show always, disable when no conversation -->
                <button @onclick="ToggleFortressKb"
                        title="Search Fortress knowledge base"
                        style="@GetFortressKbStyle()">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Style="width: 16px; height: 16px;" />
                    <span style="font-size: var(--text-sm); font-weight: var(--font-medium); margin-left: 4px;">Fortress KB</span>
                </button>
                <button @onclick="TogglePersonalKb"
                        title="My personal knowledge base"
                        style="@GetPersonalKbStyle()">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Style="width: 16px; height: 16px;" />
                    <span style="font-size: var(--text-sm); font-weight: var(--font-medium); margin-left: 4px;">My KB</span>
                </button>
                @if (_teamKbPopoverOpen)
                {
                    <div style="position: fixed; inset: 0; z-index: 999;"
                         @onclick="() => _teamKbPopoverOpen = false"></div>
                }
                @if (_userTeams.Any())
                {
                    <div style="position: relative; display: inline-block;">
                        <button @onclick="ToggleTeamKbPopover"
                                title="@(_selectedTeamIds.Any() ? "Team KBs active — click to modify" : "Select team knowledge bases")"
                                style="@GetTeamKbToggleStyle()">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Style="width: 16px; height: 16px;" />
                            <span style="font-size: var(--text-sm); font-weight: var(--font-medium); margin-left: 4px;">Team KB</span>
                            @if (_selectedTeamIds.Any())
                            {
                                <span style="margin-left: 4px; font-size: var(--text-xs); opacity: 0.8;">(@_selectedTeamIds.Count)</span>
                            }
                        </button>
                        @if (_teamKbPopoverOpen)
                        {
                            <div class="team-kb-popover"
                                 @onclick:stopPropagation="true">
                                <div style="font-size: var(--text-xs); color: var(--color-text-tertiary); padding: 4px 8px 8px 8px; font-weight: var(--font-medium); text-transform: uppercase; letter-spacing: 0.05em;">
                                    Team Knowledge Bases
                                </div>
                                @foreach (var team in _userTeams)
                                {
                                    var t = team;
                                    var isSelected = _selectedTeamIds.Contains(t.Id);
                                    <div style="display: flex; align-items: center; padding: 6px 8px; border-radius: var(--radius-sm); cursor: pointer; @(isSelected ? "background: var(--color-gold-muted);" : "")"
                                         @onclick="() => ToggleTeamKbAndClose(t.Id)">
                                        <MudIcon Icon="@(isSelected ? Icons.Material.Filled.CheckBox : Icons.Material.Filled.CheckBoxOutlineBlank)"
                                                 Style="@($"width: 16px; height: 16px; margin-right: 8px; color: {(isSelected ? "var(--color-gold)" : "var(--color-text-tertiary)")}")"/>
                                        <span style="font-size: var(--text-sm); color: @(isSelected ? "var(--color-gold)" : "var(--color-text-secondary);");">@t.Name</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
            <!-- Model selector -->
            <ModelSelector CurrentModel="@currentModel" OnModelChanged="HandleModelChanged" />
        </div>
        <!-- Attachment chips (shown when files are staged) -->
        @if (_pendingAttachments.Any())
        {
            <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: var(--space-2);">
                @foreach (var att in _pendingAttachments)
                {
                    var a = att;
                    <div style="display: inline-flex; align-items: center; gap: 6px; background: var(--color-surface-elevated, #1e1e2e); border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: 4px 8px; font-size: var(--text-xs); color: var(--color-text-secondary);">
                        <MudIcon Icon="@GetFileIcon(a.Filename)" Style="width: 14px; height: 14px;" />
                        <span>@a.Filename</span>
                        <span style="color: var(--color-text-tertiary);">(@ChatAttachmentService.FormatFileSize(a.SizeBytes))</span>
                        @if (a.TokenEstimate.HasValue)
                        {
                            <span style="color: var(--color-text-tertiary);">~@a.TokenEstimate tokens</span>
                        }
                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                            Style="width: 16px; height: 16px; padding: 0; color: var(--color-text-tertiary);"
                            OnClick="@(() => RemovePendingAttachment(a.Id))" />
                    </div>
                }
            </div>
        }
        <!-- Input row -->
        <div class="chat-input-wrapper @(_isDragOver ? "drag-over" : "")" id="chat-input-drop-zone">
            <!-- Hidden file input -->
            <InputFile id="chat-file-input" OnChange="HandleFileSelected" multiple accept=".txt,.md,.csv,.json,.xml,.html,.py,.cs,.js,.ts,.yaml,.yml,.png,.jpg,.jpeg,.gif,.pdf" style="display:none;" />
            <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                Disabled="@(isStreaming || _isBriefStreaming)"
                OnClick="TriggerFileInput"
                Title="Attach file"
                Style="background: transparent; color: var(--color-text-secondary); border-radius: var(--radius-md);"
                Size="Size.Medium" />
            <textarea class="chat-input"
                      @bind="_userInput"
                      @bind:event="oninput"
                      @onkeydown="HandleInputKeyDown"
                      placeholder="Type a message..."
                      rows="1"
                      disabled="@(isStreaming || _isBriefStreaming)"
                      id="chat-input-field"></textarea>
            @if (_speechSupported)
            {
                <MudIconButton Icon="@(_isDictating ? Icons.Material.Filled.MicNone : Icons.Material.Filled.Mic)"
                    Disabled="@(isStreaming || _isBriefStreaming)"
                    OnClick="ToggleDictation"
                    Title="@(_isDictating ? "Stop recording" : "Dictate message")"
                    Style="@GetMicButtonStyle()"
                    Size="Size.Medium" />
            }
            <button class="btn-task-mode @((_taskMode || _taskModeActive) ? "btn-task-mode--active" : "")"
                    @onclick="ToggleTaskMode"
                    title="@(_taskMode ? "Task mode on — click to disable" : "Enable task mode")"
                    disabled="@(isStreaming || _isBriefStreaming)">
                <i class="fas fa-bolt"></i> Task
            </button>
            <MudIconButton Icon="@Icons.Material.Filled.Send"
                Disabled="@(isStreaming || _isBriefStreaming || (string.IsNullOrWhiteSpace(_userInput) && !_pendingAttachments.Any()))"
                OnClick="HandleSendFromInput"
                Style="@GetSendButtonStyle()"
                Size="Size.Medium" />
        </div>
        @if (_isDictating && !string.IsNullOrEmpty(_interimTranscript))
        {
            <div style="font-size: var(--text-xs); color: var(--color-text-tertiary); padding: 4px 0; font-style: italic;">
                @_interimTranscript
            </div>
        }
        @if (!string.IsNullOrEmpty(_micError))
        {
            <div style="font-size: var(--text-xs); color: #dc2626; padding: 4px 0;">
                @_micError
            </div>
        }
    </div>
        </div>
    </div>

    @if (LayoutState.ArtifactPanelOpen)
    {
        <div style="width: 40%; min-width: 320px; max-width: 600px; flex-shrink: 0; overflow: hidden; transition: all 0.2s ease;">
            <ArtifactPreviewPanel />
        </div>
    }

    @if (LayoutState.ArtifactSidebarOpen)
    {
        <div style="width: @(_artifactSidebarWidth)px; min-width: 280px; max-width: 50vw; flex-shrink: 0; overflow: hidden;">
            <ArtifactSidebarPanel Artifacts="_conversationArtifacts" PanelWidth="@_artifactSidebarWidth" OnWidthChanged="@((w) => _artifactSidebarWidth = w)" />
        </div>
    }

</div>
}

@code {
    [Parameter] public Guid? ConversationId { get; set; }

    [CascadingParameter(Name = "DrawerOpen")]
    private bool DrawerOpen { get; set; }

    private int _artifactSidebarWidth = 320;

    private Conversation? conversation;
    private List<ChatMessage> messages = new();
    private string currentModel = "claude-sonnet-4-6";
    private bool isStreaming = false;
    private bool wasSummarized = false;
    private ChatMessage streamingMessage = new() { Role = "assistant", Content = "" };
    private CancellationTokenSource? streamingCts;
    private Guid? _lastConversationId;
    private bool _needsScroll = false;
    private bool _scrollListenerInitialized = false;
    private DotNetObjectReference<ChatView>? _dotNetRef;
    private Action? _layoutStateChangeHandler;
    private string _userInput = "";
    private bool _isDictating = false;
    private bool _speechSupported = false;
    private string _interimTranscript = "";
    private string? _micError = null;
    private UserAssistantConfig? _assistantConfig;
    private string? _avatarPreviewUrl;
    private string UserInitial =>
        (Session.CurrentUser?.DisplayName?.Trim().FirstOrDefault()
         ?? Session.CurrentUser?.Email?.Trim().FirstOrDefault()
         ?? '?').ToString().ToUpperInvariant();
    private List<KbTeam> _userTeams = new();
    private HashSet<int> _selectedTeamIds = new();
    // Local KB toggle state — works before conversation exists, synced to DB on first message send
    private bool _fortressKbEnabled = false;
    private bool _personalKbEnabled = false; // default: personal KB OFF
    private bool _teamKbPopoverOpen = false;
    private bool _hasPendingMigration = false;
    private List<McpServer> _availableToolServers = new();
    private string? _currentToolName;
    private bool _toolCallInProgress = false;

    // ADO#3241 — Tool call transparency events
    private List<ToolCallEvent> _activeToolCalls = new();
    private bool _toolCallsFading = false;
    private bool _ccTaskActive = false; // ADO#4201 — true while CC task_progress is active, prevents premature chip fade
    private record ToolCallEvent(string Server, string ToolName, string Status, string Summary, DateTime Timestamp, string? ChipIcon = null, Guid Id = default);
    // Attachment state
    private List<ChatAttachment> _pendingAttachments = new();
    private bool _isDragOver = false;
    // KB retrieval result for UI indicator (set per-message)
    private KbRetrievalResult? _lastKbResult;
    private int _chatRenderCount = 0;
    private int _afterRenderNoFirstCount = 0;

    // Task mode state
    private bool _taskMode = false;
    private bool _taskModeActive = false; // set true on mode_switch event
    private bool _taskResumedThisTurn = false; // ADO#3923: guard finally from undoing task_resume
    private bool _taskReadyPending = false; // ADO#4004: set by task_ready SSE, triggers re-submit after turn completes
    private bool _taskReadyResubmit = false; // ADO#4032: prevents HandleSend from resetting _taskModeActive on TASK_READY re-submit
    private bool _folderPickerCancelled = false; // ADO#5112: set in folder-cancel ContinueWith to suppress OperationCanceledException error message
    private string? _activeTaskFolderName = null;
    private Guid? _persistedWorkingFolderId = null;   // ADO#4144 — persisted working folder for this conversation
    private string? _persistedWorkingFolderName = null; // display name for the persisted folder
    private string _pendingTaskMessage = "";

    // Task Progress Timeline state (ADO#3244)
    private DateTime? _taskStartTime;
    private string _taskElapsed = "00:00";
    private System.Threading.Timer? _elapsedTimer;
    private CancellationTokenSource? _taskTimerCts;

    private void CancelTask()
    {
        streamingCts?.Cancel();
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
        _taskTimerCts?.Cancel();
        _taskTimerCts = null;
        _ = JS.InvokeVoidAsync("fortressChat.stopTaskTimer"); // ADO#4200
        _taskModeActive = false;
        _activeToolCalls.Clear();
        _ccTaskActive = false;
        StateHasChanged();
    }

    private void ToggleTaskMode()
    {
        _taskMode = !_taskMode;
        if (_taskMode)
            _taskModeActive = true;   // activate indicator immediately on user intent
        else
            _taskModeActive = false;  // clear indicator when user disables
        StateHasChanged();
    }

    private FeedbackModal? _feedbackModal;

    private void OpenFeedbackModal()
    {
        _feedbackModal?.Open();
    }
    private List<WorkspaceUpload> _conversationArtifacts = new();
    private WorkspaceUpload? _pendingArtifact = null;
    private FilesUpdatedPayload? _currentFileSummary = null;

    // Cold start UX — guard fields
    private bool _agentReady = false;
    private bool _checkingAgent = true;
    private bool _wasColdStart = false;
    private bool _resumptionBriefSent = false;
    private bool _isBriefStreaming = false;
    private string? _currentHarnessSessionId;
    private System.Text.StringBuilder _briefContent = new();
    // ADO#4001 — tracks whether the current conversation was just created in this session
    // (lazy creation on first send). Used to prevent spurious resumption brief on ConversationId change.
    private bool _conversationCreatedThisSession = false;

    // Failed-task banner state
    private bool _hasFailedTasks = false;
    private bool _failedTaskBannerDismissed = false;
    private bool _debugInfoDialogOpen = false;
    private static string BuildVersion =>
        (System.Reflection.Assembly.GetExecutingAssembly()
            .GetCustomAttributes(typeof(System.Reflection.AssemblyInformationalVersionAttribute), false)
            .FirstOrDefault() as System.Reflection.AssemblyInformationalVersionAttribute)
            ?.InformationalVersion ?? "unknown";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            Nav.NavigateTo("/auth/redirect-to-login", forceLoad: true);
            return;
        }

        _layoutStateChangeHandler = () => InvokeAsync(StateHasChanged);
        LayoutState.OnChange += _layoutStateChangeHandler;

        // Onboarding gate — redirect new users to setup
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.Users.FirstOrDefaultAsync(u => u.Id == Session.UserId);
            if (user != null && user.OnboardingCompletedAt == null)
            {
                Nav.NavigateTo("/assistant-setup", replace: true);
                return;
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] Onboarding check failed — skipping gate");
            // Fail open: don't block chat on DB error
        }

        // Launch the user's Fargate task if not already running
        try
        {
            await AgentRuntime.EnsureRunningAsync(Session.UserId.ToString());
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] EnsureRunningAsync failed — will poll for status");
            // Non-fatal — polling loop will surface the real status
        }

        // Check if Fargate session is running
        try
        {
            var session = await AgentRuntime.GetSessionAsync(Session.UserId.ToString());
            _agentReady = session?.Status == RuntimeSessionStatus.Running;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] Agent status check failed — defaulting to ready");
            _agentReady = true; // fail open: don't block chat on status check failure
        }
        _checkingAgent = false;
        if (_agentReady)
            _ = CheckFailedTasksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var cycle = ++_chatRenderCount;
        Logger.LogInformation("[ChatView] OnParametersSetAsync START — cycle={Cycle} ConversationId={ConversationId} lastConversationId={LastConversationId}",
            cycle, ConversationId, _lastConversationId);

        _teamKbPopoverOpen = false;
        if (ConversationId.HasValue)
        {
            conversation = await ChatSvc.GetConversationAsync(ConversationId.Value, Session.UserId);
            if (conversation != null)
            {
                var freshMessages = conversation.Messages.OrderBy(m => m.CreatedAt).ToList();
                if (freshMessages.Count != messages.Count)
                {
                    messages = freshMessages;
                }
                currentModel = conversation.Model;
                _selectedTeamIds = conversation.TeamKbs.Select(t => t.TeamId).ToHashSet();
                _fortressKbEnabled = conversation.EnableFortressKb;
                _personalKbEnabled = conversation.EnablePersonalKb;
                _conversationArtifacts = await WorkspaceFileSvc.GetConversationArtifactsAsync(conversation.Id);
                // ADO#4144 — restore persisted working folder (no re-prompt on reload)
                if (conversation.WorkingFolderId.HasValue && _persistedWorkingFolderId != conversation.WorkingFolderId)
                {
                    _persistedWorkingFolderId = conversation.WorkingFolderId;
                    try
                    {
                        var folders = await UploadSvc.GetFoldersAsync(Session.UserId, null);
                        var match = folders?.FirstOrDefault(f => f.Id == conversation.WorkingFolderId);
                        _persistedWorkingFolderName = match?.Name ?? "workspace";
                        _activeTaskFolderName = _persistedWorkingFolderName;
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] ADO#4144: Failed to load folder name for persistedWorkingFolderId={Id}", _persistedWorkingFolderId);
                    }
                }
            }
            else
            {
                _conversationArtifacts = new();
            }
        }
        else if (conversation == null)
        {
            // Lazy creation — conversation created on first message send, not on page load
            _conversationArtifacts = new();
            messages = new List<ChatMessage>();
            wasSummarized = false;
            _selectedTeamIds = new HashSet<int>();
            _fortressKbEnabled = false;
            _personalKbEnabled = false;
        }

        // Load assistant config for personality injection
        if (Session.IsAuthenticated && _assistantConfig == null)
        {
            _assistantConfig = await ConfigSvc.GetOrCreateConfigAsync(Session.UserId);
            if (!string.IsNullOrWhiteSpace(_assistantConfig?.AvatarUrl))
            {
                _avatarPreviewUrl = GenerateAvatarPreviewUrl(_assistantConfig.AvatarUrl);
            }
        }

        // Load user's team memberships for Team KB toggle
        if (Session.IsAuthenticated && !_userTeams.Any())
        {
            try { _userTeams = await ForgeSvc.GetUserTeamsAsync(Session.UserId); }
            catch { /* silent fail */ }
        }

        // Load available MCP servers for tool toggles
        if (Session.IsAuthenticated && conversation != null)
        {
            try { _availableToolServers = await McpToolSvc.GetActiveServersForUserAsync(Session.UserId); }
            catch { /* silent fail */ }
        }

        // Track conversation changes — scroll to bottom when switching chats
        if (ConversationId != _lastConversationId)
        {
            Logger.LogInformation("[ChatView] ConversationId changed — old={OldId} new={NewId} (cycle={Cycle})",
                _lastConversationId, ConversationId, cycle);
            _lastConversationId = ConversationId;
            _needsScroll = true;
            // Reset resumption brief state for new conversation
            _briefContent = new System.Text.StringBuilder();
            _resumptionBriefSent = false;
            // ADO#4001 — if conversation was just created in this session (lazy creation on first send),
            // do NOT set _wasColdStart — there is no pre-existing history to resume from.
            // This prevents a spurious resumption brief from firing after the first user message.
            if (_conversationCreatedThisSession)
            {
                _conversationCreatedThisSession = false; // consume the flag
                _wasColdStart = false;
                Logger.LogInformation("[ChatView] OnParametersSetAsync: new conversation created this session — suppressing cold-start resumption brief");
            }
            else
            {
                _wasColdStart = _agentReady; // ADO#3285 — treat cross-chat navigation as cold start if agent is ready
            }
            _isBriefStreaming = false;
            _activeToolCalls.Clear();  // ADO#3241
            _ccTaskActive = false;
            LayoutState.CloseArtifactSidebar(); // ADO#3456 — reset sidebar on conversation switch

            // ADO#3308 — refresh harness session ID for warm cross-chat navigation
            // HandleAgentReady won't fire again if agent is already warm, so we need
            // the session ID here to allow SendResumptionBrief to write its guard key
            if (_agentReady)
            {
                try
                {
                    var session = await AgentRuntime.GetSessionAsync(Session.UserId.ToString());
                    if (session?.SessionId != null)
                        _currentHarnessSessionId = session.SessionId;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[ChatView] OnParametersSetAsync: could not refresh harness session ID — non-fatal");
                }
            }
        }

        // Handle previewArtifact query param — deep-link from Workspace page
        // Only runs after _conversationArtifacts is loaded (above)
        if (_conversationArtifacts.Any())
        {
            var uri = new Uri(Nav.Uri);
            var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("previewArtifact", out var previewIdValues))
            {
                var previewIdStr = previewIdValues.FirstOrDefault();
                if (!string.IsNullOrEmpty(previewIdStr) && Guid.TryParse(previewIdStr, out var previewId))
                {
                    var artifact = _conversationArtifacts.FirstOrDefault(a => a.Id == previewId);
                    if (artifact != null && LayoutState.CurrentArtifact?.Id != artifact.Id)
                    {
                        // Mutual exclusion: close sidebar before opening preview panel
                        if (LayoutState.ArtifactSidebarOpen)
                            LayoutState.CloseArtifactSidebar();
                        LayoutState.OpenArtifactPreview(new ArtifactRef(artifact.Id, artifact.S3Key, artifact.Filename, artifact.MimeType, artifact.PreviewS3Key));
                    }
                }
            }
        }

        Logger.LogInformation("[ChatView] OnParametersSetAsync END — cycle={Cycle} ConversationId={ConversationId} messageCount={MessageCount}",
            cycle, ConversationId, messages.Count);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            var count = ++_afterRenderNoFirstCount;
            if (count % 10 == 0)
                Logger.LogWarning("[ChatView] OnAfterRenderAsync non-firstRender loop count={Count}", count);
        }
        Logger.LogInformation("[ChatView] OnAfterRenderAsync — firstRender={FirstRender} cycle={Cycle} ConversationId={ConversationId} IsAuthenticated={IsAuthenticated}",
            firstRender, _chatRenderCount, ConversationId, Session.IsAuthenticated);

        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            try
            {
                await JS.InvokeVoidAsync("fortressChat.initScrollListener", _dotNetRef);
                _scrollListenerInitialized = true;
            }
            catch { /* JS interop can fail during prerender */ }

            try
            {
                _speechSupported = await JS.InvokeAsync<bool>("fortressChat.isSpeechRecognitionSupported");
            }
            catch { /* Speech API check can fail during prerender */ }

            try
            {
                await JS.InvokeVoidAsync("window.fortressChat.setupDragDrop", "chat-input-drop-zone", _dotNetRef);
            }
            catch { /* JS interop can fail during prerender */ }
        }

        if (_needsScroll)
        {
            _needsScroll = false;
            await ScrollToBottom();
        }

        // Cold start resumption brief — fires once after agent becomes ready
        if (_wasColdStart && _agentReady && !_resumptionBriefSent && ConversationId.HasValue && ConversationId.Value != Guid.Empty
            && messages.Any(m => !m.IsResumptionBrief)
            && !_conversationCreatedThisSession) // ADO#4813 — new conversation = no resumption brief
        {
            _resumptionBriefSent = true;
            _wasColdStart = false;
            _isBriefStreaming = true;
            _briefContent = new System.Text.StringBuilder();
            // NOTE: Do NOT call StateHasChanged() here — it triggers re-entry into OnAfterRenderAsync.
            // SendResumptionBrief will call StateHasChanged() as each streaming token arrives.
            _ = SendResumptionBrief();
        }
    }

    private string? GenerateAvatarPreviewUrl(string? rawS3Url)
    {
        if (string.IsNullOrWhiteSpace(rawS3Url)) return null;
        try
        {
            var bucket = Config["WORKSPACE_S3_BUCKET"] ?? "fortress-user-workspaces";
            var prefix = $"https://{bucket}.s3.amazonaws.com/";
            if (!rawS3Url.StartsWith(prefix)) return rawS3Url;
            var key = rawS3Url[prefix.Length..];
            var req = new GetPreSignedUrlRequest
            {
                BucketName = bucket,
                Key = key,
                Expires = DateTime.UtcNow.AddHours(1),
                Verb = HttpVerb.GET
            };
            return S3.GetPreSignedURL(req);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[Avatar] Pre-signed URL failed for {Url}", rawS3Url);
            return null;
        }
    }

