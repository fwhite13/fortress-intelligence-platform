    private async Task SendResumptionBrief()
    {
        try
        {
            // Build history from last 3 messages if any
            var recentHistory = messages
                .TakeLast(3)
                .Select(m => new ChatHistoryEntry(m.Role, m.Content))
                .ToList();

            var briefRequest = new TurnRequest(
                UserId: Session.UserId.ToString(),
                Message: "__resumption_brief__",
                History: recentHistory.Any() ? recentHistory : null,
                TaskMode: false
            );

            _isBriefStreaming = true;
            _briefContent = new System.Text.StringBuilder();
            StateHasChanged();

            await foreach (var evt in AgentRuntime.SendTurnAsync(Session.UserId.ToString(), briefRequest, CancellationToken.None))
            {
                if (evt.Type == "text")
                {
                    var content = evt.Content ?? "";
                    // Strip the __brief_start__ sentinel
                    if (_briefContent.Length == 0 && content.Contains("__brief_start__"))
                        content = content.Replace("__brief_start__", "").TrimStart('\n', '\r');
                    _briefContent.Append(content);
                    StateHasChanged();
                }
                else if (evt.Type is "done" or "error")
                {
                    break;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] Resumption brief failed — non-fatal");
        }
        finally
        {
            _isBriefStreaming = false;
            StateHasChanged();
        }
    }

