    }

    private async Task HandleSend(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || isStreaming) return;
        _pendingTaskMessage = text;
        _lastKbResult = null;  // Clear stale result before new send
        _currentFileSummary = null;
        _activeToolCalls.Clear();  // ADO#3241 — Reset tool call indicators
        _ccTaskActive = false;
        if (!_taskReadyResubmit)
            _taskModeActive = false; // Reset — will be set by mode_switch event in this turn
        _taskReadyResubmit = false;  // ADO#4032: clear after consuming
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;
        // ADO#3308 — Clear in-memory resumption brief when user sends their first message
        messages.RemoveAll(m => m.IsResumptionBrief);
        _briefContent.Clear();

        // Capture pending attachments before clearing
        var attachmentsSnapshot = _pendingAttachments.ToList();
        _pendingAttachments.Clear();

        // Lazy conversation creation — only when user actually sends their first message
        if (conversation == null && Session.IsAuthenticated)
        {
            conversation = await ChatSvc.CreateConversationAsync(Session.UserId, null, currentModel);
            // Sync local KB toggle state to the new conversation
            await ChatSvc.UpdateConversationKbAsync(conversation.Id, _fortressKbEnabled, _personalKbEnabled, _selectedTeamIds.ToList());
            Logger.LogInformation("[ChatView] Nav.NavigateTo — /chat/{ConversationId} (lazy creation, replace=true)", conversation.Id);
            _conversationCreatedThisSession = true; // ADO#4001 — guard against spurious resumption brief on nav
            Nav.NavigateTo($"/chat/{conversation.Id}", replace: true);
        }

        if (conversation == null) return;

        // Add user message
        var userMsg = await ChatSvc.AddMessageAsync(conversation.Id, "user", text.Trim());
        messages.Add(userMsg);

        // Link attachments to this message
        foreach (var att in attachmentsSnapshot)
        {
            await AttachmentSvc.LinkAttachmentToMessageAsync(att.Id, userMsg.Id);
        }

        // Start streaming
        isStreaming = true;
        streamingMessage = new ChatMessage { Role = "assistant", Content = "", Model = currentModel };
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            streamingCts = new CancellationTokenSource();

            // Load project once for system prompt + KB
            FortressAI.Shared.Models.Project? project = null;
            if (conversation?.ProjectId != null)
            {
                project = await ProjectSvc.GetProjectAsync(conversation.ProjectId.Value, Session.UserId);

                // Background migration for pre-RAG docs (Content but no S3Key)
                if (project != null)
                {
                    var docsNeedingMigration = project.Documents
                        .Where(d => !string.IsNullOrEmpty(d.Content) && string.IsNullOrEmpty(d.S3Key))
                        .ToList();
                    if (docsNeedingMigration.Any())
                    {
                        _hasPendingMigration = true;
                        var userId = Session.UserId;
                        var docsSnapshot = docsNeedingMigration.Select(d => d.Id).ToList();
                        _ = Task.Run(async () =>
                        {
                            using var scope = ScopeFactory.CreateScope();
                            var docSvc = scope.ServiceProvider.GetRequiredService<DocumentService>();
                            var kbDocSvc = scope.ServiceProvider.GetRequiredService<KbDocumentService>();
                            foreach (var docId in docsSnapshot)
                            {
                                try { await docSvc.MigrateDocumentToS3ByIdAsync(docId, userId); }
                                catch (Exception ex) { Console.WriteLine($"[MIGRATE] Doc {docId} failed: {ex.Message}"); }
                            }
                            try { await kbDocSvc.StartIngestionAsync(); }
                            catch { }
                        });
                    }
                    else
                    {
                        _hasPendingMigration = false;
                    }
                }
            }

            // Build system prompt from project context
            string? systemPrompt = BuildSystemPromptFromProject(project, _hasPendingMigration);

            // Inject personality prefix from assistant config
            if (_assistantConfig != null)
            {
                var personalityPrefix = await ConfigSvc.BuildSystemPromptAsync(_assistantConfig, Session.UserId, Session.CurrentUser?.DisplayName, Session.CurrentUser?.Email);
                systemPrompt = string.IsNullOrEmpty(systemPrompt)
                    ? personalityPrefix
                    : personalityPrefix + "\n\n" + systemPrompt;
            }

            // Inject artifact system prompt
            var artifactPrompt = GetArtifactSystemPrompt();
            systemPrompt = string.IsNullOrEmpty(systemPrompt)
                ? artifactPrompt
                : systemPrompt + "\n\n" + artifactPrompt;

            // ADO#3241 — KB retrieval now handled by harness
            // Blazor passes KB flags; harness does retrieval and emits kb_sources SSE event
            bool hasCorpKb = _fortressKbEnabled;
            bool hasPersonalKb = _personalKbEnabled;
            bool hasTeamKb = _selectedTeamIds?.Any() == true;
            bool hasProjectKb = conversation?.ProjectId.HasValue == true;
            bool anyKbActive = hasCorpKb || hasPersonalKb || hasTeamKb || hasProjectKb;
            Console.WriteLine($"[KB] Flags — Corp:{hasCorpKb} Personal:{hasPersonalKb} Team:{hasTeamKb} Project:{hasProjectKb} UserId:{Session.UserId}");

            var effectiveSystemPrompt = systemPrompt;  // no longer pre-populated with KB context

            // Inject attachment content into context
            if (attachmentsSnapshot.Any())
            {
                var attachmentContextBuilder = new System.Text.StringBuilder();
                attachmentContextBuilder.AppendLine("## Attached Files");
                attachmentContextBuilder.AppendLine("The user has attached the following files to this message:");
                attachmentContextBuilder.AppendLine();
                foreach (var att in attachmentsSnapshot)
                {
                    try
                    {
                        var content = await AttachmentSvc.ExtractAttachmentContentAsync(att);
                        if (content != null)
                        {
                            attachmentContextBuilder.AppendLine($"### {att.Filename} ({ChatAttachmentService.FormatFileSize(att.SizeBytes)})");
                            attachmentContextBuilder.AppendLine(content);
                            attachmentContextBuilder.AppendLine();
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[ATTACH] Failed to extract content from {att.Filename}: {ex.Message}");
                    }
                }
                var attachmentContext = attachmentContextBuilder.ToString();
                effectiveSystemPrompt = string.IsNullOrEmpty(effectiveSystemPrompt)
                    ? attachmentContext
                    : attachmentContext + "\n\n" + effectiveSystemPrompt;
            }

            // Apply sliding window context management
            var (chatHistory, summarized) = await ChatSvc.PrepareMessagesWithSlidingWindowAsync(messages, effectiveSystemPrompt);
            wasSummarized = summarized;

            // Check if any MCP tools are available
            List<AvailableTool> availableTools = new();
            try
            {
                availableTools = await McpToolSvc.GetConversationToolsAsync(conversation.Id, Session.UserId);
                Logger.LogInformation("[MCP] Loaded {Count} tools for user {UserId}: {Tools}",
                    availableTools.Count,
                    Session.UserId,
                    string.Join(", ", availableTools.Select(t => t.FullName)));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[MCP] Failed to load tools for conversation {ConvId}", conversation.Id);
            }

            // Extract distinct MCP server slugs from available tools
            var enabledMcpSlugs = availableTools
                .Select(t => {
                    var sep = t.FullName.IndexOf("__", StringComparison.Ordinal);
                    return sep > 0 ? t.FullName[..sep] : null;
                })
                .Where(s => s != null)
                .Distinct()
                .Select(s => s!)
                .ToList();

            var fullResponse = new System.Text.StringBuilder();
            int inputTokens = 0, outputTokens = 0;

            // Route through Fargate harness (SSE streaming via IUserAgentRuntime)
            var turnRequest = new TurnRequest(
                UserId: Session.UserId.ToString(),
                Message: text.Trim(),
                History: chatHistory.Select(m => new ChatHistoryEntry(m.Role, m.Content)).ToList(),
                TaskMode: _taskMode,
                SystemPrompt: string.IsNullOrEmpty(effectiveSystemPrompt) ? null : effectiveSystemPrompt,
                ConversationId: conversation.Id.ToString(),
                EnabledMcpSlugs: enabledMcpSlugs.Count > 0 ? enabledMcpSlugs : null,
                Model: currentModel,
                PersistedWorkingFolderId: _persistedWorkingFolderId?.ToString(),  // ADO#4144
                // ADO#3316-fix: always send KbFlags (never null) so harness preference gate fires even when all KBs are off
                KbFlags: new KbFlags(
                    CorpKbEnabled: hasCorpKb,
                    PersonalKbEnabled: hasPersonalKb,
                    TeamKbEnabled: hasTeamKb,
                    PersonalKbUserId: hasPersonalKb && Session.UserId != Guid.Empty
                        ? Session.UserId.ToString()
                        : null,
                    TeamIds: hasTeamKb && _selectedTeamIds?.Any() == true
                        ? _selectedTeamIds.Intersect(_userTeams.Select(t => t.Id)).ToList()
                        : null
                )
            );

            _lastKbResult = null; // ADO#3315 — belt-and-suspenders clear at SSE stream open
            await foreach (var evt in AgentRuntime.SendTurnAsync(Session.UserId.ToString(), turnRequest, streamingCts!.Token))
            {
                if (streamingCts.IsCancellationRequested) break;

                if (evt.Type == "text")
                {
                    // Fade out tool call strip on first response token (ADO#3455)
                    // ADO#4141: only fade if no chip is still actively calling/in-progress
                    if (_activeToolCalls.Any() && !_toolCallsFading && !_ccTaskActive &&
                        !_activeToolCalls.Any(tc => tc.Status == "calling" || tc.Status == "in-progress"))
                    {
                        _toolCallsFading = true;
                        _ = Task.Delay(200).ContinueWith(_ => InvokeAsync(() =>
                        {
                            _activeToolCalls.Clear();
                            _ccTaskActive = false;
                            _toolCallsFading = false;
                            StateHasChanged();
                            return Task.CompletedTask;
                        }));
                    }
                    fullResponse.Append(evt.Content ?? "");
                    streamingMessage.Content = fullResponse.ToString();
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom();
                }
                else if (evt.Type == "done")
                {
                    inputTokens = evt.InputTokens ?? 0;
                    outputTokens = evt.OutputTokens ?? 0;
                    _taskModeActive = false;
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Type == "error")
                {
                    fullResponse.Append($"\n\n⚠️ {evt.ErrorMessage ?? "An error occurred."}");
                    streamingMessage.Content = fullResponse.ToString();
                    _taskModeActive = false;
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Type == "mode_switch")
                {
                    _taskModeActive = true;
                    _taskMode = true;  // ADO#4912 — sync pill with task mode indicator
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Type == "artifact")
                {
                    try
                    {
                        var artifactPayload = System.Text.Json.JsonSerializer.Deserialize<ArtifactPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions
                            { PropertyNameCaseInsensitive = true });
                        if (artifactPayload != null)
                        {
                            _pendingArtifact = await WorkspaceFileSvc.SaveArtifactAsync(
                                Session.UserId, conversation.Id, null, artifactPayload);
                            _conversationArtifacts.Add(_pendingArtifact);
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to save artifact from SSE event");
                    }
                }
                else if (evt.Type == "kb_sources")
                {
                    try
                    {
                        var kbSourcesPayload = System.Text.Json.JsonSerializer.Deserialize<KbSourcesPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (kbSourcesPayload?.Sources != null)
                        {
                            var result = new KbRetrievalResult { WasSearched = true };
                            foreach (var src in kbSourcesPayload.Sources)
                            {
                                if (src.SourceCount > 0)
                                {
                                    result.SourceStats.Add(new KbSourceStat
                                    {
                                        KbName = src.KbName ?? "KB",
                                        ResultCount = src.SourceCount,
                                        SourceDocuments = src.Chunks?.Select(c => c.Title ?? "").Where(t => !string.IsNullOrEmpty(t)).Distinct().ToList() ?? new()
                                    });
                                    for (int i = 0; i < src.SourceCount; i++)
                                        result.InjectedChunks.Add(new KbChunk { Source = src.KbId ?? "harness" });
                                }
                            }
                            _lastKbResult = result;
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse kb_sources payload");
                    }
                }
                else if (evt.Type == "chip")
                {
                    // ADO#4717 — ephemeral chip from Bedrock tool calls
                    // ADO#4810 — assign unique Id so auto-dismiss only removes this chip
                    var chipText = evt.Content ?? "Working...";
                    var resolvedToolName = !string.IsNullOrEmpty(evt.ToolName) ? evt.ToolName : "chip";
                    var chipIcon = GetChipIconKeyFromToolName(resolvedToolName);
                    var legacyChip = new ToolCallEvent("bedrock", resolvedToolName, "calling", chipText, DateTime.UtcNow, chipIcon, Guid.NewGuid());
                    _activeToolCalls.Add(legacyChip);
                    await InvokeAsync(StateHasChanged);
                    await ScrollToBottom(); // ADO#4862 — scroll to keep chip visible

                    // ADO#4810 — auto-dismiss legacy chip after 2s (fade then remove), same pattern as task_progress
                    var chipId = legacyChip.Id;
                    var chipAddedAt = legacyChip.Timestamp;
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            var elapsed = (DateTime.UtcNow - chipAddedAt).TotalMilliseconds;
                            var remaining = ToolChipMinDisplayMs - (int)elapsed;
                            if (remaining > 0) await Task.Delay(remaining);
                            else await Task.Delay(200);
                            await InvokeAsync(() =>
                            {
                                var idx = _activeToolCalls.FindIndex(c => c.Id == chipId);
                                if (idx >= 0)
                                {
                                    _activeToolCalls[idx] = _activeToolCalls[idx] with { Status = "done" };
                                    StateHasChanged();
                                }
                            });
                            await Task.Delay(500);
                            await InvokeAsync(() =>
                            {
                                _activeToolCalls.RemoveAll(c => c.Id == chipId);
                                StateHasChanged();
                            });
                        }
                        catch (ObjectDisposedException) { }
                        catch (TaskCanceledException) { }
                    });
                }
                else if (evt.Type == "tool_call")
                {
                    try
                    {
                        var toolCallPayload = System.Text.Json.JsonSerializer.Deserialize<ToolCallPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (toolCallPayload != null)
                        {
                            HandleToolCallEvent(toolCallPayload);
                            await InvokeAsync(StateHasChanged);
                            await ScrollToBottom(); // ADO#4862 — scroll to keep chip visible
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse tool_call payload");
                    }
                }
                else if (evt.Type == "task_progress")
                {
                    try
                    {
                        var progressPayload = System.Text.Json.JsonSerializer.Deserialize<TaskProgressPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (progressPayload != null)
                        {
                            Console.WriteLine($"[ChatView] chip received Step={progressPayload.Step} Tool={progressPayload.ToolName} Message={progressPayload.Message} Icon={progressPayload.ChipIcon}");
                            if (progressPayload.Step == "start")
                            {
                                _taskModeActive = true; // ADO#4808,4859 — activate indicator immediately on task start
                                _ccTaskActive = true;
                                await InvokeAsync(StateHasChanged); // ADO#4808,4859 — force render immediately
                                _taskStartTime = DateTime.UtcNow;
                                _elapsedTimer?.Dispose();
                                _elapsedTimer = null;
                                _taskTimerCts?.Cancel();
                                _taskTimerCts = null;
                                // ADO#4200: JS-driven timer bypasses Blazor circuit — no freeze during heavy SSE streaming
                                var startMs = DateTimeOffset.UtcNow.ToUnixTimeMilliseconds();
                                _ = JS.InvokeVoidAsync("fortressChat.startTaskTimer", startMs);
                            }
                            var stepMessage = progressPayload.Message
                                ?? GetToolLabel(progressPayload.ToolName ?? "cc", "task", null);
                            var toolName = progressPayload.ToolName ?? "cc";
                            var isFinal = progressPayload.Step == "done" || progressPayload.Status == "done";

                            // ADO#4810 — cap at 3 calling task chips; remove oldest if at limit
                            if (!isFinal && _activeToolCalls.Count(c => c.Server == "task" && c.Status == "calling") >= 3)
                                _activeToolCalls.RemoveAll(c => c.Server == "task" && c.Status == "calling" && _activeToolCalls.IndexOf(c) == _activeToolCalls.FindIndex(x => x.Server == "task" && x.Status == "calling"));

                            Logger.LogInformation("[Chip] Path=harness Tool={Tool} ChipIcon={ChipIcon}", toolName, progressPayload.ChipIcon ?? "(null)");
                            var newChip = new ToolCallEvent("task", toolName, isFinal ? "done" : "calling", stepMessage, DateTime.UtcNow, progressPayload.ChipIcon, Guid.NewGuid());
                            _activeToolCalls.Add(newChip);
                            if (isFinal)
                                _ccTaskActive = false;
                            await InvokeAsync(StateHasChanged);
                            await ScrollToBottom(); // ADO#4862 — scroll to keep chip visible

                            // ADO#4810 — auto-dismiss non-final chips after 2s (fade then remove)
                            if (!isFinal)
                            {
                                var chipId = newChip.Id;
                                var chipAddedAt2 = newChip.Timestamp;
                                _ = Task.Run(async () =>
                                {
                                    try
                                    {
                                        var elapsed2 = (DateTime.UtcNow - chipAddedAt2).TotalMilliseconds;
                                        var remaining2 = ToolChipMinDisplayMs - (int)elapsed2;
                                        if (remaining2 > 0) await Task.Delay(remaining2);
                                        else await Task.Delay(200);
                                        await InvokeAsync(() =>
                                        {
                                            var idx = _activeToolCalls.FindIndex(c => c.Id == chipId);
                                            if (idx >= 0)
                                            {
                                                _activeToolCalls[idx] = _activeToolCalls[idx] with { Status = "done" };
                                                StateHasChanged();
                                            }
                                        });
                                        await Task.Delay(500);
                                        await InvokeAsync(() =>
                                        {
                                            _activeToolCalls.RemoveAll(c => c.Id == chipId);
                                            StateHasChanged();
                                        });
                                    }
                                    catch (ObjectDisposedException) { }
                                    catch (TaskCanceledException) { }
                                });
                            }
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse task_progress payload");
                    }
                }
                else if (evt.Type == "folder_required")
                {
                    try
                    {
                        var folderPayload = System.Text.Json.JsonSerializer.Deserialize<FolderRequiredPayload>(
                            evt.Payload ?? "{}",
                            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        var parsedFolders = folderPayload?.Folders?
                            .Select(f => new FolderInfo(f.Id, f.Name, f.LastUsedAt))
                            .ToList() ?? new();
                        var lastFolderId = folderPayload?.LastFolderId;
                        var conversationId = folderPayload?.ConversationId ?? conversation?.Id.ToString() ?? "";
                        var taskMessage = _pendingTaskMessage;

                        var parameters = new DialogParameters
                        {
                            [nameof(FolderPicker.Folders)] = parsedFolders,
                            [nameof(FolderPicker.LastFolderId)] = lastFolderId,
                            [nameof(FolderPicker.ConversationId)] = conversationId,
                            [nameof(FolderPicker.TaskMessage)] = taskMessage
                        };
                        var options = new DialogOptions
                        {
                            MaxWidth = MaxWidth.Small,
                            FullWidth = true,
                            CloseOnEscapeKey = false,
                            BackdropClick = false
                        };

                        var dialog = await DialogService.ShowAsync<FolderPicker>("Select working folder", parameters, options);
                        await InvokeAsync(StateHasChanged);

                        // ADO#4925 — DEADLOCK FIX: do NOT await dialog.Result here.
                        // The SSE loop is blocking the Blazor circuit; awaiting dialog.Result inside it
                        // prevents MudDialog.Cancel() from being dispatched. Use ContinueWith to handle
                        // the result asynchronously outside this execution context.
                        _ = dialog.Result.ContinueWith(async resultTask =>
                        {
                            var result = resultTask.IsCompletedSuccessfully ? resultTask.Result : null;
                            if (result != null && !result.Canceled && result.Data is FolderPicker.FolderConfirmedArgs confirmedArgs)
                            {
                                await InvokeAsync(() =>
                                {
                                    if (_taskMode)
                                    {
                                        _taskModeActive = true;
                                    }
                                    HandleFolderConfirmed(confirmedArgs);
                                    StateHasChanged();
                                });
                            }
                            else
                            {
                                // Cancelled — clear ALL task state and abort the SSE loop
                                await InvokeAsync(() =>
                                {
                                    _folderPickerCancelled = true; // ADO#5112: suppress OperationCanceledException error in catch
                                    _taskMode = false;
                                    _taskModeActive = false;
                                    _ccTaskActive = false;
                                    _pendingTaskMessage = "";
                                    _activeToolCalls.Clear();
                                    Logger.LogInformation("[ChatView] FolderPicker cancelled — task state cleared, aborting SSE loop");
                                    streamingCts?.Cancel(); // ADO#5112: abort the waiting ReadLineAsync
                                    StateHasChanged();
                                });
                            }
                        });

                        // ADO#5112: do NOT break — harness holds the SSE connection open while awaiting folder-confirm.
                        // After /turn/folder-confirm is posted, the harness resumes and streams remaining events
                        // (task_progress, files_updated, task_resume, done) on this same connection.
                        // Breaking here would close the TCP stream and lose all post-confirm output.
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to handle folder_required / open dialog");
                    }
                }
                else if (evt.Type == "files_updated")
                {
                    try
                    {
                        var payload = System.Text.Json.JsonSerializer.Deserialize<FilesUpdatedPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (payload?.Files?.Count > 0)
                        {
                            _currentFileSummary = payload;
                            // ADO#4033: refresh artifact indicator live
                            if (conversation != null)
                            {
                                _conversationArtifacts = await WorkspaceFileSvc.GetConversationArtifactsAsync(conversation.Id);
                            }
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse files_updated payload");
                    }
                }
                else if (evt.Type == "task_hold")
                {
                    // ADO#3576 — 9.2: gate returned TASK_HOLD; deselect Task toggle
                    _taskMode = false;
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Type == "task_resume")
                {
                    // ADO#3923: model signaled requirements are now clear — re-enable task mode
                    _taskResumedThisTurn = true;
                    _taskMode = true;
                    await InvokeAsync(StateHasChanged);
                }
                else if (evt.Type == "task_ready")
                {
                    // ADO#4004: model self-escalated to task mode — set task mode and queue re-submission
                    _taskMode = true;
                    _taskReadyPending = true;
                    _taskResumedThisTurn = true; // prevent finally from resetting _taskMode
                    await InvokeAsync(StateHasChanged);
                }
                // "log" events: swallow silently
            }

            // ADO#3923/4004: strip sentinels at turn-end (may have split across chunks)
            var assistantResponseText = fullResponse.ToString().Replace("[TASK_RESUME]", "").Replace("[TASK_READY]", "").TrimEnd();

            // Save assistant message
            var assistantMsg = await ChatSvc.AddMessageAsync(
                conversation.Id, "assistant", assistantResponseText,
                currentModel, inputTokens, outputTokens);
            messages.Add(assistantMsg);

            // Generate contextual title after first exchange (fire and forget)
            if (messages.Count == 2)  // first user + first assistant
            {
                var convId = conversation.Id;
                var userText = text;
                var assistantText = assistantResponseText;
                _ = Task.Run(async () =>
                {
                    await ChatSvc.GenerateConversationTitleAsync(convId, userText, assistantText);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            streamingMessage.Content += $"\n\n⚠️ Error: {ex.Message}";
        }
        finally
        {
            if (_awaitingFolderConfirm)
            {
                // ADO#5112: harness paused for folder-confirm — skip teardown, minimal reset only
                isStreaming = false;
                streamingMessage = new ChatMessage { Role = "assistant", Content = "" };
                StateHasChanged();
            }
            else
            {
                isStreaming = false;
                _taskMode = _taskResumedThisTurn;   // ADO#3923: preserve if task_resume fired this turn
                _taskResumedThisTurn = false;        // always reset the guard flag
                _elapsedTimer?.Dispose();
                _elapsedTimer = null;
                _taskTimerCts?.Cancel();
                _taskTimerCts = null;
                _ = JS.InvokeVoidAsync("fortressChat.stopTaskTimer"); // ADO#4200
                _taskModeActive = false;
                _activeTaskFolderName = null;  // ADO#3560
                _activeToolCalls.Clear();    // ADO#3455 — ensure cleared on turn end
                _ccTaskActive = false;
                _toolCallsFading = false;    // ADO#3455
                streamingMessage = new ChatMessage { Role = "assistant", Content = "" };
                StateHasChanged();
            }
        }

        // ADO#4004: if task_ready was received, re-submit the message with task mode on
        if (_taskReadyPending && !string.IsNullOrWhiteSpace(_pendingTaskMessage))
        {
            _taskReadyPending = false;
            var resubmitText = _pendingTaskMessage;
            _pendingTaskMessage = "";
            _taskModeActive = true;        // ADO#4032: activate UI immediately
            _taskReadyResubmit = true;     // ADO#4032: guard HandleSend reset
            await InvokeAsync(StateHasChanged);
            await HandleSend(resubmitText);
        }
    }

    private string? BuildSystemPromptFromProject(FortressAI.Shared.Models.Project? project, bool hasPendingMigration = false)
    {
        if (project == null) return null;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"## Project: {project.Name}");
        sb.AppendLine();

        if (!string.IsNullOrEmpty(project.CustomInstructions))
        {
            sb.AppendLine(project.CustomInstructions);
            sb.AppendLine();
        }

        sb.AppendLine("(Project documents are retrieved via knowledge base search and will be included below.)");

        if (hasPendingMigration)
        {
            sb.AppendLine();
            sb.AppendLine("Note: Some project documents are being indexed and may not be available in this conversation yet.");
        }

        return sb.ToString().Trim();
    }

