    private async Task SendResumptionBrief()
    {
        var capturedConversationId = ConversationId; // capture before any await
        try
        {
            await ExecuteBriefWithRetryAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] Resumption brief failed — non-fatal");
        }
        finally
        {
            if (!string.IsNullOrEmpty(_currentHarnessSessionId))
            {
                try
                {
                    var briefStorageKey = $"resumption_brief_{_currentHarnessSessionId}_{capturedConversationId}";
                    await SessionStorage.SetAsync(briefStorageKey, _currentHarnessSessionId);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[ChatView] Failed to write resumption brief session to storage — non-fatal");
                }
            }
            _isBriefStreaming = false;

            // ADO#3308 — Add brief to messages list so it survives in-session navigation
            if (_briefContent.Length > 0)
            {
                messages.RemoveAll(m => m.IsResumptionBrief);
                messages.Add(new ChatMessage
                {
                    Id = Guid.NewGuid(),
                    ConversationId = capturedConversationId ?? Guid.Empty,
                    Role = "assistant",
                    Content = _briefContent.ToString(),
                    CreatedAt = DateTime.UtcNow,
                    IsResumptionBrief = true
                });
            }

            // ADO#3308 Bug 4 — trigger scroll after brief finishes
            _needsScroll = true;
            StateHasChanged();
        }
    }

    private async Task ExecuteBriefWithRetryAsync()
    {
        const int maxAttempts = 2;
        for (int attempt = 1; attempt <= maxAttempts; attempt++)
        {
            try
            {
                // ADO#4827 — safety guard: never send brief if there's no real history
                var recentHistory = messages
                    .Where(m => !m.IsResumptionBrief && (m.Role == "user" || m.Role == "assistant"))
                    .TakeLast(3)
                    .Select(m => new ChatHistoryEntry(m.Role, m.Content))
                    .ToList();

                if (!recentHistory.Any())
                {
                    Logger.LogInformation("[ChatView] ExecuteBriefWithRetryAsync: no real history found — skipping brief (attempt={Attempt})", attempt);
                    return;
                }

                var briefRequest = new TurnRequest(
                    UserId: Session.UserId.ToString(),
                    Message: "__resumption_brief__",
                    History: recentHistory.Any() ? recentHistory : null,
                    TaskMode: false,
                    Model: currentModel
                );

                await foreach (var evt in AgentRuntime.SendTurnAsync(
                    Session.UserId.ToString(), briefRequest, CancellationToken.None))
                {
                    if (evt.Type == "text")
                    {
                        var content = evt.Content ?? "";
                        _briefContent.Append(content);
                        StateHasChanged();
                    }
                    else if (evt.Type is "done" or "error")
                    {
                        break;
                    }
                }
                return; // success — exit retry loop
            }
            catch (InvalidOperationException ex) when (
                attempt < maxAttempts &&
                (ex.Message.Contains("Stale session") || ex.Message.Contains("no longer RUNNING")))
            {
                Logger.LogWarning(ex,
                    "[ChatView] SendResumptionBrief: stale task on attempt {Attempt} — waiting 5s then retrying", attempt);
                _briefContent.Clear();
                await Task.Delay(TimeSpan.FromSeconds(5), CancellationToken.None);
            }
            // All other exceptions propagate to SendResumptionBrief's catch block
        }
    }

    private async Task HandleAgentReady()
    {
        _agentReady = true;
        StateHasChanged();
        _ = CheckFailedTasksAsync();

        // ADO#3277 — guard: if brief already sent this render cycle, don't re-enter
        if (_resumptionBriefSent)
        {
            Logger.LogDebug("[ChatView] HandleAgentReady: _resumptionBriefSent already true — skipping brief setup");
            return;
        }

        // Cross-navigation guard: only send resumption brief once per Fargate session
        try
        {
            string? currentSessionId = null;
            try
            {
                var session = await AgentRuntime.GetSessionAsync(Session.UserId.ToString());
                currentSessionId = session?.SessionId;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[ChatView] Could not get sessionId for resumption brief guard — will proceed");
            }

            if (!string.IsNullOrEmpty(currentSessionId))
            {
                var briefStorageKey = $"resumption_brief_{currentSessionId}_{ConversationId}";
                string? storedSessionId = null;
                try
                {
                    var result = await SessionStorage.GetAsync<string>(briefStorageKey);
                    if (result.Success) storedSessionId = result.Value;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[ChatView] ProtectedSessionStorage read failed — treating as no stored value");
                }

                if (storedSessionId == currentSessionId)
                {
                    Logger.LogInformation("[ChatView] Resumption brief already sent for session {SessionId} convo {ConversationId} — skipping", currentSessionId, ConversationId);
                    _resumptionBriefSent = true;
                    return;
                }

                _currentHarnessSessionId = currentSessionId;
                // ADO#4827 — only set cold-start if there is prior conversation history to resume
                _wasColdStart = messages.Any(m => !m.IsResumptionBrief);
                Logger.LogInformation("[ChatView] HandleAgentReady: setting _wasColdStart={WasColdStart} (messageCount={Count})", _wasColdStart, messages.Count(m => !m.IsResumptionBrief));
            }
            else
            {
                // ADO#4827 — no session ID yet, but still only cold-start if there's history
                _wasColdStart = messages.Any(m => !m.IsResumptionBrief);
                Logger.LogInformation("[ChatView] HandleAgentReady: no sessionId, _wasColdStart={WasColdStart} (messageCount={Count})", _wasColdStart, messages.Count(m => !m.IsResumptionBrief));
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[ChatView] Resumption brief session guard failed — proceeding with cold start");
            // ADO#4827 — even on error, don't set cold start for empty conversations
            _wasColdStart = messages.Any(m => !m.IsResumptionBrief);
        }

        StateHasChanged();
    }

    private async Task CheckFailedTasksAsync()
    {
        if (!Session.IsAuthenticated) return;
        try
        {
            await using var ctx = await DbFactory.CreateDbContextAsync();
            _hasFailedTasks = await ctx.ScheduledTasks
                .AnyAsync(t => t.UserId == Session.UserId
                            && t.IsActive
                            && t.FailureCount > 0);
        }
        catch
        {
            _hasFailedTasks = false; // fail silently — banner is non-critical
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task HandleAgentRetry()
    {
        _checkingAgent = true;
        _agentReady = false;
        StateHasChanged();
        try
        {
            var session = await AgentRuntime.GetSessionAsync(Session.UserId.ToString());
            _agentReady = session?.Status == RuntimeSessionStatus.Running;
        }
        catch
        {
            _agentReady = true; // fail open
        }
        _checkingAgent = false;
        StateHasChanged();
    }

    /// <summary>DTO for files received via JS drag-drop interop.</summary>
    public class DroppedFileInfo
    {
        public string Name { get; set; } = "";
        public string ContentType { get; set; } = "";
        public string Base64 { get; set; } = "";
    }

    public record FilesUpdatedPayload(
        [property: System.Text.Json.Serialization.JsonPropertyName("folderId")] string FolderId,
        [property: System.Text.Json.Serialization.JsonPropertyName("folderName")] string FolderName,
        [property: System.Text.Json.Serialization.JsonPropertyName("files")] List<FileUpdateEntry> Files);

    public record FileUpdateEntry(
        [property: System.Text.Json.Serialization.JsonPropertyName("filename")] string Filename,
        [property: System.Text.Json.Serialization.JsonPropertyName("action")] string Action,
        [property: System.Text.Json.Serialization.JsonPropertyName("version")] int Version,
        [property: System.Text.Json.Serialization.JsonPropertyName("presignedUrl")] string PresignedUrl);
}

