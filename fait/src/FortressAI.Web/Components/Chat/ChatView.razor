    private async Task HandleInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await HandleSendFromInput();
        }
    }

    private async Task HandleSendFromInput()
    {
        if (string.IsNullOrWhiteSpace(_userInput) && !_pendingAttachments.Any()) return;
        if (isStreaming) return;
        var text = _userInput;
        _userInput = "";
        await HandleSend(string.IsNullOrWhiteSpace(text) ? "(see attached files)" : text);
    }

    // ADO#3241 — Handle tool_call SSE events
    private void HandleToolCallEvent(ToolCallPayload payload)
    {
        var server = payload.Server ?? "";
        var toolName = payload.ToolName ?? "";
        var status = payload.Status ?? "";
        var summary = payload.Summary ?? "";

        if (status == "calling")
        {
            _activeToolCalls.Add(new ToolCallEvent(server, toolName, "calling", summary, DateTime.UtcNow));
        }
        else if (status is "done" or "error")
        {
            var idx = _activeToolCalls.FindLastIndex(t => t.ToolName == toolName && t.Status == "calling");
            if (idx >= 0)
            {
                _activeToolCalls[idx] = new ToolCallEvent(server, toolName, status, summary, _activeToolCalls[idx].Timestamp);
            }
        }
    }

