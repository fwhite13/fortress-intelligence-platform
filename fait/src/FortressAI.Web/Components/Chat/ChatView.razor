    private const int ToolChipMinDisplayMs = 1500;

    // ADO#3241 — Handle tool_call SSE events
    // ADO#4055 — minimum 1500ms display duration before chip transitions to "done"
    private void HandleToolCallEvent(ToolCallPayload payload)
    {
        var server = payload.Server ?? "";
        var toolName = payload.ToolName ?? "";
        var status = payload.Status ?? "";
        var summary = payload.Summary ?? "";

        if (status == "calling")
        {
            var bedrockChipIcon = GetChipIconKeyFromToolName(toolName);
            Logger.LogInformation("[Chip] Path=bedrock Tool={Tool} ChipIcon={ChipIcon}", toolName, bedrockChipIcon);
            _activeToolCalls.Add(new ToolCallEvent(server, toolName, "calling", summary, DateTime.UtcNow, bedrockChipIcon, Guid.NewGuid()));
        }
        else if (status is "done" or "error")
        {
            var idx = _activeToolCalls.FindLastIndex(t => t.ToolName == toolName && t.Status == "calling");
            if (idx >= 0)
            {
                var startTime = _activeToolCalls[idx].Timestamp;
                var existingChipIcon = _activeToolCalls[idx].ChipIcon;
                var elapsed = (DateTime.UtcNow - startTime).TotalMilliseconds;
                var delay = Math.Max(0, ToolChipMinDisplayMs - elapsed);

                var capturedIdx = idx;
                var updatedEvent = new ToolCallEvent(server, toolName, status, summary, startTime, existingChipIcon, _activeToolCalls[idx].Id);

                if (delay <= 0)
                {
                    _activeToolCalls[capturedIdx] = updatedEvent;
                }
                else
                {
                    _ = Task.Delay((int)delay).ContinueWith(_ => InvokeAsync(() =>
                    {
                        if (capturedIdx < _activeToolCalls.Count)
                            _activeToolCalls[capturedIdx] = updatedEvent;
                        StateHasChanged();
                        return Task.CompletedTask;
                    }));
                }
            }
        }
    }

