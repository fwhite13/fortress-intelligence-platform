    [JSInvokable]
    public async Task HandleDroppedFiles(List<DroppedFileInfo> files)
    {
        if (conversation == null && Session.IsAuthenticated)
        {
            conversation = await ChatSvc.CreateConversationAsync(Session.UserId, null, currentModel);
            await ChatSvc.UpdateConversationKbAsync(conversation.Id, _fortressKbEnabled, _personalKbEnabled, _selectedTeamIds.ToList());
            Nav.NavigateTo($"/chat/{conversation.Id}", replace: true);
        }
        if (conversation == null) return;

        foreach (var file in files)
        {
            if (!ChatAttachmentService.IsSupportedFile(file.Name)) continue;
            // Rough size check: base64 encodes 3 bytes per 4 chars
            if ((long)(file.Base64.Length * 3L / 4) > 10 * 1024 * 1024) continue;

            try
            {
                var bytes = Convert.FromBase64String(file.Base64);
                using var stream = new MemoryStream(bytes);
                var attachment = await AttachmentSvc.UploadAttachmentAsync(
                    conversation.Id,
                    Session.UserId,
                    file.Name,
                    file.ContentType,
                    stream,
                    bytes.Length);
                _pendingAttachments.Add(attachment);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ATTACH] Failed to upload dropped file {file.Name}: {ex.Message}");
            }
        }
    }

    private async Task ProcessFiles(IReadOnlyList<IBrowserFile> files)
    {
        // IMPORTANT: Read ALL file bytes FIRST before any async operation (conversation creation,
        // navigation, S3 upload). IBrowserFile streams are backed by a Blazor SignalR pipe that
        // closes as soon as the component re-renders or navigation occurs. Any await before
        // CopyToAsync will invalidate file IDs ("There is no file with ID N").
        var stagedFiles = new List<(string Name, string ContentType, byte[] Bytes)>();
        foreach (var file in files)
        {
            if (!ChatAttachmentService.IsSupportedFile(file.Name)) continue;
            if (file.Size > 10 * 1024 * 1024) continue;
            try
            {
                using var stream = file.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
                using var buf = new System.IO.MemoryStream();
                await stream.CopyToAsync(buf);
                stagedFiles.Add((file.Name, file.ContentType, buf.ToArray()));
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ATTACH] Failed to read {file.Name}: {ex.Message}");
            }
        }

        if (stagedFiles.Count == 0) return;

        // Now safe to do async work (conversation creation, navigation, S3 upload)
        if (conversation == null && Session.IsAuthenticated)
        {
            conversation = await ChatSvc.CreateConversationAsync(Session.UserId, null, currentModel);
            await ChatSvc.UpdateConversationKbAsync(conversation.Id, _fortressKbEnabled, _personalKbEnabled, _selectedTeamIds.ToList());
            Nav.NavigateTo($"/chat/{conversation.Id}", replace: true);
        }
        if (conversation == null) return;

        foreach (var (name, contentType, fileBytes) in stagedFiles)
        {
            try
            {
                using var uploadStream = new System.IO.MemoryStream(fileBytes);
                var attachment = await AttachmentSvc.UploadAttachmentAsync(
                    conversation.Id,
                    Session.UserId,
                    name,
                    contentType,
                    uploadStream,
                    fileBytes.Length);
                _pendingAttachments.Add(attachment);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[ATTACH] Failed to upload {name}: {ex.Message}");
            }
        }
    }

