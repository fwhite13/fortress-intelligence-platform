    private async Task HandleSend(string text)
    {
        if (string.IsNullOrWhiteSpace(text) || isStreaming) return;
        _lastKbResult = null;  // Clear stale result before new send
        _activeToolCalls.Clear();  // ADO#3241 — Reset tool call indicators
        _taskModeActive = false; // Reset — will be set by mode_switch event in this turn
        _taskProgressSteps.Clear();
        _elapsedTimer?.Dispose();
        _elapsedTimer = null;

        // Capture pending attachments before clearing
        var attachmentsSnapshot = _pendingAttachments.ToList();
        _pendingAttachments.Clear();

        // Lazy conversation creation — only when user actually sends their first message
        if (conversation == null && Session.IsAuthenticated)
        {
            conversation = await ChatSvc.CreateConversationAsync(Session.UserId, null, currentModel);
            // Sync local KB toggle state to the new conversation
            await ChatSvc.UpdateConversationKbAsync(conversation.Id, _fortressKbEnabled, _personalKbEnabled, _selectedTeamIds.ToList());
            Logger.LogInformation("[ChatView] Nav.NavigateTo — /chat/{ConversationId} (lazy creation, replace=true)", conversation.Id);
            Nav.NavigateTo($"/chat/{conversation.Id}", replace: true);
        }

        if (conversation == null) return;

        // Add user message
        var userMsg = await ChatSvc.AddMessageAsync(conversation.Id, "user", text.Trim());
        messages.Add(userMsg);

        // Link attachments to this message
        foreach (var att in attachmentsSnapshot)
        {
            await AttachmentSvc.LinkAttachmentToMessageAsync(att.Id, userMsg.Id);
        }

        // Start streaming
        isStreaming = true;
        streamingMessage = new ChatMessage { Role = "assistant", Content = "", Model = currentModel };
        StateHasChanged();
        await ScrollToBottom();

        try
        {
            streamingCts = new CancellationTokenSource();

            // Load project once for system prompt + KB
            FortressAI.Shared.Models.Project? project = null;
            if (conversation?.ProjectId != null)
            {
                project = await ProjectSvc.GetProjectAsync(conversation.ProjectId.Value, Session.UserId);

                // Background migration for pre-RAG docs (Content but no S3Key)
                if (project != null)
                {
                    var docsNeedingMigration = project.Documents
                        .Where(d => !string.IsNullOrEmpty(d.Content) && string.IsNullOrEmpty(d.S3Key))
                        .ToList();
                    if (docsNeedingMigration.Any())
                    {
                        _hasPendingMigration = true;
                        var userId = Session.UserId;
                        var docsSnapshot = docsNeedingMigration.Select(d => d.Id).ToList();
                        _ = Task.Run(async () =>
                        {
                            using var scope = ScopeFactory.CreateScope();
                            var docSvc = scope.ServiceProvider.GetRequiredService<DocumentService>();
                            var kbDocSvc = scope.ServiceProvider.GetRequiredService<KbDocumentService>();
                            foreach (var docId in docsSnapshot)
                            {
                                try { await docSvc.MigrateDocumentToS3ByIdAsync(docId, userId); }
                                catch (Exception ex) { Console.WriteLine($"[MIGRATE] Doc {docId} failed: {ex.Message}"); }
                            }
                            try { await kbDocSvc.StartIngestionAsync(); }
                            catch { }
                        });
                    }
                    else
                    {
                        _hasPendingMigration = false;
                    }
                }
            }

            // Build system prompt from project context
            string? systemPrompt = BuildSystemPromptFromProject(project, _hasPendingMigration);

            // Inject personality prefix from assistant config
            if (_assistantConfig != null)
            {
                var personalityPrefix = await ConfigSvc.BuildSystemPromptAsync(_assistantConfig, Session.UserId, Session.CurrentUser?.DisplayName, Session.CurrentUser?.Email);
                systemPrompt = string.IsNullOrEmpty(systemPrompt)
                    ? personalityPrefix
                    : personalityPrefix + "\n\n" + systemPrompt;
            }

            // Inject artifact system prompt
            var artifactPrompt = GetArtifactSystemPrompt();
            systemPrompt = string.IsNullOrEmpty(systemPrompt)
                ? artifactPrompt
                : systemPrompt + "\n\n" + artifactPrompt;

            // ADO#3241 — KB retrieval now handled by harness
            // Blazor passes KB flags; harness does retrieval and emits kb_sources SSE event
            bool hasCorpKb = _fortressKbEnabled;
            bool hasPersonalKb = _personalKbEnabled;
            bool hasTeamKb = _selectedTeamIds?.Any() == true;
            bool hasProjectKb = conversation?.ProjectId.HasValue == true;
            bool anyKbActive = hasCorpKb || hasPersonalKb || hasTeamKb || hasProjectKb;
            Console.WriteLine($"[KB] Flags — Corp:{hasCorpKb} Personal:{hasPersonalKb} Team:{hasTeamKb} Project:{hasProjectKb} UserId:{Session.UserId}");

            var effectiveSystemPrompt = systemPrompt;  // no longer pre-populated with KB context

            // Inject attachment content into context
            if (attachmentsSnapshot.Any())
            {
                var attachmentContextBuilder = new System.Text.StringBuilder();
                attachmentContextBuilder.AppendLine("## Attached Files");
                attachmentContextBuilder.AppendLine("The user has attached the following files to this message:");
                attachmentContextBuilder.AppendLine();
                foreach (var att in attachmentsSnapshot)
                {
                    try
                    {
                        var content = await AttachmentSvc.ExtractAttachmentContentAsync(att);
                        if (content != null)
                        {
                            attachmentContextBuilder.AppendLine($"### {att.Filename} ({ChatAttachmentService.FormatFileSize(att.SizeBytes)})");
                            attachmentContextBuilder.AppendLine(content);
                            attachmentContextBuilder.AppendLine();
                        }
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"[ATTACH] Failed to extract content from {att.Filename}: {ex.Message}");
                    }
                }
                var attachmentContext = attachmentContextBuilder.ToString();
                effectiveSystemPrompt = string.IsNullOrEmpty(effectiveSystemPrompt)
                    ? attachmentContext
                    : attachmentContext + "\n\n" + effectiveSystemPrompt;
            }

            // Apply sliding window context management
            var (chatHistory, summarized) = await ChatSvc.PrepareMessagesWithSlidingWindowAsync(messages, effectiveSystemPrompt);
            wasSummarized = summarized;

            // Check if any MCP tools are available
            List<AvailableTool> availableTools = new();
            try
            {
                availableTools = await McpToolSvc.GetConversationToolsAsync(conversation.Id, Session.UserId);
                Logger.LogInformation("[MCP] Loaded {Count} tools for user {UserId}: {Tools}",
                    availableTools.Count,
                    Session.UserId,
                    string.Join(", ", availableTools.Select(t => t.FullName)));
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[MCP] Failed to load tools for conversation {ConvId}", conversation.Id);
            }

            // Extract distinct MCP server slugs from available tools
            var enabledMcpSlugs = availableTools
                .Select(t => {
                    var sep = t.FullName.IndexOf("__", StringComparison.Ordinal);
                    return sep > 0 ? t.FullName[..sep] : null;
                })
                .Where(s => s != null)
                .Distinct()
                .Select(s => s!)
                .ToList();

            var fullResponse = new System.Text.StringBuilder();
            int inputTokens = 0, outputTokens = 0;

            // Route through Fargate harness (SSE streaming via IUserAgentRuntime)
            var turnRequest = new TurnRequest(
                UserId: Session.UserId.ToString(),
                Message: text.Trim(),
                History: chatHistory.Select(m => new ChatHistoryEntry(m.Role, m.Content)).ToList(),
                TaskMode: _taskMode,
                SystemPrompt: string.IsNullOrEmpty(effectiveSystemPrompt) ? null : effectiveSystemPrompt,
                ConversationId: conversation.Id.ToString(),
                EnabledMcpSlugs: enabledMcpSlugs.Count > 0 ? enabledMcpSlugs : null,
                KbFlags: anyKbActive ? new KbFlags(
                    CorpKbEnabled: hasCorpKb,
                    PersonalKbEnabled: hasPersonalKb,
                    TeamKbEnabled: hasTeamKb,
                    PersonalKbUserId: hasPersonalKb && Session.UserId != Guid.Empty
                        ? Session.UserId.ToString()
                        : null,
                    TeamIds: hasTeamKb && _selectedTeamIds?.Any() == true
                        ? _selectedTeamIds.Intersect(_userTeams.Select(t => t.Id)).ToList()
                        : null
                ) : null
            );

            await foreach (var evt in AgentRuntime.SendTurnAsync(Session.UserId.ToString(), turnRequest, streamingCts!.Token))
            {
                if (streamingCts.IsCancellationRequested) break;

                if (evt.Type == "text")
                {
                    fullResponse.Append(evt.Content ?? "");
                    streamingMessage.Content = fullResponse.ToString();
                    StateHasChanged();
                    await ScrollToBottom();
                }
                else if (evt.Type == "done")
                {
                    inputTokens = evt.InputTokens ?? 0;
                    outputTokens = evt.OutputTokens ?? 0;
                }
                else if (evt.Type == "error")
                {
                    fullResponse.Append($"\n\n⚠️ {evt.ErrorMessage ?? "An error occurred."}");
                    streamingMessage.Content = fullResponse.ToString();
                    StateHasChanged();
                }
                else if (evt.Type == "mode_switch")
                {
                    _taskModeActive = true;
                    StateHasChanged();
                }
                else if (evt.Type == "artifact")
                {
                    try
                    {
                        var artifactPayload = System.Text.Json.JsonSerializer.Deserialize<ArtifactPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions
                            { PropertyNameCaseInsensitive = true });
                        if (artifactPayload != null)
                        {
                            _pendingArtifact = await WorkspaceFileSvc.SaveArtifactAsync(
                                Session.UserId, conversation.Id, null, artifactPayload);
                            _conversationArtifacts.Add(_pendingArtifact);
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to save artifact from SSE event");
                    }
                }
                else if (evt.Type == "kb_sources")
                {
                    try
                    {
                        var kbSourcesPayload = System.Text.Json.JsonSerializer.Deserialize<KbSourcesPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (kbSourcesPayload?.Sources != null)
                        {
                            var result = new KbRetrievalResult { WasSearched = true };
                            foreach (var src in kbSourcesPayload.Sources)
                            {
                                if (src.SourceCount > 0)
                                {
                                    result.SourceStats.Add(new KbSourceStat
                                    {
                                        KbName = src.KbName ?? "KB",
                                        ResultCount = src.SourceCount,
                                        SourceDocuments = src.Chunks?.Select(c => c.Title ?? "").Where(t => !string.IsNullOrEmpty(t)).Distinct().ToList() ?? new()
                                    });
                                    for (int i = 0; i < src.SourceCount; i++)
                                        result.InjectedChunks.Add(new KbChunk { Source = src.KbId ?? "harness" });
                                }
                            }
                            _lastKbResult = result;
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse kb_sources payload");
                    }
                }
                else if (evt.Type == "tool_call")
                {
                    try
                    {
                        var toolCallPayload = System.Text.Json.JsonSerializer.Deserialize<ToolCallPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (toolCallPayload != null)
                        {
                            HandleToolCallEvent(toolCallPayload);
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse tool_call payload");
                    }
                }
                else if (evt.Type == "task_progress")
                {
                    try
                    {
                        var progressPayload = System.Text.Json.JsonSerializer.Deserialize<TaskProgressPayload>(
                            evt.Payload ?? "{}", new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                        if (progressPayload != null)
                        {
                            if (progressPayload.Step == "start")
                            {
                                _taskStartTime = DateTime.UtcNow;
                                _taskProgressSteps.Clear();
                                _elapsedTimer?.Dispose();
                                _elapsedTimer = new System.Threading.Timer(_ =>
                                {
                                    if (_taskStartTime.HasValue)
                                    {
                                        var elapsed = DateTime.UtcNow - _taskStartTime.Value;
                                        _taskElapsed = elapsed.ToString(@"mm\:ss");
                                        InvokeAsync(StateHasChanged);
                                    }
                                }, null, 0, 1000);
                            }
                            var stepMessage = progressPayload.Message
                                ?? (progressPayload.Step == "tool_use" ? $"Calling {progressPayload.ToolName}..." : progressPayload.Step ?? "Working...");
                            _taskProgressSteps.Add(new TaskProgressStep(
                                progressPayload.Status ?? "running",
                                progressPayload.ToolName,
                                stepMessage,
                                DateTime.UtcNow));
                            StateHasChanged();
                        }
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "[ChatView] Failed to parse task_progress payload");
                    }
                }
                // "log" events: swallow silently
            }

            // Save assistant message
            var assistantMsg = await ChatSvc.AddMessageAsync(
                conversation.Id, "assistant", fullResponse.ToString(),
                currentModel, inputTokens, outputTokens);
            messages.Add(assistantMsg);

            // Generate contextual title after first exchange (fire and forget)
            if (messages.Count == 2)  // first user + first assistant
            {
                var convId = conversation.Id;
                var userText = text;
                var assistantText = fullResponse.ToString();
                _ = Task.Run(async () =>
                {
                    await ChatSvc.GenerateConversationTitleAsync(convId, userText, assistantText);
                    await InvokeAsync(StateHasChanged);
                });
            }
        }
        catch (Exception ex)
        {
            streamingMessage.Content += $"\n\n⚠️ Error: {ex.Message}";
        }
        finally
        {
            isStreaming = false;
            _taskMode = false; // reset toggle after send completes
            _elapsedTimer?.Dispose();
            _elapsedTimer = null;
            _taskModeActive = false;
            streamingMessage = new ChatMessage { Role = "assistant", Content = "" };
            StateHasChanged();
        }
    }

    private string? BuildSystemPromptFromProject(FortressAI.Shared.Models.Project? project, bool hasPendingMigration = false)
    {
        if (project == null) return null;

        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"## Project: {project.Name}");
        sb.AppendLine();

        if (!string.IsNullOrEmpty(project.CustomInstructions))
        {
            sb.AppendLine(project.CustomInstructions);
            sb.AppendLine();
        }

        sb.AppendLine("(Project documents are retrieved via knowledge base search and will be included below.)");

        if (hasPendingMigration)
        {
            sb.AppendLine();
            sb.AppendLine("Note: Some project documents are being indexed and may not be available in this conversation yet.");
        }

        return sb.ToString().Trim();
    }

