    // Resolve chipIcon key from a Bedrock tool name (mirrors resolveProgressIcon in harness-server.js)
    private static string GetChipIconKeyFromToolName(string toolName)
    {
        var t = (toolName ?? "").ToLowerInvariant();
        if (t.Contains("agent") || t.Contains("spawn")) return "agent";
        if (t == "web_search" || (t.Contains("search") && !t.Contains("kb") && !t.Contains("knowledge") && !t.Contains("memory"))) return "search";
        if (t == "web_fetch" || t.Contains("fetch") || t.Contains("url") || t.Contains("browse")) return "search";
        if (t == "read_memory" || t == "write_memory" || t == "search_memory" || t == "update_user_profile" || t.Contains("memory")) return "memory";
        if (t == "write_file" || t == "create_document" || t.Contains("str_replace") || t.Contains("edit_tool") || t == "edit" || (t.Contains("write") && !t.Contains("memory"))) return "document";
        if (t == "read_file" || t == "list_workspace_files" || t == "list_files" || (t.Contains("read") && !t.Contains("memory")) || t.Contains("list")) return "file";
        if (t == "bash" || t == "computer" || t.Contains("exec") || t.Contains("shell") || t.Contains("python")) return "code";
        if (t.Contains("calendar") || t.Contains("event")) return "calendar";
        if (t.Contains("email") || t.Contains("mail")) return "email";
        if (t.Contains("ado") || t.Contains("devops") || t.Contains("work_item")) return "devops";
        if (t.Contains("kb") || t.Contains("knowledge")) return "kb";
        if (t.Contains("sync")) return "sync";
        return "tool";
    }

    // ADO#4249 — Truncate chip label for display safety
    private static string TruncChip(string? s, int max = 60) =>
        s == null ? "" : s.Length > max ? s[..57] + "..." : s;

    // ADO#4056 — human-readable labels for tool chips (raw CC tool names → readable text)
    private static string GetToolLabel(string toolName, string server, string? summary = null)
    {
        // ADO#4249 — prefer harness summary (now always contextual) when present
        if (!string.IsNullOrWhiteSpace(summary))
            return summary;

        return toolName switch
        {
            "read_memory" => "Reading memory...",
            "write_memory" => "Saving to memory...",
            "search_memory" => "Searching memory...",
            "read_file" or "read_workspace_file" => "Reading file...",
            "write_file" => "Saving file...",
            "list_files" or "list_workspace_files" => "Listing files...",
            "search_kb" or "retrieve_kb" => "Searching knowledge base...",
            "graph_list_emails" => "Reading inbox...",
            "graph_get_email" => "Reading email...",
            "graph_send_email" => "Sending email...",
            "graph_list_calendar_events" => "Checking calendar...",
            "create_document" => "Creating document...",
            "str_replace_based_edit_tool" or "str_replace_editor" => "Editing file...",
            "bash" or "computer" => "Running command...",
            var t when t.Contains("search") => "Searching...",
            var t when t.Contains("read") || t.Contains("get") => "Reading...",
            var t when t.Contains("write") || t.Contains("save") || t.Contains("create") => "Saving...",
            var t when t.Contains("list") => "Listing...",
            var t when t.Contains("exec") || t.Contains("run") || t.Contains("bash") || t.Contains("shell") => "Running command...",
            var t when t.Contains("web") || t.Contains("fetch") || t.Contains("url") => "Fetching...",
            var t when t.Contains("str_replace") || t.Contains("edit_tool") || t == "edit" => "Editing file...",
            var t when t.Contains("python") || t.Contains("pip") => "Running script...",
            "update_user_profile" => "Updating your profile...",
            _ => "Working...",
        };
    }

