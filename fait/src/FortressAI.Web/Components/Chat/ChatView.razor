    [JSInvokable]
    public void OnSpeechResult(string finalText, string interimText)
    {
        if (!string.IsNullOrEmpty(finalText))
            _userInput = finalText;  // Replace, don't append — JS accumulates the full final transcript
        _interimTranscript = interimText;
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSpeechEnded()
    {
        _isDictating = false;
        _interimTranscript = "";
        InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public void OnSpeechError(string error)
    {
        _isDictating = false;
        _interimTranscript = "";
        _micError = error == "not-allowed"
            ? "Microphone access denied. Check your browser permissions."
            : $"Microphone error: {error}";
        InvokeAsync(StateHasChanged);
    }

