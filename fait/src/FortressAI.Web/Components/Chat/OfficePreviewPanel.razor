@inject ArtifactPreviewService PreviewSvc
@inject UserSessionService Session
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject IWorkspaceFileService WorkspaceFileSvc
@inject ISnackbar Snackbar
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@implements IDisposable

<div class="office-preview-panel">
    @if (_loading)
    {
        <div class="office-preview-panel__loading">
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">@_loadingMessage</MudText>
        </div>
    }
    else if (_error != null)
    {
        <div class="office-preview-panel__error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Disabled="@_downloadLoading"
                       OnClick="DownloadAsync"
                       Class="mt-2">
                @if (_downloadLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Download file
            </MudButton>
        </div>
    }
    else if (_proxyUrl != null)
    {
        <iframe src="@_proxyUrl"
                style="width: 100%; height: 100%; border: none;"
                title="Document preview" />
    }
    else
    {
        <div id="@_containerId" class="office-preview-panel__content"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public WorkspaceUpload Artifact { get; set; } = default!;
    [Parameter] public EventCallback<string> OnPreviewError { get; set; }

    private bool _loading = true;
    private string _loadingMessage = "Loading document...";
    private string? _error;
    private string? _proxyUrl;
    private byte[]? _pendingBytes;
    private string _containerId = $"office-{Guid.NewGuid():N}";
    private bool _loadStarted = false;
    private bool _jsRenderPending = false;
    private bool _jsRenderInFlight = false;
    private bool _downloadLoading = false;

    private bool IsConverterType()
    {
        var ext = System.IO.Path.GetExtension(Artifact.Filename);
        return ext.Equals(".pptx", StringComparison.OrdinalIgnoreCase)
            || ext.Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
            || Artifact.MimeType == "application/vnd.openxmlformats-officedocument.presentationml.presentation"
            || Artifact.MimeType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    }

    protected override void OnInitialized()
    {
        Console.WriteLine($"[office-preview] OnInitialized: ArtifactId={Artifact.Id} Filename={Artifact.Filename}");
        Session.OnAuthStateChanged += HandleAuthStateChanged;
        _loadingMessage = IsConverterType() ? "Generating preview… this may take a moment." : "Loading document...";
    }

    private void HandleAuthStateChanged()
    {
        Console.WriteLine($"[office-preview] HandleAuthStateChanged: _loading={_loading} UserId={Session.UserId}");
        if (_loading && Session.UserId != Guid.Empty)
        {
            InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadAsync();
            return;
        }

        if (!_jsRenderPending || _jsRenderInFlight || _pendingBytes == null)
            return;

        _jsRenderPending = false;
        _jsRenderInFlight = true;
        try
        {
            var base64 = Convert.ToBase64String(_pendingBytes);
            await JSRuntime.InvokeVoidAsync("officePreviewInterop.render", base64, "docx", _containerId, null);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[office-preview] JS render failed: {ex.Message}");
            _error = "Document preview failed.";
            await OnPreviewError.InvokeAsync(_error);
            StateHasChanged();
        }
        finally
        {
            _jsRenderInFlight = false;
        }
    }

    private async Task LoadAsync()
    {
        if (_loadStarted) return;
        _loadStarted = true;

        var userId = Session.UserId;
        if (userId == Guid.Empty)
        {
            Console.WriteLine($"[office-preview] LoadAsync: UserId empty for artifact {Artifact.Id}, waiting for auth");
            _loadStarted = false;
            return;
        }

        Console.WriteLine($"[office-preview] LoadAsync start: ArtifactId={Artifact.Id} Filename={Artifact.Filename}");
        try
        {
            if (IsConverterType())
                await LoadConverterPreviewAsync(userId);
            else
                await FetchDocxBytesAsync(userId);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[office-preview] LoadAsync failed: {ex.GetType().Name}: {ex.Message}");
            _error = "Failed to load preview. Try downloading the file.";
            _loading = false;
            await OnPreviewError.InvokeAsync(_error);
            StateHasChanged();
        }
    }

    private async Task LoadConverterPreviewAsync(Guid userId)
    {
        string? previewS3Key = Artifact.PreviewS3Key;
        if (!string.IsNullOrEmpty(previewS3Key))
        {
            Console.WriteLine($"[office-preview] Cache hit for artifact {Artifact.Id} — skipping conversion");
        }
        else
        {
            Console.WriteLine($"[office-preview] Triggering conversion for artifact {Artifact.Id}");
            var ext = System.IO.Path.GetExtension(Artifact.Filename).ToLowerInvariant();
            if (ext == ".xlsx")
            {
                var (xlsxKey, _) = await PreviewSvc.ConvertXlsxAsync(Artifact.Id, Artifact.S3Key, userId, HttpClientFactory);
                previewS3Key = xlsxKey;
            }
            else
            {
                previewS3Key = await PreviewSvc.ConvertPptxAsync(Artifact.Id, Artifact.S3Key, userId, HttpClientFactory);
            }
            if (string.IsNullOrEmpty(previewS3Key))
            {
                Console.Error.WriteLine($"[office-preview] Conversion returned no output for artifact {Artifact.Id}");
                _error = "Preview conversion failed. Try downloading the file.";
                _loading = false;
                await OnPreviewError.InvokeAsync(_error);
                StateHasChanged();
                return;
            }
            Console.WriteLine($"[office-preview] Conversion success for artifact {Artifact.Id}: key={previewS3Key}");
        }

        var (token, expires) = PreviewSvc.GenerateToken(Artifact.Id, userId);
        _proxyUrl = $"/api/artifacts/{Artifact.Id}/preview?token={Uri.EscapeDataString(token)}&expires={expires}&preview=true";
        Console.WriteLine($"[office-preview] Proxy URL ready for artifact {Artifact.Id}");
        _loading = false;
        StateHasChanged();
    }

    private async Task FetchDocxBytesAsync(Guid userId)
    {
        Console.WriteLine($"[office-preview] FetchDocxBytesAsync: ArtifactId={Artifact.Id}");
        var (token, expires) = PreviewSvc.GenerateToken(Artifact.Id, userId);
        var relativeUrl = $"/api/artifacts/{Artifact.Id}/preview?token={Uri.EscapeDataString(token)}&expires={expires}";
        using var http = HttpClientFactory.CreateClient("InternalPreview");
        using var response = await http.GetAsync(relativeUrl);
        Console.WriteLine($"[office-preview] HTTP {(int)response.StatusCode} for {relativeUrl}");
        if (!response.IsSuccessStatusCode)
        {
            _error = $"Preview failed ({(int)response.StatusCode}). Try downloading.";
            _loading = false;
            await OnPreviewError.InvokeAsync(_error);
            StateHasChanged();
            return;
        }
        _pendingBytes = await response.Content.ReadAsByteArrayAsync();
        Console.WriteLine($"[office-preview] FetchDocxBytesAsync success: {_pendingBytes.Length} bytes");
        _loading = false;
        _jsRenderPending = true;
        StateHasChanged();
    }

    private async Task DownloadAsync()
    {
        _downloadLoading = true;
        StateHasChanged();
        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(Artifact.S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[office-preview] Download failed: {ex.Message}");
            Snackbar.Add("Download failed.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Console.WriteLine("[office-preview] Dispose");
        Session.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}

<style>
.office-preview-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.office-preview-panel__loading,
.office-preview-panel__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.office-preview-panel__content {
    padding: 16px;
    background: white;
    min-height: 100%;
    overflow: auto;
}
</style>
