@* ADO#4003 — FolderPicker as MudDialog modal *@
@using FortressAI.Web.Services
@inject IUserAgentRuntime AgentRuntime
@inject UserSessionService Session
@inject ILogger<FolderPicker> Logger

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.caption" Class="folder-picker__label mb-2">Select a working folder for this task:</MudText>

        <MudSelect T="string" Value="@_selectedFolderId" ValueChanged="OnSelectChanged"
                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined"
                   Class="folder-picker__select" AdornmentIcon="@Icons.Material.Filled.Folder"
                   Adornment="Adornment.Start">
            @foreach (var folder in Folders)
            {
                <MudSelectItem T="string" Value="@folder.Id">@folder.Name</MudSelectItem>
            }
            <MudSelectItem T="string" Value="@("__new__")">+ New folder</MudSelectItem>
        </MudSelect>

        @if (_showNewFolderInput)
        {
            <div class="folder-picker__new-row d-flex align-center gap-2 mt-2">
                <MudTextField @bind-Value="_newFolderName"
                              Placeholder="folder-name"
                              MaxLength="64"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Immediate="true"
                              Class="folder-picker__new-input flex-grow-1"
                              OnKeyDown="OnNewFolderKeyDown" />
                <MudIconButton Icon="@Icons.Material.Filled.Check"
                               Size="Size.Small"
                               Color="Color.Primary"
                               OnClick="@(() => _ = OnStartTask())"
                               Title="Confirm folder name" />
            </div>
            @if (!string.IsNullOrEmpty(_validationError))
            {
                <MudText Color="Color.Error" Typo="Typo.caption" Class="mt-1">@_validationError</MudText>
            }
        }

        @{
            var otherFolders = Folders.Where(f => f.Id != _effectiveSelectedFolderId).ToList();
        }
        @if (otherFolders.Any())
        {
            <div class="folder-picker__readonly-section mt-3">
                <MudText Typo="Typo.caption" Class="folder-picker__readonly-label mb-1">Also include (read-only):</MudText>
                @foreach (var folder in otherFolders)
                {
                    var folderId = folder.Id;
                    var isChecked = _readOnlyFolderIds.Contains(folderId);
                    var isReferenced = _referencedFolderIds.Contains(folderId);
                    <div class="folder-picker__readonly-item d-flex align-center gap-1">
                        <MudCheckBox T="bool" Value="@isChecked"
                                     ValueChanged="@(v => OnReadOnlyToggle(folderId, v))"
                                     Dense="true" Size="Size.Small"
                                     Color="Color.Primary" />
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="folder-picker__folder-icon" />
                        <MudText Typo="Typo.body2" Class="folder-picker__readonly-name">@folder.Name</MudText>
                        @if (isReferenced)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                     Color="Color.Info" Class="folder-picker__referenced-chip">Referenced in your message</MudChip>
                        }
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="OnStartTask"
                   Disabled="@(_submitting || _confirming)"
                   Class="folder-picker__start-btn">
            @if (_submitting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                <span>Starting...</span>
            }
            else
            {
                <span>Start task</span>
            }
        </MudButton>
    </DialogActions>
</MudDialog>

<style>
    .folder-picker__label {
        color: var(--mud-palette-text-secondary);
    }

    .folder-picker__folder-icon {
        color: var(--mud-palette-text-secondary);
    }

    .folder-picker__referenced-chip {
        font-size: 0.7rem;
        height: 20px;
    }

    .folder-picker__action-row {
        flex-wrap: wrap;
    }

    .folder-picker__readonly-item {
        flex-wrap: wrap;
    }
</style>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<FolderInfo> Folders { get; set; } = new();
    [Parameter] public string? LastFolderId { get; set; }
    [Parameter] public string ConversationId { get; set; } = "";
    [Parameter] public string TaskMessage { get; set; } = "";

    private string _selectedFolderId = "";
    private bool _initialized = false;
    private bool _showNewFolderInput = false;
    private string _newFolderName = "";
    private string _validationError = "";
    private bool _submitting = false;
    private bool _confirming = false;  // ADO#3566: idempotency guard — set true on first click, prevents re-render double-fire
    private HashSet<string> _readOnlyFolderIds = new();
    private HashSet<string> _referencedFolderIds = new();

    private string _effectiveSelectedFolderId =>
        _selectedFolderId == "__new__" ? "" : _selectedFolderId;

    protected override void OnInitialized()
    {
        if (Folders.Count > 0)
        {
            var hasLastFolder = LastFolderId != null && Folders.Any(f => f.Id == LastFolderId);
            _selectedFolderId = hasLastFolder ? LastFolderId! : Folders.First().Id;
        }
        else
        {
            _selectedFolderId = "__new__";
            _showNewFolderInput = true;
        }
        ApplyHeuristics();
        _initialized = true;
    }

    protected override void OnParametersSet()
    {
        if (!_initialized) return;
        ApplyHeuristics();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StateHasChanged();  // ADO#4000: force re-render after MudSelectItem children have registered, so MudSelect resolves label from GUID
        }
        await Task.CompletedTask;
    }

    private void ApplyHeuristics()
    {
        if (string.IsNullOrWhiteSpace(TaskMessage)) return;
        var msgLower = TaskMessage.ToLowerInvariant();
        _referencedFolderIds = new HashSet<string>(
            Folders
                .Where(f => !string.IsNullOrEmpty(f.Name) && msgLower.Contains(f.Name.ToLowerInvariant()))
                .Select(f => f.Id)
        );
        // Pre-check referenced folders that are NOT the working folder
        var effectiveWorking = _effectiveSelectedFolderId;
        foreach (var id in _referencedFolderIds)
        {
            if (id != effectiveWorking)
                _readOnlyFolderIds.Add(id);
        }
    }

    private void OnSelectChanged(string value)
    {
        _selectedFolderId = value;
        OnSelectionChanged();
    }

    private void OnSelectionChanged()
    {
        _showNewFolderInput = _selectedFolderId == "__new__";
        _validationError = "";
        // Remove newly-selected working folder from read-only set
        _readOnlyFolderIds.Remove(_selectedFolderId);
        ApplyHeuristics();
    }

    private void OnReadOnlyToggle(string folderId, bool isChecked)
    {
        if (isChecked)
            _readOnlyFolderIds.Add(folderId);
        else
            _readOnlyFolderIds.Remove(folderId);
    }

    private void OnNewFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = OnStartTask();
    }

    private static readonly System.Text.RegularExpressions.Regex FolderNameRegex =
        new(@"^[a-zA-Z0-9_-]{1,64}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private async Task OnStartTask()
    {
        if (_confirming) return;  // idempotency guard — prevent double-fire on re-render (ADO#3566)
        _confirming = true;

        if (_selectedFolderId == "__new__")
        {
            if (!FolderNameRegex.IsMatch(_newFolderName))
            {
                _validationError = "Folder name: alphanumeric, hyphens, underscores only (max 64 chars).";
                _confirming = false;  // allow retry after validation error
                return;
            }
        }

        _submitting = true;
        _validationError = "";
        StateHasChanged();

        try
        {
            object payload;
            string? resolvedFolderName;

            var readOnlyIds = _readOnlyFolderIds
                .Where(id => id != _selectedFolderId)
                .ToArray();

            if (_selectedFolderId == "__new__")
            {
                payload = new { conversationId = ConversationId, newFolderName = _newFolderName, readOnlyFolderIds = readOnlyIds };
                resolvedFolderName = _newFolderName;
            }
            else
            {
                payload = new { conversationId = ConversationId, folderId = _selectedFolderId, readOnlyFolderIds = readOnlyIds };
                resolvedFolderName = Folders.FirstOrDefault(f => f.Id == _selectedFolderId)?.Name;
            }

            var response = await AgentRuntime.PostToHarnessAsync(
                Session.UserId.ToString(),
                "/turn/folder-confirm",
                payload);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _validationError = $"Could not confirm folder ({response.StatusCode}).";
                Logger.LogWarning("[FolderPicker] /turn/folder-confirm returned {Status}: {Body}", response.StatusCode, body);
                _submitting = false;
                _confirming = false;  // allow retry (ADO#3566)
                StateHasChanged();
                return;
            }

            MudDialog.Close(DialogResult.Ok(new FolderConfirmedArgs(
                _selectedFolderId == "__new__" ? null : _selectedFolderId,
                resolvedFolderName,
                readOnlyIds)));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FolderPicker] PostToHarnessAsync failed");
            _validationError = "Error contacting harness. Please retry.";
            _submitting = false;
            _confirming = false;  // allow retry (ADO#3566)
            StateHasChanged();
        }
    }

    public record FolderConfirmedArgs(string? FolderId, string? FolderName, string[] ReadOnlyFolderIds);
}
