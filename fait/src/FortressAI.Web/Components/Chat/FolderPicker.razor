@* ADO#3560 — Inline folder picker for CC task turns *@
@using FortressAI.Web.Services
@inject IUserAgentRuntime AgentRuntime
@inject UserSessionService Session
@inject ILogger<FolderPicker> Logger

<div class="folder-picker">
    <div class="folder-picker__label">Select a working folder for this task:</div>

    <select @bind="_selectedFolderId" @bind:after="OnSelectionChanged" class="folder-picker__select">
        @foreach (var folder in Folders)
        {
            <option value="@folder.Id">@folder.Name</option>
        }
        <option value="__new__">+ New folder</option>
    </select>

    @if (_showNewFolderInput)
    {
        <input type="text"
               @bind="_newFolderName"
               placeholder="folder-name"
               maxlength="64"
               class="folder-picker__new-input"
               @onkeydown="OnNewFolderKeyDown" />
        @if (!string.IsNullOrEmpty(_validationError))
        {
            <div class="folder-picker__error">@_validationError</div>
        }
    }

    @{
        var otherFolders = Folders.Where(f => f.Id != _effectiveSelectedFolderId).ToList();
    }
    @if (otherFolders.Any())
    {
        <div class="folder-picker__readonly-section">
            <div class="folder-picker__readonly-label">Also include (read-only):</div>
            @foreach (var folder in otherFolders)
            {
                var folderId = folder.Id;
                var isChecked = _readOnlyFolderIds.Contains(folderId);
                var isReferenced = _referencedFolderIds.Contains(folderId);
                <label class="folder-picker__readonly-item">
                    <input type="checkbox"
                           checked="@isChecked"
                           @onchange="@(e => OnReadOnlyToggle(folderId, (bool)(e.Value ?? false)))"
                           class="folder-picker__readonly-checkbox" />
                    <span class="folder-picker__readonly-name">@folder.Name</span>
                    @if (isReferenced)
                    {
                        <span class="folder-picker__readonly-hint">Referenced in your message</span>
                    }
                </label>
            }
        </div>
    }

    <button class="folder-picker__btn" @onclick="OnStartTask" disabled="@(_submitting || _confirming)">
        @(_submitting ? "Starting..." : "Start task")
    </button>
</div>

@code {
    [Parameter] public List<FolderInfo> Folders { get; set; } = new();
    [Parameter] public string? LastFolderId { get; set; }
    [Parameter] public string ConversationId { get; set; } = "";
    [Parameter] public EventCallback<FolderConfirmedArgs> OnFolderConfirmed { get; set; }
    [Parameter] public string TaskMessage { get; set; } = "";

    private string _selectedFolderId = "";
    private bool _showNewFolderInput = false;
    private string _newFolderName = "";
    private string _validationError = "";
    private bool _submitting = false;
    private bool _confirming = false;  // ADO#3566: idempotency guard — set true on first click, prevents re-render double-fire
    private HashSet<string> _readOnlyFolderIds = new();
    private HashSet<string> _referencedFolderIds = new();

    private string _effectiveSelectedFolderId =>
        _selectedFolderId == "__new__" ? "" : _selectedFolderId;

    protected override void OnInitialized()
    {
        if (Folders.Count > 0)
        {
            _selectedFolderId = LastFolderId ?? Folders.FirstOrDefault()!.Id;
        }
        else
        {
            _selectedFolderId = "__new__";
            _showNewFolderInput = true;
        }
        ApplyHeuristics();
    }

    protected override void OnParametersSet()
    {
        ApplyHeuristics();
    }

    private void ApplyHeuristics()
    {
        if (string.IsNullOrWhiteSpace(TaskMessage)) return;
        var msgLower = TaskMessage.ToLowerInvariant();
        _referencedFolderIds = new HashSet<string>(
            Folders
                .Where(f => !string.IsNullOrEmpty(f.Name) && msgLower.Contains(f.Name.ToLowerInvariant()))
                .Select(f => f.Id)
        );
        // Pre-check referenced folders that are NOT the working folder
        var effectiveWorking = _effectiveSelectedFolderId;
        foreach (var id in _referencedFolderIds)
        {
            if (id != effectiveWorking)
                _readOnlyFolderIds.Add(id);
        }
    }

    private void OnSelectionChanged()
    {
        _showNewFolderInput = _selectedFolderId == "__new__";
        _validationError = "";
        // Remove newly-selected working folder from read-only set
        _readOnlyFolderIds.Remove(_selectedFolderId);
        ApplyHeuristics();
    }

    private void OnReadOnlyToggle(string folderId, bool isChecked)
    {
        if (isChecked)
            _readOnlyFolderIds.Add(folderId);
        else
            _readOnlyFolderIds.Remove(folderId);
    }

    private void OnNewFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = OnStartTask();
    }

    private static readonly System.Text.RegularExpressions.Regex FolderNameRegex =
        new(@"^[a-zA-Z0-9_-]{1,64}$", System.Text.RegularExpressions.RegexOptions.Compiled);

    private async Task OnStartTask()
    {
        if (_confirming) return;  // idempotency guard — prevent double-fire on re-render (ADO#3566)
        _confirming = true;

        if (_selectedFolderId == "__new__")
        {
            if (!FolderNameRegex.IsMatch(_newFolderName))
            {
                _validationError = "Folder name: alphanumeric, hyphens, underscores only (max 64 chars).";
                _confirming = false;  // allow retry after validation error
                return;
            }
        }

        _submitting = true;
        _validationError = "";
        StateHasChanged();

        try
        {
            object payload;
            string? resolvedFolderName;

            var readOnlyIds = _readOnlyFolderIds
                .Where(id => id != _selectedFolderId)
                .ToArray();

            if (_selectedFolderId == "__new__")
            {
                payload = new { conversationId = ConversationId, newFolderName = _newFolderName, readOnlyFolderIds = readOnlyIds };
                resolvedFolderName = _newFolderName;
            }
            else
            {
                payload = new { conversationId = ConversationId, folderId = _selectedFolderId, readOnlyFolderIds = readOnlyIds };
                resolvedFolderName = Folders.FirstOrDefault(f => f.Id == _selectedFolderId)?.Name;
            }

            var response = await AgentRuntime.PostToHarnessAsync(
                Session.UserId.ToString(),
                "/turn/folder-confirm",
                payload);

            if (!response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();
                _validationError = $"Could not confirm folder ({response.StatusCode}).";
                Logger.LogWarning("[FolderPicker] /turn/folder-confirm returned {Status}: {Body}", response.StatusCode, body);
                _submitting = false;
                _confirming = false;  // allow retry (ADO#3566)
                StateHasChanged();
                return;
            }

            await OnFolderConfirmed.InvokeAsync(new FolderConfirmedArgs(
                _selectedFolderId == "__new__" ? null : _selectedFolderId,
                resolvedFolderName,
                readOnlyIds));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[FolderPicker] PostToHarnessAsync failed");
            _validationError = "Error contacting harness. Please retry.";
            _submitting = false;
            _confirming = false;  // allow retry (ADO#3566)
            StateHasChanged();
        }
    }

    public record FolderConfirmedArgs(string? FolderId, string? FolderName, string[] ReadOnlyFolderIds);
}
