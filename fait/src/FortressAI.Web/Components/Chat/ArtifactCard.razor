@using FortressAI.Shared.Models
@inject IWorkspaceFileService WorkspaceFileSvc
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@inject ChatLayoutState LayoutState
@using FortressAI.Web.Services

<MudCard Elevation="1" Class="mt-2" Style="max-width: 400px;">
    <MudCardContent Class="py-2 px-3">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@GetFileIcon(Artifact.MimeType)" Color="Color.Primary" Size="Size.Medium" />
            <div class="flex-grow-1 artifact-card-meta">
                <MudText Typo="Typo.body2" Class="artifact-card-filename">
                    @Artifact.Filename
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @FormatSize(Artifact.SizeBytes)
                </MudText>
            </div>
        </div>
    </MudCardContent>
    <MudCardActions Class="pt-0 px-2 pb-2">
        @{
            bool previewSupported = Artifact.MimeType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
            string previewTooltip = previewSupported ? "" : "Preview not yet supported for this file type";
        }
        <MudTooltip Text="@previewTooltip" Disabled="@previewSupported">
            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Visibility"
                       Disabled="@(!previewSupported)"
                       OnClick="PreviewArtifact">
                Preview
            </MudButton>
        </MudTooltip>
        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@_downloadLoading"
                   OnClick="DownloadAsync">
            @if (_downloadLoading)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
            }
            Download
        </MudButton>
    </MudCardActions>
</MudCard>

@code {
    [Parameter, EditorRequired] public UserWorkspaceFile Artifact { get; set; } = null!;

    private bool _downloadLoading = false;

    private async Task DownloadAsync()
    {
        _downloadLoading = true;
        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(Artifact.S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Download failed. Please try again.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    private static string GetFileIcon(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Material.Filled.Description,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => Icons.Material.Filled.TableChart,
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => Icons.Material.Filled.Slideshow,
        "application/pdf" => Icons.Material.Filled.PictureAsPdf,
        "text/plain" or "text/markdown" => Icons.Material.Filled.Article,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private void PreviewArtifact()
    {
        var artifactRef = new ArtifactRef(Artifact.S3Key, Artifact.Filename, Artifact.MimeType);
        LayoutState.OpenArtifactPreview(artifactRef);
    }

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}

<style>
.artifact-card-meta {
    min-width: 0;
}
.artifact-card-filename {
    font-weight: var(--font-semibold, 600);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
</style>
