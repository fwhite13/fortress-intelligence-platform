@inject IJSRuntime JS
@using Microsoft.AspNetCore.Components

<div class="artifact-panel">
    <div class="artifact-header" @onclick="ToggleExpanded">
        <span>@GetArtifactIcon()</span>
        <span class="artifact-title">@Title</span>
        <span class="artifact-type-badge">@Type@(Type == "code" && !string.IsNullOrEmpty(Language) ? $" · {Language}" : "")</span>
        <div class="artifact-actions" @onclick:stopPropagation="true">
            <MudIconButton Icon="@Icons.Material.Filled.ContentCopy"
                Size="Size.Small"
                Title="Copy"
                OnClick="CopyContent" />
            <MudIconButton Icon="@Icons.Material.Filled.Download"
                Size="Size.Small"
                Title="Download"
                OnClick="DownloadContent" />
        </div>
        <MudIcon Icon="@(_expanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
            Size="Size.Small" />
    </div>
    @if (_expanded)
    {
        <div class="artifact-body">
            @if (Type == "code")
            {
                <pre><code class="language-@(Language ?? "text")">@Content</code></pre>
            }
            else
            {
                <pre>@Content</pre>
            }
        </div>
    }
</div>

@code {
    [Parameter] public string Type { get; set; } = "text";
    [Parameter] public string Title { get; set; } = "Artifact";
    [Parameter] public string Content { get; set; } = "";
    [Parameter] public string? Language { get; set; }

    private bool _expanded = false;

    private void ToggleExpanded() => _expanded = !_expanded;

    private string GetArtifactIcon() => Type switch
    {
        "code" => "💻",
        "markdown" => "📝",
        _ => "📄"
    };

    private string GetDownloadExtension() => Type switch
    {
        "code" => Language switch
        {
            "python" => ".py",
            "javascript" or "js" => ".js",
            "typescript" or "ts" => ".ts",
            "csharp" or "cs" => ".cs",
            "sql" => ".sql",
            "html" => ".html",
            "css" => ".css",
            "json" => ".json",
            "xml" => ".xml",
            "yaml" or "yml" => ".yml",
            "bash" or "sh" => ".sh",
            _ => ".txt"
        },
        "markdown" => ".md",
        _ => ".txt"
    };

    private async Task CopyContent()
    {
        try
        {
            await JS.InvokeVoidAsync("fortressChat.copyToClipboard", Content);
        }
        catch { /* JS interop failure */ }
    }

    private async Task DownloadContent()
    {
        try
        {
            var filename = $"{SanitizeFilename(Title)}{GetDownloadExtension()}";
            await JS.InvokeVoidAsync("fortressChat.downloadTextFile", filename, Content);
        }
        catch { /* JS interop failure */ }
    }

    private static string SanitizeFilename(string name)
    {
        var invalid = System.IO.Path.GetInvalidFileNameChars();
        return string.Join("_", name.Split(invalid)).Trim().Replace(" ", "_");
    }
}
