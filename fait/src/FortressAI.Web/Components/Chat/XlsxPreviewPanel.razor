@inject ArtifactPreviewService PreviewSvc
@inject FortressAI.Web.Services.UserSessionService Session
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject IWorkspaceFileService WorkspaceFileSvc
@inject ISnackbar Snackbar
@using FortressAI.Web.Services
@implements IAsyncDisposable

<div class="xlsx-preview-panel">
    @if (_loading)
    {
        <div class="xlsx-preview-panel__loading">
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Generating preview… this may take a moment.</MudText>
        </div>
    }
    else if (_error != null)
    {
        <div class="xlsx-preview-panel__error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Disabled="@_downloadLoading"
                       OnClick="DownloadAsync"
                       Class="mt-2">
                @if (_downloadLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Download spreadsheet
            </MudButton>
        </div>
    }
    else if (_proxyUrl != null)
    {
        <iframe src="@_proxyUrl"
                style="width: 100%; height: 100%; border: none;"
                title="Spreadsheet preview"
                sandbox="allow-scripts allow-popups allow-forms" />
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter, EditorRequired] public string S3Key { get; set; } = "";
    [Parameter] public string? ExistingPreviewS3Key { get; set; }

    private bool _loading = true;
    private string? _error;
    private string? _proxyUrl;
    private bool _downloadLoading = false;

    protected override void OnInitialized()
    {
        Session.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        if (_loading && Session.UserId != Guid.Empty)
        {
            InvokeAsync(async () =>
            {
                await LoadAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        var userId = Session.UserId;
        if (userId == Guid.Empty)
        {
            Console.WriteLine($"[preview] [xlsx] userId empty for artifact {ArtifactId}, waiting for auth");
            return;
        }

        try
        {
            string? previewS3Key = ExistingPreviewS3Key;
            if (!string.IsNullOrEmpty(previewS3Key))
            {
                Console.WriteLine($"[preview] [xlsx] Cache hit for artifact {ArtifactId} — skipping conversion");
            }
            else
            {
                Console.WriteLine($"[preview] [xlsx] Triggering XLSX→PDF conversion for artifact {ArtifactId}");
                var (convertedKey, sheetNames) = await PreviewSvc.ConvertXlsxAsync(ArtifactId, S3Key, userId, HttpClientFactory);
                previewS3Key = convertedKey;
                if (string.IsNullOrEmpty(previewS3Key))
                {
                    Console.Error.WriteLine($"[preview] [xlsx] Conversion returned no output for artifact {ArtifactId}");
                    _error = "Preview conversion failed. Try downloading the file.";
                    _loading = false;
                    StateHasChanged();
                    return;
                }
                Console.WriteLine($"[preview] [xlsx] Conversion success for artifact {ArtifactId}: key={previewS3Key} sheets=[{string.Join(", ", sheetNames)}]");
            }

            var (token, expires) = PreviewSvc.GenerateToken(ArtifactId, userId);
            _proxyUrl = $"/api/artifacts/{ArtifactId}/preview?token={Uri.EscapeDataString(token)}&expires={expires}&preview=true";
            Console.WriteLine($"[preview] [xlsx] Proxy URL ready for artifact {ArtifactId}");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[preview] [xlsx] LoadAsync failed for artifact {ArtifactId}: {ex.Message}");
            _error = "Failed to load spreadsheet preview. Try downloading the file.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task DownloadAsync()
    {
        _downloadLoading = true;
        StateHasChanged();
        try
        {
            Console.WriteLine($"[preview] [xlsx] Download fallback for artifact {ArtifactId}");
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[preview] [xlsx] Download failed: {ex.Message}");
            Snackbar.Add("Download failed.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        Session.OnAuthStateChanged -= HandleAuthStateChanged;
        return ValueTask.CompletedTask;
    }
}

<style>
.xlsx-preview-panel {
    width: 100%;
    height: 100%;
    overflow: hidden;
}
.xlsx-preview-panel__loading,
.xlsx-preview-panel__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
</style>
