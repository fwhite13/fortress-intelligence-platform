@inject ArtifactPreviewService PreviewSvc
@inject UserSessionService Session
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@using FortressAI.Web.Services
@implements IDisposable

<div class="xlsx-preview-panel">
    @if (_loading)
    {
        <div class="xlsx-preview-panel__loading">
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading spreadsheet...</MudText>
        </div>
    }
    else if (_error != null)
    {
        <div class="xlsx-preview-panel__error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>
        </div>
    }
    else if (_sheetNames.Count > 0)
    {
        @if (_sheetNames.Count == 1)
        {
            <div id="@_containerId" class="xlsx-preview-panel__table-container"></div>
        }
        else
        {
            <MudTabs ActivePanelIndex="@_activeSheet" ActivePanelIndexChanged="OnTabChanged" Class="xlsx-preview-panel__tabs">
                @foreach (var (name, index) in _sheetNames.Select((n, i) => (n, i)))
                {
                    <MudTabPanel Text="@name">
                        <div id="@($"{_containerId}-{index}")" class="xlsx-preview-panel__table-container"></div>
                    </MudTabPanel>
                }
            </MudTabs>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter, EditorRequired] public string Filename { get; set; } = "";
    [Parameter, EditorRequired] public string MimeType { get; set; } = "";

    private bool _loading = true;
    private string? _error;
    private List<string> _sheetNames = new();
    private int _activeSheet = 0;
    private string _containerId = $"xlsx-{Guid.NewGuid():N}";
    private byte[]? _fileBytes;
    // Prevents concurrent invocations from OnAfterRenderAsync(firstRender=true) and HandleAuthStateChanged.
    // Reset to false only when UserId is empty so HandleAuthStateChanged can retry after auth populates.
    private bool _loadStarted = false;
    private bool _jsRenderPending = false;
    private bool _jsRenderInFlight = false;

    protected override void OnInitialized()
    {
        Console.WriteLine($"[XlsxPreview] OnInitialized: ArtifactId={ArtifactId} Filename={Filename}");
        Session.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        Console.WriteLine($"[XlsxPreview] HandleAuthStateChanged: _loading={_loading} UserId={Session.UserId}");
        // Session just populated — if we haven't loaded yet, kick off the fetch
        if (_loading && Session.UserId != Guid.Empty)
        {
            InvokeAsync(async () =>
            {
                await FetchBytesAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine($"[XlsxPreview] OnAfterRenderAsync firstRender={firstRender} _jsRenderPending={_jsRenderPending} _jsRenderInFlight={_jsRenderInFlight}");
        if (firstRender)
        {
            await FetchBytesAsync();
            return;
        }

        // Second pass: bytes are ready and container div is now in DOM
        if (_jsRenderPending && !_jsRenderInFlight)
        {
            _jsRenderPending = false;
            _jsRenderInFlight = true;
            try
            {
                await RenderSheetAsync(0);
            }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[ERROR] [xlsx-preview] Render phase failed: {ex.Message}");
                _error = "Failed to load spreadsheet preview. Try downloading the file.";
                StateHasChanged();
            }
            finally
            {
                _jsRenderInFlight = false;
            }
        }
    }

    private async Task OnTabChanged(int index)
    {
        Console.WriteLine($"[XlsxPreview] Tab changed to {index}");
        _activeSheet = index;
        StateHasChanged();
        await Task.Yield(); // wait for tab panel to render before invoking JS
        if (_fileBytes != null && index < _sheetNames.Count)
        {
            await RenderSheetAsync(index);
        }
    }

    private async Task FetchBytesAsync()
    {
        if (_loadStarted) return;
        _loadStarted = true;
        Console.WriteLine($"[XlsxPreview] FetchBytesAsync start: ArtifactId={ArtifactId} Filename={Filename} UserId={Session.UserId}");
        try
        {
            var userId = Session.UserId;
            if (userId == Guid.Empty)
            {
                Console.WriteLine("[XlsxPreview] FetchBytesAsync: UserId empty, waiting for auth");
                _loadStarted = false; // allow HandleAuthStateChanged to retry once session populates
                return;
            }

            var (token, expires) = PreviewSvc.GenerateToken(ArtifactId, userId);
            var relativeUrl = $"/api/artifacts/{ArtifactId}/preview?token={Uri.EscapeDataString(token)}&expires={expires}";
            Console.WriteLine($"[XlsxPreview] FetchBytesAsync: url={relativeUrl}");
            using var http = HttpClientFactory.CreateClient("InternalPreview");
            using var response = await http.GetAsync(relativeUrl);
            Console.WriteLine($"[XlsxPreview] HTTP {(int)response.StatusCode} {response.StatusCode} for {relativeUrl}");
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Preview failed ({(int)response.StatusCode}). Try downloading.";
                _loading = false;
                StateHasChanged();
                return;
            }
            _fileBytes = await response.Content.ReadAsByteArrayAsync();

            // Get sheet names via JS interop — safe in fetch phase (no DOM container needed)
            Console.WriteLine($"[INFO] [xlsx-preview] calling getSheetNames for ArtifactId={ArtifactId}");
            var base64Bytes = Convert.ToBase64String(_fileBytes);
            var names = await JSRuntime.InvokeAsync<string[]>("xlsxPreviewInterop.getSheetNames", base64Bytes);
            _sheetNames = names?.ToList() ?? new List<string>();
            Console.WriteLine($"[XlsxPreview] getSheetNames: {_sheetNames.Count} sheets: {string.Join(", ", _sheetNames)}");

            if (_sheetNames.Count == 0)
            {
                _error = "No sheets found in this spreadsheet.";
                _loading = false;
                StateHasChanged();
                return;
            }

            _loading = false;
            _jsRenderPending = true;
            Console.WriteLine("[XlsxPreview] FetchBytesAsync success — _jsRenderPending=true, calling StateHasChanged");
            StateHasChanged(); // triggers second OnAfterRenderAsync pass with container div in DOM
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[XlsxPreview] FetchBytesAsync failed: ArtifactId={ArtifactId} Error={ex.GetType().Name}: {ex.Message}");
            _error = "Failed to load spreadsheet preview. Try downloading the file.";
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task RenderSheetAsync(int index)
    {
        if (_fileBytes == null || index >= _sheetNames.Count) return;
        var sheetName = _sheetNames[index];
        var containerId = _sheetNames.Count == 1 ? _containerId : $"{_containerId}-{index}";
        var base64Sheet = Convert.ToBase64String(_fileBytes);
        await JSRuntime.InvokeVoidAsync("xlsxPreviewInterop.renderSheet", base64Sheet, sheetName, containerId);
    }

    public void Dispose()
    {
        Console.WriteLine("[XlsxPreview] Dispose");
        Session.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}

<style>
.xlsx-preview-panel {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    overflow: hidden;
}
.xlsx-preview-panel__loading,
.xlsx-preview-panel__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.xlsx-preview-panel__tabs {
    flex: 1;
    overflow: hidden;
    display: flex;
    flex-direction: column;
}
.xlsx-preview-panel__table-container {
    max-height: 60vh;
    overflow-y: auto;
    overflow-x: auto;
    padding: 8px;
    background: white;
}
.xlsx-preview-panel__table-container table {
    border-collapse: collapse;
    font-size: 12px;
    font-family: 'Consolas', monospace;
}
.xlsx-preview-panel__table-container td,
.xlsx-preview-panel__table-container th {
    border: 1px solid #e0e0e0;
    padding: 4px 8px;
    white-space: nowrap;
}
.xlsx-preview-panel__table-container th {
    background: #f5f5f5;
    font-weight: 600;
}
</style>
