@inject ArtifactPreviewService PreviewSvc
@inject UserSessionService Session
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@implements IDisposable

<div class="docx-preview-panel">
    @if (_loading)
    {
        <div class="docx-preview-panel__loading">
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Loading document...</MudText>
        </div>
    }
    else if (_error != null)
    {
        <div class="docx-preview-panel__error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>
        </div>
    }
    else
    {
        <div id="@_containerId" class="docx-preview-panel__content"></div>
    }
</div>

@code {
    [Parameter, EditorRequired] public WorkspaceUpload Artifact { get; set; } = default!;

    private bool _loading = true;
    private string? _error;
    private byte[]? _pendingBytes;
    private string _containerId = $"docx-{Guid.NewGuid():N}";
    // _loadStarted: prevents double-fetch from OnAfterRenderAsync(firstRender=true) + HandleAuthStateChanged racing.
    // Reset to false only when UserId is empty so HandleAuthStateChanged can retry after auth populates.
    private bool _loadStarted = false;
    // _jsRenderPending: set when bytes are ready; only cleared after JSInterop completes or errors.
    // _jsRenderInFlight: set while JSInterop is running; prevents re-entry during the await suspension.
    private bool _jsRenderPending = false;
    private bool _jsRenderInFlight = false;

    protected override void OnInitialized()
    {
        Console.WriteLine($"[DocxPreview] OnInitialized: ArtifactId={Artifact.Id} Filename={Artifact.Filename}");
        Session.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        Console.WriteLine($"[DocxPreview] HandleAuthStateChanged: _loading={_loading} UserId={Session.UserId}");
        if (_loading && Session.UserId != Guid.Empty)
        {
            InvokeAsync(async () =>
            {
                await FetchBytesAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        Console.WriteLine($"[DocxPreview] OnAfterRenderAsync firstRender={firstRender} _pendingBytes={(_pendingBytes != null ? _pendingBytes.Length : -1)} _jsRenderPending={_jsRenderPending} _jsRenderInFlight={_jsRenderInFlight}");
        if (firstRender)
        {
            await FetchBytesAsync();
            return;
        }

        // Guard: skip if no render is needed, or one is already in progress.
        // _jsRenderInFlight stays true during the JSInterop await so concurrent OnAfterRenderAsync
        // calls triggered by the ChatView render loop cannot enter this block simultaneously.
        if (!_jsRenderPending || _jsRenderInFlight || _pendingBytes == null)
            return;

        _jsRenderInFlight = true;
        var bytes = _pendingBytes;
        var base64 = Convert.ToBase64String(bytes);
        Console.WriteLine($"[INFO] [docx-preview] rendering to containerId={_containerId}");
        try
        {
            await JSRuntime.InvokeVoidAsync("docxPreviewInterop.render", base64, _containerId);
            Console.WriteLine("[INFO] [docx-preview] JSInterop render complete");
            _jsRenderPending = false;
            _pendingBytes = null;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[ERROR] [docx-preview] JSInterop render failed: {ex.Message}");
            _jsRenderPending = false;
            _error = "Document preview failed. Please download the file.";
            StateHasChanged();
        }
        finally
        {
            _jsRenderInFlight = false;
        }
    }

    private async Task FetchBytesAsync()
    {
        if (_loadStarted) return;
        _loadStarted = true;
        Console.WriteLine($"[DocxPreview] FetchBytesAsync start: ArtifactId={Artifact.Id} UserId={Session.UserId}");
        try
        {
            var userId = Session.UserId;
            if (userId == Guid.Empty)
            {
                Console.WriteLine("[DocxPreview] FetchBytesAsync: UserId empty, waiting for auth");
                _loadStarted = false; // allow HandleAuthStateChanged to retry once session populates
                return;
            }
            var (token, expires) = PreviewSvc.GenerateToken(Artifact.Id, userId);
            var relativeUrl = $"/api/artifacts/{Artifact.Id}/preview?token={Uri.EscapeDataString(token)}&expires={expires}";
            Console.WriteLine($"[DocxPreview] FetchBytesAsync: token generated, url={relativeUrl}");
            using var http = HttpClientFactory.CreateClient("InternalPreview");
            using var response = await http.GetAsync(relativeUrl);
            Console.WriteLine($"[DocxPreview] HTTP {(int)response.StatusCode} {response.StatusCode} for {relativeUrl}");
            if (!response.IsSuccessStatusCode)
            {
                _error = $"Preview failed ({(int)response.StatusCode}). Try downloading.";
                _loading = false;
                StateHasChanged();
                return;
            }
            _pendingBytes = await response.Content.ReadAsByteArrayAsync();
            Console.WriteLine($"[DocxPreview] FetchBytesAsync success: {_pendingBytes.Length} bytes, signalling JS render");
            _loading = false;
            _jsRenderPending = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DocxPreview] FetchBytesAsync failed: ArtifactId={Artifact.Id} Error={ex.GetType().Name}: {ex.Message}");
            _error = "Failed to load document preview. Try downloading the file.";
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        Console.WriteLine("[DocxPreview] Dispose");
        Session.OnAuthStateChanged -= HandleAuthStateChanged;
    }
}

<style>
.docx-preview-panel {
    width: 100%;
    height: 100%;
    overflow: auto;
}
.docx-preview-panel__loading,
.docx-preview-panel__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.docx-preview-panel__content {
    padding: 16px;
    background: white;
    min-height: 100%;
}
</style>
