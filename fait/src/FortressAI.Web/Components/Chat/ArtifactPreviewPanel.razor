@inject IWorkspaceFileService WorkspaceFileSvc
@inject ArtifactPreviewService PreviewSvc
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatLayoutState LayoutState
@inject ISnackbar Snackbar
@inject IJSRuntime JSRuntime
@implements IDisposable
@using FortressAI.Web.Services
@using FortressAI.Shared.Models
@using System.IO
@using Microsoft.AspNetCore.Components.Authorization

<div style="display: flex; flex-direction: column; height: 100%; background: var(--color-surface); border-left: 1px solid var(--color-border);">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-3, 12px) var(--spacing-4, 16px); border-bottom: 1px solid var(--color-border); flex-shrink: 0;">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            @(LayoutState.CurrentArtifact?.Filename ?? "Preview")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       OnClick="Close"
                       Title="Close preview" />
    </div>

    <!-- Content -->
    <div style="flex: 1; overflow: hidden; position: relative;">
        @if (_loading)
        {
            <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (_error != null)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 16px; padding: 24px; text-align: center;">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                <MudText Color="Color.Error">@_error</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="LoadPreview">Retry</MudButton>
            </div>
        }
        else if (_isXlsx && _currentXlsxUpload != null)
        {
            <XlsxPreviewPanel ArtifactId="@_currentXlsxUpload.Id"
                              S3Key="@_currentXlsxUpload.S3Key"
                              ExistingPreviewS3Key="@_currentXlsxUpload.PreviewS3Key" />
        }
        else if (_isOffice && _currentOfficeUpload != null)
        {
            <OfficePreviewPanel Artifact="@_currentOfficeUpload" OnPreviewError="HandleOfficeError" />
        }
        else if (!_canPreview)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 16px; padding: 32px; text-align: center;">
                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Large" Style="opacity: 0.4;" />
                <MudText Typo="Typo.body1" Style="opacity: 0.6;">Preview not available for this file type.</MudText>
                @if (!string.IsNullOrEmpty(_rawPresignedUrl))
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               Href="@_rawPresignedUrl"
                               Target="_blank">
                        Download File
                    </MudButton>
                }
            </div>
        }
        else if (_isPptx && _currentPptxUpload != null)
        {
            <PptxPreviewPanel ArtifactId="@_currentPptxUpload.Id"
                              S3Key="@_currentPptxUpload.S3Key"
                              ExistingPreviewS3Key="@_currentPptxUpload.PreviewS3Key" />
        }
        else if (_presignedUrl != null)
        {
            <iframe src="@_presignedUrl"
                    style="width: 100%; height: 100%; border: none;"
                    title="Document preview"
                    sandbox="allow-scripts allow-popups allow-forms" />
        }
    </div>
</div>

@code {
    private static readonly HashSet<string> PreviewableExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".pdf", ".xlsx"
    };

    private static bool IsXlsxType(string filename, string mimeType)
    {
        var ext = Path.GetExtension(filename);
        return ext.Equals(".xlsx", StringComparison.OrdinalIgnoreCase)
            || mimeType == "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
    }

    private static bool IsPptxType(string filename, string mimeType)
    {
        var ext = Path.GetExtension(filename);
        return ext.Equals(".pptx", StringComparison.OrdinalIgnoreCase)
            || mimeType == "application/vnd.openxmlformats-officedocument.presentationml.presentation";
    }

    private string? _presignedUrl;
    private string? _rawPresignedUrl;
    private bool _canPreview;
    private bool _loading = true;
    private string? _error;
    private ArtifactRef? _loadedFor;
    private bool _isOffice;
    private WorkspaceUpload? _currentOfficeUpload;
    private bool _isPptx;
    private WorkspaceUpload? _currentPptxUpload;
    private bool _isXlsx;
    private WorkspaceUpload? _currentXlsxUpload;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += OnLayoutStateChanged;
        if (LayoutState.CurrentArtifact != null)
            await LoadPreview();
    }

    private async void OnLayoutStateChanged()
    {
        await InvokeAsync(async () =>
        {
            if (LayoutState.CurrentArtifact != _loadedFor)
                await LoadPreview();
            StateHasChanged();
        });
    }

    private async Task LoadPreview()
    {
        var artifact = LayoutState.CurrentArtifact;
        if (artifact == null) return;

        _loading = true;
        _error = null;
        _presignedUrl = null;
        _rawPresignedUrl = null;
        _canPreview = false;
        _isOffice = false;
        _currentOfficeUpload = null;
        _isPptx = false;
        _currentPptxUpload = null;
        _isXlsx = false;
        _currentXlsxUpload = null;
        StateHasChanged();

        try
        {
            if (IsXlsxType(artifact.Filename, artifact.MimeType))
            {
                // XlsxPreviewPanel handles conversion + iframe rendering via LibreOffice PDF
                Console.WriteLine($"[preview] [xlsx] Routing artifact {artifact.Id} to XlsxPreviewPanel");
                _isXlsx = true;
                _currentXlsxUpload = new WorkspaceUpload { Id = artifact.Id, S3Key = artifact.S3Key, Filename = artifact.Filename, MimeType = artifact.MimeType, PreviewS3Key = artifact.PreviewS3Key };
                _canPreview = true;
                _loading = false;
                _loadedFor = artifact;
                StateHasChanged();
                return;
            }

            if (IsPptxType(artifact.Filename, artifact.MimeType))
            {
                // PptxPreviewPanel handles its own loading
                _isPptx = true;
                _currentPptxUpload = new WorkspaceUpload
                {
                    Id = artifact.Id,
                    S3Key = artifact.S3Key,
                    Filename = artifact.Filename,
                    MimeType = artifact.MimeType,
                    PreviewS3Key = artifact.PreviewS3Key
                };
                _canPreview = true;
                _presignedUrl = null;
                _loading = false;
                _loadedFor = artifact;
                StateHasChanged();
                return;
            }

            var rawUrl = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(artifact.S3Key, expiryMinutes: 30);
            _rawPresignedUrl = rawUrl;

            var ext = Path.GetExtension(artifact.Filename);
            _isOffice = ext.Equals(".docx", StringComparison.OrdinalIgnoreCase)
                || artifact.MimeType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";

            if (_isOffice)
            {
                _currentOfficeUpload = new WorkspaceUpload
                {
                    Id = artifact.Id,
                    S3Key = artifact.S3Key,
                    Filename = artifact.Filename,
                    MimeType = artifact.MimeType
                };
                _canPreview = true;
            }
            else
            {
                _canPreview = PreviewableExtensions.Contains(ext);
                _currentOfficeUpload = null;
            }

            if (_canPreview && !_isOffice)
            {
                if (ext.Equals(".pdf", StringComparison.OrdinalIgnoreCase))
                {
                    _presignedUrl = await GetProxyPreviewUrlAsync(artifact);
                }
            }

            _loadedFor = artifact;
        }
        catch (Exception ex)
        {
            _error = "Failed to load preview. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task<string?> GetProxyPreviewUrlAsync(ArtifactRef artifact)
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userIdStr = authState.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!Guid.TryParse(userIdStr, out var userId)) return null;
        var (token, expires) = PreviewSvc.GenerateToken(artifact.Id, userId);
        return $"/api/artifacts/{artifact.Id}/preview?token={Uri.EscapeDataString(token)}&expires={expires}";
    }

    private Task HandleOfficeError(string message)
    {
        _error = message;
        _isOffice = false;
        _currentOfficeUpload = null;
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void Close() => LayoutState.CloseArtifactPreview();

    public void Dispose()
    {
        LayoutState.OnChange -= OnLayoutStateChanged;
    }
}
