@inject IWorkspaceFileService WorkspaceFileSvc
@inject ChatLayoutState LayoutState
@inject ISnackbar Snackbar
@implements IDisposable
@using FortressAI.Web.Services

<div style="display: flex; flex-direction: column; height: 100%; background: var(--color-surface); border-left: 1px solid var(--color-border);">
    <!-- Header -->
    <div style="display: flex; align-items: center; justify-content: space-between; padding: var(--spacing-3, 12px) var(--spacing-4, 16px); border-bottom: 1px solid var(--color-border); flex-shrink: 0;">
        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
            @(LayoutState.CurrentArtifact?.Filename ?? "Preview")
        </MudText>
        <MudIconButton Icon="@Icons.Material.Filled.Close"
                       Size="Size.Small"
                       OnClick="Close"
                       Title="Close preview" />
    </div>

    <!-- Content -->
    <div style="flex: 1; overflow: hidden; position: relative;">
        @if (_loading)
        {
            <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                <MudProgressCircular Indeterminate="true" />
            </div>
        }
        else if (_error != null)
        {
            <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: 16px; padding: 24px; text-align: center;">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Color="Color.Error" Size="Size.Large" />
                <MudText Color="Color.Error">@_error</MudText>
                <MudButton Variant="Variant.Outlined" OnClick="LoadPreview">Retry</MudButton>
            </div>
        }
        else if (_presignedUrl != null)
        {
            <iframe src="@_presignedUrl"
                    style="width: 100%; height: 100%; border: none;"
                    title="Document preview"
                    sandbox="allow-scripts allow-same-origin allow-popups allow-forms" />
        }
    </div>
</div>

@code {
    private string? _presignedUrl;
    private bool _loading;
    private string? _error;
    private ArtifactRef? _loadedFor;

    protected override async Task OnInitializedAsync()
    {
        LayoutState.OnChange += OnLayoutStateChanged;
        if (LayoutState.CurrentArtifact != null)
            await LoadPreview();
    }

    private async void OnLayoutStateChanged()
    {
        await InvokeAsync(async () =>
        {
            if (LayoutState.CurrentArtifact != _loadedFor)
                await LoadPreview();
            StateHasChanged();
        });
    }

    private async Task LoadPreview()
    {
        var artifact = LayoutState.CurrentArtifact;
        if (artifact == null) return;

        _loading = true;
        _error = null;
        _presignedUrl = null;
        StateHasChanged();

        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(artifact.S3Key, expiryMinutes: 30);
            var encoded = Uri.EscapeDataString(url);
            _presignedUrl = $"https://view.officeapps.live.com/op/embed.aspx?src={encoded}";
            _loadedFor = artifact;
        }
        catch (Exception ex)
        {
            _error = "Failed to load preview. Please try again.";
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void Close() => LayoutState.CloseArtifactPreview();

    public void Dispose()
    {
        LayoutState.OnChange -= OnLayoutStateChanged;
    }
}
