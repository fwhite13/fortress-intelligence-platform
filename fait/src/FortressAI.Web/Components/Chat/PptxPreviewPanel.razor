@inject ArtifactPreviewService PreviewSvc
@inject FortressAI.Web.Services.UserSessionService Session
@inject IJSRuntime JSRuntime
@inject IHttpClientFactory HttpClientFactory
@inject Amazon.S3.IAmazonS3 S3Client
@inject IConfiguration Configuration
@inject IWorkspaceFileService WorkspaceFileSvc
@inject ISnackbar Snackbar
@using FortressAI.Web.Services
@implements IAsyncDisposable

<div class="pptx-preview-panel">
    @if (_loading)
    {
        <div class="pptx-preview-panel__loading">
            <MudProgressCircular Indeterminate="true" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2">Generating preview… this may take a moment.</MudText>
        </div>
    }
    else if (_error != null)
    {
        <div class="pptx-preview-panel__error">
            <MudIcon Icon="@Icons.Material.Outlined.ErrorOutline" Size="Size.Large" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">@_error</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Default"
                       StartIcon="@Icons.Material.Outlined.Download"
                       Disabled="@_downloadLoading"
                       OnClick="DownloadAsync"
                       Class="mt-2">
                @if (_downloadLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                }
                Download presentation
            </MudButton>
        </div>
    }
    else
    {
        <div class="pptx-preview-panel__viewer">
            <div id="@_containerId" class="pptx-preview-panel__canvas-container"></div>
            @if (_totalPages > 1)
            {
                <div class="pptx-preview-panel__nav">
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronLeft"
                                   Size="Size.Small"
                                   Disabled="@(_currentPage <= 1)"
                                   OnClick="PrevPage" />
                    <MudText Typo="Typo.body2" Class="pptx-preview-panel__page-label">
                        Page @_currentPage of @_totalPages
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Outlined.ChevronRight"
                                   Size="Size.Small"
                                   Disabled="@(_currentPage >= _totalPages)"
                                   OnClick="NextPage" />
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public Guid ArtifactId { get; set; }
    [Parameter, EditorRequired] public string S3Key { get; set; } = "";
    [Parameter] public string? ExistingPreviewS3Key { get; set; }

    private bool _loading = true;
    private string? _error;
    private byte[]? _pendingBytes;
    private string _containerId = $"pptx-{Guid.NewGuid():N}";
    private int _currentPage = 1;
    private int _totalPages = 0;
    private bool _downloadLoading = false;

    private async Task DownloadAsync()
    {
        _downloadLoading = true;
        StateHasChanged();
        try
        {
            Console.WriteLine($"[preview] [pptx] Download fallback requested for artifact {ArtifactId}, S3Key={S3Key}");
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(S3Key);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[preview] [pptx] Download fallback failed: {ex.Message}");
            Snackbar.Add("Download failed.", Severity.Error);
        }
        finally
        {
            _downloadLoading = false;
            StateHasChanged();
        }
    }

    protected override void OnInitialized()
    {
        Session.OnAuthStateChanged += HandleAuthStateChanged;
    }

    private void HandleAuthStateChanged()
    {
        if (_loading && Session.UserId != Guid.Empty)
        {
            InvokeAsync(async () =>
            {
                await FetchAndConvertAsync();
                StateHasChanged();
            });
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await FetchAndConvertAsync();
            return;
        }

        if (_pendingBytes != null)
        {
            var bytes = _pendingBytes;
            _pendingBytes = null;
            var base64 = Convert.ToBase64String(bytes);
            _totalPages = await JSRuntime.InvokeAsync<int>("pptxPreviewInterop.render", base64, _containerId);
            StateHasChanged();
        }
    }

    private async Task FetchAndConvertAsync()
    {
        try
        {
            Console.WriteLine($"[preview] [pptx] Starting fetch/convert for artifact {ArtifactId}, S3Key={S3Key}");
            var userId = Session.UserId;
            if (userId == Guid.Empty)
            {
                Console.WriteLine($"[PptxPreview] FetchAndConvertAsync: userId empty, staying in loading state — OnAuthStateChanged will retry");
                // Stay in loading state — HandleAuthStateChanged will trigger retry when session is ready
                return;
            }

            // Step 1: Get cached key or trigger conversion directly (no [Authorize] HTTP round-trip)
            string? previewS3Key = ExistingPreviewS3Key;
            if (string.IsNullOrEmpty(previewS3Key))
            {
                previewS3Key = await PreviewSvc.ConvertPptxAsync(ArtifactId, S3Key, userId, HttpClientFactory);
            }

            if (string.IsNullOrEmpty(previewS3Key))
            {
                _error = "Conversion produced no output. Try downloading the file.";
                _loading = false;
                StateHasChanged();
                return;
            }

            // ADO#4863 — Direct S3 fetch (avoid hairpin NAT issue with internal→ALB→internal)
            var bucket = Configuration["WORKSPACE_S3_BUCKET"] ?? "fortress-user-workspaces";
            Console.WriteLine($"[pptx-preview] ADO#4863: direct S3 fetch bucket={bucket} key={previewS3Key} userId={userId}");
            using var s3Resp = await S3Client.GetObjectAsync(bucket, previewS3Key);
            using var ms = new System.IO.MemoryStream();
            await s3Resp.ResponseStream.CopyToAsync(ms);
            _pendingBytes = ms.ToArray();
            _loading = false;
            StateHasChanged();
        }
        catch (Amazon.S3.AmazonS3Exception s3Ex)
        {
            Console.Error.WriteLine($"[pptx-preview] S3 fetch failed: {s3Ex.ErrorCode} — {s3Ex.Message}");
            _error = "Failed to load presentation preview. Try downloading the file.";
            _loading = false;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[PptxPreview] FetchAndConvertAsync failed: {ex.Message}");
            _error = "Failed to load presentation preview. Try downloading the file.";
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task PrevPage()
    {
        if (_currentPage <= 1) return;
        _currentPage--;
        await JSRuntime.InvokeVoidAsync("pptxPreviewInterop.renderPage", _containerId, _currentPage);
        StateHasChanged();
    }

    private async Task NextPage()
    {
        if (_currentPage >= _totalPages) return;
        _currentPage++;
        await JSRuntime.InvokeVoidAsync("pptxPreviewInterop.renderPage", _containerId, _currentPage);
        StateHasChanged();
    }

    public ValueTask DisposeAsync()
    {
        Session.OnAuthStateChanged -= HandleAuthStateChanged;
        return ValueTask.CompletedTask;
    }
}

<style>
.pptx-preview-panel {
    width: 100%;
    height: 100%;
    overflow: auto;
}
.pptx-preview-panel__loading,
.pptx-preview-panel__error {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    gap: 12px;
    padding: 24px;
    text-align: center;
    color: var(--color-text-secondary);
}
.pptx-preview-panel__viewer {
    display: flex;
    flex-direction: column;
    height: 100%;
}
.pptx-preview-panel__canvas-container {
    flex: 1;
    overflow: auto;
    background: var(--color-surface-sunken, #f5f5f5);
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding: 16px;
}
.pptx-preview-panel__canvas-container canvas {
    max-width: 100%;
    box-shadow: 0 2px 8px rgba(0,0,0,0.15);
}
.pptx-preview-panel__nav {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 8px 16px;
    border-top: 1px solid var(--color-border);
    flex-shrink: 0;
}
.pptx-preview-panel__page-label {
    min-width: 100px;
    text-align: center;
}
</style>
