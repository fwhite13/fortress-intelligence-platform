@rendermode InteractiveServer
@inject AuthService AuthSvc
@inject UserSessionService Session
@inject IConfiguration Config

<div style="min-height: 100vh; background: var(--color-header-bg); display: flex; align-items: center; justify-content: center;">
    <MudCard Style="width: 420px; border-radius: var(--radius-xl); background: var(--color-bg-card); padding: var(--space-8); box-shadow: var(--shadow-lg);">
        <MudCardContent>
            <div style="text-align: center; margin-bottom: var(--space-3);">
                <img src="/images/fip-tower-icon.png" alt="Fortress Intelligence Platform" style="width: 96px; height: 96px;" />
            </div>
            <MudText Typo="Typo.h6" Align="Align.Center" Style="font-weight: var(--font-semibold); margin-bottom: var(--space-2);">
                Fortress Intelligence Platform
            </MudText>
            <MudText Typo="Typo.body2" Align="Align.Center" Style="color: var(--color-text-secondary); margin-bottom: var(--space-6);">
                Sign in to access your tools.
            </MudText>

            @if (!string.IsNullOrEmpty(error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mb-4">@error</MudAlert>
            }

            @if (_entraConfigured)
            {
                <a href="/auth/login-entra"
                   style="display: flex; align-items: center; justify-content: center; gap: 12px; width: 100%; height: 41px; border-radius: 3px; border: 1px solid rgba(255,255,255,0.3); background: #2f2f2f; color: #ffffff; font-family: 'Segoe UI', system-ui, -apple-system, sans-serif; font-size: 15px; font-weight: 600; text-decoration: none; margin-bottom: var(--space-4); cursor: pointer; letter-spacing: 0.01em; padding: 0 12px; box-sizing: border-box;"
                   title="Sign in with your Microsoft account">
                    <svg xmlns="http://www.w3.org/2000/svg" width="21" height="21" viewBox="0 0 21 21" style="flex-shrink: 0;">
                        <rect x="1" y="1" width="9" height="9" fill="#f25022"/>
                        <rect x="12" y="1" width="9" height="9" fill="#7fba00"/>
                        <rect x="1" y="12" width="9" height="9" fill="#00a4ef"/>
                        <rect x="12" y="12" width="9" height="9" fill="#ffb900"/>
                    </svg>
                    Sign in with Microsoft
                </a>

                <div style="display: flex; align-items: center; gap: var(--space-3); margin-bottom: var(--space-4);">
                    <div style="flex: 1; height: 1px; background: var(--color-border);"></div>
                    <span style="font-size: var(--text-xs); color: var(--color-text-tertiary);">or sign in with email</span>
                    <div style="flex: 1; height: 1px; background: var(--color-border);"></div>
                </div>
            }

            @if (isRegistering)
            {
                <MudTextField @bind-Value="displayName" Label="Display Name" Variant="Variant.Outlined"
                              Placeholder="Your name" Class="mb-3" />
            }

            <MudTextField @bind-Value="email" Label="Email" Variant="Variant.Outlined"
                          InputType="InputType.Email" Placeholder="you@fortress.ai" Class="mb-3"
                          OnKeyUp="HandleKeyUp" />

            <MudTextField @bind-Value="password" Label="Password" Variant="Variant.Outlined"
                          InputType="InputType.Password" Placeholder="••••••••" Class="mb-3"
                          OnKeyUp="HandleKeyUp" />

            @if (isRegistering)
            {
                <MudTextField @bind-Value="confirmPassword" Label="Confirm Password" Variant="Variant.Outlined"
                              InputType="InputType.Password" Placeholder="••••••••" Class="mb-3"
                              OnKeyUp="HandleKeyUp" />
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="Submit" Disabled="@isLoading"
                       Style="height: 40px; margin-bottom: var(--space-4);">
                @if (isLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                @(isRegistering ? "Complete Registration" : "Sign In")
            </MudButton>

            <div style="text-align: center;">
                @if (isRegistering)
                {
                    <MudText Typo="Typo.body2">Already have an account?
                        <MudLink OnClick="@(() => { isRegistering = false; error = null; })">Sign in</MudLink>
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.body2">Don't have an account?
                        <MudLink OnClick="@(() => { isRegistering = true; error = null; })">Complete Registration</MudLink>
                    </MudText>
                }
            </div>
        </MudCardContent>
    </MudCard>
</div>

@code {
    private string email = "";
    private string password = "";
    private string confirmPassword = "";
    private string displayName = "";
    private string? error;
    private bool isRegistering = false;
    private bool isLoading = false;
    private bool _entraConfigured;

    protected override void OnInitialized()
    {
        _entraConfigured = !string.IsNullOrEmpty(Config["Auth:EntraAuthority"])
            && !string.IsNullOrEmpty(Config["Auth:EntraClientId"])
            && !string.IsNullOrEmpty(Config["Auth:EntraClientSecret"]);
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Submit();
    }

    private async Task Submit()
    {
        error = null;
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            error = "Please fill in all required fields.";
            return;
        }

        if (isRegistering && password != confirmPassword)
        {
            error = "Passwords do not match.";
            return;
        }

        if (password.Length < 6)
        {
            error = "Password must be at least 6 characters.";
            return;
        }

        isLoading = true;
        try
        {
            if (isRegistering)
            {
                var (success, err, user) = await AuthSvc.RegisterAsync(email, password, displayName);
                if (!success) { error = err; return; }
                Session.SetUser(user);
            }
            else
            {
                var (success, err, user) = await AuthSvc.LoginAsync(email, password);
                if (!success) { error = err; return; }
                Session.SetUser(user);
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}
