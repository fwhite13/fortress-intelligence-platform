    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    private static string GetIngestionStatusColor(string status) => status switch
    {
        "ingested" => "#059669",   // green
        "pending"  => "#d97706",   // amber
        "failed"   => "#dc2626",   // red
        _          => "#6b7280"    // gray (unknown / none)
    };

    private static string GetIngestionStatusLabel(string status) => status switch
    {
        "ingested" => "✓ Ready",
        "pending"  => "⏳ Processing",
        "failed"   => "✗ Failed",
        _          => "⏳ Processing"  // default for newly uploaded docs
    };

    // ── Project actions ───────────────────────────────────────────────────────

    private async Task OpenNewTeam()
    {
        var parameters = new DialogParameters<ProjectDialog>();
        var dialog = await DialogService.ShowAsync<ProjectDialog>("New Project", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is ProjectDialogResult r)
            await CreateTeam(r.Name, r.Description);
    }

    private async Task CreateTeam(string name, string? description)
    {
        try
        {
            var desc = string.IsNullOrWhiteSpace(description) ? null : description.Trim();
            await Forge.CreateTeamAsync(Session.UserId, name.Trim(), desc);
            Snackbar.Add("Team created!", Severity.Success);
            _teams = await Forge.GetUserTeamsAsync(Session.UserId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "CreateTeam failed for user {UserId}", Session.UserId);
            Snackbar.Add($"Failed to create team: {ex.Message}", Severity.Error);
        }
    }

    private async Task SelectTeam(KbTeam team)
    {
        _selectedTeam       = team;
        _loadingTeamEntries = true;
        StateHasChanged();
        try
        {
            _teamEntries = await Forge.GetTeamEntriesAsync(Session.UserId, team.Id);
            _teamDocuments = await KbDocumentService.ListDocumentsAsync(KbTier.Team, Session.UserId, team.Id);

            // Load display names for members
            var userIds = team.Members.Select(m => m.UserId).ToList();
            await using var db = await ContextFactory.CreateDbContextAsync();
            var users = await db.Users
                .Where(u => userIds.Contains(u.Id))
                .Select(u => new { u.Id, Name = u.DisplayName ?? u.Email ?? u.Id.ToString() })
                .ToListAsync();
            _memberDisplayNames = users.ToDictionary(u => u.Id, u => u.Name);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingTeamEntries = false;
        }
    }

    private void BackToTeams()
    {
        _selectedTeam = null;
        _memberDisplayNames = new();
        _teamEntries  = new();
    }

    private async Task OpenNewTeamEntry()
    {
        var parameters = new DialogParameters<EntryDialog>();
        var dialog = await DialogService.ShowAsync<EntryDialog>("Add Entry", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is EntryDialogResult r)
            await SaveEntry(KbTier.Team, _selectedTeam!.Id, r.Title, r.Content, r.Tags);
    }

    // ── Member actions ────────────────────────────────────────────────────────

    private async Task OpenAddMember()
    {
        // Load all users except current user and existing members
        var existingMemberIds = _selectedTeam?.Members.Select(m => m.UserId).ToHashSet() ?? new HashSet<Guid>();
        await using var db = await ContextFactory.CreateDbContextAsync();
        var availableUsers = await db.Users
            .Where(u => u.Id != Session.UserId && !existingMemberIds.Contains(u.Id))
            .OrderBy(u => u.DisplayName ?? u.Email)
            .ToListAsync();

        var parameters = new DialogParameters<AddMemberDialog>
        {
            { x => x.AvailableUsers, availableUsers }
        };
        var dialog = await DialogService.ShowAsync<AddMemberDialog>("Add Member", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is Guid newMemberId)
            await AddMember(newMemberId);
    }

    private async Task AddMember(Guid memberId)
    {
        try
        {
            await Forge.AddMemberAsync(Session.UserId, _selectedTeam!.Id, memberId);
            Snackbar.Add("Member added successfully.", Severity.Success);
            _teams        = await Forge.GetUserTeamsAsync(Session.UserId);
            _selectedTeam = _teams.FirstOrDefault(p => p.Id == _selectedTeam.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveMember(Guid memberId)
    {
        try
        {
            await Forge.RemoveMemberAsync(Session.UserId, _selectedTeam!.Id, memberId);
            Snackbar.Add("Member removed.", Severity.Success);
            _teams        = await Forge.GetUserTeamsAsync(Session.UserId);
            _selectedTeam = _teams.FirstOrDefault(p => p.Id == _selectedTeam.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
