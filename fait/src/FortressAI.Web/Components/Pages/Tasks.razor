@page "/tasks"
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@using FortressAI.Web.Components.Tasks
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@implements IAsyncDisposable
<PageTitle>Tasks — FAIT</PageTitle>
@inject UserSessionService Session
@inject IDbContextFactory<FortressAI.Web.Data.AppDbContext> DbFactory
@inject IUserAgentRuntime AgentRuntime
@inject IScheduledTaskService TaskSvc
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Tasks> Logger
@inject ITaskNotificationService _notificationService
@inject NavigationManager NavigationManager

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-4">Tasks</MudText>

    @if (!Session.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Warning">Please log in to view your tasks.</MudAlert>
    }
    else if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" PanelClass="pt-4">
            <MudTabPanel Text="Recurring">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateModalAsync" Class="mb-3">
                    Create Recurring Task
                </MudButton>

                @if (_recurringTasks == null || _recurringTasks.Count == 0)
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                        No recurring tasks yet. Create one to get started.
                    </MudText>
                }
                else
                {
                    <MudTable Items="@_recurringTasks" Hover="true" Dense="false" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Schedule</MudTh>
                            <MudTh>Last Run</MudTh>
                            <MudTh>Next Run</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Last Result</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var localTask = context;
                            }
                            <MudTd DataLabel="Name">@localTask.Name</MudTd>
                            <MudTd DataLabel="Schedule">@FormatCron(localTask.CronExpression)</MudTd>
                            <MudTd DataLabel="Last Run">
                                @(localTask.LastRunAt.HasValue ? localTask.LastRunAt.Value.ToLocalTime().ToString("g") : "—")
                            </MudTd>
                            <MudTd DataLabel="Next Run">
                                @(localTask.NextRunAt.HasValue ? localTask.NextRunAt.Value.ToLocalTime().ToString("g") : "—")
                            </MudTd>
                            <MudTd DataLabel="Status">
                                @if (localTask.FailureCount >= 2)
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                }
                                else if (localTask.IsActive)
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Active</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">Paused</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Last Result">
                                @if (localTask.LastRunStatus == "success")
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip>
                                }
                                else if (localTask.LastRunStatus == "failed")
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Never run</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Title="Edit"
                                               OnClick="@(() => OpenEditModalAsync(localTask))"
                                               Size="Size.Small" />
                                <MudIconButton Icon="@(localTask.IsActive ? Icons.Material.Filled.Pause : Icons.Material.Filled.PlayArrow)"
                                               Title="@(localTask.IsActive ? "Pause" : "Resume")"
                                               OnClick="@(() => TogglePauseAsync(localTask))"
                                               Size="Size.Small" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Title="Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => ConfirmDeleteAsync(localTask))"
                                               Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="On-Demand">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="OpenCreateOnDemandModalAsync" Class="mb-3">
                    Save On-Demand Prompt
                </MudButton>

                @if (_onDemandTasks == null || _onDemandTasks.Count == 0)
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">
                        No saved prompts yet. Save a prompt to run it on demand.
                    </MudText>
                }
                else
                {
                    <MudTable Items="@_onDemandTasks" Hover="true" Dense="false" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Prompt Preview</MudTh>
                            <MudTh>Last Run</MudTh>
                            <MudTh>Last Result</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var localTask = context;
                                var promptPreview = localTask.Prompt.Length > 100
                                    ? localTask.Prompt.Substring(0, 100) + "…"
                                    : localTask.Prompt;
                            }
                            <MudTd DataLabel="Name">@localTask.Name</MudTd>
                            <MudTd DataLabel="Prompt Preview">
                                <MudText Typo="Typo.body2" Style="color: var(--mud-palette-text-secondary);">@promptPreview</MudText>
                            </MudTd>
                            <MudTd DataLabel="Last Run">
                                @(localTask.LastRunAt.HasValue ? localTask.LastRunAt.Value.ToLocalTime().ToString("g") : "—")
                            </MudTd>
                            <MudTd DataLabel="Last Result">
                                @if (localTask.LastRunStatus == "success")
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip>
                                }
                                else if (localTask.LastRunStatus == "failed")
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Default" Size="Size.Small">Never run</MudChip>
                                }
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                           OnClick="@(() => RunNowAsync(localTask))"
                                           StartIcon="@Icons.Material.Filled.PlayArrow">
                                    Run Now
                                </MudButton>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                               Title="Edit"
                                               OnClick="@(() => OpenEditOnDemandModalAsync(localTask))"
                                               Size="Size.Small" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Title="Delete"
                                               Color="Color.Error"
                                               OnClick="@(() => ConfirmDeleteOnDemandAsync(localTask))"
                                               Size="Size.Small" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudTabPanel>

            <MudTabPanel Text="History">
                @if (_runHistory == null || _runHistory.Count == 0)
                {
                    <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-4">No task history yet.</MudText>
                }
                else
                {
                    <MudTable Items="@_runHistory" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh></MudTh>
                            <MudTh>Task</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Started</MudTh>
                            <MudTh>Duration</MudTh>
                            <MudTh>Status</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var localRun = context;
                                var duration = localRun.CompletedAt.HasValue
                                    ? (localRun.CompletedAt.Value - localRun.StartedAt).TotalSeconds.ToString("F0") + "s"
                                    : "—";
                                var isExpanded = _expandedRunIds.Contains(localRun.RunId);
                            }
                            <MudTd>
                                @if (!string.IsNullOrEmpty(localRun.Error) || !string.IsNullOrEmpty(localRun.ResultSummary))
                                {
                                    <MudIconButton Icon="@(isExpanded ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small" OnClick="@(() => ToggleExpand(localRun.RunId))" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Task">@localRun.TaskName</MudTd>
                            <MudTd DataLabel="Type">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(localRun.ScheduleType == "recurring" ? Color.Info : Color.Default)">
                                    @(localRun.ScheduleType == "recurring" ? "Recurring" : "On-Demand")
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Started">@localRun.StartedAt.ToLocalTime().ToString("g")</MudTd>
                            <MudTd DataLabel="Duration">@duration</MudTd>
                            <MudTd DataLabel="Status">
                                @if (localRun.Status == "success")
                                {
                                    <MudChip T="string" Color="Color.Success" Size="Size.Small">Success</MudChip>
                                }
                                else if (localRun.Status == "failed")
                                {
                                    <MudChip T="string" Color="Color.Error" Size="Size.Small">Failed</MudChip>
                                }
                                else
                                {
                                    <MudChip T="string" Color="Color.Warning" Size="Size.Small">@localRun.Status</MudChip>
                                }
                            </MudTd>
                        </RowTemplate>
                        <ChildRowContent>
                            @{
                                var localRun = context;
                                var isExpanded = _expandedRunIds.Contains(localRun.RunId);
                            }
                            @if (isExpanded)
                            {
                                <MudTr>
                                    <MudTd colspan="6">
                                        <MudText Typo="Typo.body2" Class="px-4 py-2" Style="white-space: pre-wrap;">
                                            @(localRun.Status == "failed" ? localRun.Error : localRun.ResultSummary)
                                        </MudText>
                                    </MudTd>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>

                    @if (_hasMoreHistory)
                    {
                        <MudButton Variant="Variant.Text" OnClick="LoadMoreHistoryAsync" Class="mt-2">Load more</MudButton>
                    }
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private static readonly DialogOptions DefaultDialogOptions = new DialogOptions
    {
        MaxWidth = MaxWidth.Medium,
        FullWidth = true,
        CloseOnEscapeKey = true,
        CloseButton = true
    };

    private List<ScheduledTask>? _recurringTasks;
    private bool _loading = true;

    // On-Demand tab state
    private List<ScheduledTask>? _onDemandTasks;

    // History tab state
    private class TaskRunHistoryItem
    {
        public Guid RunId { get; set; }
        public string TaskName { get; set; } = "";
        public string ScheduleType { get; set; } = "";
        public DateTime StartedAt { get; set; }
        public DateTime? CompletedAt { get; set; }
        public string Status { get; set; } = "";
        public string? Error { get; set; }
        public string? ResultSummary { get; set; }
    }

    private List<TaskRunHistoryItem>? _runHistory;
    private int _historyPage = 0;
    private bool _hasMoreHistory = false;
    private const int HistoryPageSize = 50;
    private HashSet<Guid> _expandedRunIds = new();

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            _loading = false;
            return;
        }
        await LoadRecurringTasksAsync();
        await LoadOnDemandTasksAsync();
        await LoadHistoryAsync();
        _loading = false;
    }

    private async Task LoadRecurringTasksAsync()
    {
        if (!Session.IsAuthenticated) return;
        try
        {
            var all = await TaskSvc.GetTasksAsync(Session.UserId);
            _recurringTasks = all.Where(t => t.ScheduleType == "recurring").ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Tasks] Failed to load recurring tasks for user {UserId}", Session.UserId);
            _recurringTasks = new List<ScheduledTask>();
        }
    }

    private async Task LoadOnDemandTasksAsync()
    {
        if (!Session.IsAuthenticated) return;
        try
        {
            var all = await TaskSvc.GetTasksAsync(Session.UserId);
            _onDemandTasks = all.Where(t => t.ScheduleType == "on_demand").ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Tasks] Failed to load on-demand tasks for user {UserId}", Session.UserId);
            _onDemandTasks = new List<ScheduledTask>();
        }
    }

    private async Task LoadHistoryAsync()
    {
        if (!Session.IsAuthenticated) return;
        try
        {
            _historyPage = 0;
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var items = await ctx.ScheduledTaskRuns
                .Include(r => r.Task)
                .Where(r => r.Task != null && r.Task.UserId == Session.UserId)
                .OrderByDescending(r => r.StartedAt)
                .Skip(_historyPage * HistoryPageSize)
                .Take(HistoryPageSize)
                .ToListAsync();
            _runHistory = items.Select(r => new TaskRunHistoryItem
            {
                RunId = r.Id,
                TaskName = r.Task?.Name ?? "Unknown task",
                ScheduleType = r.Task?.ScheduleType ?? "unknown",
                StartedAt = r.StartedAt,
                CompletedAt = r.CompletedAt,
                Status = r.Status,
                Error = r.Error,
                ResultSummary = r.ResultSummary
            }).ToList();
            _hasMoreHistory = items.Count == HistoryPageSize;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Tasks] Failed to load run history for user {UserId}", Session.UserId);
            _runHistory = new List<TaskRunHistoryItem>();
        }
    }

    private async Task LoadMoreHistoryAsync()
    {
        if (!Session.IsAuthenticated) return;
        try
        {
            _historyPage++;
            await using var ctx = await DbFactory.CreateDbContextAsync();
            var more = await ctx.ScheduledTaskRuns
                .Include(r => r.Task)
                .Where(r => r.Task != null && r.Task.UserId == Session.UserId)
                .OrderByDescending(r => r.StartedAt)
                .Skip(_historyPage * HistoryPageSize)
                .Take(HistoryPageSize)
                .ToListAsync();
            var mapped = more.Select(r => new TaskRunHistoryItem
            {
                RunId = r.Id,
                TaskName = r.Task?.Name ?? "Unknown task",
                ScheduleType = r.Task?.ScheduleType ?? "unknown",
                StartedAt = r.StartedAt,
                CompletedAt = r.CompletedAt,
                Status = r.Status,
                Error = r.Error,
                ResultSummary = r.ResultSummary
            });
            _runHistory ??= new List<TaskRunHistoryItem>();
            _runHistory.AddRange(mapped);
            _hasMoreHistory = more.Count == HistoryPageSize;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[Tasks] Failed to load more history for user {UserId}", Session.UserId);
        }
    }

    private void ToggleExpand(Guid runId)
    {
        if (!_expandedRunIds.Remove(runId))
            _expandedRunIds.Add(runId);
    }

    private async Task OpenCreateOnDemandModalAsync()
    {
        var parameters = new DialogParameters<TaskEditModal>
        {
            { x => x.ExistingTask, null },
            { x => x.IsOnDemand, true }
        };
        var dialog = await DialogService.ShowAsync<TaskEditModal>("Save On-Demand Prompt", parameters, DefaultDialogOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadOnDemandTasksAsync();
            StateHasChanged();
        }
    }

    private async Task OpenEditOnDemandModalAsync(ScheduledTask task)
    {
        var parameters = new DialogParameters<TaskEditModal>
        {
            { x => x.ExistingTask, task },
            { x => x.IsOnDemand, true }
        };
        var dialog = await DialogService.ShowAsync<TaskEditModal>("Edit On-Demand Prompt", parameters, DefaultDialogOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadOnDemandTasksAsync();
            StateHasChanged();
        }
    }

    private async Task ConfirmDeleteOnDemandAsync(ScheduledTask task)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Delete Prompt",
            $"Delete '{task.Name}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            var success = await TaskSvc.DeleteTaskAsync(task.Id, Session.UserId);
            if (success)
            {
                _onDemandTasks?.Remove(task);
                StateHasChanged();
                Snackbar.Add("Prompt deleted", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to delete prompt", Severity.Error);
            }
        }
    }

    private async Task RunNowAsync(ScheduledTask task)
    {
        // 1. Create run row with Status="running"
        var run = new FortressAI.Shared.Models.ScheduledTaskRun
        {
            Id = Guid.NewGuid(),
            TaskId = task.Id,
            StartedAt = DateTime.UtcNow,
            Status = "running"
        };
        await using var ctx = await DbFactory.CreateDbContextAsync();
        ctx.ScheduledTaskRuns.Add(run);
        await ctx.SaveChangesAsync();

        // 2. Optimistic UI update
        task.LastRunAt = DateTime.UtcNow;
        StateHasChanged();
        Snackbar.Add($"Task '{task.Name}' started — check History for results.", Severity.Info);

        // Capture values for use inside background thread (avoid closure over task object)
        var taskId = task.Id;
        var taskName = task.Name;
        var taskPrompt = task.Prompt;
        var taskMode = task.TaskMode;
        var alertOnCompletion = task.AlertOnCompletion;
        var alertOnFailure = task.AlertOnFailure;
        var userId = Session.UserId;

        // 3. Fire-and-forget dispatch (do NOT await — don't block UI)
        _ = Task.Run(async () =>
        {
            string? resultSummary = null;
            bool success = false;
            string? errorMessage = null;

            try
            {
                var userIdStr = userId.ToString();
                var turnRequest = new FortressAI.Web.Services.TurnRequest(
                    UserId: userIdStr,
                    Message: taskPrompt,
                    IsScheduledTask: true,
                    TaskMode: taskMode
                );
                var sb = new System.Text.StringBuilder();
                await foreach (var evt in AgentRuntime.SendTurnAsync(userIdStr, turnRequest))
                {
                    if (evt.Type == "text" && !string.IsNullOrEmpty(evt.Content))
                        sb.Append(evt.Content);
                }

                resultSummary = sb.Length > 500 ? sb.ToString(0, 500) : sb.ToString();
                success = true;

                // Update run row to success
                await using var doneCtx = await DbFactory.CreateDbContextAsync();
                var savedRun = await doneCtx.ScheduledTaskRuns.FindAsync(run.Id);
                if (savedRun != null)
                {
                    savedRun.Status = "success";
                    savedRun.CompletedAt = DateTime.UtcNow;
                    savedRun.ResultSummary = resultSummary;
                    await doneCtx.SaveChangesAsync();
                }

                // FIX 1: Update task.LastRunStatus in DB so the card reflects completion
                await using var taskCtx = await DbFactory.CreateDbContextAsync();
                var dbTask = await taskCtx.ScheduledTasks.FindAsync(taskId);
                if (dbTask != null)
                {
                    dbTask.LastRunAt = DateTime.UtcNow;
                    dbTask.LastRunStatus = "success";
                    dbTask.UpdatedAt = DateTime.UtcNow;
                    await taskCtx.SaveChangesAsync();
                }
            }
            catch (Exception ex)
            {
                errorMessage = ex.Message;
                success = false;

                try
                {
                    await using var errCtx = await DbFactory.CreateDbContextAsync();
                    var savedRun = await errCtx.ScheduledTaskRuns.FindAsync(run.Id);
                    if (savedRun != null)
                    {
                        savedRun.Status = "failed";
                        savedRun.CompletedAt = DateTime.UtcNow;
                        savedRun.Error = ex.Message;
                        await errCtx.SaveChangesAsync();
                    }

                    // Update task.LastRunStatus to failed in DB
                    await using var taskErrCtx = await DbFactory.CreateDbContextAsync();
                    var dbTask = await taskErrCtx.ScheduledTasks.FindAsync(taskId);
                    if (dbTask != null)
                    {
                        dbTask.LastRunAt = DateTime.UtcNow;
                        dbTask.LastRunStatus = "failed";
                        dbTask.UpdatedAt = DateTime.UtcNow;
                        await taskErrCtx.SaveChangesAsync();
                    }
                }
                catch { /* best effort */ }
            }

            // FIX 2: Reload history tab and update task list on UI thread
            await InvokeAsync(async () =>
            {
                // Reload the full on-demand task list to pick up new LastRunStatus
                await LoadOnDemandTasksAsync();
                // Reload history so the History tab shows the new run
                await LoadHistoryAsync();
                StateHasChanged();
            });

            // FIX 3: Fire notifications (SignalR toast + conditional email)
            try
            {
                if (success && alertOnCompletion)
                {
                    await _notificationService.NotifyTaskCompletedAsync(userId, taskName, resultSummary);
                }
                else if (!success && alertOnFailure)
                {
                    await _notificationService.NotifyTaskPermanentlyFailedAsync(userId, taskName, errorMessage ?? "Unknown error");
                }
            }
            catch { /* notification errors must never bubble */ }
        });
    }

    private async Task OpenCreateModalAsync()
    {
        var parameters = new DialogParameters<TaskEditModal>
        {
            { x => x.ExistingTask, null }
        };
        var dialog = await DialogService.ShowAsync<TaskEditModal>("Create Recurring Task", parameters, DefaultDialogOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadRecurringTasksAsync();
            StateHasChanged();
        }
    }

    private async Task OpenEditModalAsync(ScheduledTask task)
    {
        var parameters = new DialogParameters<TaskEditModal>
        {
            { x => x.ExistingTask, task }
        };
        var dialog = await DialogService.ShowAsync<TaskEditModal>("Edit Task", parameters, DefaultDialogOptions);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            await LoadRecurringTasksAsync();
            StateHasChanged();
        }
    }

    private async Task TogglePauseAsync(ScheduledTask task)
    {
        bool success;
        if (task.IsActive)
            success = await TaskSvc.PauseAsync(task.Id, Session.UserId);
        else
            success = await TaskSvc.ResumeAsync(task.Id, Session.UserId);

        if (success)
        {
            task.IsActive = !task.IsActive;
            StateHasChanged();
        }
        else
        {
            Snackbar.Add("Failed to update task status", Severity.Error);
        }
    }

    private async Task ConfirmDeleteAsync(ScheduledTask task)
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Delete Task",
            $"Delete '{task.Name}'? This cannot be undone.",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed == true)
        {
            var success = await TaskSvc.DeleteTaskAsync(task.Id, Session.UserId);
            if (success)
            {
                _recurringTasks?.Remove(task);
                StateHasChanged();
                Snackbar.Add("Task deleted", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to delete task", Severity.Error);
            }
        }
    }

    private static string FormatCron(string? cron) => cron switch
    {
        "0 * * * *"   => "Hourly",
        "0 9 * * *"   => "Daily at 9am",
        "0 9 * * 1"   => "Weekly (Mondays at 9am)",
        "0 9 * * 1-5" => "Weekdays at 9am",
        null or ""    => "—",
        _             => cron
    };

    public record TaskNotificationPayload(string TaskName, string Status, string Message, string TasksUrl);

    private HubConnection? _taskHubConnection;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Session.IsAuthenticated)
        {
            await InitTaskHubAsync();
        }
    }

    private async Task InitTaskHubAsync()
    {
        try
        {
            _taskHubConnection = new HubConnectionBuilder()
                .WithUrl(NavigationManager.ToAbsoluteUri("/hubs/dashboard"))
                .WithAutomaticReconnect()
                .Build();

            _taskHubConnection.On<TaskNotificationPayload>("ReceiveTaskNotification", async (payload) =>
            {
                var severity = payload.Status == "success" ? Severity.Success : Severity.Error;
                Snackbar.Add($"Task '{payload.TaskName}': {payload.Message}", severity,
                    config =>
                    {
                        config.Action = "View";
                        config.ActionColor = Color.Primary;
                    });
                await InvokeAsync(StateHasChanged);
            });

            await _taskHubConnection.StartAsync();

            if (Session.UserId != Guid.Empty)
            {
                await _taskHubConnection.InvokeAsync("JoinUserGroup", Session.UserId.ToString());
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to connect to DashboardHub for task notifications");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_taskHubConnection is not null)
        {
            await _taskHubConnection.DisposeAsync();
        }
    }
}
