@page "/assistant-settings"
@using Microsoft.EntityFrameworkCore
@using Amazon.S3.Model
<PageTitle>Assistant Settings — FAIT</PageTitle>
@inject UserSessionService Session
@inject AssistantConfigService ConfigSvc
@inject ISnackbar Snackbar
@inject IDbContextFactory<FortressAI.Web.Data.AppDbContext> DbFactory
@inject ILogger<AssistantSettings> Logger
@inject NavigationManager Nav
@inject Amazon.S3.IAmazonS3 S3
@inject IConfiguration AppConfig

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-4">Assistant Settings</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else
    {
        <!-- Assistant Identity -->
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="mr-2" Style="vertical-align: middle;" />
                        Assistant Identity
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        Customize what your assistant is called.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudTextField @bind-Value="_assistantName" Label="Assistant Name" Variant="Variant.Outlined"
                              MaxLength="30" Class="mb-3"
                              HelperText="The name your assistant goes by" />
                <MudTextField @bind-Value="_preferredName" Label="Your Preferred Name" Variant="Variant.Outlined"
                              MaxLength="50" Class="mb-3"
                              HelperText="What the assistant calls you" />
            </MudCardContent>
        </MudCard>

        <!-- Communication Preferences -->
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Tune" Class="mr-2" Style="vertical-align: middle;" />
                        Communication Preferences
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        How your assistant communicates with you.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <MudSelect @bind-Value="_communicationStyle" Label="Communication Style" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem Value="@("concise")">Concise — Brief and to the point</MudSelectItem>
                    <MudSelectItem Value="@("balanced")">Balanced — Clear with adequate detail</MudSelectItem>
                    <MudSelectItem Value="@("detailed")">Detailed — Thorough and comprehensive</MudSelectItem>
                    <MudSelectItem Value="@("structured")">Structured — Organized with headers and sections</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_responseFormat" Label="Response Format" Variant="Variant.Outlined" Class="mb-3">
                    <MudSelectItem Value="@("mixed")">Mixed — Best format for context</MudSelectItem>
                    <MudSelectItem Value="@("bullets")">Bullets — Structured lists</MudSelectItem>
                    <MudSelectItem Value="@("prose")">Prose — Full paragraphs</MudSelectItem>
                    <MudSelectItem Value="@("technical")">Technical — Code-friendly output</MudSelectItem>
                </MudSelect>
            </MudCardContent>
        </MudCard>

        <!-- Accent Color -->
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.Palette" Class="mr-2" Style="vertical-align: middle;" />
                        Accent Color
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        Your assistant's signature color.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                <div style="display: flex; gap: var(--spacing-2, 12px); flex-wrap: wrap; align-items: center;">
                    @foreach (var (hex, label) in _colorPresets)
                    {
                        var isSelected = string.Equals(_colorHex, hex, StringComparison.OrdinalIgnoreCase);
                        <div title="@label"
                             style="@($"width: 36px; height: 36px; border-radius: 50%; background-color: {hex}; cursor: pointer; display: flex; align-items: center; justify-content: center; border: {(isSelected ? "3px solid var(--color-text-primary, #e8edf2)" : "3px solid transparent")}; box-shadow: {(isSelected ? "0 0 0 2px " + hex : "none")}; transition: transform 0.1s;")"
                             @onclick="() => _colorHex = hex">
                            @if (isSelected)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Style="color: white; font-size: 1.1rem;" />
                            }
                        </div>
                    }
                </div>
            </MudCardContent>
        </MudCard>

        <!-- Assistant Avatar -->
        <MudCard Class="mb-4" Elevation="2">
            <MudCardHeader>
                <CardHeaderContent>
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.AccountCircle" Class="mr-2" Style="vertical-align: middle;" />
                        Assistant Avatar
                    </MudText>
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        Upload a custom image for your assistant.
                    </MudText>
                </CardHeaderContent>
            </MudCardHeader>
            <MudCardContent>
                @if (!string.IsNullOrWhiteSpace(_avatarUrl))
                {
                    <div class="avatar-preview-wrapper">
                        <img src="@_avatarUrl" alt="Assistant Avatar" class="avatar-preview-img" />
                    </div>
                }
                <MudFileUpload T="IBrowserFile" FilesChanged="HandleAvatarUpload" Accept=".jpg,.jpeg,.png,.gif,.webp" MaximumFileCount="1">
                    <ActivatorContent>
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" Disabled="@_avatarUploading">
                            @(_avatarUploading ? "Uploading..." : "Upload Avatar")
                        </MudButton>
                    </ActivatorContent>
                </MudFileUpload>
                @if (_avatarError != null)
                {
                    <MudText Color="Color.Error" Typo="Typo.caption">@_avatarError</MudText>
                }
            </MudCardContent>
        </MudCard>

        <!-- Save -->
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveSettings" Disabled="_saving"
                   StartIcon="@Icons.Material.Filled.Save" Size="Size.Large">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
            Save Settings
        </MudButton>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private bool _saving = false;

    private string _assistantName = "Assistant";
    private string _preferredName = string.Empty;
    private string _communicationStyle = "balanced";
    private string _responseFormat = "mixed";
    private string _colorHex = "#d4af37";

    private readonly (string hex, string label)[] _colorPresets = new[]
    {
        ("#d4af37", "Gold"),
        ("#4fc3f7", "Blue"),
        ("#81c784", "Green"),
        ("#ff8a65", "Orange"),
        ("#ce93d8", "Purple"),
        ("#ef9a9a", "Rose"),
    };

    private string? _avatarUrl;
    private bool _avatarUploading = false;
    private string? _avatarError;

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated)
        {
            return;
        }

        var config = await ConfigSvc.GetOrCreateConfigAsync(Session.UserId);
        _assistantName = config.AssistantName;
        _preferredName = config.PreferredName ?? string.Empty;
        // Normalize to lowercase — onboarding wizard writes PascalCase ("Balanced"), dropdowns use lowercase
        _communicationStyle = !string.IsNullOrWhiteSpace(config.CommunicationStyle) ? config.CommunicationStyle.ToLowerInvariant() : "balanced";
        _responseFormat = !string.IsNullOrWhiteSpace(config.ResponseFormat) ? config.ResponseFormat.ToLowerInvariant() : "mixed";
        _colorHex = config.ColorHex;
        _avatarUrl = config.AvatarUrl;

        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && !Session.IsAuthenticated)
        {
            Nav.NavigateTo("/chat");
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var config = await db.UserAssistantConfigs.FirstOrDefaultAsync(c => c.UserId == Session.UserId);
            if (config == null)
            {
                config = new FortressAI.Shared.Models.UserAssistantConfig { UserId = Session.UserId };
                db.UserAssistantConfigs.Add(config);
            }
            config.AssistantName = _assistantName;
            config.PreferredName = string.IsNullOrWhiteSpace(_preferredName) ? null : _preferredName.Trim();
            config.CommunicationStyle = _communicationStyle;
            config.ResponseFormat = _responseFormat;
            config.ColorHex = _colorHex;
            config.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            Logger.LogInformation("Saved assistant settings for user {UserId}", Session.UserId);
            Snackbar.Add("Settings saved", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error saving assistant settings for user {UserId}", Session.UserId);
            Snackbar.Add($"Error saving: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task HandleAvatarUpload(IBrowserFile file)
    {
        _avatarError = null;
        if (file.Size > 2 * 1024 * 1024)
        {
            _avatarError = "File too large — maximum 2MB.";
            return;
        }
        var ext = Path.GetExtension(file.Name).ToLowerInvariant();
        if (ext is not (".jpg" or ".jpeg" or ".png" or ".gif" or ".webp"))
        {
            _avatarError = "Unsupported format. Use JPG, PNG, GIF, or WebP.";
            return;
        }
        _avatarUploading = true;
        StateHasChanged();
        try
        {
            var bucket = AppConfig["WORKSPACE_S3_BUCKET"] ?? "fortress-user-workspaces";
            var s3Prefix = AppConfig["WORKSPACE_S3_PREFIX"] ?? "";
            // Normalize prefix: ensure trailing slash so key is always prefix + workspaces/...
            if (!string.IsNullOrEmpty(s3Prefix) && !s3Prefix.EndsWith('/'))
                s3Prefix += '/';
            var fileName = $"{Guid.NewGuid()}{ext}";
            var key = $"{s3Prefix}workspaces/{Session.UserId}/avatar/{fileName}";

            // Delete old avatar from S3 if exists
            if (!string.IsNullOrWhiteSpace(_avatarUrl))
            {
                try
                {
                    var oldKey = ExtractS3Key(_avatarUrl, bucket);
                    if (!string.IsNullOrWhiteSpace(oldKey))
                        await S3.DeleteObjectAsync(bucket, oldKey);
                }
                catch (Exception ex) { Logger.LogWarning(ex, "[AvatarUpload] Failed to delete old avatar"); }
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            var putReq = new PutObjectRequest
            {
                BucketName = bucket,
                Key = key,
                InputStream = stream,
                ContentType = file.ContentType
            };
            await S3.PutObjectAsync(putReq);

            var avatarUrl = $"https://{bucket}.s3.amazonaws.com/{key}";

            // Persist to DB
            await using var db = await DbFactory.CreateDbContextAsync();
            var config = await db.UserAssistantConfigs.FirstOrDefaultAsync(c => c.UserId == Session.UserId);
            if (config == null)
            {
                config = new FortressAI.Shared.Models.UserAssistantConfig { UserId = Session.UserId };
                db.UserAssistantConfigs.Add(config);
            }
            config.AvatarUrl = avatarUrl;
            config.UpdatedAt = DateTime.UtcNow;
            await db.SaveChangesAsync();

            _avatarUrl = avatarUrl;
            Snackbar.Add("Avatar updated!", Severity.Success);
        }
        catch (Amazon.S3.AmazonS3Exception ex) when (ex.ErrorCode == "AccessDenied")
        {
            Logger.LogError(ex, "[AvatarUpload] AccessDenied — halting");
            _avatarError = "Upload failed: access denied. Contact support.";
            throw;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[AvatarUpload] Upload failed");
            _avatarError = "Upload failed. Please try again.";
        }
        finally
        {
            _avatarUploading = false;
            StateHasChanged();
        }
    }

    private static string? ExtractS3Key(string avatarUrl, string bucket)
    {
        var prefix = $"https://{bucket}.s3.amazonaws.com/";
        if (avatarUrl.StartsWith(prefix))
            return avatarUrl[prefix.Length..];
        return null;
    }
}

<style>
    .avatar-preview-wrapper {
        margin-bottom: var(--space-3, 0.75rem);
    }

    .avatar-preview-img {
        width: var(--avatar-size-lg, 80px);
        height: var(--avatar-size-lg, 80px);
        border-radius: var(--radius-full, 50%);
        object-fit: cover;
        border: var(--border-width-thin, 2px) solid var(--color-accent, #d4af37);
    }
</style>
