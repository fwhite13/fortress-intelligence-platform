@page "/memory"
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@implements IAsyncDisposable
<PageTitle>Memory — FAIT</PageTitle>
@inject UserSessionService Session
@inject IMemoryFileService MemoryService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager NavigationManager
@inject IJSRuntime JS

@if (!Session.IsAuthenticated)
{
    <MudAlert Severity="Severity.Warning">Please log in to view memory topics.</MudAlert>
}
else
{
    <MudGrid>
        <!-- Left column: topic list -->
        <MudItem xs="12" md="4">
            <MudPaper Elevation="1" Class="pa-3" Style="height: calc(100vh - 120px); display: flex; flex-direction: column; overflow: hidden;">
                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Memory Topics</MudText>

                <div style="display: flex; gap: 8px; margin-bottom: 8px;">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="() => { _showNewDialog = true; _newTitle = string.Empty; _newSlug = string.Empty; _slugManuallyEdited = false; }"
                               FullWidth="true">
                        New Topic
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download"
                               Disabled="@_exportLoading"
                               OnClick="ExportAsync">
                        @if (_exportLoading)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                            <span>Exporting...</span>
                        }
                        else
                        {
                            <span>Export</span>
                        }
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.CloudDownload"
                               OnClick="OpenImportDialog">
                        Import
                    </MudButton>
                </div>

                <MudTextField @bind-Value="_searchQuery"
                              Label="Search topics"
                              Variant="Variant.Outlined"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Immediate="true"
                              Class="mb-2" />

                <div style="flex: 1; overflow-y: auto;">
                    @if (_loading)
                    {
                        <div style="display: flex; justify-content: center; padding: 16px;">
                            <MudProgressCircular Indeterminate="true" />
                        </div>
                    }
                    else if (_filteredTopics.Count == 0 && string.IsNullOrWhiteSpace(_searchQuery))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                            No memory topics yet. Your assistant will create them automatically as it learns about you, or you can create one manually.
                        </MudText>
                    }
                    else if (_filteredTopics.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                            No topics match your search.
                        </MudText>
                    }
                    else
                    {
                        <MudList T="MemoryTopic" Dense="true">
                            @foreach (var topic in _filteredTopics)
                            {
                                var localTopic = topic;
                                <MudListItem T="MemoryTopic"
                                             OnClick="() => SelectTopicAsync(localTopic)"
                                             Style="@(_selectedSlug == localTopic.Slug ? "background: var(--mud-palette-action-hover);" : "cursor: pointer;")">
                                    <div>
                                        <MudText Typo="Typo.body1" Style="font-weight: var(--font-bold);">@localTopic.Title</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@TimeAgo(localTopic.UpdatedAt)</MudText>
                                    </div>
                                </MudListItem>
                            }
                        </MudList>
                    }
                </div>
            </MudPaper>
        </MudItem>

        <!-- Right column: viewer/editor -->
        <MudItem xs="12" md="8">
            <MudPaper Elevation="1" Class="pa-4" Style="height: calc(100vh - 120px); display: flex; flex-direction: column; overflow: hidden;">
                @if (_selectedSlug == null)
                {
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                        <MudText Color="Color.Secondary">Select a topic to view or edit.</MudText>
                    </div>
                }
                else if (_contentLoading)
                {
                    <div style="display: flex; align-items: center; justify-content: center; height: 100%;">
                        <MudProgressCircular Indeterminate="true" />
                    </div>
                }
                else
                {
                    <div style="display: flex; flex-direction: column; height: 100%;">
                        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 12px;">
                            <MudText Typo="Typo.h6" Style="color: var(--color-gold);">@_selectedTitle</MudText>
                            <div style="display: flex; gap: 8px;">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Save"
                                           OnClick="SaveTopicAsync">
                                    Save
                                </MudButton>
                                <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                           StartIcon="@Icons.Material.Filled.Delete"
                                           OnClick="ConfirmDeleteAsync">
                                    Delete
                                </MudButton>
                            </div>
                        </div>

                        <div style="flex: 1; overflow: auto;">
                            <MudTextField @bind-Value="_editorContent"
                                          @oninput="OnEditorInput"
                                          Label="@_selectedTitle"
                                          Variant="Variant.Outlined"
                                          Lines="24"
                                          FullWidth="true"
                                          AutoGrow="true" />
                        </div>
                    </div>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <!-- New Topic Dialog -->
    @if (_showNewDialog)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200">
            <MudCard Style="min-width: 400px; padding: 16px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">New Memory Topic</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudTextField @bind-Value="_newTitle"
                                  @oninput="OnNewTitleInput"
                                  Label="Title"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  Class="mb-3" />
                    <MudTextField @bind-Value="_newSlug"
                                  @oninput="OnNewSlugInput"
                                  Label="Slug (auto-generated)"
                                  Variant="Variant.Outlined"
                                  Required="true"
                                  HelperText="Lowercase, hyphens only (e.g. my-topic)" />
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               OnClick="CreateTopicAsync"
                               Disabled="@(string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newSlug))">
                        Create
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               OnClick="() => _showNewDialog = false">
                        Cancel
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudOverlay>
    }

    <!-- Import Memory Dialog (ADO#4053) -->
    @if (_showImportDialog)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200">
            <MudCard Style="min-width: 500px; max-width: 700px; max-height: 90vh; padding: 16px; display: flex; flex-direction: column;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Import Memory</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent Style="flex: 1; overflow-y: auto; min-height: 0;">
                    @if (_importStep == 1)
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Copy this prompt and paste it into Claude, ChatGPT, or any other AI to export your memories:
                        </MudText>
                        <MudPaper Elevation="0" Class="pa-3 mb-3" Style="background: var(--mud-palette-background-grey); border-radius: 4px;">
                            <MudText Typo="Typo.body2" Style="font-family: monospace; white-space: pre-wrap;">@_importPrompt</MudText>
                        </MudPaper>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.ContentCopy"
                                   OnClick="CopyImportPromptAsync">
                            @(_importPromptCopied ? "Copied!" : "Copy Prompt")
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Class="mb-3">
                            Paste the exported content from your other AI below:
                        </MudText>
                        <MudTextField @bind-Value="_importContent"
                                      Label="Paste exported memory here"
                                      Variant="Variant.Outlined"
                                      Lines="12"
                                      FullWidth="true"
                                      Disabled="@_importLoading" />
                        @if (_importError != null)
                        {
                            <MudAlert Severity="Severity.Error" Class="mt-2">@_importError</MudAlert>
                        }
                    }
                </MudCardContent>
                <MudCardActions>
                    @if (_importStep == 1)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="() => _importStep = 2">
                            Next: Paste Content
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="RunImportAsync"
                                   Disabled="@(string.IsNullOrWhiteSpace(_importContent) || _importLoading)">
                            @if (_importLoading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Importing...</span>
                            }
                            else
                            {
                                <span>Import</span>
                            }
                        </MudButton>
                        <MudButton Variant="Variant.Outlined"
                                   OnClick="() => _importStep = 1"
                                   Disabled="@_importLoading">
                            Back
                        </MudButton>
                    }
                    <MudButton Variant="Variant.Text"
                               OnClick="CloseImportDialog"
                               Disabled="@_importLoading">
                        Cancel
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudOverlay>
    }

    <!-- Delete Confirmation Dialog -->
    @if (_showDeleteConfirm)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="1200">
            <MudCard Style="min-width: 400px; padding: 16px;">
                <MudCardHeader>
                    <CardHeaderContent>
                        <MudText Typo="Typo.h6">Delete Topic</MudText>
                    </CardHeaderContent>
                </MudCardHeader>
                <MudCardContent>
                    <MudText>Delete topic '@_selectedTitle'? This cannot be undone.</MudText>
                </MudCardContent>
                <MudCardActions>
                    <MudButton Variant="Variant.Filled" Color="Color.Error"
                               OnClick="DeleteTopicAsync">
                        Delete
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               OnClick="() => _showDeleteConfirm = false">
                        Cancel
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudOverlay>
    }
}

@code {
    private List<MemoryTopic> _topics = new();
    private List<MemoryTopic> _filteredTopics => string.IsNullOrWhiteSpace(_searchQuery)
        ? _topics
        : _topics.Where(t => t.Title.Contains(_searchQuery, StringComparison.OrdinalIgnoreCase)).ToList();
    private string _searchQuery = string.Empty;
    private bool _loading = true;
    private bool _contentLoading = false;
    private string? _selectedSlug;
    private string? _selectedTitle;
    private string _editorContent = string.Empty;
    private bool _isDirty = false;
    private bool _showNewDialog = false;
    private bool _showDeleteConfirm = false;
    private string _newTitle = string.Empty;
    private string _newSlug = string.Empty;
    private bool _slugManuallyEdited = false;
    private bool _exportLoading = false;
    private IDisposable? _locationChangingHandler;

    // Import memory (ADO#4053)
    private bool _showImportDialog = false;
    private int _importStep = 1;
    private string _importContent = string.Empty;
    private bool _importLoading = false;
    private bool _importPromptCopied = false;
    private string? _importError = null;
    private const string _importPrompt = @"Export all of my stored memories and any context you've learned about me from past conversations. Preserve my words verbatim where possible, especially for instructions and preferences.

## Categories (output in this order):

1. **Instructions**: Rules I've explicitly asked you to follow going forward — tone, format, style, ""always do X"", ""never do Y"", and corrections to your behavior. Only include rules from stored memories, not from conversations.

2. **Identity**: Name, age, location, education, family, relationships, languages, and personal interests.

3. **Career**: Current and past roles, companies, and general skill areas.

4. **Projects**: Projects I meaningfully built or committed to. Ideally ONE entry per project. Include what it does, current status, and any key decisions. Use the project name or a short descriptor as the first words of the entry.

5. **Preferences**: Opinions, tastes, and working-style preferences that apply broadly.

## Format:

Use section headers for each category. Within each category, list one entry per line, sorted by oldest date first. Format each line as:

[YYYY-MM-DD] - Entry content here.

If no date is known, use [unknown] instead.

## Output:
- Wrap the entire export in a single code block for easy copying.
- After the code block, state whether this is the complete set or if more remain.";

    protected override async Task OnInitializedAsync()
    {
        if (!Session.IsAuthenticated) return;

        _locationChangingHandler = NavigationManager.RegisterLocationChangingHandler(OnLocationChanging);
        await LoadTopicsAsync();
    }

    private async ValueTask OnLocationChanging(LocationChangingContext context)
    {
        if (_isDirty)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Unsaved Changes",
                $"You have unsaved changes to '{_selectedTitle}'. Leave without saving?",
                yesText: "Leave",
                cancelText: "Stay");
            if (confirmed != true)
            {
                context.PreventNavigation();
            }
        }
    }

    private async Task LoadTopicsAsync()
    {
        _loading = true;
        try
        {
            _topics = await MemoryService.GetTopicsAsync(Session.UserId);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SelectTopicAsync(MemoryTopic topic)
    {
        if (_isDirty && _selectedSlug != null)
        {
            var confirmed = await DialogService.ShowMessageBox(
                "Unsaved Changes",
                $"You have unsaved changes to '{_selectedTitle}'. Discard them?",
                yesText: "Discard",
                cancelText: "Keep editing");
            if (confirmed != true) return;
        }

        _selectedSlug = topic.Slug;
        _selectedTitle = topic.Title;
        _isDirty = false;
        await LoadTopicContentAsync(topic.Slug);
    }

    private async Task LoadTopicContentAsync(string slug)
    {
        _contentLoading = true;
        _editorContent = string.Empty;
        try
        {
            var content = await MemoryService.GetTopicContentAsync(Session.UserId, slug);
            _editorContent = content ?? string.Empty;
            _isDirty = false;
        }
        finally
        {
            _contentLoading = false;
        }
    }

    private void OnEditorInput(ChangeEventArgs e)
    {
        _editorContent = e.Value?.ToString() ?? string.Empty;
        _isDirty = true;
    }

    private async Task SaveTopicAsync()
    {
        if (_selectedSlug == null || _selectedTitle == null) return;
        await MemoryService.WriteTopicAsync(Session.UserId, _selectedSlug, _selectedTitle, _editorContent);
        _isDirty = false;
        Snackbar.Add("Saved.", Severity.Success);
        await LoadTopicsAsync();
    }

    private void ConfirmDeleteAsync()
    {
        _showDeleteConfirm = true;
    }

    private async Task DeleteTopicAsync()
    {
        if (_selectedSlug == null) return;
        _showDeleteConfirm = false;
        await MemoryService.DeleteTopicAsync(Session.UserId, _selectedSlug);
        _selectedSlug = null;
        _selectedTitle = null;
        _editorContent = string.Empty;
        _isDirty = false;
        Snackbar.Add("Topic deleted.", Severity.Info);
        await LoadTopicsAsync();
    }

    private void OnNewTitleInput(ChangeEventArgs e)
    {
        _newTitle = e.Value?.ToString() ?? string.Empty;
        if (!_slugManuallyEdited)
        {
            _newSlug = GenerateSlug(_newTitle);
        }
    }

    private void OnNewSlugInput(ChangeEventArgs e)
    {
        _newSlug = e.Value?.ToString() ?? string.Empty;
        _slugManuallyEdited = true;
    }

    private static string GenerateSlug(string title)
    {
        if (string.IsNullOrWhiteSpace(title)) return string.Empty;
        var slug = title.ToLowerInvariant()
            .Replace(' ', '-');
        // Strip non-alphanumeric except hyphens
        var clean = new System.Text.StringBuilder();
        foreach (var c in slug)
        {
            if (char.IsLetterOrDigit(c) || c == '-')
                clean.Append(c);
        }
        // Collapse multiple hyphens
        var result = System.Text.RegularExpressions.Regex.Replace(clean.ToString(), "-+", "-").Trim('-');
        return result;
    }

    private async Task CreateTopicAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTitle) || string.IsNullOrWhiteSpace(_newSlug)) return;
        var slug = _newSlug.Trim();
        var title = _newTitle.Trim();
        if (slug.Equals("memory", StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("\"memory\" is a reserved slug. Choose a different title.", Severity.Error);
            _showNewDialog = true;
            return;
        }
        _showNewDialog = false;
        await MemoryService.WriteTopicAsync(Session.UserId, slug, title, string.Empty);
        await LoadTopicsAsync();
        // Select the new topic
        var newTopic = _topics.FirstOrDefault(t => t.Slug == slug);
        if (newTopic != null)
        {
            _selectedSlug = newTopic.Slug;
            _selectedTitle = newTopic.Title;
            _isDirty = false;
            await LoadTopicContentAsync(newTopic.Slug);
        }
        Snackbar.Add($"Topic '{title}' created.", Severity.Success);
    }

    private async Task ExportAsync()
    {
        _exportLoading = true;
        StateHasChanged();
        try
        {
            await Task.Delay(50);
            NavigationManager.NavigateTo($"/api/memory/export", forceLoad: true);
        }
        finally
        {
            await Task.Delay(1500);
            _exportLoading = false;
            StateHasChanged();
        }
    }

    private static string TimeAgo(DateTime dt)
    {
        var diff = DateTime.UtcNow - dt.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "just now";
        if (diff.TotalHours < 1) return $"{(int)diff.TotalMinutes}m ago";
        if (diff.TotalDays < 1) return $"{(int)diff.TotalHours}h ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays}d ago";
        return dt.ToString("MMM d");
    }

    private void OpenImportDialog()
    {
        _showImportDialog = true;
        _importStep = 1;
        _importContent = string.Empty;
        _importLoading = false;
        _importPromptCopied = false;
        _importError = null;
    }

    private void CloseImportDialog()
    {
        _showImportDialog = false;
    }

    private async Task CopyImportPromptAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", _importPrompt);
            _importPromptCopied = true;
            Snackbar.Add("Prompt copied — paste into your AI.", Severity.Info);
            await Task.Delay(2000);
            _importPromptCopied = false;
            StateHasChanged();
        }
        catch
        {
            // Clipboard API might be blocked — silently fall through
        }
    }

    private async Task RunImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importContent)) return;
        _importLoading = true;
        _importError = null;
        StateHasChanged();
        try
        {
            var result = await MemoryService.ImportMemoryAsync(Session.UserId, _importContent);
            _showImportDialog = false;
            await LoadTopicsAsync();
            Snackbar.Add($"Import complete — {result.Chunks} chunks added to memory.", Severity.Success);
        }
        catch (Exception ex)
        {
            _importError = $"Import failed: {ex.Message}";
        }
        finally
        {
            _importLoading = false;
            StateHasChanged();
        }
    }

    public ValueTask DisposeAsync()
    {
        _locationChangingHandler?.Dispose();
        return ValueTask.CompletedTask;
    }
}
