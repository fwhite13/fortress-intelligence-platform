@page "/workspace"
@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@using Microsoft.EntityFrameworkCore
@inject UserSessionService Session
@inject IWorkspaceFileService WorkspaceFileSvc
@inject IWorkspaceUploadService UploadSvc
@inject ChatService ChatSvc
@inject ChatLayoutState LayoutState
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<WorkspaceFiles> Logger
@inject IDbContextFactory<FortressAI.Web.Data.AppDbContext> DbFactory
@implements IDisposable

<PageTitle>Workspace — FAIT</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <MudText Typo="Typo.h4" Class="mb-4">Workspace</MudText>

    @if (!Session.IsAuthenticated)
    {
        <MudAlert Severity="Severity.Warning">Please log in to view your workspace.</MudAlert>
    }
    else
    {
        <MudTabs Elevation="0" ApplyEffectsToContainer="true" PanelClass="pt-4"
                 @bind-ActivePanelIndex="_activeTab">
            <MudTabPanel Text="Files">
                @* ── Toolbar ── *@
                <div class="workspace-toolbar">
                    <MudButton StartIcon="@Icons.Material.Filled.CreateNewFolder"
                               Variant="Variant.Outlined"
                               Size="Size.Small"
                               OnClick="@ShowNewFolderInput"
                               Class="workspace-toolbar-btn">
                        New Folder
                    </MudButton>
                    <label for="fileUploadInput" class="workspace-toolbar-upload-label">
                        <MudButton StartIcon="@Icons.Material.Filled.Upload"
                                   Variant="Variant.Outlined"
                                   Size="Size.Small"
                                   Disabled="@_uploading"
                                   Class="workspace-toolbar-btn"
                                   HtmlTag="span">
                            @if (_uploading)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Uploading...</span>
                            }
                            else
                            {
                                <span>Upload</span>
                            }
                        </MudButton>
                    </label>
                    <InputFile id="fileUploadInput" multiple OnChange="HandleFilesSelected"
                               style="display:none" />
                </div>

                @* ── Breadcrumb ── *@
                @if (_breadcrumb.Count > 0)
                {
                    <div class="workspace-breadcrumb">
                        <MudLink OnClick="@(() => NavigateToFolder(null, null))"
                                 Class="workspace-breadcrumb-link">
                            Root
                        </MudLink>
                        @foreach (var (id, name) in _breadcrumb)
                        {
                            var localId = id;
                            var localName = name;
                            <MudText Class="workspace-breadcrumb-sep">/</MudText>
                            @if (id == _currentFolderId)
                            {
                                <MudText Class="workspace-breadcrumb-current">@localName</MudText>
                            }
                            else
                            {
                                <MudLink OnClick="@(() => NavigateToBreadcrumb(localId))"
                                         Class="workspace-breadcrumb-link">
                                    @localName
                                </MudLink>
                            }
                        }
                    </div>
                }

                @* ── New folder inline input ── *@
                @if (_showNewFolderInput)
                {
                    <div class="workspace-newfolder-row">
                        <MudTextField @bind-Value="_newFolderName"
                                      Placeholder="Folder name"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      @onkeydown="HandleNewFolderKeyDown"
                                      @ref="_newFolderField"
                                      Class="workspace-newfolder-input" />
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="CreateFolder" Class="workspace-newfolder-confirm">
                            Create
                        </MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Text"
                                   OnClick="@(() => _showNewFolderInput = false)">
                            Cancel
                        </MudButton>
                    </div>
                }

                @* ── Per-file upload progress ── *@
                @if (_uploadProgress.Count > 0)
                {
                    <div class="workspace-upload-progress">
                        @foreach (var kv in _uploadProgress)
                        {
                            <div class="workspace-upload-item">
                                <MudProgressLinear Value="@kv.Value" Color="Color.Primary" Class="workspace-upload-bar" />
                                <MudText Typo="Typo.caption" Class="workspace-upload-name">@kv.Key</MudText>
                            </div>
                        }
                    </div>
                }

                @* ── Bulk actions toolbar ── *@
                @if (_selectedFileIds.Count > 0)
                {
                    <div class="workspace-bulk-actions">
                        <MudText Typo="Typo.body2">@_selectedFileIds.Count selected</MudText>
                        <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                   Variant="Variant.Filled"
                                   Color="Color.Error"
                                   Size="Size.Small"
                                   OnClick="BulkDeleteSelected">
                            Delete Selected (@_selectedFileIds.Count)
                        </MudButton>
                        <MudButton Variant="Variant.Text"
                                   Size="Size.Small"
                                   OnClick="@(() => _selectedFileIds.Clear())">
                            Clear Selection
                        </MudButton>
                    </div>
                }

                @if (_loadingFiles)
                {
                    <div class="workspace-loading">
                        <MudProgressCircular Indeterminate="true" />
                    </div>
                }
                else
                {
                    @* ── Folders ── *@
                    @if (_folders.Count > 0)
                    {
                        <MudTable Items="@_folders" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="workspace-folder-table">
                            <HeaderContent>
                                <MudTh>Name</MudTh>
                                <MudTh>Created</MudTh>
                                <MudTh Class="workspace-actions-col">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var folder = context;
                                }
                                <MudTd>
                                    <div @oncontextmenu="@(e => ShowFolderContextMenu(e, folder))"
                                         @oncontextmenu:preventDefault="true"
                                         @ondragover="@(e => OnDragOverFolder(e, folder))"
                                         @ondragover:preventDefault="true"
                                         @ondrop="@(e => OnDropOnFolder(folder))"
                                         class="@(_dragOverFolderId == folder.Id ? "workspace-drag-over" : "")">
                                        @if (_renamingFolderId == folder.Id)
                                        {
                                            <div class="workspace-file-name-cell">
                                                <MudIcon Icon="@Icons.Material.Filled.Folder"
                                                         Size="Size.Small" Class="mr-1 workspace-folder-icon" />
                                                <MudTextField @bind-Value="_renameValue"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              @onkeydown="HandleRenameKeyDown"
                                                              @onblur="CommitFolderRename"
                                                              Immediate="true"
                                                              Class="workspace-rename-input" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div @ondblclick="@(() => StartFolderRename(folder))">
                                                <MudLink OnClick="@(() => NavigateToFolder(folder.Id, folder.Name))"
                                                         Class="workspace-folder-link">
                                                    <MudIcon Icon="@Icons.Material.Filled.Folder"
                                                             Size="Size.Small" Class="mr-1 workspace-folder-icon" />
                                                    @folder.Name
                                                </MudLink>
                                            </div>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2">@folder.CreatedAt.ToString("MMM d, yyyy")</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Title="Delete folder"
                                                   OnClick="@(() => DeleteFolder(folder))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }

                    @* ── Files ── *@
                    @if (_uploads.Count > 0)
                    {
                        <MudTable Items="@_uploads" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="workspace-files-table">
                            <HeaderContent>
                                <MudTh>
                                    <MudCheckBox T="bool" Value="@_allSelected"
                                                 ValueChanged="ToggleSelectAll" />
                                </MudTh>
                                <MudTh>Name</MudTh>
                                <MudTh>Size</MudTh>
                                <MudTh>Created</MudTh>
                                <MudTh Class="workspace-actions-col">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                @{
                                    var upload = context;
                                    var isSelected = _selectedFileIds.Contains(upload.Id);
                                }
                                <MudTd>
                                    <MudCheckBox T="bool" Value="@isSelected"
                                                 ValueChanged="@(val => ToggleFileSelection(upload.Id, val))" />
                                </MudTd>
                                <MudTd>
                                    <div @oncontextmenu="@(e => ShowFileContextMenu(e, upload))"
                                         @oncontextmenu:preventDefault="true"
                                         draggable="true"
                                         @ondragstart="@(() => OnDragStart(upload))"
                                         @ondragend="OnDragEnd">
                                        @if (_renamingFileId == upload.Id)
                                        {
                                            <div class="workspace-file-name-cell">
                                                <MudIcon Icon="@GetFileIcon(upload.MimeType)"
                                                         Size="Size.Small" Class="mr-1" />
                                                <MudTextField @bind-Value="_renameValue"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              @onkeydown="HandleRenameKeyDown"
                                                              @onblur="CommitFileRename"
                                                              Immediate="true"
                                                              Class="workspace-rename-input" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="workspace-file-name-cell"
                                                 @ondblclick="@(() => StartFileRename(upload))">
                                                <MudIcon Icon="@GetFileIcon(upload.MimeType)"
                                                         Size="Size.Small" Class="mr-1" />
                                                <MudText Typo="Typo.body2">@upload.Filename</MudText>
                                            </div>
                                        }
                                    </div>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2">@FormatSize(upload.SizeBytes)</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudText Typo="Typo.body2">@upload.CreatedAt.ToString("MMM d, yyyy")</MudText>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Download"
                                                   Size="Size.Small"
                                                   Title="Download"
                                                   OnClick="@(() => DownloadFile(upload))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Size="Size.Small"
                                                   Title="Delete file"
                                                   OnClick="@(() => DeleteFile(upload))" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }

                    @* ── Empty state ── *@
                    @if (_folders.Count == 0 && _uploads.Count == 0)
                    {
                        <div class="workspace-empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Large"
                                     Class="workspace-empty-icon" />
                            <MudText Class="workspace-empty-text">
                                No files here. Upload files or create a folder to get started.
                            </MudText>
                        </div>
                    }
                }
            </MudTabPanel>
            <MudTabPanel Text="Generated">
                @if (_loading)
                {
                    <MudProgressCircular Indeterminate="true" />
                }
                else if (_artifacts.Count == 0)
                {
                    <div style="display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 64px 0; gap: 16px; color: var(--color-text-secondary); text-align: center;">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" />
                        <MudText>No files yet. Ask your assistant to create a document to get started.</MudText>
                    </div>
                }
                else
                {
                    <MudExpansionPanels MultiExpansion="true">
                        @foreach (var group in _groupedArtifacts)
                        {
                            var localGroup = group;
                            bool isFirst = localGroup == _groupedArtifacts.First();
                            <MudExpansionPanel IsInitiallyExpanded="@isFirst"
                                               Text="@localGroup.ConversationTitle"
                                               SecondaryText="@($"{localGroup.Artifacts.Count} file{(localGroup.Artifacts.Count == 1 ? "" : "s")}")">
                                <MudTable Items="@localGroup.Artifacts" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                                    <HeaderContent>
                                        <MudTh>File</MudTh>
                                        <MudTh>Size</MudTh>
                                        <MudTh>Created</MudTh>
                                        <MudTh>Actions</MudTh>
                                    </HeaderContent>
                                    <RowTemplate>
                                        @{
                                            var artifact = context;
                                            bool previewSupported = artifact.MimeType == "application/vnd.openxmlformats-officedocument.wordprocessingml.document";
                                        }
                                        <MudTd>
                                            <div style="display: flex; align-items: center; gap: 8px;">
                                                <MudIcon Icon="@GetFileIcon(artifact.MimeType)" Size="Size.Small" />
                                                <MudText Typo="Typo.body2">@artifact.Filename</MudText>
                                            </div>
                                        </MudTd>
                                        <MudTd><MudText Typo="Typo.body2">@FormatSize(artifact.SizeBytes)</MudText></MudTd>
                                        <MudTd><MudText Typo="Typo.body2">@artifact.CreatedAt.ToString("MMM d, yyyy")</MudText></MudTd>
                                        <MudTd>
                                            <MudTooltip Text="@(previewSupported ? "" : "Preview not yet supported for this file type")" Disabled="@previewSupported">
                                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                                           StartIcon="@Icons.Material.Filled.Visibility"
                                                           Disabled="@(!previewSupported)"
                                                           OnClick="@(() => PreviewArtifact(artifact))">
                                                    Preview
                                                </MudButton>
                                            </MudTooltip>
                                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                                       StartIcon="@Icons.Material.Filled.Download"
                                                       OnClick="@(() => DownloadArtifactAsync(artifact))">
                                                Download
                                            </MudButton>
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            </MudExpansionPanel>
                        }
                    </MudExpansionPanels>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@* ── Context menu ── *@
@if (_contextMenuVisible)
{
    <div class="workspace-context-menu-backdrop" @onclick="CloseContextMenu"></div>
    <div class="workspace-context-menu" style="left: @(_ctxX)px; top: @(_ctxY)px;">
        @if (_ctxFile != null)
        {
            <div class="workspace-context-menu-item" @onclick="@(() => DownloadFile(_ctxFile))">
                <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" />
                <span>Download</span>
            </div>
            <div class="workspace-context-menu-item" @onclick="@(() => { CloseContextMenu(); StartFileRename(_ctxFile); })">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                <span>Rename</span>
            </div>
            <div class="workspace-context-menu-item" @onclick="@(() => ShowMoveFilePicker(_ctxFile))">
                <MudIcon Icon="@Icons.Material.Filled.DriveFileMove" Size="Size.Small" />
                <span>Move</span>
            </div>
            <div class="workspace-context-menu-item" @onclick="@(() => ShowVersionHistory(_ctxFile))">
                <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                <span>Version History</span>
            </div>
            <div class="workspace-context-menu-divider"></div>
            <div class="workspace-context-menu-item workspace-context-menu-danger" @onclick="@(() => { var f = _ctxFile; CloseContextMenu(); DeleteFile(f); })">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                <span>Delete</span>
            </div>
        }
        else if (_ctxFolder != null)
        {
            <div class="workspace-context-menu-item" @onclick="@(() => { CloseContextMenu(); StartFolderRename(_ctxFolder); })">
                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" />
                <span>Rename</span>
            </div>
            <div class="workspace-context-menu-divider"></div>
            <div class="workspace-context-menu-item workspace-context-menu-danger" @onclick="@(() => { var f = _ctxFolder; CloseContextMenu(); DeleteFolder(f); })">
                <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" />
                <span>Delete</span>
            </div>
        }
    </div>
}

@* ── Version history panel ── *@
@if (_versionPanelVisible && _versionPanelFile != null)
{
    <div class="workspace-version-panel">
        <div class="workspace-version-panel-header">
            <MudText Typo="Typo.h6">Version History: @_versionPanelFile.Filename</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@CloseVersionPanel" />
        </div>
        @if (_versionsLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else if (_fileVersions != null)
        {
            <table class="workspace-version-table">
                <thead>
                    <tr>
                        <th>Version</th>
                        <th>Date</th>
                        <th>Source</th>
                        <th>Size</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in _fileVersions)
                    {
                        var localV = v;
                        <tr class="workspace-version-row @(v.VersionNumber == _versionPanelFile.CurrentVersion ? "workspace-version-current" : "")">
                            <td>v@(v.VersionNumber) @(v.VersionNumber == _versionPanelFile.CurrentVersion ? "(current)" : "")</td>
                            <td>@v.CreatedAt.ToString("MMM d, yyyy h:mm tt")</td>
                            <td>@v.CreatedBy</td>
                            <td>@FormatSize(v.SizeBytes)</td>
                            <td>
                                @if (v.VersionNumber != _versionPanelFile.CurrentVersion)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                               OnClick="@(() => RestoreVersion(localV))">
                                        Restore
                                    </MudButton>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
}

@* ── Move file picker panel ── *@
@if (_movePickerVisible && _movePickerFile != null)
{
    <div class="workspace-version-panel">
        <div class="workspace-version-panel-header">
            <MudText Typo="Typo.h6">Move: @_movePickerFile.Filename</MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" OnClick="@CloseMoveFilePicker" />
        </div>
        @if (_movePickerLoading)
        {
            <MudProgressLinear Indeterminate="true" />
        }
        else
        {
            <div class="workspace-move-list">
                @if (_currentFolderId != null)
                {
                    <div class="workspace-move-item" @onclick="@(() => MoveFileToFolder(null))">
                        <MudIcon Icon="@Icons.Material.Filled.Home" Size="Size.Small" />
                        <span>Root</span>
                    </div>
                }
                @if (_movePickerFolders != null)
                {
                    @foreach (var folder in _movePickerFolders)
                    {
                        var localFolder = folder;
                        <div class="workspace-move-item" @onclick="@(() => MoveFileToFolder(localFolder.Id))">
                            <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                            <span>@localFolder.Name</span>
                        </div>
                    }
                }
            </div>
        }
    </div>
}

<style>
    .workspace-context-menu-backdrop {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        z-index: 999;
    }
    .workspace-context-menu {
        position: fixed;
        background: var(--color-surface, #fff);
        border: 1px solid var(--color-border);
        border-radius: 4px;
        padding: var(--space-sm, 4px) 0;
        z-index: 1000;
        min-width: 160px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.15);
    }
    .workspace-context-menu-item {
        padding: var(--space-sm, 6px) var(--space-md, 12px);
        cursor: pointer;
        font-family: var(--font-primary, inherit);
        font-size: var(--font-size-sm, 0.875rem);
        display: flex;
        align-items: center;
        gap: var(--space-sm, 6px);
    }
    .workspace-context-menu-item:hover {
        background: rgba(0,0,0,0.06);
    }
    .workspace-context-menu-danger {
        color: var(--color-error, #d32f2f);
    }
    .workspace-context-menu-divider {
        border-top: 1px solid var(--color-border);
        margin: 4px 0;
    }
    .workspace-version-panel {
        position: fixed;
        right: 0;
        top: 0;
        height: 100%;
        width: 380px;
        background: var(--color-surface, #fff);
        border-left: 1px solid var(--color-border);
        z-index: 900;
        padding: var(--space-lg, 24px);
        overflow-y: auto;
        box-shadow: -2px 0 8px rgba(0,0,0,0.1);
    }
    .workspace-version-panel-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: var(--space-md, 16px);
    }
    .workspace-version-table {
        width: 100%;
        border-collapse: collapse;
        font-size: var(--font-size-sm, 0.875rem);
        font-family: var(--font-primary, inherit);
    }
    .workspace-version-table th,
    .workspace-version-table td {
        padding: var(--space-sm, 6px) var(--space-sm, 8px);
        text-align: left;
        border-bottom: 1px solid var(--color-border);
    }
    .workspace-version-current {
        font-weight: 600;
    }
    .workspace-version-row:hover {
        background: rgba(0,0,0,0.03);
    }
    .workspace-bulk-actions {
        display: flex;
        align-items: center;
        gap: var(--space-sm, 8px);
        padding: var(--space-sm, 8px);
        background: rgba(var(--color-primary-rgb, 25,118,210), 0.08);
        border-radius: 4px;
        margin-bottom: var(--space-sm, 8px);
    }
    .workspace-drag-over {
        background: rgba(var(--color-primary-rgb, 25,118,210), 0.1);
        outline: 2px dashed var(--color-primary);
    }
    .workspace-rename-input {
        max-width: 300px;
    }
    .workspace-move-list {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }
    .workspace-move-item {
        padding: var(--space-sm, 8px) var(--space-md, 12px);
        cursor: pointer;
        display: flex;
        align-items: center;
        gap: var(--space-sm, 8px);
        border-radius: 4px;
        font-size: var(--font-size-sm, 0.875rem);
        font-family: var(--font-primary, inherit);
    }
    .workspace-move-item:hover {
        background: rgba(0,0,0,0.06);
    }
</style>

@code {
    // ── Generated (existing) state ──────────────────────────────────────────
    private bool _loading = true;
    private int _activeTab = 0;
    private List<UserWorkspaceFile> _artifacts = new();
    private List<ArtifactGroup> _groupedArtifacts = new();
    private record ArtifactGroup(string ConversationTitle, Guid ConversationId, List<UserWorkspaceFile> Artifacts);

    // ── Files tab state ─────────────────────────────────────────────────────
    private Guid? _currentFolderId = null;
    private List<WorkspaceFolder> _folders = new();
    private List<WorkspaceUpload> _uploads = new();
    private List<(Guid Id, string Name)> _breadcrumb = new();
    private bool _showNewFolderInput = false;
    private string _newFolderName = "";
    private bool _loadingFiles = true;
    private bool _uploading = false;
    private Dictionary<string, int> _uploadProgress = new();
    private MudTextField<string>? _newFolderField;

    // ── Context menu state ──────────────────────────────────────────────────
    private bool _contextMenuVisible = false;
    private double _ctxX, _ctxY;
    private WorkspaceUpload? _ctxFile;
    private WorkspaceFolder? _ctxFolder;

    // ── Inline rename state ─────────────────────────────────────────────────
    private Guid? _renamingFileId;
    private Guid? _renamingFolderId;
    private string _renameValue = "";

    // ── Multi-select state ──────────────────────────────────────────────────
    private HashSet<Guid> _selectedFileIds = new();
    private bool _allSelected => _uploads.Count > 0 && _selectedFileIds.Count == _uploads.Count;

    // ── Drag-and-drop state ─────────────────────────────────────────────────
    private Guid? _draggingFileId;
    private Guid? _dragOverFolderId;

    // ── Version history state ───────────────────────────────────────────────
    private bool _versionPanelVisible = false;
    private WorkspaceUpload? _versionPanelFile;
    private List<WorkspaceFileVersion>? _fileVersions;
    private bool _versionsLoading = false;

    // ── Move file picker state ──────────────────────────────────────────────
    private bool _movePickerVisible = false;
    private WorkspaceUpload? _movePickerFile;
    private List<WorkspaceFolder>? _movePickerFolders;
    private bool _movePickerLoading = false;

    protected override async Task OnInitializedAsync()
    {
        Session.OnAuthStateChanged += StateHasChanged;

        if (!Session.IsAuthenticated) return;

        var filesTask = LoadFilesAsync();
        var artifactsTask = LoadArtifactsAsync();
        await Task.WhenAll(filesTask, artifactsTask);
    }

    public void Dispose()
    {
        Session.OnAuthStateChanged -= StateHasChanged;
    }

    // ── Files tab ──────────────────────────────────────────────────────────

    private async Task LoadFilesAsync()
    {
        _loadingFiles = true;
        try
        {
            _folders = await UploadSvc.GetFoldersAsync(Session.UserId, _currentFolderId);
            _uploads = await UploadSvc.GetFilesAsync(Session.UserId, _currentFolderId);
            _selectedFileIds.Clear();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] LoadFilesAsync failed");
            Snackbar.Add("Failed to load files.", Severity.Error);
        }
        finally
        {
            _loadingFiles = false;
        }
    }

    private async Task NavigateToFolder(Guid? folderId, string? folderName)
    {
        if (folderId == null)
        {
            _currentFolderId = null;
            _breadcrumb.Clear();
        }
        else
        {
            _currentFolderId = folderId;
            if (folderName != null && !_breadcrumb.Any(b => b.Id == folderId))
                _breadcrumb.Add((folderId.Value, folderName));
        }
        await LoadFilesAsync();
    }

    private async Task NavigateToBreadcrumb(Guid folderId)
    {
        var idx = _breadcrumb.FindIndex(b => b.Id == folderId);
        if (idx >= 0)
            _breadcrumb = _breadcrumb.Take(idx + 1).ToList();
        _currentFolderId = folderId;
        await LoadFilesAsync();
    }

    private void ShowNewFolderInput()
    {
        _newFolderName = "";
        _showNewFolderInput = true;
    }

    private async Task HandleNewFolderKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await CreateFolder();
        else if (e.Key == "Escape") _showNewFolderInput = false;
    }

    private async Task CreateFolder()
    {
        if (string.IsNullOrWhiteSpace(_newFolderName)) return;
        try
        {
            await UploadSvc.CreateFolderAsync(Session.UserId, _newFolderName.Trim(), _currentFolderId);
            _showNewFolderInput = false;
            _newFolderName = "";
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] CreateFolder failed");
            Snackbar.Add("Failed to create folder.", Severity.Error);
        }
    }

    private async Task DeleteFolder(WorkspaceFolder folder)
    {
        try
        {
            await UploadSvc.DeleteFolderAsync(Session.UserId, folder.Id);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] DeleteFolder failed");
            Snackbar.Add("Failed to delete folder.", Severity.Error);
        }
    }

    private async Task HandleFilesSelected(InputFileChangeEventArgs e)
    {
        _uploading = true;
        _uploadProgress.Clear();
        var files = e.GetMultipleFiles(100);

        foreach (var file in files)
        {
            if (file.Size > 52428800)
            {
                Snackbar.Add($"{file.Name} exceeds 50MB limit — skipped.", Severity.Warning);
                continue;
            }
            _uploadProgress[file.Name] = 0;
            StateHasChanged();
            try
            {
                var mimeType = string.IsNullOrEmpty(file.ContentType) ? "application/octet-stream" : file.ContentType;
                await using var stream = file.OpenReadStream(maxAllowedSize: 52428800);
                await UploadSvc.SaveUploadAsync(Session.UserId, _currentFolderId, file.Name, mimeType, stream);
                _uploadProgress[file.Name] = 100;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "[WorkspaceFiles] Upload failed for {Filename}", file.Name);
                Snackbar.Add($"Upload failed: {file.Name}", Severity.Error);
            }
        }

        _uploading = false;
        _uploadProgress.Clear();
        await LoadFilesAsync();
    }

    private async Task DownloadFile(WorkspaceUpload upload)
    {
        CloseContextMenu();
        try
        {
            var url = await UploadSvc.GetPresignedUrlAsync(upload.S3Key, 30);
            if (!string.IsNullOrEmpty(url))
                await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] Download failed for {Filename}", upload.Filename);
            Snackbar.Add("Download failed.", Severity.Error);
        }
    }

    private async Task DeleteFile(WorkspaceUpload upload)
    {
        try
        {
            await UploadSvc.DeleteFileAsync(Session.UserId, upload.Id);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] DeleteFile failed for {Filename}", upload.Filename);
            Snackbar.Add("Failed to delete file.", Severity.Error);
        }
    }

    // ── Context menu ────────────────────────────────────────────────────────

    private void ShowFileContextMenu(MouseEventArgs e, WorkspaceUpload file)
    {
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _ctxFile = file;
        _ctxFolder = null;
        _contextMenuVisible = true;
    }

    private void ShowFolderContextMenu(MouseEventArgs e, WorkspaceFolder folder)
    {
        _ctxX = e.ClientX;
        _ctxY = e.ClientY;
        _ctxFile = null;
        _ctxFolder = folder;
        _contextMenuVisible = true;
    }

    private void CloseContextMenu()
    {
        _contextMenuVisible = false;
        _ctxFile = null;
        _ctxFolder = null;
    }

    // ── Inline rename ───────────────────────────────────────────────────────

    private void StartFileRename(WorkspaceUpload file)
    {
        _renamingFileId = file.Id;
        _renamingFolderId = null;
        _renameValue = file.Filename;
    }

    private void StartFolderRename(WorkspaceFolder folder)
    {
        _renamingFolderId = folder.Id;
        _renamingFileId = null;
        _renameValue = folder.Name;
    }

    private async Task HandleRenameKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            if (_renamingFileId != null) await CommitFileRename();
            else if (_renamingFolderId != null) await CommitFolderRename();
        }
        else if (e.Key == "Escape")
        {
            _renamingFileId = null;
            _renamingFolderId = null;
        }
    }

    private async Task CommitFileRename()
    {
        if (_renamingFileId == null || string.IsNullOrWhiteSpace(_renameValue)) { _renamingFileId = null; return; }
        var fileId = _renamingFileId.Value;
        _renamingFileId = null;
        try
        {
            await UploadSvc.RenameFileAsync(Session.UserId, fileId, _renameValue.Trim());
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] RenameFile failed");
            Snackbar.Add("Rename failed.", Severity.Error);
        }
    }

    private async Task CommitFolderRename()
    {
        if (_renamingFolderId == null || string.IsNullOrWhiteSpace(_renameValue)) { _renamingFolderId = null; return; }
        var folderId = _renamingFolderId.Value;
        _renamingFolderId = null;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var folder = await db.WorkspaceFolders.FirstOrDefaultAsync(f => f.Id == folderId && f.UserId == Session.UserId);
            if (folder != null)
            {
                folder.Name = _renameValue.Trim();
                await db.SaveChangesAsync();
            }
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] RenameFolder failed");
            Snackbar.Add("Folder rename failed.", Severity.Error);
        }
    }

    // ── Multi-select ────────────────────────────────────────────────────────

    private void ToggleFileSelection(Guid fileId, bool selected)
    {
        if (selected) _selectedFileIds.Add(fileId);
        else _selectedFileIds.Remove(fileId);
    }

    private void ToggleSelectAll(bool selectAll)
    {
        if (selectAll)
            _selectedFileIds = _uploads.Select(u => u.Id).ToHashSet();
        else
            _selectedFileIds.Clear();
    }

    private async Task BulkDeleteSelected()
    {
        if (_selectedFileIds.Count == 0) return;
        try
        {
            await UploadSvc.BulkDeleteFilesAsync(Session.UserId, _selectedFileIds.ToList());
            Snackbar.Add($"Deleted {_selectedFileIds.Count} file(s).", Severity.Success);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] BulkDelete failed");
            Snackbar.Add("Bulk delete failed.", Severity.Error);
        }
    }

    // ── Drag-and-drop ───────────────────────────────────────────────────────

    private void OnDragStart(WorkspaceUpload file)
    {
        _draggingFileId = file.Id;
    }

    private void OnDragEnd()
    {
        _draggingFileId = null;
        _dragOverFolderId = null;
    }

    private void OnDragOverFolder(DragEventArgs e, WorkspaceFolder folder)
    {
        _dragOverFolderId = folder.Id;
    }

    private async Task OnDropOnFolder(WorkspaceFolder folder)
    {
        _dragOverFolderId = null;
        if (_draggingFileId == null) return;
        var fileId = _draggingFileId.Value;
        _draggingFileId = null;
        try
        {
            await UploadSvc.MoveFileAsync(Session.UserId, fileId, folder.Id);
            Snackbar.Add($"Moved file to {folder.Name}.", Severity.Success);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] Drag-move failed");
            Snackbar.Add("Move failed.", Severity.Error);
        }
    }

    // ── Version history ─────────────────────────────────────────────────────

    private async Task ShowVersionHistory(WorkspaceUpload file)
    {
        _versionPanelFile = file;
        _versionPanelVisible = true;
        _versionsLoading = true;
        _contextMenuVisible = false;
        _movePickerVisible = false;
        StateHasChanged();
        try
        {
            _fileVersions = await UploadSvc.GetFileVersionsAsync(Session.UserId, file.Id);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] GetFileVersions failed");
            Snackbar.Add("Failed to load versions.", Severity.Error);
        }
        _versionsLoading = false;
        StateHasChanged();
    }

    private void CloseVersionPanel()
    {
        _versionPanelVisible = false;
        _versionPanelFile = null;
        _fileVersions = null;
    }

    private async Task RestoreVersion(WorkspaceFileVersion version)
    {
        try
        {
            await UploadSvc.RollbackFileAsync(Session.UserId, version.FileId, version.VersionNumber);
            Snackbar.Add($"Restored to version {version.VersionNumber}", Severity.Success);
            await LoadFilesAsync();
            _versionPanelFile = _uploads.FirstOrDefault(f => f.Id == version.FileId);
            if (_versionPanelFile != null)
            {
                _fileVersions = await UploadSvc.GetFileVersionsAsync(Session.UserId, _versionPanelFile.Id);
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] RestoreVersion failed");
            Snackbar.Add("Restore failed.", Severity.Error);
        }
    }

    // ── Move file picker ────────────────────────────────────────────────────

    private async Task ShowMoveFilePicker(WorkspaceUpload file)
    {
        _movePickerFile = file;
        _movePickerVisible = true;
        _movePickerLoading = true;
        _contextMenuVisible = false;
        _versionPanelVisible = false;
        StateHasChanged();
        try
        {
            _movePickerFolders = await UploadSvc.GetFoldersAsync(Session.UserId, null);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] LoadFolders for move picker failed");
            Snackbar.Add("Failed to load folders.", Severity.Error);
        }
        _movePickerLoading = false;
        StateHasChanged();
    }

    private void CloseMoveFilePicker()
    {
        _movePickerVisible = false;
        _movePickerFile = null;
        _movePickerFolders = null;
    }

    private async Task MoveFileToFolder(Guid? folderId)
    {
        if (_movePickerFile == null) return;
        var fileId = _movePickerFile.Id;
        CloseMoveFilePicker();
        try
        {
            await UploadSvc.MoveFileAsync(Session.UserId, fileId, folderId);
            Snackbar.Add("File moved.", Severity.Success);
            await LoadFilesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] MoveFile failed");
            Snackbar.Add("Move failed.", Severity.Error);
        }
    }

    // ── Artifacts tab (unchanged logic) ────────────────────────────────────

    private async Task LoadArtifactsAsync()
    {
        _loading = true;
        try
        {
            _artifacts = await WorkspaceFileSvc.GetUserArtifactsAsync(Session.UserId);
            var grouped = _artifacts
                .GroupBy(a => a.ConversationId)
                .OrderByDescending(g => g.Max(a => a.CreatedAt));
            var result = new List<ArtifactGroup>();
            foreach (var group in grouped)
            {
                var conv = await ChatSvc.GetConversationAsync(group.Key, Session.UserId);
                var title = string.IsNullOrWhiteSpace(conv?.Title)
                    ? $"Conversation {group.Key.ToString()[..8]}"
                    : conv!.Title;
                result.Add(new ArtifactGroup(title, group.Key,
                    group.OrderByDescending(a => a.CreatedAt).ToList()));
            }
            _groupedArtifacts = result;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[WorkspaceFiles] LoadArtifactsAsync failed");
        }
        finally
        {
            _loading = false;
        }
    }

    private void PreviewArtifact(UserWorkspaceFile artifact)
    {
        NavigationManager.NavigateTo($"/chat/{artifact.ConversationId}?previewArtifact={artifact.Id}");
    }

    private async Task DownloadArtifactAsync(UserWorkspaceFile artifact)
    {
        try
        {
            var url = await WorkspaceFileSvc.GetPresignedDownloadUrlAsync(artifact.S3Key, expiryMinutes: 30);
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
        catch (Exception ex)
        {
            Snackbar.Add("Download failed. Please try again.", Severity.Error);
            Logger.LogWarning(ex, "[WorkspaceFiles] Download failed for {Filename}", artifact.Filename);
        }
    }

    // ── Helpers ────────────────────────────────────────────────────────────

    private static string GetFileIcon(string mimeType) => mimeType switch
    {
        "application/vnd.openxmlformats-officedocument.wordprocessingml.document" => Icons.Material.Filled.Description,
        "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" => Icons.Material.Filled.TableChart,
        "application/vnd.openxmlformats-officedocument.presentationml.presentation" => Icons.Material.Filled.Slideshow,
        "application/pdf" => Icons.Material.Filled.PictureAsPdf,
        "text/plain" => Icons.Material.Filled.Article,
        "application/json" => Icons.Material.Filled.DataObject,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }
}
