@inject IDialogService DialogService

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">👋 Welcome to FAIT!</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Class="mb-3">What should FAIT call you?</MudText>
        <MudTextField @bind-Value="_name" Label="Your name" Variant="Variant.Outlined"
                      MaxLength="50" Immediate="true"
                      HelperText="You can change this anytime in Settings" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Skip</MudButton>
        <MudButton OnClick="Submit" Color="Color.Primary" Variant="Variant.Filled"
                   Disabled="@string.IsNullOrWhiteSpace(_name)">Save</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = null!;

    private string _name = string.Empty;

    private void Submit() => MudDialog.Close(DialogResult.Ok(_name.Trim()));
    private void Cancel() => MudDialog.Close(DialogResult.Cancel());
}
