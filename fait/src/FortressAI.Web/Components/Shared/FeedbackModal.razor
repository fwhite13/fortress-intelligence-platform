@using Microsoft.EntityFrameworkCore
@using FortressAI.Web.Data
@using FortressAI.Web.Data.Models
@using FortressAI.Web.Services
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDbContextFactory<AppDbContext> DbFactory
@inject FeedbackDispatcher FeedbackDispatcher
@inject UserSessionService Session
@inject ILogger<FeedbackModal> _logger

<MudDialog @bind-Visible="_isOpen" Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(_type == "bug" ? "Report a Bug" : "Suggest a Feature")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudToggleGroup T="string" @bind-Value="_type" SelectionMode="SelectionMode.SingleSelection" Class="feedback-modal__toggle">
            <MudToggleItem Value="@("bug")" Class="feedback-modal__toggle-item">Bug</MudToggleItem>
            <MudToggleItem Value="@("feature")" Class="feedback-modal__toggle-item">Feature</MudToggleItem>
        </MudToggleGroup>

        <MudTextField @bind-Value="_description"
                      Label="Describe the issue or idea"
                      Lines="4"
                      Required="true"
                      Class="feedback-modal__description mt-3"
                      Placeholder="What happened? What did you expect?" />

        <MudText Typo="Typo.caption" Class="feedback-modal__page-url mt-2" Color="Color.Secondary">
            Current page: @_pageUrl
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close" Class="feedback-modal__cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="Submit"
                   Disabled="@(string.IsNullOrWhiteSpace(_description) || _isSubmitting)"
                   Class="feedback-modal__submit">
            @(_isSubmitting ? "Sending..." : "Submit")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _isOpen;
    private bool _isSubmitting;
    private string _type = "bug";
    private string _description = string.Empty;
    private string _pageUrl = string.Empty;

    private readonly DialogOptions _dialogOptions = new()
    {
        MaxWidth = MaxWidth.Small,
        FullWidth = true,
        CloseOnEscapeKey = true,
    };

    public void Open()
    {
        _pageUrl = Nav.Uri;
        _description = string.Empty;
        _type = "bug";
        _isSubmitting = false;
        _isOpen = true;
        StateHasChanged();
    }

    private void Close()
    {
        _isOpen = false;
    }

    // v1: no real-time feedback notification in Chat. Callback will reach Dashboard/Tasks users
    // (who are already in the hub group). Upgrade in v1.1 to join hub group here.

    private async Task Submit()
    {
        if (string.IsNullOrWhiteSpace(_description)) return;
        _isSubmitting = true;
        StateHasChanged();

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var submission = new FeedbackSubmission
            {
                Id = Guid.NewGuid().ToString(),
                UserId = Session.UserId.ToString(),
                Type = _type,
                Description = _description,
                PageUrl = _pageUrl,
                Status = "pending",
                CreatedAt = DateTime.UtcNow
            };
            db.FeedbackSubmissions.Add(submission);
            await db.SaveChangesAsync();
            _ = FeedbackDispatcher.DispatchToJarvisAsync(submission);
            _isOpen = false;
            Snackbar.Add("Feedback submitted! Jarvis is reviewing it now.", Severity.Success);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "Feedback submission failed");
            Snackbar.Add("Something went wrong. Please try again.", Severity.Error);
        }
        finally
        {
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}
