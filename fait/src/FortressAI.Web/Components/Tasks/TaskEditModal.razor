@using FortressAI.Shared.Models
@using FortressAI.Web.Services
@inject UserSessionService Session
@inject IScheduledTaskService TaskSvc

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">
            @(ExistingTask == null ? (IsOnDemand ? "Save On-Demand Prompt" : "Create Recurring Task") : "Edit Task")
        </MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_name" Label="Name" Required="true" MaxLength="200"
                          Variant="Variant.Outlined" />
            <MudTextField @bind-Value="_prompt" Label="Prompt" Required="true" Lines="4"
                          Variant="Variant.Outlined" />

            @if (!IsOnDemand)
            {
                <MudSelect @bind-Value="_cronPreset" Label="Schedule" T="string" Variant="Variant.Outlined">
                    <MudSelectItem Value="@("0 * * * *")">Hourly</MudSelectItem>
                    <MudSelectItem Value="@("0 9 * * *")">Daily at 9am</MudSelectItem>
                    <MudSelectItem Value="@("0 9 * * 1")">Weekly (Mondays at 9am)</MudSelectItem>
                    <MudSelectItem Value="@("0 9 * * 1-5")">Weekdays at 9am</MudSelectItem>
                    <MudSelectItem Value="@("custom")">Custom</MudSelectItem>
                </MudSelect>

                @if (_cronPreset == "custom")
                {
                    <MudTextField @bind-Value="_customCron" Label="Custom cron expression"
                                  Placeholder="0 9 * * *" Variant="Variant.Outlined" />
                }
            }

            <MudSwitch @bind-Value="_taskMode" Label="Run as task (uses CC sandbox)" Color="Color.Primary" />
            <MudSwitch @bind-Value="_alertOnCompletion" Label="Alert on completion" Color="Color.Primary" />
            <MudSwitch @bind-Value="_alertOnFailure" Label="Alert on failure" Color="Color.Warning" />

            @if (!string.IsNullOrEmpty(_validationError))
            {
                <MudAlert Severity="Severity.Error" Dense="true">@_validationError</MudAlert>
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton OnClick="SaveAsync" Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving">
            @(_saving ? "Saving..." : (ExistingTask == null ? (IsOnDemand ? "Save Prompt" : "Create") : "Save"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ScheduledTask? ExistingTask { get; set; }
    [Parameter] public bool IsOnDemand { get; set; } = false;

    private string _name = string.Empty;
    private string _prompt = string.Empty;
    private string _cronPreset = "0 9 * * *";
    private string _customCron = string.Empty;
    private bool _taskMode = false;
    private bool _alertOnCompletion = false;
    private bool _alertOnFailure = true;
    private bool _saving = false;
    private string? _validationError;

    protected override void OnParametersSet()
    {
        if (ExistingTask != null)
        {
            _name = ExistingTask.Name;
            _prompt = ExistingTask.Prompt;
            _taskMode = ExistingTask.TaskMode;
            _alertOnCompletion = ExistingTask.AlertOnCompletion;
            _alertOnFailure = ExistingTask.AlertOnFailure;

            // Map existing cron to preset or custom
            var knownPresets = new[] { "0 * * * *", "0 9 * * *", "0 9 * * 1", "0 9 * * 1-5" };
            if (ExistingTask.CronExpression != null && Array.IndexOf(knownPresets, ExistingTask.CronExpression) >= 0)
            {
                _cronPreset = ExistingTask.CronExpression;
            }
            else if (!string.IsNullOrEmpty(ExistingTask.CronExpression))
            {
                _cronPreset = "custom";
                _customCron = ExistingTask.CronExpression;
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        _validationError = null;

        if (string.IsNullOrWhiteSpace(_name))
        {
            _validationError = "Name is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_prompt))
        {
            _validationError = "Prompt is required.";
            return;
        }
        if (!IsOnDemand && _cronPreset == "custom" && string.IsNullOrWhiteSpace(_customCron))
        {
            _validationError = "Custom cron expression is required.";
            return;
        }

        var cron = (!IsOnDemand && _cronPreset == "custom") ? _customCron : _cronPreset;

        _saving = true;
        try
        {
            if (ExistingTask == null)
            {
                var dto = new CreateScheduledTaskDto
                {
                    Name = _name,
                    Prompt = _prompt,
                    ScheduleType = IsOnDemand ? "on_demand" : "recurring",
                    CronExpression = IsOnDemand ? null : cron,
                    TaskMode = _taskMode,
                    AlertOnCompletion = _alertOnCompletion,
                    AlertOnFailure = _alertOnFailure
                };
                var created = await TaskSvc.CreateTaskAsync(Session.UserId, dto);
                MudDialog.Close(DialogResult.Ok(created));
            }
            else
            {
                var dto = new UpdateScheduledTaskDto
                {
                    Name = _name,
                    Prompt = _prompt,
                    CronExpression = IsOnDemand ? null : cron,
                    TaskMode = _taskMode,
                    AlertOnCompletion = _alertOnCompletion,
                    AlertOnFailure = _alertOnFailure
                };
                var updated = await TaskSvc.UpdateTaskAsync(ExistingTask.Id, Session.UserId, dto);
                MudDialog.Close(DialogResult.Ok(updated));
            }
        }
        finally
        {
            _saving = false;
        }
    }
}
