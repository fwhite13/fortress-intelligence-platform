@using Microsoft.AspNetCore.Components.Forms
@using MudBlazor

<div class="file-upload-zone">
    <MudFileUpload T="IReadOnlyList<IBrowserFile>"
                   Accept=".html,.png,.jpg,.jpeg,.webp,.pdf"
                   MaximumFileCount="10"
                   OnFilesChanged="HandleFilesChanged">
        <ActivatorContent>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.CloudUpload"
                       Class="file-upload-btn">
                Choose Files or Drop Here (up to 10)
            </MudButton>
        </ActivatorContent>
    </MudFileUpload>

    <MudText Typo="Typo.caption" Class="file-upload-hint">@_hint</MudText>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Class="file-upload-error">@_errorMessage</MudAlert>
    }

    @if (_selectedFiles.Count > 0)
    {
        <MudList T="string" Dense="true" Class="file-upload-list">
            @foreach (var file in _selectedFiles)
            {
                var capturedFile = file;
                <MudListItem T="string">
                    <div class="file-upload-list-item">
                        <MudIcon Icon="@GetFileIcon(capturedFile.ContentType)" Color="Color.Primary" Size="Size.Small" />
                        <MudText Typo="Typo.body2">@capturedFile.Name (@FormatSize(capturedFile.Size))</MudText>
                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                       Size="Size.Small"
                                       Color="Color.Error"
                                       OnClick="@(() => RemoveFile(capturedFile))"
                                       Class="file-upload-remove-btn" />
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

@code {
    [Parameter] public EventCallback<IReadOnlyList<IBrowserFile>> OnFilesSelected { get; set; }
    [Parameter] public EventCallback<IBrowserFile> OnFileSelected { get; set; }
    [Parameter] public string[] AcceptedTypes { get; set; } = ["text/html", "image/png", "image/jpeg", "image/jpg", "image/webp", "application/pdf"];
    [Parameter] public long MaxFileSizeBytes { get; set; } = 10 * 1024 * 1024;
    [Parameter] public int MaxFiles { get; set; } = 10;
    [Parameter] public IReadOnlyList<IBrowserFile>? InitialFiles { get; set; }

    protected override void OnParametersSet()
    {
        if (InitialFiles is { Count: > 0 } && _selectedFiles.Count == 0)
        {
            _selectedFiles = InitialFiles.ToList();
        }
    }

    private List<IBrowserFile> _selectedFiles = new();
    private string _errorMessage = "";
    private string _hint => $"Accepted: HTML, PNG, JPG, WEBP, PDF — Max {MaxFileSizeBytes / 1024 / 1024}MB each, up to {MaxFiles} files";

    private async Task HandleFilesChanged(InputFileChangeEventArgs e)
    {
        _errorMessage = "";
        var newFiles = e.GetMultipleFiles(MaxFiles).ToList();

        foreach (var file in newFiles)
        {
            if (file.Size > MaxFileSizeBytes)
            {
                _errorMessage = $"'{file.Name}' exceeds the maximum size of {MaxFileSizeBytes / 1024 / 1024}MB.";
                return;
            }
            if (!AcceptedTypes.Contains(file.ContentType.ToLowerInvariant()))
            {
                _errorMessage = $"'{file.Name}': type '{file.ContentType}' is not accepted.";
                return;
            }
        }

        _selectedFiles = newFiles;

        await OnFilesSelected.InvokeAsync(_selectedFiles.AsReadOnly());

        // Deprecated single-file compat
        if (OnFileSelected.HasDelegate && _selectedFiles.Count > 0)
            await OnFileSelected.InvokeAsync(_selectedFiles[0]);
    }

    private async Task RemoveFile(IBrowserFile file)
    {
        _selectedFiles.Remove(file);
        await OnFilesSelected.InvokeAsync(_selectedFiles.AsReadOnly());
    }

    private static string GetFileIcon(string contentType) =>
        contentType.ToLowerInvariant() switch
        {
            "text/html" => Icons.Material.Filled.Code,
            "application/pdf" => Icons.Material.Filled.PictureAsPdf,
            var ct when ct.StartsWith("image/") => Icons.Material.Filled.Image,
            _ => Icons.Material.Filled.InsertDriveFile
        };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024 / 1024} MB";
    }
}
