@page "/nexus/{Id:int}/artifacts"
@attribute [Authorize]
@rendermode InteractiveServer

@inject IDbContextFactory<NexusDbContext> DbFactory
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserContextService UserContextService
@inject IDialogService DialogService
@inject IConfiguration Configuration
@inject IAdoService AdoService
@inject IAdoCredentialService AdoCredentialService
@inject ILogger<NexusArtifacts> PageLogger

@using FortressNexus.Web.Data
@using FortressNexus.Web.Models.DTOs
@using FortressNexus.Web.Models.Enums
@using FortressNexus.Web.Services
@using Microsoft.EntityFrameworkCore

<PageTitle>Work Items — NEXUS</PageTitle>

@if (_loading)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="mb-2" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" />
    </MudContainer>
}
else if (_error is not null)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    </MudContainer>
}
else if (_artifactSet is not null)
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
        <div class="d-flex align-center justify-space-between mb-4 flex-wrap gap-2">
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5">Work Items — @_submissionTitle</MudText>
                @if (_editMode)
                {
                    <MudChip T="string" Color="Color.Warning" Size="Size.Small" Class="ml-2">✏️ EDIT MODE</MudChip>
                }
            </div>
            <div class="d-flex align-center gap-2">
                @* ADO project selector — always visible to admins *@
                @if (_isAdmin)
                {
                    @if (_headerProjectsLoading)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                    }
                    else if (_headerProjects.Count > 0)
                    {
                        <MudSelect T="string"
                                   Value="@_headerSelectedProject"
                                   Label="ADO Project"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Style="min-width:180px"
                                   ValueChanged="@OnHeaderProjectChangedAsync">
                            @foreach (var proj in _headerProjects)
                            {
                                <MudSelectItem T="string" Value="@proj">@proj</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else
                    {
                        <MudTooltip Text="Could not load ADO projects — click to retry">
                            <MudButton Variant="Variant.Outlined"
                                       Size="Size.Small"
                                       Color="Color.Warning"
                                       StartIcon="@Icons.Material.Filled.Refresh"
                                       OnClick="@LoadHeaderProjectsAsync">
                                ADO Project
                            </MudButton>
                        </MudTooltip>
                    }
                }
                @if (_isEditor && !_editMode && !_alreadyPosted)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Edit"
                               Size="Size.Small"
                               OnClick="@(() => { _editMode = true; StateHasChanged(); })">
                        Edit
                    </MudButton>
                }
                @if (_editMode)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               StartIcon="@Icons.Material.Filled.CheckCircle"
                               Size="Size.Small"
                               OnClick="@(() => { _editMode = false; StateHasChanged(); })">
                        Done Editing
                    </MudButton>
                }
                @if (_isAdmin && !_alreadyPosted)
                {
                    <MudTooltip Text="@(_editMode ? "Exit edit mode to post" : (_isPosting ? "Posting..." : "Post work items to ADO"))">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@(_isPosting ? null : Icons.Material.Filled.CloudUpload)"
                                   Size="Size.Small"
                                   Disabled="@(_editMode || _isPosting)"
                                   OnClick="@OpenAdoConfirmDialogAsync">
                            @if (_isPosting)
                            {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                <span>Posting...</span>
                            }
                            else
                            {
                                <span>Post to ADO</span>
                            }
                        </MudButton>
                    </MudTooltip>
                }
                @if (_alreadyPosted)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">Posted to ADO</MudChip>
                }
            </div>
        </div>

        @* ── External Dependencies Panel ── *@
        @if (_artifactSet.ExternalDependencyCount > 0)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">
                @_artifactSet.ExternalDependencyCount external @(_artifactSet.ExternalDependencyCount == 1 ? "dependency requires" : "dependencies require") action before these WIs can be completed. These will <strong>not</strong> be posted to ADO.
            </MudAlert>

            <MudExpansionPanels Class="mb-4">
                <MudExpansionPanel Text="External Dependencies" Expanded="true">
                    @foreach (var extWi in _externalDependencies)
                    {
                        <MudCard Class="mb-2">
                            <MudCardContent>
                                <div class="d-flex align-center justify-space-between mb-1">
                                    <div>
                                        <MudText Typo="Typo.subtitle2"><strong>@extWi.ExternalOwner</strong></MudText>
                                        <MudText Typo="Typo.body1">@extWi.Title</MudText>
                                    </div>
                                    <MudButton OnClick="@(() => CopyToClipboard(extWi.Description ?? extWi.Title))"
                                               StartIcon="@Icons.Material.Outlined.ContentCopy"
                                               Size="Size.Small">
                                        Copy brief
                                    </MudButton>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(extWi.Description))
                                {
                                    <MudExpansionPanels Class="mt-1">
                                        <MudExpansionPanel Text="View brief" Dense="true">
                                            <MudText Typo="Typo.body2" Style="white-space: pre-wrap;">@extWi.Description</MudText>
                                        </MudExpansionPanel>
                                    </MudExpansionPanels>
                                }
                            </MudCardContent>
                        </MudCard>
                    }
                </MudExpansionPanel>
            </MudExpansionPanels>
        }

        @* ── WI Tree: Epic → Feature → Story → Task ── *@
        @if (_editMode)
        {
            <div class="mb-3">
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           Size="Size.Small"
                           OnClick="@AddEpic">
                    Add Epic
                </MudButton>
            </div>
        }
        <MudExpansionPanels MultiExpansion="true">
            @foreach (var epic in _epics)
            {
                <MudExpansionPanel Text="@epic.Title" Expanded="true">
                    <TitleContent>
                        <div class="d-flex align-center gap-2 flex-wrap">
                            @RenderTemplateBadge(epic)
                            @if (_editMode)
                            {
                                <MudText Typo="Typo.subtitle2" Class="mr-1"><strong>Epic:</strong></MudText>
                                <MudTextField @bind-Value="epic.Title"
                                              Variant="Variant.Outlined"
                                              Margin="Margin.Dense"
                                              Style="min-width:300px"
                                              @onblur="@(() => SaveTitle(epic))"
                                              @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") InvokeAsync(() => SaveTitle(epic)); })"
                                              @onclick:stopPropagation="true" />
                            }
                            else
                            {
                                <MudText Typo="Typo.subtitle1"><strong>Epic:</strong> @epic.Title</MudText>
                            }
                            @RenderPredecessorBadges(epic)
                            @if (_editMode)
                            {
                                <span @onclick:stopPropagation="true">
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => ConfirmDelete(epic))" />
                                </span>
                            }
                        </div>
                    </TitleContent>
                    <ChildContent>
                        @{
                            var features = GetChildren("Feature", epic.Title);
                        }
                        @foreach (var feature in features)
                        {
                            <MudPaper Elevation="0" Class="ml-4 mb-2 pa-2" Style="border-left: 3px solid var(--mud-palette-primary);">
                                <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                                    <MudIconButton Icon="@(_collapsedFeatures.Contains(feature.Id) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small"
                                                   OnClick="@(() => { if (_collapsedFeatures.Contains(feature.Id)) _collapsedFeatures.Remove(feature.Id); else _collapsedFeatures.Add(feature.Id); })"
                                                   Class="mr-1" />
                                    @RenderTemplateBadge(feature)
                                    @if (_editMode)
                                    {
                                        <MudText Typo="Typo.subtitle2" Class="mr-1"><strong>Feature:</strong></MudText>
                                        <MudTextField @bind-Value="feature.Title"
                                                      Variant="Variant.Outlined"
                                                      Margin="Margin.Dense"
                                                      Style="min-width:260px"
                                                      @onblur="@(() => SaveTitle(feature))"
                                                      @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") InvokeAsync(() => SaveTitle(feature)); })" />
                                        <MudMenu Label="Move ▾" Size="Size.Small" Dense="true">
                                            @foreach (var target in GetValidParents(feature))
                                            {
                                                <MudMenuItem OnClick="@(() => MoveWi(feature, target.Title))">@target.Title</MudMenuItem>
                                            }
                                        </MudMenu>
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Color="Color.Error"
                                                       Size="Size.Small"
                                                       OnClick="@(() => ConfirmDelete(feature))" />
                                    }
                                    else
                                    {
                                        <MudText Typo="Typo.subtitle2"><strong>Feature:</strong> @feature.Title</MudText>
                                    }
                                    @RenderPredecessorBadges(feature)
                                </div>
                                @if (!_collapsedFeatures.Contains(feature.Id))
                                {
                                    @if (_editMode)
                                    {
                                        <MudExpansionPanels Class="ml-2 mb-1">
                                            <MudExpansionPanel Text="Description ▾">
                                                <MudTextField @bind-Value="feature.Description"
                                                              Variant="Variant.Outlined"
                                                              Lines="3"
                                                              Label="Feature Description"
                                                              @onblur="@(() => SaveDescription(feature))" />
                                            </MudExpansionPanel>
                                        </MudExpansionPanels>
                                    }

                                    @foreach (var story in GetChildren("User Story", feature.Title))
                                {
                                    <MudPaper Elevation="0" Class="ml-4 mb-2 pa-2" Style="border-left: 3px solid var(--mud-palette-secondary);">
                                        <div class="d-flex align-center flex-wrap gap-2 mb-1">
                                            <MudIconButton Icon="@(_collapsedStories.Contains(story.Id) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)"
                                                           Size="Size.Small"
                                                           OnClick="@(() => { if (_collapsedStories.Contains(story.Id)) _collapsedStories.Remove(story.Id); else _collapsedStories.Add(story.Id); })"
                                                           Class="mr-1" />
                                            @RenderTemplateBadge(story)
                                            @if (_editMode)
                                            {
                                                <MudText Typo="Typo.body2" Class="mr-1"><strong>Story:</strong></MudText>
                                                <MudTextField @bind-Value="story.Title"
                                                              Variant="Variant.Outlined"
                                                              Margin="Margin.Dense"
                                                              Style="min-width:260px"
                                                              @onblur="@(() => SaveTitle(story))"
                                                              @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") InvokeAsync(() => SaveTitle(story)); })" />
                                                <MudMenu Label="Move ▾" Size="Size.Small" Dense="true">
                                                    @foreach (var target in GetValidParents(story))
                                                    {
                                                        <MudMenuItem OnClick="@(() => MoveWi(story, target.Title))">@target.Title</MudMenuItem>
                                                    }
                                                </MudMenu>
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                               Color="Color.Error"
                                                               Size="Size.Small"
                                                               OnClick="@(() => ConfirmDelete(story))" />
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body1"><strong>Story:</strong> @story.Title</MudText>
                                            }
                                            @RenderPredecessorBadges(story)
                                        </div>
                                        @if (!_collapsedStories.Contains(story.Id))
                                        {
                                        @if (_editMode)
                                        {
                                            <MudExpansionPanels Class="ml-2 mb-1">
                                                <MudExpansionPanel Text="Description ▾">
                                                    <MudTextField @bind-Value="story.Description"
                                                                  Variant="Variant.Outlined"
                                                                  Lines="3"
                                                                  Label="Story Description"
                                                                  @onblur="@(() => SaveDescription(story))" />
                                                </MudExpansionPanel>
                                                <MudExpansionPanel Text="Acceptance Criteria ▾">
                                                    @{
                                                        if (!_acLists.ContainsKey(story.Id))
                                                            _acLists[story.Id] = new List<string>();
                                                        var acItems = _acLists[story.Id];
                                                    }
                                                    @for (int acIdx = 0; acIdx < acItems.Count; acIdx++)
                                                    {
                                                        var capturedIdx = acIdx;
                                                        <div class="d-flex align-center gap-1 mb-1">
                                                            <MudTextField Value="@acItems[capturedIdx]"
                                                                          ValueChanged="@((string val) => { acItems[capturedIdx] = val; })"
                                                                          Variant="Variant.Outlined"
                                                                          Margin="Margin.Dense"
                                                                          Style="flex:1"
                                                                          @onblur="@(() => SaveAc(story))" />
                                                            <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                           Size="Size.Small"
                                                                           Color="Color.Default"
                                                                           OnClick="@(async () => { acItems.RemoveAt(capturedIdx); story.AcceptanceCriteria = string.Join('\n', acItems); await SaveAc(story); })" />
                                                        </div>
                                                    }
                                                    <MudButton Variant="Variant.Text"
                                                               Color="Color.Primary"
                                                               StartIcon="@Icons.Material.Filled.Add"
                                                               Size="Size.Small"
                                                               OnClick="@(() => { acItems.Add(""); StateHasChanged(); })">
                                                        + Add AC
                                                    </MudButton>
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }

                                        @* Tasks under this Story *@
                                        @foreach (var task in GetChildren("Task", story.Title))
                                        {
                                            <div class="d-flex align-center flex-wrap gap-2 ml-4 mb-1">
                                                @RenderTemplateBadge(task)
                                                <MudIcon Icon="@Icons.Material.Filled.CheckBox" Size="Size.Small" />
                                                @if (_editMode)
                                                {
                                                    <MudTextField @bind-Value="task.Title"
                                                                  Variant="Variant.Outlined"
                                                                  Margin="Margin.Dense"
                                                                  Style="min-width:240px"
                                                                  @onblur="@(() => SaveTitle(task))"
                                                                  @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") InvokeAsync(() => SaveTitle(task)); })" />
                                                    <MudMenu Label="Move ▾" Size="Size.Small" Dense="true">
                                                        @foreach (var target in GetValidParents(task))
                                                        {
                                                            <MudMenuItem OnClick="@(() => MoveWi(task, target.Title))">@target.Title</MudMenuItem>
                                                        }
                                                    </MudMenu>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   OnClick="@(() => ConfirmDelete(task))" />
                                                }
                                                else
                                                {
                                                    <MudText Typo="Typo.body2">@task.Title</MudText>
                                                }
                                                @RenderPredecessorBadges(task)
                                            </div>
                                        }
                                        @if (_editMode)
                                        {
                                            <div class="ml-4 mt-1">
                                                <MudButton Variant="Variant.Text"
                                                           Color="Color.Default"
                                                           StartIcon="@Icons.Material.Filled.Add"
                                                           Size="Size.Small"
                                                           OnClick="@(() => AddWi("Task", story.Title))">
                                                    + Add Task
                                                </MudButton>
                                            </div>
                                        }

                                        @* Test Cases collapsible subsection *@
                                        @if (_workItems.Where(w => w.WorkItemType == "Test Case" && w.ParentTitle == story.Title).ToList() is var testCases && (testCases.Any() || _editMode))
                                        {
                                            <MudExpansionPanels Class="mt-2 ml-4">
                                                <MudExpansionPanel Expanded="false">
                                                    <TitleContent>
                                                        <MudText Typo="Typo.body2">Test Cases (@testCases.Count)</MudText>
                                                    </TitleContent>
                                                    <ChildContent>
                                                        @foreach (var tc in testCases)
                                                        {
                                                            <div class="ml-4 mb-2">
                                                                <div class="d-flex align-center gap-2">
                                                                    <MudChip T="string" Color="Color.Primary" Size="Size.Small">TC</MudChip>
                                                                    @if (_editMode)
                                                                    {
                                                                        <MudTextField @bind-Value="tc.Title"
                                                                                      Variant="Variant.Outlined"
                                                                                      Margin="Margin.Dense"
                                                                                      Style="min-width:220px"
                                                                                      @onblur="@(() => SaveTitle(tc))"
                                                                                      @onkeydown="@((KeyboardEventArgs e) => { if (e.Key == "Enter") InvokeAsync(() => SaveTitle(tc)); })" />
                                                                        <MudMenu Label="Move ▾" Size="Size.Small" Dense="true">
                                                                            @foreach (var target in GetValidParents(tc))
                                                                            {
                                                                                <MudMenuItem OnClick="@(() => MoveWi(tc, target.Title))">@target.Title</MudMenuItem>
                                                                            }
                                                                        </MudMenu>
                                                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                                       Color="Color.Error"
                                                                                       Size="Size.Small"
                                                                                       OnClick="@(() => ConfirmDelete(tc))" />
                                                                    }
                                                                    else
                                                                    {
                                                                        <MudText Typo="Typo.body2">@tc.Title</MudText>
                                                                    }
                                                                </div>
                                                            </div>
                                                        }
                                                        @if (_editMode)
                                                        {
                                                            <div class="ml-4 mt-1">
                                                                <MudButton Variant="Variant.Text"
                                                                           Color="Color.Primary"
                                                                           StartIcon="@Icons.Material.Filled.Add"
                                                                           Size="Size.Small"
                                                                           OnClick="@(() => AddWi("Test Case", story.Title))">
                                                                    + Add Test Case
                                                                </MudButton>
                                                            </div>
                                                        }
                                                    </ChildContent>
                                                </MudExpansionPanel>
                                            </MudExpansionPanels>
                                        }
                                        }
                                    </MudPaper>
                                }
                                @if (_editMode)
                                {
                                    <div class="ml-4 mt-1">
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Secondary"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   Size="Size.Small"
                                                   OnClick="@(() => AddWi("User Story", feature.Title))">
                                            + Add Story
                                        </MudButton>
                                    </div>
                                }
                                }
                            </MudPaper>
                        }
                        @if (_editMode)
                        {
                            <div class="ml-4 mt-2">
                                <MudButton Variant="Variant.Text"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Size="Size.Small"
                                           OnClick="@(() => AddWi("Feature", epic.Title))">
                                    + Add Feature
                                </MudButton>
                            </div>

                            @* Description section for Epic *@
                            <MudExpansionPanels Class="ml-4 mt-1">
                                <MudExpansionPanel Text="Description ▾">
                                    <MudTextField @bind-Value="epic.Description"
                                                  Variant="Variant.Outlined"
                                                  Lines="3"
                                                  Label="Epic Description"
                                                  @onblur="@(() => SaveDescription(epic))" />
                                </MudExpansionPanel>
                            </MudExpansionPanels>
                        }
                    </ChildContent>
                </MudExpansionPanel>
            }
        </MudExpansionPanels>

        @* ── ADO Post Progress ── *@
        @if (_isPosting)
        {
            <MudPaper Class="pa-4 mt-4">
                <MudText Typo="Typo.body1" Class="mb-2">@_postingStatus</MudText>
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            </MudPaper>
        }

        @* ── ADO Post Results Panel ── *@
        @if (_postResults is not null && !_isPosting)
        {
            var createdCount = _postResults.Count(r => r.Status == "Created");
            var errorCount = _postResults.Count(r => r.Status == "Error");

            <MudPaper Class="pa-4 mt-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" />
                    <MudText Typo="Typo.h6">ADO Post Complete — @createdCount created, @errorCount errors</MudText>
                </div>

                @foreach (var result in _postResults)
                {
                    <div class="d-flex align-center gap-2 mb-1 flex-wrap">
                        <MudChip T="string" Color="Color.Secondary" Size="Size.Small">@result.WorkItemType</MudChip>
                        <MudText Typo="Typo.body2" Style="flex:1">@result.Title</MudText>
                        @if (result.Status == "Created")
                        {
                            <MudChip T="string" Color="Color.Success" Size="Size.Small">✅ Created</MudChip>
                            @if (!string.IsNullOrEmpty(result.AdoWorkItemUrl))
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.OpenInNew"
                                               Size="Size.Small"
                                               Color="Color.Primary"
                                               Href="@result.AdoWorkItemUrl"
                                               Target="_blank" />
                            }
                        }
                        else
                        {
                            <MudTooltip Text="@(result.ErrorDetail ?? "Unknown error")">
                                <MudChip T="string" Color="Color.Error" Size="Size.Small">❌ Error</MudChip>
                            </MudTooltip>
                        }
                    </div>
                }
            </MudPaper>
        }
    </MudContainer>

    @* ── ADO Confirmation Dialog ── *@
    @if (_showAdoConfirmDialog)
    {
        <MudOverlay Visible="true" DarkBackground="true" ZIndex="9" AutoClose="false">
            <MudPaper Class="pa-6" Style="min-width:400px; max-width:500px;">
                <MudText Typo="Typo.h6" Class="mb-4">Post to Azure DevOps</MudText>

                <MudTextField @bind-Value="_adoOrg"
                              Label="Organization"
                              Variant="Variant.Outlined"
                              Class="mb-3"
                              ReadOnly="true" />

                @if (_adoProjects.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="mb-3">Loading projects...</MudText>
                }
                else
                {
                    <MudSelect @bind-Value="_selectedAdoProject"
                               Label="ADO Project"
                               Variant="Variant.Outlined"
                               Class="mb-3">
                        @foreach (var proj in _adoProjects)
                        {
                            <MudSelectItem T="string" Value="@proj">@proj</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudText Typo="Typo.body1" Class="mb-4">
                    Post <strong>@(_workItems.Count(w => !w.IsExternalDependency))</strong> work items to <strong>@(_selectedAdoProject ?? "...")</strong>?
                    @if (_workItems.Any(w => w.IsExternalDependency))
                    {
                        <MudText Typo="Typo.body2" Color="Color.Warning">(@_workItems.Count(w => w.IsExternalDependency) external dependencies will be skipped.)</MudText>
                    }
                </MudText>

                <div class="d-flex justify-end gap-2">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Default"
                               OnClick="@(() => { _showAdoConfirmDialog = false; StateHasChanged(); })">
                        Cancel
                    </MudButton>
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               Disabled="@(_selectedAdoProject == null)"
                               OnClick="@PostToAdoAsync"
                               StartIcon="@Icons.Material.Filled.CloudUpload">
                        Post to ADO →
                    </MudButton>
                </div>
            </MudPaper>
        </MudOverlay>
    }
}

@code {
    [Parameter] public int Id { get; set; }

    private ArtifactSet? _artifactSet;
    private List<WorkItemRecord> _workItems = new();
    private List<WorkItemRecord> _externalDependencies = new();
    private List<WorkItemRecord> _epics = new();
    // ADO#3449 — collapse state for Features and Stories
    private HashSet<int> _collapsedFeatures = new();
    private HashSet<int> _collapsedStories = new();
    private string _submissionTitle = "";
    private bool _loading = true;
    private string? _error;

    // Edit Mode state
    private bool _editMode = false;
    private bool _isEditor = false;

    // ADO Post state
    private bool _isAdmin = false;
    private bool _isPosting = false;
    private string _postingStatus = "";
    private bool _alreadyPosted => _workItems?.Any(w => w.AdoWorkItemId != null) == true;
    private List<WorkItemRecord>? _postResults = null;

    // ADO confirmation dialog state
    private bool _showAdoConfirmDialog = false;

    // Header ADO project selector (inline, always-visible for admins)
    private List<string> _headerProjects = new();
    private string? _headerSelectedProject;
    private bool _headerProjectsLoading = false;
    private string _adoOrg = "FortressAffinityGroup";
    private List<string> _adoProjects = new();
    private string? _selectedAdoProject = null;
    // Track original titles for revert on save failure
    private Dictionary<int, string> _originalTitles = new();
    private Dictionary<int, string> _originalDescriptions = new();
    private Dictionary<int, string> _originalAc = new();
    // AC list state (per WI id → list of ac strings)
    private Dictionary<int, List<string>> _acLists = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            // Load the latest artifact set for this submission's active spec
            var submission = await db.Submissions
                .Include(s => s.SpecDocuments)
                .FirstOrDefaultAsync(s => s.Id == Id);

            if (submission is null)
            {
                _error = "Submission not found.";
                return;
            }

            // Ownership check: only the submitter or an editor/admin may view
            var currentUpn = await UserContextService.GetUpnAsync();
            var isAdmin = await UserContextService.IsNexusEditorAsync();
            if (!string.Equals(submission.SubmittedBy, currentUpn, StringComparison.OrdinalIgnoreCase) && !isAdmin)
            {
                _error = "You do not have permission to view this submission's artifacts.";
                return;
            }

            _submissionTitle = submission.Title;

            var specDocId = submission.ActiveSpecDocumentId;
            if (!specDocId.HasValue)
            {
                _error = "No active spec document.";
                return;
            }

            _artifactSet = await db.ArtifactSets
                .Include(a => a.WorkItemRecords)
                .Where(a => a.SpecDocumentId == specDocId.Value)
                .OrderByDescending(a => a.CreatedAt)
                .FirstOrDefaultAsync();

            if (_artifactSet is null)
            {
                _error = "No work items generated yet.";
                return;
            }

            _workItems = _artifactSet.WorkItemRecords;
            _externalDependencies = _workItems.Where(w => w.IsExternalDependency).ToList();

            // Epics are top-level (no parent or parent is null)
            _epics = _workItems.Where(w => w.WorkItemType == "Epic").ToList();
            // ADO#3449 — default all features and stories collapsed
            _collapsedFeatures = _workItems.Where(w => w.WorkItemType == "Feature").Select(w => w.Id).ToHashSet();
            _collapsedStories = _workItems.Where(w => w.WorkItemType == "User Story").Select(w => w.Id).ToHashSet();

            _isEditor = await UserContextService.IsNexusEditorAsync();
            _isAdmin = await UserContextService.IsAdminAsync();
            _adoOrg = Configuration["NexusAdo:Organization"] ?? "FortressAffinityGroup";

            // Load ADO projects for inline header selector
            if (_isAdmin)
                await LoadHeaderProjectsAsync();
            // Snapshot originals for revert on save failure
            foreach (var w in _workItems)
            {
                _originalTitles[w.Id] = w.Title;
                _originalDescriptions[w.Id] = w.Description ?? "";
                _originalAc[w.Id] = w.AcceptanceCriteria ?? "";
                _acLists[w.Id] = (w.AcceptanceCriteria ?? "")
                    .Split('\n', StringSplitOptions.None)
                    .Where(s => !string.IsNullOrEmpty(s))
                    .ToList();
            }
        }
        catch (Exception ex)
        {
            _error = $"Error loading artifacts: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private List<WorkItemRecord> GetChildren(string wiType, string parentTitle)
    {
        return _workItems
            .Where(w => w.WorkItemType == wiType
                        && w.ParentTitle == parentTitle
                        && w.WorkItemType != "Test Case")
            .ToList();
    }

    private string? GetCrossEpicName(WorkItemRecord wi, string predecessorTitle)
    {
        // Find the predecessor WI
        var pred = _workItems.FirstOrDefault(w =>
            string.Equals(w.Title, predecessorTitle, StringComparison.OrdinalIgnoreCase));
        if (pred == null) return null;

        // Walk up the parent chain to find each WI's Epic
        var predEpic = FindEpicFor(pred);
        var wiEpic = FindEpicFor(wi);

        return predEpic != null && wiEpic != null && predEpic.Title != wiEpic.Title
            ? predEpic.Title : null;
    }

    private WorkItemRecord? FindEpicFor(WorkItemRecord wi)
    {
        var current = wi;
        var visited = new HashSet<string>();
        while (current is not null && current.WorkItemType != "Epic")
        {
            if (current.ParentTitle is null || !visited.Add(current.ParentTitle))
                return null;
            current = _workItems.FirstOrDefault(w => w.Title == current.ParentTitle);
        }
        return current;
    }

    private bool IsUnresolvedPredecessor(string predTitle)
    {
        return !_workItems.Any(w => w.Title == predTitle);
    }

    private static string Truncate(string text, int maxLen)
    {
        return text.Length <= maxLen ? text : text[..maxLen] + "...";
    }

    private async Task CopyToClipboard(string? text)
    {
        if (text is not null)
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
    }

    // ── Edit Mode Helpers ──

    private List<WorkItemRecord> GetValidParents(WorkItemRecord wi)
    {
        return wi.WorkItemType switch
        {
            "Feature" => _workItems.Where(w => w.WorkItemType == "Epic").ToList(),
            "User Story" => _workItems.Where(w => w.WorkItemType == "Feature").ToList(),
            "Task" => _workItems.Where(w => w.WorkItemType == "User Story").ToList(),
            "Test Case" => _workItems.Where(w => w.WorkItemType == "User Story").ToList(),
            _ => new List<WorkItemRecord>()
        };
    }

    private List<WorkItemRecord> GetAllDescendants(WorkItemRecord wi)
    {
        var result = new List<WorkItemRecord>();
        CollectDescendantsLocal(wi, result);
        return result;
    }

    private void CollectDescendantsLocal(WorkItemRecord parent, List<WorkItemRecord> result)
    {
        var children = _workItems.Where(w => w.ParentTitle == parent.Title && w.Id != parent.Id).ToList();
        foreach (var child in children)
        {
            result.Add(child);
            CollectDescendantsLocal(child, result);
        }
    }

    // ── Save Methods ──

    private async Task SaveTitle(WorkItemRecord wi)
    {
        if (string.IsNullOrWhiteSpace(wi.Title))
        {
            wi.Title = _originalTitles.GetValueOrDefault(wi.Id, wi.Title);
            Snackbar.Add("Title cannot be empty — reverted.", Severity.Warning);
            return;
        }
        var oldTitle = _originalTitles.GetValueOrDefault(wi.Id, wi.Title);
        if (oldTitle == wi.Title) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await using var tx = await db.Database.BeginTransactionAsync();
            var record = await db.WorkItemRecords.FindAsync(wi.Id);
            if (record is null) { Snackbar.Add("WI not found.", Severity.Error); return; }
            record.Title = wi.Title;
            // Cascade: update ParentTitle refs in same ArtifactSet
            var dependents = await db.WorkItemRecords
                .Where(w => w.ArtifactSetId == wi.ArtifactSetId && w.ParentTitle == oldTitle)
                .ToListAsync();
            foreach (var dep in dependents)
            {
                dep.ParentTitle = wi.Title;
                // Also update local list
                var local = _workItems.FirstOrDefault(w => w.Id == dep.Id);
                if (local is not null) local.ParentTitle = wi.Title;
            }
            await db.SaveChangesAsync();
            await tx.CommitAsync();
            _originalTitles[wi.Id] = wi.Title;
            StateHasChanged();
        }
        catch
        {
            wi.Title = oldTitle;
            Snackbar.Add("Save failed — check connection.", Severity.Error);
        }
    }

    private async Task SaveDescription(WorkItemRecord wi)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var record = await db.WorkItemRecords.FindAsync(wi.Id);
            if (record is null) return;
            record.Description = wi.Description;
            await db.SaveChangesAsync();
            _originalDescriptions[wi.Id] = wi.Description ?? "";
        }
        catch
        {
            wi.Description = _originalDescriptions.GetValueOrDefault(wi.Id, "");
            Snackbar.Add("Save failed — check connection.", Severity.Error);
        }
    }

    private async Task SaveAc(WorkItemRecord wi)
    {
        if (!_acLists.TryGetValue(wi.Id, out var items)) return;
        var joined = string.Join('\n', items.Where(s => !string.IsNullOrWhiteSpace(s)));
        wi.AcceptanceCriteria = joined;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var record = await db.WorkItemRecords.FindAsync(wi.Id);
            if (record is null) return;
            record.AcceptanceCriteria = joined;
            await db.SaveChangesAsync();
            _originalAc[wi.Id] = joined;
        }
        catch
        {
            var orig = _originalAc.GetValueOrDefault(wi.Id, "");
            wi.AcceptanceCriteria = orig;
            _acLists[wi.Id] = orig.Split('\n', StringSplitOptions.None)
                .Where(s => !string.IsNullOrEmpty(s)).ToList();
            Snackbar.Add("Save failed — check connection.", Severity.Error);
        }
    }

    private async Task MoveWi(WorkItemRecord wi, string newParentTitle)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var record = await db.WorkItemRecords.FindAsync(wi.Id);
            if (record is null) return;
            record.ParentTitle = newParentTitle;
            await db.SaveChangesAsync();
            wi.ParentTitle = newParentTitle;
            _epics = _workItems.Where(w => w.WorkItemType == "Epic").ToList();
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Move failed — check connection.", Severity.Error);
        }
    }

    private async Task ConfirmDelete(WorkItemRecord wi)
    {
        var descendants = GetAllDescendants(wi);
        string message = descendants.Count > 0
            ? $"Delete '{wi.Title}' and its {descendants.Count} child item(s)? This cannot be undone."
            : $"Delete '{wi.Title}'? This cannot be undone.";
        string yesText = descendants.Count > 0 ? "Delete with children" : "Delete";

        bool? confirmed = await DialogService.ShowMessageBox(
            "Confirm Delete",
            message,
            yesText: yesText,
            cancelText: "Cancel");

        if (confirmed != true) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var allToDelete = new List<int> { wi.Id };
            allToDelete.AddRange(descendants.Select(d => d.Id));
            var dbRecords = await db.WorkItemRecords
                .Where(w => allToDelete.Contains(w.Id))
                .ToListAsync();
            db.WorkItemRecords.RemoveRange(dbRecords);
            await db.SaveChangesAsync();

            _workItems.Remove(wi);
            foreach (var d in descendants) _workItems.Remove(d);
            _epics = _workItems.Where(w => w.WorkItemType == "Epic").ToList();
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Delete failed — check connection.", Severity.Error);
        }
    }

    private Task AddEpic() => AddWi("Epic", null!);

    private async Task AddWi(string wiType, string parentTitle)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var newWi = new WorkItemRecord
            {
                ArtifactSetId = _artifactSet!.Id,
                WorkItemType = wiType,
                Title = $"New {wiType}",
                ParentTitle = parentTitle,
                Status = "Created",
                WiTemplate = WiTemplateType.Standard
            };
            db.WorkItemRecords.Add(newWi);
            await db.SaveChangesAsync();

            _workItems.Add(newWi);
            _originalTitles[newWi.Id] = newWi.Title;
            _originalDescriptions[newWi.Id] = "";
            _originalAc[newWi.Id] = "";
            _acLists[newWi.Id] = new List<string>();
            if (wiType == "Epic")
                _epics = _workItems.Where(w => w.WorkItemType == "Epic").ToList();
            StateHasChanged();
        }
        catch
        {
            Snackbar.Add("Add failed — check connection.", Severity.Error);
        }
    }

