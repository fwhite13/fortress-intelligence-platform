    // ── ADO Post ──

    private async Task LoadHeaderProjectsAsync()
    {
        _headerProjectsLoading = true;
        _headerProjects = new();
        StateHasChanged();
        try
        {
            var upn = await UserContextService.GetUpnAsync();
            _headerProjects = await AdoCredentialService.GetProjectsAsync(upn);
            _headerSelectedProject = _artifactSet?.AdoProjectName
                ?? (_headerProjects.Count > 0 ? _headerProjects[0] : null);
        }
        catch (Exception ex)
        {
            PageLogger.LogWarning("[NexusArtifacts] Failed to load header ADO projects: {Msg}", ex.Message);
        }
        finally
        {
            _headerProjectsLoading = false;
            StateHasChanged();
        }
    }

    private async Task OnHeaderProjectChangedAsync(string newProject)
    {
        _headerSelectedProject = newProject;
        if (_artifactSet is null) return;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var set = await db.ArtifactSets.FindAsync(_artifactSet.Id);
            if (set is not null)
            {
                set.AdoProjectName = newProject;
                await db.SaveChangesAsync();
                _artifactSet.AdoProjectName = newProject;
            }
            Snackbar.Add($"ADO project updated to {newProject}.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to save project: {ex.Message}", Severity.Error);
        }
    }

    private async Task OpenAdoConfirmDialogAsync()
    {
        // Reuse already-loaded header projects if available
        if (_headerProjects.Count > 0)
        {
            _adoProjects = _headerProjects;
            _selectedAdoProject = _headerSelectedProject ?? _artifactSet?.AdoProjectName ?? _headerProjects[0];
            _showAdoConfirmDialog = true;
            StateHasChanged();
            return;
        }

        _adoProjects = new List<string>();
        _selectedAdoProject = null;
        _showAdoConfirmDialog = true;
        StateHasChanged();

        try
        {
            var upn2 = await UserContextService.GetUpnAsync();
            _adoProjects = await AdoCredentialService.GetProjectsAsync(upn2);
            _selectedAdoProject = _artifactSet?.AdoProjectName
                ?? (_adoProjects.Count > 0 ? _adoProjects[0] : null);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load ADO projects: {ex.Message}", Severity.Error);
            _showAdoConfirmDialog = false;
            StateHasChanged();
        }
    }

    private async Task PostToAdoAsync()
    {
        _showAdoConfirmDialog = false;
        _isPosting = true;
        _postResults = null;
        _postingStatus = $"Posting {_workItems.Count} work items to {_selectedAdoProject}...";
        StateHasChanged();

        try
        {
            var dtos = _workItems.Select(MapToDto).ToList();
            _artifactSet!.AdoProjectName = _selectedAdoProject!;
            var results = await AdoService.CreateWorkItemBatchAsync(_artifactSet!, dtos);
            _postResults = results;
            await WriteBackResultsAsync(results);
            Snackbar.Add($"Posted {results.Count(r => r.Status == "Created")} work items to ADO.", Severity.Success);
        }
        catch (HttpRequestException ex) when (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
        {
            Snackbar.Add("ADO posting failed: Unauthorized (401). Check your PAT in the project selector — it may have expired.", Severity.Error);
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("No ADO credential"))
        {
            Snackbar.Add($"ADO posting failed: {ex.Message}. Set your PAT on the submission page before posting.", Severity.Error);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"ADO posting failed: {ex.Message}. Check your PAT in Account Settings.", Severity.Error);
        }
        finally
        {
            _isPosting = false;
            StateHasChanged();
        }
    }

    private async Task WriteBackResultsAsync(List<WorkItemRecord> results)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        // Build a lookup of all existing WI records for this artifact set, keyed by title.
        // AdoCreationService returns new (unsaved) WorkItemRecord objects, so result.Id is 0.
        // Match back to the persisted rows by ArtifactSetId + Title instead.
        var existingRecords = await db.WorkItemRecords
            .Where(w => w.ArtifactSetId == _artifactSet!.Id)
            .ToListAsync();
        var existingByTitle = existingRecords
            .GroupBy(r => r.Title, StringComparer.OrdinalIgnoreCase)
            .ToDictionary(g => g.Key, g => g.First(), StringComparer.OrdinalIgnoreCase);

        foreach (var result in results)
        {
            if (!existingByTitle.TryGetValue(result.Title, out var record)) continue;

            record.AdoWorkItemId = result.AdoWorkItemId;
            record.AdoWorkItemUrl = result.AdoWorkItemUrl;
            record.Status = result.Status;
            record.ErrorDetail = result.ErrorDetail;

            var local = _workItems.FirstOrDefault(w =>
                string.Equals(w.Title, result.Title, StringComparison.OrdinalIgnoreCase));
            if (local is not null)
            {
                local.AdoWorkItemId = result.AdoWorkItemId;
                local.AdoWorkItemUrl = result.AdoWorkItemUrl;
                local.Status = result.Status;
                local.ErrorDetail = result.ErrorDetail;
            }
        }

        // Mark the artifact set as Posted
        var artifactSetRecord = await db.ArtifactSets.FindAsync(_artifactSet!.Id);
        if (artifactSetRecord is not null)
        {
            var createdCount = results.Count(r => r.Status == "Created");
            var errorCount = results.Count(r => r.Status == "Error");
            artifactSetRecord.Status = errorCount == 0 ? ArtifactSetStatus.Success : ArtifactSetStatus.PartialFailure;
        }

        await db.SaveChangesAsync();
    }

    private static AdoWorkItemDto MapToDto(WorkItemRecord record) => new()
    {
        WorkItemType = record.WorkItemType,
        Title = record.Title,
        Description = record.Description,
        AcceptanceCriteria = record.AcceptanceCriteria,
        ParentTitle = record.ParentTitle,
        PredecessorTitles = record.PredecessorTitles,
        IsExternalDependency = record.IsExternalDependency,
        ExternalOwner = record.ExternalOwner,
        WiTemplate = record.WiTemplate,
        TestedByTitles = record.TestedByTitles
    };

    private RenderFragment RenderPredecessorBadges(WorkItemRecord wi) => builder =>
    {
        if (wi.PredecessorTitles?.Any() != true) return;

        foreach (var predTitle in wi.PredecessorTitles)
        {
            var crossEpicName = GetCrossEpicName(wi, predTitle);
            var isUnresolved = IsUnresolvedPredecessor(predTitle);

            if (isUnresolved)
            {
                builder.OpenComponent<MudTooltip>(0);
                builder.AddAttribute(1, "Text", "Could not be auto-linked");
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(tb =>
                {
                    tb.OpenComponent<MudChip<string>>(0);
                    tb.AddAttribute(1, "Color", Color.Error);
                    tb.AddAttribute(2, "Size", Size.Small);
                    tb.AddAttribute(3, "ChildContent", (RenderFragment)(cb => cb.AddContent(0, $"\u26D3 [!] {Truncate(predTitle, 30)}")));
                    tb.CloseComponent();
                }));
                builder.CloseComponent();
            }
            else if (crossEpicName != null)
            {
                builder.OpenComponent<MudTooltip>(0);
                builder.AddAttribute(1, "Text", predTitle);
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(tb =>
                {
                    tb.OpenComponent<MudChip<string>>(0);
                    tb.AddAttribute(1, "Color", Color.Warning);
                    tb.AddAttribute(2, "Size", Size.Small);
                    tb.AddAttribute(3, "Style", "background-color: orange;");
                    tb.AddAttribute(4, "ChildContent", (RenderFragment)(cb => cb.AddContent(0, $"\u26D3 Cross-Epic: {crossEpicName} > {Truncate(predTitle, 25)}")));
                    tb.CloseComponent();
                }));
                builder.CloseComponent();
            }
            else
            {
                builder.OpenComponent<MudTooltip>(0);
                builder.AddAttribute(1, "Text", predTitle);
                builder.AddAttribute(2, "ChildContent", (RenderFragment)(tb =>
                {
                    tb.OpenComponent<MudChip<string>>(0);
                    tb.AddAttribute(1, "Color", Color.Warning);
                    tb.AddAttribute(2, "Size", Size.Small);
                    tb.AddAttribute(3, "ChildContent", (RenderFragment)(cb => cb.AddContent(0, $"\u26D3 Blocked by: {Truncate(predTitle, 30)}")));
                    tb.CloseComponent();
                }));
                builder.CloseComponent();
            }
        }
    };
