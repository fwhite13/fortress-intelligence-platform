@page "/nexus/{Id:int}/review"
@attribute [Authorize]
@rendermode InteractiveServer

@inject ISubmissionService SubmissionService
@inject ISpecService SpecService
@inject UserContextService UserContextService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

@using FortressNexus.Web.Models.Entities
@using FortressNexus.Web.Models.Enums
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Review Spec — NEXUS</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (_loading)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="nexus-review-container">
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="nexus-review-skeleton-title" />
                <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="500px" Class="nexus-review-skeleton-body" />
            </MudContainer>
        }
        else if (_error is not null)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="nexus-review-container">
                <MudAlert Severity="Severity.Error" Class="nexus-review-error">@_error</MudAlert>
            </MudContainer>
        }
        else if (_submission is not null && _specDoc is not null)
        {
            <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="nexus-review-container">
                <div class="nexus-review-header">
                    <MudText Typo="Typo.h5" Class="nexus-review-title">Review: @_submission.Title</MudText>
                    @if (_specDoc.IsApproved)
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="nexus-review-approved-chip">Approved</MudChip>
                    }
                    <MudChip T="string" Color="Color.Info" Size="Size.Small" Class="nexus-review-status-chip">@_submission.Status.ToString()</MudChip>
                    <MudToggleIconButton @bind-Toggled="_showEdit"
                                        Icon="@Icons.Material.Filled.Visibility"
                                        ToggledIcon="@Icons.Material.Filled.Edit"
                                        Color="Color.Primary"
                                        Class="nexus-review-toggle-btn" />
                    <MudText Typo="Typo.caption" Class="nexus-review-toggle-label">
                        @(_showEdit ? "Editing" : "AI Original")
                    </MudText>
                </div>

                <MudDivider Class="nexus-review-divider" />

                <MudGrid Spacing="3" Class="nexus-review-panels">
                    @* Left panel — AI original *@
                    <MudItem xs="12" md="6" Class="nexus-review-panel">
                        <MudText Typo="Typo.subtitle2" Class="nexus-review-panel-label">AI Original</MudText>
                        <MudPaper Elevation="1" Class="nexus-review-original-viewer">
                            <div class="nexus-spec-content">
                                @RenderMarkdown(_specDoc.Content)
                            </div>
                        </MudPaper>
                    </MudItem>

                    @* Right panel — editable *@
                    <MudItem xs="12" md="6" Class="nexus-review-panel">
                        <MudText Typo="Typo.subtitle2" Class="nexus-review-panel-label">
                            My Edit @if (_lastSavedAt.HasValue) { <span class="nexus-review-saved-at">Saved @_lastSavedAt.Value.ToLocalTime().ToString("h:mm tt")</span> }
                        </MudText>
                        @if (_specDoc.IsApproved)
                        {
                            <MudPaper Elevation="1" Class="nexus-review-original-viewer">
                                <div class="nexus-spec-content">
                                    @RenderMarkdown(_specDoc.EditedContent ?? _specDoc.Content)
                                </div>
                            </MudPaper>
                        }
                        else if (_hasSections)
                        {
                            @* Section-by-section editor *@
                            foreach (var sec in _sections)
                            {
                                var idx = sec.Index;
                                <div class="nexus-review-section">
                                    <div class="nexus-review-section-header">
                                        @if (!string.IsNullOrEmpty(sec.Heading))
                                        {
                                            <MudText Typo="Typo.h6" Class="nexus-review-section-title">@(sec.Heading)</MudText>
                                        }
                                        @if (!_specDoc.IsApproved && _canEdit)
                                        {
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           Class="nexus-review-section-edit-btn"
                                                           OnClick="@(() => _editingSections.Add(idx))" />
                                        }
                                    </div>
                                    @if (_editingSections.Contains(idx))
                                    {
                                        <MudTextField Value="@(sec.Body)"
                                                      ValueChanged="@((string v) => UpdateSectionBody(idx, v))"
                                                      Lines="8"
                                                      Variant="Variant.Outlined"
                                                      Class="nexus-review-section-editor"
                                                      @onblur="@(async () => await SaveSectionAsync(idx))" />
                                    }
                                    else
                                    {
                                        <div class="nexus-spec-content nexus-review-section-body">
                                            @RenderMarkdown(sec.Body)
                                        </div>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @* Fallback: no ## headings — full content editor *@
                            <MudTextField @bind-Value="_editedContent"
                                          Lines="30"
                                          Variant="Variant.Outlined"
                                          Class="nexus-review-editor"
                                          Disabled="@(_specDoc.IsApproved || !_canEdit)" />
                        }
                    </MudItem>
                </MudGrid>

                @* Actions *@
                <div class="nexus-review-actions">
                    @if (!_specDoc.IsApproved)
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Save"
                                   OnClick="HandleSaveDraft"
                                   Disabled="@_isSaving"
                                   Class="nexus-review-save-btn">
                            Save Draft
                        </MudButton>

                        <AuthorizeView Roles="@NexusRoles.Admin" Context="adminContext">
                            <Authorized>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Success"
                                           StartIcon="@Icons.Material.Filled.CheckCircle"
                                           OnClick="HandleApprove"
                                           Disabled="@_isApproving"
                                           Class="nexus-review-approve-btn">
                                    Approve
                                </MudButton>
                            </Authorized>
                        </AuthorizeView>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Build"
                                   Disabled="true"
                                   Class="nexus-review-ado-btn">
                            Generate ADO Artifacts (Phase 2)
                        </MudButton>
                    }
                </div>

                @if (_isSaving)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="nexus-review-save-progress" />
                }

            </MudContainer>
        }
    </Authorized>
</AuthorizeView>

@code {
    [Parameter] public int Id { get; set; }
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private Submission? _submission;
    private SpecDocument? _specDoc;
    private string _editedContent = "";
    private bool _loading = true;
    private string? _error;
    private bool _isSaving;
    private bool _isApproving;
    private bool _showEdit;
    private DateTime? _lastSavedAt;
    private bool _isAdmin;
    private bool _canEdit;
    private string _upn = "";
    private List<SpecSection> _sections = new();
    private HashSet<int> _editingSections = new();
    private bool _hasSections;

    private record SpecSection(int Index, string Heading, string Body);

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _submission = await SubmissionService.GetByIdAsync(Id);
            if (_submission is null)
            {
                _error = "Submission not found.";
                return;
            }

            if (_submission.ActiveSpecDocumentId.HasValue)
                _specDoc = _submission.SpecDocuments.FirstOrDefault(d => d.Id == _submission.ActiveSpecDocumentId.Value);

            if (_specDoc is null)
            {
                _error = "No spec document found for this submission.";
                return;
            }

            var upn = await UserContextService.GetUpnAsync();
            var isAdmin = await UserContextService.IsAdminAsync();
            var isEditor = await UserContextService.IsNexusEditorAsync();
            bool isSubmitter = _submission.SubmittedBy == upn;

            if (!isAdmin && !isEditor && !isSubmitter)
            {
                Snackbar.Add("Access denied.", Severity.Warning);
                NavigationManager.NavigateTo("/nexus");
                return;
            }

            _isAdmin = isAdmin;
            _canEdit = isEditor;
            _upn = upn;

            _editedContent = _specDoc.EditedContent ?? _specDoc.Content;
            _sections = ParseSections(_editedContent);
            _hasSections = _sections.Any(s => !string.IsNullOrEmpty(s.Heading));
        }
        catch (Exception ex)
        {
            _error = $"Error loading review: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private static List<SpecSection> ParseSections(string content)
    {
        var sections = new List<SpecSection>();
        if (string.IsNullOrWhiteSpace(content)) return sections;

        var pattern = @"(?=^## |\A)";
        var parts = System.Text.RegularExpressions.Regex.Split(content, pattern,
            System.Text.RegularExpressions.RegexOptions.Multiline);

        int index = 0;
        foreach (var part in parts)
        {
            var trimmed = part.Trim();
            if (string.IsNullOrEmpty(trimmed)) continue;

            if (trimmed.StartsWith("## "))
            {
                var firstNewline = trimmed.IndexOf('\n');
                if (firstNewline < 0)
                {
                    sections.Add(new SpecSection(index++, trimmed.Substring(3).Trim(), ""));
                }
                else
                {
                    var heading = trimmed.Substring(3, firstNewline - 3).Trim();
                    var body = trimmed.Substring(firstNewline + 1).Trim();
                    sections.Add(new SpecSection(index++, heading, body));
                }
            }
            else
            {
                // preamble before any ## heading
                sections.Add(new SpecSection(index++, "", trimmed));
            }
        }
        return sections;
    }

    private string ReassembleSections()
    {
        var sb = new System.Text.StringBuilder();
        foreach (var s in _sections)
        {
            if (!string.IsNullOrEmpty(s.Heading))
            {
                sb.AppendLine($"## {s.Heading}");
                sb.AppendLine();
            }
            if (!string.IsNullOrEmpty(s.Body))
            {
                sb.AppendLine(s.Body);
                sb.AppendLine();
            }
        }
        return sb.ToString().TrimEnd();
    }

    private void UpdateSectionBody(int index, string newBody)
    {
        var s = _sections[index];
        _sections[index] = s with { Body = newBody };
    }

    private async Task SaveSectionAsync(int sectionIndex)
    {
        _editingSections.Remove(sectionIndex);
        if (_specDoc is null) return;
        _isSaving = true;
        StateHasChanged();
        try
        {
            _editedContent = ReassembleSections();
            await SpecService.SaveDraftAsync(_specDoc.Id, _editedContent, _upn);
            _lastSavedAt = DateTime.UtcNow;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HandleSaveDraft()
    {
        if (_specDoc is null) return;
        _isSaving = true;
        StateHasChanged();
        try
        {
            if (_hasSections)
                _editedContent = ReassembleSections();
            await SpecService.SaveDraftAsync(_specDoc.Id, _editedContent, _upn);
            _lastSavedAt = DateTime.UtcNow;
            Snackbar.Add("Draft saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task HandleApprove()
    {
        if (_specDoc is null) return;
        _isApproving = true;
        StateHasChanged();
        try
        {
            // First save current edits
            if (_hasSections)
                _editedContent = ReassembleSections();
            await SpecService.SaveDraftAsync(_specDoc.Id, _editedContent, _upn);

            // Get ClaimsPrincipal for service-layer role check
            var authState = AuthState is not null ? await AuthState : null;
            var claimsPrincipal = authState?.User
                ?? throw new InvalidOperationException("Unable to resolve authenticated user.");

            _specDoc = await SpecService.ApproveAsync(_specDoc.Id, claimsPrincipal);
            Snackbar.Add("Spec approved!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Approval failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isApproving = false;
            StateHasChanged();
        }
    }

    private static MarkupString RenderMarkdown(string? content)
    {
        if (string.IsNullOrEmpty(content)) return new MarkupString("");
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return new MarkupString(Markdown.ToHtml(content, pipeline));
    }
}
