@page "/nexus/{ResumeSubmissionId:int}/resume"
@page "/nexus/new"
@attribute [Authorize]
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Components.Forms
@using FortressNexus.Web.Models.Entities
@using FortressNexus.Web.Services.Discovery
@using FortressNexus.Web.Components.Nexus

@inject IFileStorageService FileStorageService
@inject ISubmissionService SubmissionService
@inject IDiscoveryService DiscoveryService
@inject ISpecGenerationService SpecGenerationService
@inject NavigationManager Nav
@inject UserContextService UserContextService
@inject ISnackbar Snackbar

<PageTitle>New Feature Submission — NEXUS</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="nexus-wizard-container">
    <MudText Typo="Typo.h4" Class="nexus-wizard-title">New Feature Submission</MudText>
    <MudText Typo="Typo.body2" Class="nexus-wizard-subtitle">Complete each step to submit your feature request for AI spec generation.</MudText>
    <MudDivider Class="nexus-wizard-divider" />

    @* Step indicators *@
    <MudStack Row="true" Spacing="2" Justify="Justify.Center" Class="nexus-wizard-steps">
        <MudChip T="string" Color="@(_activeStep == 0 ? Color.Primary : Color.Default)" Size="Size.Small" Class="nexus-wizard-step-chip">1. Details</MudChip>
        <MudChip T="string" Color="@(_activeStep == 1 ? Color.Primary : Color.Default)" Size="Size.Small" Class="nexus-wizard-step-chip">2. Files</MudChip>
        <MudChip T="string" Color="@(_activeStep == 2 ? Color.Primary : Color.Default)" Size="Size.Small" Class="nexus-wizard-step-chip">3. Discovery</MudChip>
        <MudChip T="string" Color="@(_activeStep == 3 ? Color.Primary : Color.Default)" Size="Size.Small" Class="nexus-wizard-step-chip">4. Review</MudChip>
    </MudStack>

    @* Step 0 — Details *@
    @if (_activeStep == 0)
    {
        <MudStack Spacing="4" Class="nexus-wizard-step">
            <MudTextField @bind-Value="_title"
                          Label="Title"
                          Required="true"
                          RequiredError="Title is required"
                          Placeholder="Brief descriptive title for this feature"
                          Variant="Variant.Outlined"
                          Class="nexus-field-title" />

            <MudTextField @bind-Value="_featureArea"
                          Label="Feature Area"
                          Placeholder="e.g. FAIT, FIRM, FORMS (optional)"
                          Variant="Variant.Outlined"
                          Class="nexus-field-area" />

            <MudTextField @bind-Value="_narrativeText"
                          Label="Narrative"
                          Required="true"
                          RequiredError="Narrative is required"
                          Placeholder="Describe what this feature should do and why it matters..."
                          Variant="Variant.Outlined"
                          Lines="8"
                          Class="nexus-field-narrative" />

            @if (!string.IsNullOrWhiteSpace(_step1Error))
            {
                <MudAlert Severity="Severity.Error" Class="nexus-wizard-step-error">@_step1Error</MudAlert>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="GoToStep2"
                       Class="nexus-wizard-next-btn">
                Next: Upload Files
            </MudButton>
        </MudStack>
    }

    @* Step 1 — Files *@
    @if (_activeStep == 1)
    {
        <MudStack Spacing="4" Class="nexus-wizard-step">
            <MudText Typo="Typo.body2" Class="nexus-wizard-step-desc">
                Upload UI mockups, screenshots, or reference documents (optional — 0–10 files).
            </MudText>

            @* Unified file list — existing (resume) or pending (new submission) *@
            @{
                var visibleExisting = _isResume
                    ? _uploadedFiles.Where(f => !_filesToDelete.Contains(f.Id)).ToList()
                    : new List<UploadedFile>();
            }

            @if (visibleExisting.Count > 0 || (_isResume && _pendingFiles.Count > 0))
            {
                <MudText Typo="Typo.subtitle2" Class="nexus-existing-files-heading">Attached Files</MudText>
                <MudList T="string" Dense="true" Class="nexus-existing-files-list">
                    @foreach (var existingFile in visibleExisting)
                    {
                        var capturedFile = existingFile;
                        <MudListItem T="string">
                            <div class="nexus-existing-file-item">
                                <MudText Typo="Typo.body2">@capturedFile.OriginalFileName</MudText>
                                <MudIconButton Icon="@Icons.Material.Filled.Close"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               OnClick="@(() => RemoveExistingFile(capturedFile.Id))"
                                               Class="nexus-existing-file-remove-btn"
                                               aria-label="Remove file" />
                            </div>
                        </MudListItem>
                    }
                    @if (_isResume)
                    {
                        @foreach (var pendingFile in _pendingFiles)
                        {
                            var capturedPending = pendingFile;
                            <MudListItem T="string">
                                <div class="nexus-existing-file-item">
                                    <MudText Typo="Typo.body2">@capturedPending.Name</MudText>
                                </div>
                            </MudListItem>
                        }
                    }
                </MudList>
            }

            <FileUploadZone OnFilesSelected="HandleFilesSelected"
                            InitialFiles="@(_isResume ? null : _pendingFiles.AsReadOnly())" />

            @foreach (var (file, error) in _fileErrors)
            {
                <MudAlert Severity="Severity.Error" Class="nexus-wizard-file-error">@file.Name: @error</MudAlert>
            }

            @if (_isUploading)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="nexus-wizard-upload-progress" />
                <MudText Typo="Typo.caption" Class="nexus-wizard-upload-status">Uploading files...</MudText>
            }

            <MudStack Row="true" Spacing="2" Class="nexus-wizard-nav-row">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="GoToStep1" Class="nexus-wizard-back-btn">Back</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GoToStep2Discovery" Disabled="@_isUploading" Class="nexus-wizard-next-btn">Next: Discovery</MudButton>
            </MudStack>
        </MudStack>
    }

    @* Step 2 — Discovery *@
    @if (_activeStep == 2)
    {
        <DiscoveryStep Session="_discoverySession"
                       IsLoading="_discoveryLoading"
                       OnCompleted="GoToStep3Confirm"
                       OnSkipped="GoToStep3Confirm" />
        <div class="nexus-wizard-nav mt-3">
            <MudButton Variant="Variant.Outlined" OnClick="BackToStep1Files">Back</MudButton>
        </div>
    }

    @* Step 3 — Review *@
    @if (_activeStep == 3)
    {
        <MudStack Spacing="3" Class="nexus-wizard-step">
            <MudText Typo="Typo.subtitle1" Class="nexus-wizard-review-heading">Review Your Submission</MudText>

            @if (_isResume)
            {
                @if (_hasChanges)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="nexus-wizard-resume-notice">
                        Changes detected — your spec will be regenerated.
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="nexus-wizard-resume-notice">
                        No changes detected — your existing spec will be submitted as-is.
                    </MudAlert>
                }
            }

            <MudPaper Elevation="0" Class="nexus-wizard-review-card">
                <MudText Typo="Typo.overline" Class="nexus-wizard-review-label">Title</MudText>
                <MudText Typo="Typo.body1" Class="nexus-wizard-review-value">@_title</MudText>
            </MudPaper>

            @if (!string.IsNullOrWhiteSpace(_featureArea))
            {
                <MudPaper Elevation="0" Class="nexus-wizard-review-card">
                    <MudText Typo="Typo.overline" Class="nexus-wizard-review-label">Feature Area</MudText>
                    <MudText Typo="Typo.body1" Class="nexus-wizard-review-value">@_featureArea</MudText>
                </MudPaper>
            }

            <MudPaper Elevation="0" Class="nexus-wizard-review-card">
                <MudText Typo="Typo.overline" Class="nexus-wizard-review-label">Narrative (preview)</MudText>
                <MudText Typo="Typo.body2" Class="nexus-wizard-review-value">
                    @(_narrativeText.Length > 200 ? _narrativeText[..200] + "..." : _narrativeText)
                </MudText>
            </MudPaper>

            <MudPaper Elevation="0" Class="nexus-wizard-review-card">
                <MudText Typo="Typo.overline" Class="nexus-wizard-review-label">Files</MudText>
                <MudText Typo="Typo.body2" Class="nexus-wizard-review-value">
                    @(TotalFileCount == 0 ? "None (narrative-only)" : $"{TotalFileCount} file(s)")
                </MudText>
            </MudPaper>

            @* Discovery answers summary *@
            @if (_discoverySession != null)
            {
                <DiscoveryAnswersSummary Session="_discoverySession" />
            }

            @if (_isSubmitting)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="nexus-wizard-submit-progress" />
            }

            @if (_isResume && _regenInProgress)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="nexus-wizard-regen-progress" />
                <MudText Typo="Typo.caption" Class="nexus-wizard-regen-status">@_regenStatusMessage</MudText>
            }

            <MudStack Row="true" Spacing="2" Class="nexus-wizard-nav-row">
                <MudButton Variant="Variant.Outlined" Color="Color.Default" OnClick="BackToStep2Discovery" Disabled="@_isSubmitting" Class="nexus-wizard-back-btn">Back</MudButton>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Success"
                           OnClick="HandleSubmit"
                           Disabled="@(!CanSubmit || _isSubmitting || _regenInProgress)"
                           Class="nexus-wizard-submit-btn">
                    Submit for AI Spec Generation
                </MudButton>
            </MudStack>
        </MudStack>
    }
</MudContainer>

@code {
    private int _activeStep;

    private string _title = "";
    private string? _featureArea;
    private string _narrativeText = "";

    private List<IBrowserFile> _pendingFiles = new();
    private List<UploadedFile> _uploadedFiles = new();
    private List<(IBrowserFile File, string Error)> _fileErrors = new();

    private bool _isUploading;
    private bool _isSubmitting;
    private string? _step1Error;

    private int? _submissionId;

    // Resume mode
    [Parameter] public int? ResumeSubmissionId { get; set; }
    private bool _isResume = false;
    private bool _regenPending = false; // true after re-discovery initiated; triggers regen on next Submit
    private bool _regenInProgress = false;
    private string _regenStatusMessage = "Processing\u2026";
    private string _originalNarrative = string.Empty;
    private HashSet<int> _originalFileIds = new();
    private HashSet<int> _filesToDelete = new();
    private SpecDocument? _existingSpecDocument;

    private DiscoverySession? _discoverySession;
    private bool _discoveryLoading;

    private int TotalFileCount =>
        (_isResume ? _uploadedFiles.Count(f => !_filesToDelete.Contains(f.Id)) : 0) + _pendingFiles.Count;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_title) &&
        !string.IsNullOrWhiteSpace(_narrativeText) &&
        _narrativeText.Trim().Length >= 5 &&
        !_isUploading &&
        !_isSubmitting;

    private bool _hasChanges => _isResume && (
        _narrativeText.Trim() != _originalNarrative.Trim() ||
        _filesToDelete.Count > 0 ||
        _uploadedFiles.Any(f => !_originalFileIds.Contains(f.Id))
    );

    protected override async Task OnInitializedAsync()
    {
        if (ResumeSubmissionId is null)
            return; // New-submission flow — nothing to do

        // --- Resume mode ---
        var submission = await SubmissionService.GetByIdAsync(ResumeSubmissionId.Value);
        if (submission is null)
        {
            Snackbar.Add("Submission not found.", Severity.Error);
            Nav.NavigateTo("/nexus");
            return;
        }

        // Auth guard: only the owner or a NexusAdmin can resume
        var currentUpn = await UserContextService.GetUpnAsync();
        var isAdmin = await UserContextService.IsAdminAsync();
        if (!isAdmin && submission.SubmittedBy != currentUpn)
        {
            Snackbar.Add("You do not have permission to resume this submission.", Severity.Warning);
            Nav.NavigateTo("/nexus");
            return;
        }

        // Populate wizard fields from the submission
        _title = submission.Title;
        _featureArea = submission.FeatureArea;
        _narrativeText = submission.NarrativeText;
        _submissionId = submission.Id;

        // Load existing uploaded files
        _uploadedFiles = submission.SubmissionFiles
            .OrderBy(sf => sf.SortOrder)
            .Select(sf => sf.UploadedFile!)
            .Where(f => f is not null)
            .ToList();

        // Load discovery session if present
        if (!string.IsNullOrEmpty(submission.DiscoveryStatus))
        {
            try
            {
                _discoverySession = await DiscoveryService.GetSessionAsync(submission.Id);
            }
            catch
            {
                // Non-fatal — discovery session load failure does not block resume
            }
        }

        // Latest spec document (if any)
        _existingSpecDocument = submission.SpecDocuments
            .OrderByDescending(d => d.Version)
            .FirstOrDefault();

        // Set resume flag
        _isResume = true;

        // Snapshot originals for change detection (WI #1656)
        _originalNarrative = submission.NarrativeText;
        _originalFileIds = new HashSet<int>(
            submission.SubmissionFiles
                .Select(sf => sf.UploadedFileId)
                .Where(id => id > 0)
        );
    }

    private void GoToStep1() => _activeStep = 0;

    private void GoToStep2()
    {
        _step1Error = null;
        if (string.IsNullOrWhiteSpace(_title))
        {
            _step1Error = "Title is required.";
            return;
        }
        if (string.IsNullOrWhiteSpace(_narrativeText) || _narrativeText.Trim().Length < 5)
        {
            _step1Error = "Narrative must be at least 5 characters.";
            return;
        }
        _activeStep = 1;
    }

    private async Task GoToStep2Discovery()
    {
        _isSubmitting = false;
        _isUploading = false;
        _fileErrors.Clear();

        var upn = await UserContextService.GetUpnAsync();

        if (_submissionId == null && _pendingFiles.Count > 0)
        {
            _isUploading = true;
            StateHasChanged();

            _uploadedFiles.Clear();
            foreach (var browserFile in _pendingFiles)
            {
                try
                {
                    var uploaded = await FileStorageService.UploadAsync(browserFile, upn);
                    var saved = await SubmissionService.SaveUploadedFileAsync(uploaded);
                    _uploadedFiles.Add(saved);
                }
                catch (Exception ex)
                {
                    _fileErrors.Add((browserFile, ex.Message));
                    Snackbar.Add($"Failed to upload '{browserFile.Name}': {ex.Message}", Severity.Error);
                }
            }
            _isUploading = false;
            StateHasChanged();

            if (_fileErrors.Count > 0)
                return; // Stay on Step 1, errors shown
        }

        // Create submission now so we have an ID for discovery
        if (_submissionId == null)
        {
            try
            {
                var dto = new FortressNexus.Web.Models.DTOs.SubmissionCreateDto
                {
                    Title = _title,
                    FeatureArea = _featureArea,
                    NarrativeText = _narrativeText,
                    FileIds = _uploadedFiles.Select(f => f.Id)
                };
                var submission = await SubmissionService.CreateAsync(dto, upn);
                _submissionId = submission.Id;
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Submission creation failed: {ex.Message}", Severity.Error);
                return;
            }
        }

        // Persist narrative edit before advancing (resume mode only)
        if (_isResume && _submissionId.HasValue)
        {
            try
            {
                await SubmissionService.UpdateNarrativeAsync(_submissionId.Value, _narrativeText);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Warning: narrative save failed — {ex.Message}", Severity.Warning);
            }
        }

        _activeStep = 2;
        _discoveryLoading = true;
        StateHasChanged();

        // Fire InitiateDiscoveryAsync in background — fire-and-poll (only on first entry)
        if (_discoverySession == null)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await DiscoveryService.InitiateDiscoveryAsync(_submissionId!.Value);
                    // Poll until QuestionsReady or timeout (60s — Bedrock inference can take 20–40s)
                    var deadline = DateTime.UtcNow.AddSeconds(60);
                    while (DateTime.UtcNow < deadline)
                    {
                        _discoverySession = await DiscoveryService.GetSessionAsync(_submissionId!.Value);
                        if (_discoverySession?.Status is DiscoverySessionStatus.QuestionsReady or DiscoverySessionStatus.Failed) break;
                        await Task.Delay(1000);
                    }
                }
                catch (Exception)
                {
                    // Graceful skip — session stays null
                }
                finally
                {
                    _discoveryLoading = false;
                    await InvokeAsync(StateHasChanged);
                }
            });
        }
        else
        {
            // Already have a session — just clear the loading flag
            _discoveryLoading = false;
        }
    }

    private void GoToStep3Confirm() => _activeStep = 3;

    private void BackToStep1Files() => _activeStep = 1;

    private void BackToStep2Discovery()
    {
        _isSubmitting = false;
        _activeStep = 2;
    }

    private async Task HandleFilesSelected(IReadOnlyList<IBrowserFile> files)
    {
        if (_isUploading) return;   // ← guard against concurrent invocations
        _isUploading = true;        // ← before any await
        try
        {
            if (_isResume && _submissionId.HasValue)
            {
                // Resume mode: immediately upload new files and persist junction records
                var upn = await UserContextService.GetUpnAsync();
                StateHasChanged();

                _pendingFiles.Clear();
                _fileErrors.Clear();

                foreach (var browserFile in files)
                {
                    try
                    {
                        var uploaded = await FileStorageService.UploadAsync(browserFile, upn);
                        var saved = await SubmissionService.SaveUploadedFileAsync(uploaded);
                        var sortOrder = _uploadedFiles.Count(f => !_filesToDelete.Contains(f.Id)) + _pendingFiles.Count;
                        await SubmissionService.AddFileToSubmissionAsync(_submissionId.Value, saved.Id, sortOrder);
                        _uploadedFiles.Add(saved);
                    }
                    catch (Exception ex)
                    {
                        _fileErrors.Add((browserFile, ex.Message));
                        Snackbar.Add($"Failed to upload '{browserFile.Name}': {ex.Message}", Severity.Error);
                    }
                }

                StateHasChanged();
            }
            else
            {
                // New submission mode: buffer for upload on GoToStep2Discovery
                _pendingFiles = files.ToList();
            }
        }
        finally
        {
            _isUploading = false;
        }
    }

    private void RemoveExistingFile(int fileId)
    {
        _filesToDelete.Add(fileId);
        // Optimistic UI — file disappears from list immediately
        // Actual DB/S3 deletion applied in ApplyResumeChangesAsync() at submit
    }

    private async Task ApplyResumeChangesAsync()
    {
        // 1. Persist updated narrative
        try
        {
            await SubmissionService.UpdateNarrativeAsync(_submissionId!.Value, _narrativeText);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Warning: narrative save failed — {ex.Message}", Severity.Warning);
        }

        // 2. Delete flagged files from S3 + DB
        var toDelete = _filesToDelete.ToList(); // snapshot to avoid mutation during iteration
        foreach (var fileId in toDelete)
        {
            await SubmissionService.DeleteUploadedFileAsync(_submissionId!.Value, fileId);
        }

        // 3. Clear the set to prevent double-delete
        _filesToDelete.Clear();
    }

    private async Task HandleSubmit()
    {
        if (!CanSubmit) return;
        if (_submissionId == null) return;

        _isSubmitting = true;
        StateHasChanged();

        try
        {
            if (_isResume && _hasChanges)
            {
                if (!_regenPending)
                {
                    // Apply pending changes (narrative + file deletions) before re-discovery
                    await ApplyResumeChangesAsync();

                    // === FIRST PASS: Send user through new Discovery session ===
                    // Supersede the prior discovery session if one exists
                    if (_discoverySession != null)
                    {
                        await DiscoveryService.SupersedeSessionAsync(_discoverySession.Id);
                        _discoverySession = null;
                    }

                    // Kick off new discovery session
                    await DiscoveryService.InitiateDiscoveryAsync(_submissionId.Value);

                    // Mark regen pending — next Submit will trigger spec regen instead of re-discovery
                    _regenPending = true;

                    // Navigate back to Discovery step
                    _isSubmitting = false;
                    _activeStep = 2;
                    _discoveryLoading = true;
                    StateHasChanged();

                    // Poll for the new session in background
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            var deadline = DateTime.UtcNow.AddSeconds(60);
                            while (DateTime.UtcNow < deadline)
                            {
                                _discoverySession = await DiscoveryService.GetSessionAsync(_submissionId!.Value);
                                if (_discoverySession?.Status is DiscoverySessionStatus.QuestionsReady or DiscoverySessionStatus.Failed)
                                    break;
                                await Task.Delay(1000);
                            }
                        }
                        catch
                        {
                            // Graceful — session stays null
                        }
                        finally
                        {
                            _discoveryLoading = false;
                            await InvokeAsync(StateHasChanged);
                        }
                    });

                    return;
                }
                else
                {
                    // === SECOND PASS: User completed new Discovery — regenerate spec at Version+1 ===
                    _regenInProgress = true;
                    _regenStatusMessage = "Processing\u2026";
                    StateHasChanged();

                    try
                    {
                        await SubmissionService.UpdateStatusAsync(_submissionId.Value, SubmissionStatus.Generating);
                        await ApplyResumeChangesAsync();
                        await SpecGenerationService.GenerateAsync(_submissionId.Value);
                        // GenerateAsync sets status to AwaitingReview internally — no need to set here
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add($"Spec regeneration failed: {ex.Message}", Severity.Error);
                        await SubmissionService.UpdateStatusAsync(_submissionId.Value, SubmissionStatus.Failed);
                        _regenInProgress = false;
                        _isSubmitting = false;
                        StateHasChanged();
                        return;
                    }

                    _regenStatusMessage = "Complete";
                    StateHasChanged();
                    await Task.Delay(800);
                    Nav.NavigateTo($"/nexus/{_submissionId.Value}");
                    return;
                }
            }

            if (_isResume && !_hasChanges && _existingSpecDocument != null)
            {
                // Skip-regen path: existing spec, no changes — persist narrative then promote Draft → AwaitingReview
                await SubmissionService.UpdateNarrativeAsync(_submissionId.Value, _narrativeText);
                await SubmissionService.UpdateStatusAsync(_submissionId.Value, SubmissionStatus.AwaitingReview);
                Nav.NavigateTo($"/nexus/{ResumeSubmissionId}");
                return;
            }

            // New submission (or resume with no changes but no prior spec) — normal flow
            Nav.NavigateTo($"/nexus/{_submissionId.Value}");
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Submit failed: {ex.Message}", Severity.Error);
            _isSubmitting = false;
            StateHasChanged();
        }
    }
}
