@page "/nexus/{Id:int}"
@attribute [Authorize]
@rendermode InteractiveServer
@implements IDisposable

@inject ISubmissionService SubmissionService
@inject ISpecGenerationService SpecGenerationService
@inject IFileStorageService FileStorageService
@inject NavigationManager Nav
@inject UserContextService UserContextService
@inject ISnackbar Snackbar
@inject IArtifactGenerationService ArtifactGenerationService
@inject IAdoService AdoService
@inject IDiscoveryService DiscoveryService
@inject IDialogService DialogService

@using FortressNexus.Web.Models.Entities
@using FortressNexus.Web.Models.Enums
@using FortressNexus.Web.Services.Discovery
@using FortressNexus.Web.Components.Nexus

<PageTitle>@(_submission?.Title ?? "Submission") — NEXUS</PageTitle>

@if (_loading)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="nexus-detail-container">
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="40px" Class="nexus-detail-skeleton-title" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="24px" Width="30%" Class="nexus-detail-skeleton-meta" />
        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="200px" Class="nexus-detail-skeleton-body" />
    </MudContainer>
}
else if (_error is not null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="nexus-detail-container">
        <MudAlert Severity="Severity.Error" Class="nexus-detail-error">@_error</MudAlert>
    </MudContainer>
}
else if (_submission is not null)
{
    <MudContainer MaxWidth="MaxWidth.Large" Class="nexus-detail-container">

        @* Header *@
        <div class="nexus-detail-header">
            <MudText Typo="Typo.h4" Class="nexus-detail-title">@_submission.Title</MudText>
            <div class="nexus-detail-meta">
                <MudChip T="string"
                         Color="@GetStatusColor(_submission.Status)"
                         Size="Size.Small"
                         Class="nexus-detail-status-chip">
                    @_submission.Status.ToString()
                </MudChip>
                <MudText Typo="Typo.caption" Class="nexus-detail-submitted">
                    Submitted by @_submission.SubmittedBy on @_submission.SubmittedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                </MudText>
                @if (!string.IsNullOrWhiteSpace(_submission.FeatureArea))
                {
                    <MudChip T="string" Size="Size.Small" Class="nexus-detail-area-chip">@_submission.FeatureArea</MudChip>
                }
            </div>
        </div>

        <MudDivider Class="nexus-detail-divider" />

        @* Files *@
        @if (_submission.SubmissionFiles.Count > 0)
        {
            <div class="nexus-detail-files">
                <MudText Typo="Typo.subtitle2" Class="nexus-detail-section-label">Attached Files</MudText>
                <MudList T="string" Dense="true" Class="nexus-detail-file-list">
                    @foreach (var sf in _submission.SubmissionFiles.OrderBy(f => f.SortOrder))
                    {
                        var uf = sf.UploadedFile;
                        if (uf is null) continue;
                        <MudListItem T="string">
                            <div class="nexus-detail-file-item">
                                <MudIcon Icon="@GetFileTypeIcon(uf.FileType)" Color="Color.Primary" Size="Size.Small" />
                                @if (_presignedUrls.TryGetValue(uf.S3Key, out var url))
                                {
                                    <a href="@url" target="_blank" class="nexus-detail-file-link">@uf.OriginalFileName</a>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">@uf.OriginalFileName</MudText>
                                }
                                <MudText Typo="Typo.caption" Class="nexus-detail-file-type">@uf.FileType</MudText>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            </div>
        }

        @* WI #1650: Narrative preview — only for Draft with narrative text *@
        @if (_submission.Status == SubmissionStatus.Draft && !string.IsNullOrEmpty(_submission.NarrativeText))
        {
            <MudDivider Class="nexus-detail-divider" />
            <div class="nexus-detail-narrative">
                <MudText Typo="Typo.subtitle2" Class="nexus-detail-section-label">Your Narrative</MudText>
                <MudPaper Elevation="0" Class="nexus-detail-narrative-preview">
                    <MudText Typo="Typo.body2">@_submission.NarrativeText</MudText>
                </MudPaper>
            </div>
        }

        @* WI #1658: Discovery panel — modified with history toggle *@
        @if (_discoverySession != null || !string.IsNullOrEmpty(_submission.DiscoveryStatus))
        {
            <MudDivider Class="nexus-detail-divider" />
            <div class="nexus-detail-discovery">
                <div class="nexus-detail-discovery-header">
                    <MudText Typo="Typo.subtitle2" Class="nexus-detail-section-label">Discovery</MudText>
                    @if (_allDiscoverySessions.Count > 1)
                    {
                        <MudSwitch T="bool"
                                   @bind-Value="_showDiscoveryHistory"
                                   Label="Show history"
                                   Color="Color.Primary"
                                   Class="nexus-detail-discovery-history-toggle" />
                    }
                </div>
                @if (_showDiscoveryHistory)
                {
                    @foreach (var session in _allDiscoverySessions)
                    {
                        <div class="nexus-detail-discovery-session mb-3">
                            <MudText Typo="Typo.caption"
                                     Color="@(session.Status != DiscoverySessionStatus.Superseded ? Color.Default : Color.Secondary)"
                                     Class="nexus-detail-discovery-session-label">
                                @(session.Status != DiscoverySessionStatus.Superseded ? "Active session" : $"Superseded — {session.CreatedAt.ToLocalTime():yyyy-MM-dd}")
                            </MudText>
                            <DiscoveryAnswersSummary Session="session" />
                        </div>
                    }
                }
                else
                {
                    <DiscoveryAnswersSummary Session="_discoverySession" />
                }
            </div>
        }

        @* WI #1650: Previous version panel — shown during Generating when prior spec exists *@
        @if (_submission.Status == SubmissionStatus.Generating && _submission.SpecDocuments.Count > 1)
        {
            <MudDivider Class="nexus-detail-divider" />
            <div class="nexus-detail-prev-version">
                <MudExpansionPanels>
                    <MudExpansionPanel Text="Previous Version">
                        <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                            @if (_submission.SpecDocuments.OrderByDescending(d => d.Version).Skip(1).FirstOrDefault() is { } prevSpec)
                            {
                                <MudText Typo="Typo.body2">
                                    @(prevSpec.EditedContent ?? prevSpec.Content)
                                </MudText>
                            }
                        </MudAlert>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            </div>
        }

        @* Actions *@
        <div class="nexus-detail-actions">
            @* WI #1650: Continue Submission button — for Draft status *@
            @if (_submission.Status == SubmissionStatus.Draft)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Edit"
                           OnClick="@(() => Nav.NavigateTo($"/nexus/{Id}/resume"))"
                           Class="nexus-detail-continue-btn">
                    Continue Submission
                </MudButton>
            }

            @if (_submission.Status == SubmissionStatus.Pending)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.AutoAwesome"
                           OnClick="HandleGenerateSpec"
                           Disabled="@_isGenerating"
                           Class="nexus-detail-generate-btn">
                    Generate Spec
                </MudButton>
            }

            @if (_submission.Status == SubmissionStatus.Generating)
            {
                <MudProgressCircular Indeterminate="true" Color="Color.Warning" Size="Size.Small" Class="nexus-detail-generating-spinner" />
                <MudText Typo="Typo.body2" Class="nexus-detail-generating-text">Generating spec...</MudText>
            }

            @if (_submission.Status == SubmissionStatus.AwaitingReview)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.RateReview"
                           OnClick="@(() => Nav.NavigateTo($"/nexus/{Id}/review"))"
                           Class="nexus-detail-review-btn">
                    Review Spec
                </MudButton>
            }

            @if (_submission.Status == SubmissionStatus.Approved || _submission.Status == SubmissionStatus.ArtifactsCreated)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.WorkOutline"
                           OnClick="HandleGenerateWorkItems"
                           Disabled="@_isGeneratingWorkItems"
                           Class="nexus-detail-generate-wi-btn">
                    Generate Work Items
                </MudButton>
            }

            @* Download dropdown *@
            @if (_activeSpec is not null)
            {
                <MudMenu Label="Download" StartIcon="@Icons.Material.Filled.Download" Variant="Variant.Outlined" Color="Color.Default" Class="nexus-detail-download-menu">
                    <MudMenuItem OnClick="@(() => DownloadSpec("md"))">Markdown (.md)</MudMenuItem>
                    <MudMenuItem OnClick="@(() => DownloadSpec("docx"))">Word (.docx)</MudMenuItem>
                    <MudMenuItem OnClick="@(() => DownloadSpec("pdf"))">PDF (.pdf)</MudMenuItem>
                </MudMenu>
            }

            @* WI #1651: Delete Submission button — Draft only, owner or admin *@
            @if (_submission.Status == SubmissionStatus.Draft && (_submission.SubmittedBy == _currentUserUpn || _isAdmin))
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Error"
                           StartIcon="@Icons.Material.Filled.DeleteForever"
                           OnClick="HandleDeleteSubmissionAsync"
                           Class="nexus-detail-delete-btn">
                    Delete Submission
                </MudButton>
            }
        </div>

        @* Spec viewer *@
        @if (_activeSpec is not null)
        {
            <MudDivider Class="nexus-detail-divider" />
            <div class="nexus-detail-spec">
                <MudText Typo="Typo.subtitle2" Class="nexus-detail-section-label">
                    Specification v@(_activeSpec.Version)
                    @if (_activeSpec.IsApproved) { <MudChip T="string" Color="Color.Success" Size="Size.Small" Class="nexus-detail-approved-chip">Approved</MudChip> }
                </MudText>
                <MudPaper Elevation="1" Class="nexus-detail-spec-viewer">
                    <div class="nexus-spec-content">
                        @RenderMarkdown(_activeSpec.EditedContent ?? _activeSpec.Content)
                    </div>
                </MudPaper>
            </div>
        }

        @* WI #1652: Version History accordion — shown when more than one spec version exists *@
        @if (_historicalSpecs.Count > 0)
        {
            <MudDivider Class="nexus-detail-divider" />
            <div class="nexus-detail-version-history">
                <MudText Typo="Typo.subtitle2" Class="nexus-detail-section-label">Version History</MudText>
                <MudExpansionPanels>
                    @foreach (var spec in _historicalSpecs)
                    {
                        <MudExpansionPanel Text="@($"v{spec.Version} — {spec.GeneratedAt.ToLocalTime():yyyy-MM-dd}")">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Generated: @spec.GeneratedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                            </MudText>
                            @if (!string.IsNullOrEmpty(spec.Content))
                            {
                                <MudText Typo="Typo.body2" Class="nexus-version-history-preview">
                                    @(spec.Content.Length > 200 ? spec.Content[..200] + "…" : spec.Content)
                                </MudText>
                            }
                        </MudExpansionPanel>
                    }
                </MudExpansionPanels>
            </div>
        }

    </MudContainer>
}

@code {
    [Parameter] public int Id { get; set; }

    private Submission? _submission;
    private SpecDocument? _activeSpec;
    private bool _loading = true;
    private string? _error;
    private bool _isGenerating;
    private bool _isGeneratingWorkItems;
    private Dictionary<string, string> _presignedUrls = new();
    private DiscoverySession? _discoverySession;
    private System.Threading.Timer? _pollTimer;

    // WI #1651
    private string? _currentUserUpn;
    private bool _isAdmin;

    // WI #1658
    private bool _showDiscoveryHistory = false;
    private List<DiscoverySession> _allDiscoverySessions = new();

    // WI #1652
    private List<SpecDocument> _historicalSpecs = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadSubmissionAsync();
    }

    private async Task LoadSubmissionAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _submission = await SubmissionService.GetByIdAsync(Id);
            if (_submission is null)
            {
                _error = "Submission not found.";
                return;
            }

            // Load active spec
            if (_submission.ActiveSpecDocumentId.HasValue)
                _activeSpec = _submission.SpecDocuments.FirstOrDefault(d => d.Id == _submission.ActiveSpecDocumentId.Value);

            // WI #1652: historical specs (all versions except latest)
            _historicalSpecs = _submission.SpecDocuments
                .OrderByDescending(d => d.Version)
                .Skip(1)
                .ToList();

            // Generate presigned URLs for files
            foreach (var sf in _submission.SubmissionFiles)
            {
                if (sf.UploadedFile is not null && !_presignedUrls.ContainsKey(sf.UploadedFile.S3Key))
                {
                    try
                    {
                        var url = await FileStorageService.GetPresignedUrlAsync(sf.UploadedFile.S3Key, sf.UploadedFile.S3Bucket);
                        _presignedUrls[sf.UploadedFile.S3Key] = url;
                    }
                    catch { /* presigned URL failure is non-fatal */ }
                }
            }

            // Load discovery session if present
            if (!string.IsNullOrEmpty(_submission.DiscoveryStatus))
            {
                try
                {
                    _discoverySession = await DiscoveryService.GetSessionAsync(_submission.Id);
                    _allDiscoverySessions = await DiscoveryService.GetAllSessionsAsync(_submission.Id);
                }
                catch { /* non-fatal */ }
            }

            // WI #1650/#1651: current user context
            _currentUserUpn = await UserContextService.GetUpnAsync();
            _isAdmin = await UserContextService.IsAdminAsync();
        }
        catch (Exception ex)
        {
            _error = $"Error loading submission: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private Task HandleGenerateSpec()
    {
        _isGenerating = true;
        StateHasChanged();

        try
        {
            _ = Task.Run(async () => {
                try
                {
                    await SpecGenerationService.GenerateAsync(Id);
                }
                catch (Exception ex)
                {
                    await InvokeAsync(() => {
                        Snackbar.Add($"Spec generation failed: {ex.Message}", Severity.Error);
                        _isGenerating = false;
                        StateHasChanged();
                        return Task.CompletedTask;
                    });
                }
            });

            // Start polling
            _pollTimer = new System.Threading.Timer(async _ =>
            {
                await InvokeAsync(async () =>
                {
                    await LoadSubmissionAsync();
                    StateHasChanged();

                    if (_submission?.Status != SubmissionStatus.Generating)
                    {
                        _isGenerating = false;
                        _pollTimer?.Dispose();
                        _pollTimer = null;
                    }
                });
            }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to start spec generation: {ex.Message}", Severity.Error);
            _isGenerating = false;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    private async Task HandleGenerateWorkItems()
    {
        if (_activeSpec is null || _submission is null) return;

        _isGeneratingWorkItems = true;
        StateHasChanged();

        try
        {
            var workItems = await ArtifactGenerationService.GenerateWorkItemsAsync(_activeSpec.Id);

            var stubArtifactSet = new ArtifactSet
            {
                SpecDocumentId = _activeSpec.Id,
                AdoOrganization = "stub",
                AdoProjectName = "NEXUS",
                ProcessTemplateTypeId = "6b724908-ef14-45cf-84f8-768b5384da45",
                CreatedAt = DateTime.UtcNow,
                CreatedBy = "nexus-ui"
            };

            var records = await AdoService.CreateWorkItemBatchAsync(stubArtifactSet, workItems);
            Snackbar.Add($"{records.Count} work items created in ADO.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Work item generation failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isGeneratingWorkItems = false;
            StateHasChanged();
        }
    }

    private async Task HandleDeleteSubmissionAsync()
    {
        bool? confirmed = await DialogService.ShowMessageBox(
            "Delete Submission",
            "This is permanent — all files and any generated spec will be deleted. Are you sure?",
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirmed != true) return;

        await SubmissionService.DeleteSubmissionAsync(Id);
        Snackbar.Add("Submission deleted.", Severity.Success);
        Nav.NavigateTo("/nexus");
    }

    private void DownloadSpec(string format)
    {
        if (_submission is null || _activeSpec is null) return;
        Nav.NavigateTo($"/nexus/{Id}/export?format={format}", forceLoad: true);
    }

    private static Color GetStatusColor(SubmissionStatus status) => status switch
    {
        SubmissionStatus.Draft => Color.Default,
        SubmissionStatus.Pending => Color.Info,
        SubmissionStatus.Generating => Color.Warning,
        SubmissionStatus.AwaitingReview => Color.Primary,
        SubmissionStatus.Approved => Color.Success,
        SubmissionStatus.ArtifactsCreated => Color.Success,
        SubmissionStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private static string GetFileTypeIcon(FileType fileType) => fileType switch
    {
        FileType.Html => Icons.Material.Filled.Code,
        FileType.Image => Icons.Material.Filled.Image,
        FileType.Pdf => Icons.Material.Filled.PictureAsPdf,
        _ => Icons.Material.Filled.InsertDriveFile
    };

    public void Dispose()
    {
        _pollTimer?.Dispose();
    }

    private static MarkupString RenderMarkdown(string? content)
    {
        if (string.IsNullOrEmpty(content)) return new MarkupString("");
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build();
        return new MarkupString(Markdown.ToHtml(content, pipeline));
    }
}
