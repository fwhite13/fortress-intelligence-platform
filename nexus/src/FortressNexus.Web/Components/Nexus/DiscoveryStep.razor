@using FortressNexus.Web.Models.Entities
@using FortressNexus.Web.Models.Enums
@using FortressNexus.Web.Services.Discovery
@using FortressNexus.Web.Services
@implements IDisposable

@inject IDiscoveryService DiscoveryService
@inject UserContextService UserContextService
@inject ISnackbar Snackbar

<div class="nexus-discovery-step">

    @* ── Phase indicator ──────────────────────────────────────────────────── *@
    @if (Session != null && !Session.SkippedByUser)
    {
        <div class="nexus-discovery-phase-indicator d-flex align-center gap-3 mb-3">
            <span class="nexus-phase-dot nexus-phase-dot--active">●</span>
            <MudText Typo="Typo.body2" Class="nexus-phase-label nexus-phase-label--active">
                Phase 1 of 2 — Business Discovery
            </MudText>
            <span class="nexus-phase-separator mx-2">→</span>
            <span class="@("nexus-phase-dot" + (CurrentPhase >= 2 ? " nexus-phase-dot--active" : " nexus-phase-dot--inactive"))">○</span>
            <MudText Typo="Typo.body2" Class="@("nexus-phase-label" + (CurrentPhase >= 2 ? " nexus-phase-label--active" : " nexus-phase-label--inactive"))">
                Phase 2 — Technical Review
            </MudText>
        </div>

        @if (CurrentRound > 0)
        {
            <MudChip T="string" Size="Size.Small" Color="Color.Default" Class="mb-3 nexus-round-badge">
                Round @CurrentRound
            </MudChip>
        }
    }

    @* ── Phase transition screen ──────────────────────────────────────────── *@
    @if (_showPhaseTransition)
    {
        <MudPaper Elevation="2" Class="pa-5 mb-4 nexus-phase-transition">
            <MudText Typo="Typo.h6" Class="mb-3">✅ Phase 1 Complete</MudText>
            <MudText Typo="Typo.body1" Class="mb-4">
                Phase 1 complete. NEXUS has a good picture of the business need. Now for a few technical
                questions — these help prevent architectural surprises in the spec.
            </MudText>
            @if (_isAdmin)
            {
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           OnClick="HandleAdvanceToPhase2"
                           Disabled="@_advancing"
                           Class="nexus-phase-advance-btn">
                    @if (_advancing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        <span>Starting Phase 2…</span>
                    }
                    else
                    {
                        <span>Continue to Technical Review →</span>
                    }
                </MudButton>
            }
            else
            {
                <MudAlert Severity="Severity.Info">
                    Waiting for an admin to advance to Phase 2.
                </MudAlert>
            }
        </MudPaper>
    }

    @* ── Main question/loading area ───────────────────────────────────────── *@
    else if (_loading)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="nexus-discovery-loading-text mb-2">@LoadingText</MudText>
        @for (int i = 0; i < 3; i++)
        {
            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="120px" Class="mb-3" />
        }
    }
    else if (Session == null || Session.SkippedByUser ||
             (!IsActiveOrAnsweredStatus(Session.Status) && !CurrentQuestions.Any()))
    {
        <MudAlert Severity="Severity.Info" Class="nexus-discovery-empty-alert">
            Couldn't generate questions — continuing to spec generation.
        </MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="HandleSkip" Class="mt-3 nexus-discovery-continue-btn">
            Continue
        </MudButton>
    }
    else if (Session.Status == DiscoverySessionStatus.Phase2Complete)
    {
        @* Phase 2 complete — show completion and let the parent advance to spec gen *@
        <MudAlert Severity="Severity.Success" Class="mb-4">
            Discovery complete. Both phases finished.
        </MudAlert>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="OnCompleted"
                   Class="nexus-discovery-continue-btn">
            Continue to Spec Generation →
        </MudButton>
    }
    else
    {
        @* ── Intro text (phase-aware) ────────────────────────────────────── *@
        <MudText Typo="Typo.body1" Class="nexus-discovery-intro mb-4">
            @IntroText
        </MudText>

        @* ── Question cards ──────────────────────────────────────────────── *@
        @foreach (var question in CurrentQuestions.OrderBy(q => q.SortOrder))
        {
            @* Phase 2 questions are admin-only *@
            @if (question.Phase == 2 && !_isAdmin) { continue; }

            <DiscoveryQuestionCard @key="question.Id" Question="question"
                                   Answer="@(_answers.GetValueOrDefault(question.Id))"
                                   OnAnswerChanged="@((val) => _answers[question.Id] = val)" />
        }

        @* ── Action buttons ──────────────────────────────────────────────── *@
        <div class="nexus-discovery-actions mt-4">

            @* Primary: Submit *@
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       OnClick="HandleContinue"
                       Disabled="@(!CanContinue || _submitting)"
                       Class="nexus-discovery-continue-btn">
                Submit Answers →
            </MudButton>

            @* Secondary: That's enough / Skip technical *@
            @if (CurrentPhase == 1)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="HandlePhase1UserTerminate"
                           Class="nexus-discovery-skip-link ml-3">
                    That's enough, move on →
                </MudButton>
            }
            else if (CurrentPhase == 2 && _isAdmin)
            {
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           OnClick="HandlePhase2Skip"
                           Class="nexus-discovery-skip-link ml-3">
                    Skip technical questions →
                </MudButton>
            }

            @* Tertiary: Skip discovery entirely (Phase 1 only, small/muted) *@
            @if (CurrentPhase == 1)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Default"
                           OnClick="HandleSkip"
                           Size="Size.Small"
                           Class="nexus-discovery-skip-entirely-link ml-3">
                    Skip discovery entirely
                </MudButton>
            }
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public DiscoverySession? Session { get; set; }
    [Parameter, EditorRequired] public int SubmissionId { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    [Parameter] public EventCallback OnCompleted { get; set; }
    [Parameter] public EventCallback OnSkipped { get; set; }
    [Parameter] public EventCallback<DiscoverySession> OnSessionUpdated { get; set; }

    private Dictionary<Guid, string> _answers = new();
    private bool _loading => IsLoading || _loadingNextRound;
    private bool _isAdmin = false;
    private bool _showPhaseTransition = false;
    private bool _advancing = false;
    private bool _submitting = false;
    private bool _loadingNextRound = false;
    private int _submittedRound = 0;
    private int _submittedPhase = 0;
    private CancellationTokenSource? _pollCts;

    // ── Derived state ──────────────────────────────────────────────────────

    private int CurrentPhase => Session?.Phase ?? 1;
    private int CurrentRound => CurrentQuestions.Any() ? CurrentQuestions.Max(q => q.Round) : 0;

    /// <summary>Questions in the current active round for the current phase.</summary>
    private IReadOnlyList<DiscoveryQuestion> CurrentQuestions
    {
        get
        {
            if (Session?.Questions == null) return Array.Empty<DiscoveryQuestion>();
            var phase = CurrentPhase;
            var phaseQs = Session.Questions.Where(q => q.Phase == phase).ToList();
            if (!phaseQs.Any()) return Array.Empty<DiscoveryQuestion>();
            var maxRound = phaseQs.Max(q => q.Round);
            return phaseQs.Where(q => q.Round == maxRound).ToList();
        }
    }

    private string LoadingText
    {
        get
        {
            if (_loadingNextRound)
            {
                // Phase/round-aware text while polling for next round
                if (_submittedRound == 1)
                    return "Reviewing your answers\u2026";
                return "Checking for follow-up questions\u2026";
            }
            // Initial load text
            return CurrentPhase == 1
                ? (CurrentRound <= 1 ? "Analyzing your submission\u2026" : "Reviewing your answers\u2026")
                : "Shifting to technical review\u2026";
        }
    }

    private string IntroText => CurrentPhase == 1
        ? "Before writing your spec, NEXUS wants to understand what you're trying to accomplish. These questions focus on your goals, users, and workflows — nothing technical."
        : "Based on your answers, NEXUS now has a few technical questions. These help resolve integration points and architectural decisions before the spec is written. If you're not sure, you can skip.";

    private bool CanContinue => !_submitting && !CurrentQuestions
        .Where(q => q.IsBlocking && (CurrentPhase != 2 || _isAdmin))
        .Any(q => string.IsNullOrWhiteSpace(_answers.GetValueOrDefault(q.Id)));

    private static bool IsActiveOrAnsweredStatus(string? status) =>
        status is
            DiscoverySessionStatus.Pending or
            DiscoverySessionStatus.QuestionsReady or
            DiscoverySessionStatus.Answered or
            DiscoverySessionStatus.Phase1Active or
            DiscoverySessionStatus.Phase2Active;

    // ── Lifecycle ──────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = await UserContextService.IsAdminAsync();
    }

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }

    protected override void OnParametersSet()
    {
        if (Session?.Questions == null) return;

        // Restore saved answers for current-round questions
        foreach (var q in CurrentQuestions)
        {
            if (!_answers.ContainsKey(q.Id))
            {
                if (q.Answer != null && !string.IsNullOrEmpty(q.Answer.AnswerText))
                    _answers[q.Id] = q.Answer.AnswerText;
            }
        }

        // Check if we should show the phase transition screen
        // Show it when Phase 1 is complete but Phase 2 hasn't started yet
        _showPhaseTransition = Session.Status == DiscoverySessionStatus.Phase1Complete
                             && !_loading;
    }

    // ── Event handlers ─────────────────────────────────────────────────────

    private async Task HandleContinue()
    {
        if (_submitting) return; // double-submit guard
        if (Session == null) { await OnCompleted.InvokeAsync(); return; }

        _submitting = true;
        StateHasChanged();

        var savedPhase = CurrentPhase;
        var savedRound = CurrentRound;

        try
        {
            var oid = await UserContextService.GetUpnAsync();
            var pairs = _answers.Select(kv => (kv.Key, (string?)kv.Value)).ToList();

            await DiscoveryService.SaveRoundAnswersAsync(
                Session.Id, savedPhase, savedRound, pairs, oid);

            // Enter the "waiting for next round" loading state and start polling
            _loadingNextRound = true;
            _submittedRound = savedRound;
            _submittedPhase = savedPhase;
            StateHasChanged();

            _ = StartPostSubmitPollingAsync(Session.Id, savedPhase, savedRound);
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DISCOVERY] Failed to save round answers for session {Session.Id}: {ex.Message}");
            Snackbar.Add("Could not save your answers. Please try again.", Severity.Error);
            _submitting = false;
            _loadingNextRound = false;
            StateHasChanged();
        }
    }

    /// <summary>
    /// Polls GetSessionAsync every 2s after submitting a round.
    /// Stops when new questions arrive (higher round) or the phase/session is complete.
    /// Times out after 60 seconds.
    /// </summary>
    private Task StartPostSubmitPollingAsync(Guid sessionId, int submittedPhase, int submittedRound)
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        var token = _pollCts.Token;

        var deadline = DateTime.UtcNow.AddSeconds(60);
        var submissionId = SubmissionId;

        _ = Task.Run(async () =>
        {
            try
            {
                while (DateTime.UtcNow < deadline && !token.IsCancellationRequested)
                {
                    await Task.Delay(2000, token);

                    DiscoverySession? updated;
                    try
                    {
                        updated = await DiscoveryService.GetSessionAsync(submissionId, token);
                    }
                    catch
                    {
                        continue;
                    }

                    if (updated == null) continue;

                    // Phase or session complete
                    if (updated.Status == DiscoverySessionStatus.Phase1Complete)
                    {
                        // Show the Phase 1 → Phase 2 transition screen; do NOT advance wizard yet
                        await InvokeAsync(async () =>
                        {
                            _loadingNextRound = false;
                            _submitting = false;
                            await OnSessionUpdated.InvokeAsync(updated);
                            _showPhaseTransition = true;
                            StateHasChanged();
                        });
                        return;
                    }

                    if (updated.Status == DiscoverySessionStatus.Phase2Complete)
                    {
                        await InvokeAsync(async () =>
                        {
                            _loadingNextRound = false;
                            _submitting = false;
                            await OnSessionUpdated.InvokeAsync(updated);
                            StateHasChanged();
                            await OnCompleted.InvokeAsync();
                        });
                        return;
                    }

                    // New round of questions available for the same phase
                    if (updated.Questions != null)
                    {
                        var phaseQs = updated.Questions.Where(q => q.Phase == submittedPhase).ToList();
                        var latestRound = phaseQs.Any() ? phaseQs.Max(q => q.Round) : 0;
                        if (latestRound > submittedRound)
                        {
                            await InvokeAsync(async () =>
                            {
                                _loadingNextRound = false;
                                _submitting = false;
                                // Clear answers for the new round (before parent re-renders)
                                _answers.Clear();
                                foreach (var q in phaseQs.Where(q => q.Round == latestRound))
                                {
                                    if (q.Answer != null && !string.IsNullOrEmpty(q.Answer.AnswerText))
                                        _answers[q.Id] = q.Answer.AnswerText;
                                }
                                await OnSessionUpdated.InvokeAsync(updated);
                                StateHasChanged();
                            });
                            return;
                        }
                    }
                }

                // Timeout — show error and re-enable submit
                await InvokeAsync(() =>
                {
                    _loadingNextRound = false;
                    _submitting = false;
                    Snackbar.Add("Timed out waiting for the next round. Please try submitting again.", Severity.Warning);
                    StateHasChanged();
                });
            }
            catch (OperationCanceledException) { }
            catch (Exception ex)
            {
                Console.Error.WriteLine($"[DISCOVERY] Post-submit poll error: {ex.Message}");
                await InvokeAsync(() =>
                {
                    _loadingNextRound = false;
                    _submitting = false;
                    Snackbar.Add("Error checking for next questions. Please try again.", Severity.Error);
                    StateHasChanged();
                });
            }
        }, token);

        return Task.CompletedTask;
    }

    private async Task HandlePhase1UserTerminate()
    {
        if (Session == null) return;
        try
        {
            var oid = await UserContextService.GetUpnAsync();
            // Save any current answers first (best-effort)
            if (_answers.Any())
            {
                var pairs = _answers.Select(kv => (kv.Key, (string?)kv.Value)).ToList();
                await DiscoveryService.SaveAnswersAsync(Session.Id, pairs, oid);
            }
            // Mark Phase 1 terminated by user via SaveRoundAnswersAsync with force-complete
            // We use a dedicated skip path: mark Phase1Complete with terminatedByUser=true
            await DiscoveryService.SaveRoundAnswersAsync(
                Session.Id, phase: 1, round: CurrentRound,
                answers: _answers.Select(kv => (kv.Key, (string?)kv.Value)),
                upn: oid);

            _showPhaseTransition = true;
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DISCOVERY] Phase1 user terminate failed: {ex.Message}");
            Snackbar.Add("Could not advance phase. Please try again.", Severity.Error);
        }
    }

    private async Task HandleAdvanceToPhase2()
    {
        if (Session == null || !_isAdmin) return;
        _advancing = true;
        StateHasChanged();
        try
        {
            var oid = await UserContextService.GetUpnAsync();
            await DiscoveryService.AdvanceToPhase2Async(Session.Id, oid);
            _showPhaseTransition = false;
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DISCOVERY] AdvanceToPhase2 failed: {ex.Message}");
            Snackbar.Add("Could not advance to Phase 2. Please try again.", Severity.Error);
        }
        finally
        {
            _advancing = false;
            StateHasChanged();
        }
    }

    private async Task HandlePhase2Skip()
    {
        if (Session == null || !_isAdmin) return;
        try
        {
            var oid = await UserContextService.GetUpnAsync();
            // Treat Phase 2 skip as completed — save any current answers then advance
            if (_answers.Any())
            {
                var pairs = _answers.Select(kv => (kv.Key, (string?)kv.Value)).ToList();
                await DiscoveryService.SaveAnswersAsync(Session.Id, pairs, oid);
            }
            await OnCompleted.InvokeAsync();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"[DISCOVERY] Phase2 skip failed: {ex.Message}");
            Snackbar.Add("Could not skip Phase 2. Please try again.", Severity.Error);
        }
    }

    private async Task HandleSkip()
    {
        if (Session != null)
        {
            var oid = await UserContextService.GetUpnAsync();
            await DiscoveryService.SkipDiscoveryAsync(Session.Id, oid);
        }
        await OnSkipped.InvokeAsync();
    }
}
