# Debian-based Dockerfile for local WSL2 builds and AWS CodeBuild (MCR-free)
# Build context: ~/projects/fip/ (repo root — needed for shared/FipShared reference)
# Uses ECR-mirrored debian:bookworm-slim to avoid Docker Hub rate limits in CodeBuild
# Build stage - uses Debian + dotnet-install script
ARG DEBIAN_IMAGE=742932328420.dkr.ecr.us-east-1.amazonaws.com/debian:bookworm-slim
FROM ${DEBIAN_IMAGE} AS build
WORKDIR /src

# Install .NET 8 SDK dependencies + curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libicu72 \
    libssl3 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install .NET 8 SDK via dotnet-install.sh (avoids MCR CDN issue on WSL2)
ENV DOTNET_ROOT=/usr/local/lib/dotnet
ENV PATH="$PATH:/usr/local/lib/dotnet"
RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
    | bash -s -- --channel 8.0 --install-dir /usr/local/lib/dotnet \
    && dotnet --info

# Copy shared project (referenced as ../../../shared/FipShared from nexus/src/FortressNexus.Web)
COPY shared/FipShared/ /src/shared/FipShared/

# Copy Nexus project files for restore caching
COPY nexus/src/FortressNexus.Web/FortressNexus.Web.csproj /src/nexus/src/FortressNexus.Web/

# Restore — csproj path relative to /src
WORKDIR /src/nexus/src/FortressNexus.Web
RUN dotnet restore "FortressNexus.Web.csproj"

# Copy full Nexus source
COPY nexus/src/ /src/nexus/src/

# Publish
WORKDIR /src/nexus/src/FortressNexus.Web
RUN dotnet publish "FortressNexus.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage - uses Debian + ASP.NET Core runtime only
ARG DEBIAN_IMAGE=742932328420.dkr.ecr.us-east-1.amazonaws.com/debian:bookworm-slim
FROM ${DEBIAN_IMAGE} AS final
WORKDIR /app
EXPOSE 8080

# Install .NET 8 ASP.NET Core Runtime dependencies + curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libicu72 \
    libssl3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Install .NET 8 ASP.NET Core Runtime via dotnet-install.sh
ENV DOTNET_ROOT=/usr/local/lib/dotnet
ENV PATH="$PATH:/usr/local/lib/dotnet"
RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
    | bash -s -- --channel 8.0 --runtime aspnetcore --install-dir /usr/local/lib/dotnet \
    && dotnet --info

ENV ASPNETCORE_URLS=http://+:8080
RUN mkdir -p /app/keys && chmod 755 /app/keys
COPY --from=build /app/publish .
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:8080/health || exit 1
ENTRYPOINT ["dotnet", "FortressNexus.Web.dll"]
