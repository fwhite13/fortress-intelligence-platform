@page "/Error"
@attribute [AllowAnonymous]

<PageTitle>Error — RISE</PageTitle>

<div style="display: flex; align-items: center; justify-content: center; min-height: 80vh;">
    <MudCard Style="background: #F5F5F3; border: 1px solid #E0DFDB; border-radius: 12px; padding: 2rem; max-width: 420px; width: 100%;">
        <MudCardContent>
            <div style="text-align: center;">
                <MudIcon Icon="@Icons.Material.Filled.Error" Style="font-size: 3rem; color: #A97C50; margin-bottom: 1rem;" />
                <MudText Typo="Typo.h5" Style="color: #194C5C; font-weight: 700;">Something went wrong</MudText>
                <MudText Typo="Typo.body2" Style="color: #7A776E; margin-top: 0.5rem;">
                    An unexpected error occurred. Please try again or contact support.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/" Style="margin-top: 1.5rem;">
                    Return Home
                </MudButton>
            </div>
        </MudCardContent>
    </MudCard>
</div>
