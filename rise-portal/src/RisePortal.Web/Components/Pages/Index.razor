@page "/"
@attribute [Authorize]
@inject IDbContextFactory<RisePortalContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>RISE — Refuge Intelligence Suite for Enterprise</PageTitle>

<div class="portal-wrapper">
    <div class="portal-header">
        <MudText Typo="Typo.h4" Class="portal-title">Your Applications</MudText>
    </div>

    <MudGrid Justify="Justify.Center" Class="portal-grid">

        @if (_cards != null && _cards.Count == 0)
        {
            <MudItem xs="12">
                <MudText Typo="Typo.body1" Style="text-align: center; color: #7A776E; padding: 2rem;">
                    No applications are available for your account.
                </MudText>
            </MudItem>
        }

        @foreach (var card in _cards ?? new List<RiseAppCard>())
        {
            <MudItem xs="12" sm="6" md="5" lg="4">
                <MudCard Class="app-tile" Elevation="2">
                    <MudCardContent Class="app-tile-content">
                        <div class="app-icon-wrap">
                            <span style="font-size: 2.5rem; line-height: 1;">@card.Icon</span>
                        </div>
                        <MudText Typo="Typo.h6" Class="app-name">@card.DisplayName</MudText>
                        <MudText Typo="Typo.body2" Class="app-description">
                            @card.Description
                        </MudText>
                    </MudCardContent>
                    <MudCardActions Class="app-tile-actions">
                        <MudButton Variant="Variant.Outlined"
                                   Href="@card.Url"
                                   Target="_blank"
                                   Class="app-open-btn"
                                   FullWidth="true">
                            Open
                        </MudButton>
                    </MudCardActions>
                </MudCard>
            </MudItem>
        }

        <!-- Coming Soon (always last, hardcoded) -->
        <MudItem xs="12" sm="6" md="5" lg="4">
            <MudCard Class="app-tile app-tile--disabled" Elevation="0">
                <MudCardContent Class="app-tile-content">
                    <div class="app-icon-wrap app-icon-wrap--disabled">
                        <MudIcon Icon="@Icons.Material.Filled.RocketLaunch" Style="font-size: 2.5rem; color: #B0ADA6;" />
                    </div>
                    <MudText Typo="Typo.h6" Class="app-name app-name--disabled">More Coming Soon</MudText>
                    <MudText Typo="Typo.body2" Class="app-description app-description--disabled">
                        New intelligence tools are on the way.
                    </MudText>
                </MudCardContent>
                <MudCardActions Class="app-tile-actions">
                    <MudButton Variant="Variant.Filled"
                               Disabled="true"
                               Class="app-open-btn app-open-btn--disabled"
                               FullWidth="true">
                        Coming Soon
                    </MudButton>
                </MudCardActions>
            </MudCard>
        </MudItem>

    </MudGrid>

    <div class="portal-footer">
        <MudText Typo="Typo.caption" Style="color: #B0ADA6;">
            &copy; 2026 Refuge Intelligence Suite for Enterprise (RISE). All rights reserved.
        </MudText>
    </div>
</div>

@code {
    private List<RiseAppCard>? _cards;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var userOid = authState.User
            .FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
            ?? authState.User.FindFirst("oid")?.Value;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var allActive = await db.RiseAppCards
                .Where(c => c.Active)
                .OrderBy(c => c.SortOrder)
                .ToListAsync();

            if (string.IsNullOrEmpty(userOid))
            {
                _cards = allActive.Where(c => !c.Restricted).ToList();
            }
            else
            {
                var accessibleIds = await db.RiseAppCardAccesses
                    .Where(a => a.EntraOid == userOid)
                    .Select(a => a.AppCardId)
                    .ToListAsync();

                _cards = allActive
                    .Where(c => !c.Restricted || accessibleIds.Contains(c.Id))
                    .ToList();
            }
        }
        catch
        {
            _cards = new List<RiseAppCard>();
        }
    }
}
