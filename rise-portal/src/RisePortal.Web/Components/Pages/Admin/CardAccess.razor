@page "/admin/cards/{Id:int}/access"
@attribute [Authorize]
@inject IDbContextFactory<RisePortalContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Access List — RISE Admin</PageTitle>

@if (!_initialized)
{
    <div style="display: flex; justify-content: center; padding: 3rem;">
        <MudProgressCircular Indeterminate="true" />
    </div>
}
else
{
    <div style="padding: 24px; max-width: 960px; margin: 0 auto;">
        <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
                   Href="/admin" Style="margin-bottom: 16px;">
            Back to Cards
        </MudButton>

        <MudText Typo="Typo.h5" Style="color: #194C5C; margin-bottom: 20px;">
            Access: @(_card?.DisplayName ?? "Card")
        </MudText>

        <MudTable Items="_accessList" Dense="true" Striped="true" Elevation="2">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Email</MudTh>
                <MudTh>OID</MudTh>
                <MudTh>Granted</MudTh>
                <MudTh>Granted By</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate Context="entry">
                <MudTd>@(entry.DisplayName ?? "—")</MudTd>
                <MudTd>@(entry.Email ?? "—")</MudTd>
                <MudTd>
                    <MudText Typo="Typo.caption">@entry.EntraOid</MudText>
                </MudTd>
                <MudTd>@(entry.GrantedAt?.ToString("yyyy-MM-dd") ?? "—")</MudTd>
                <MudTd>
                    <MudText Typo="Typo.caption">@(entry.GrantedByOid ?? "—")</MudText>
                </MudTd>
                <MudTd>
                    <MudButton Color="Color.Error" Variant="Variant.Outlined"
                               Size="Size.Small" OnClick="@(() => RemoveAccess(entry))">
                        Remove
                    </MudButton>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Typo="Typo.body2" Style="padding: 1rem; color: #7A776E;">
                    No users on this access list.
                </MudText>
            </NoRecordsContent>
        </MudTable>

        <MudDivider Style="margin: 28px 0;" />

        <MudText Typo="Typo.h6" Style="margin-bottom: 16px;">Add User</MudText>

        <MudGrid>
            <MudItem xs="12" md="6">
                <MudAutocomplete T="RiseUser"
                                 Label="Search by name or email"
                                 @bind-Value="_selectedUser"
                                 SearchFunc="SearchUsers"
                                 ToStringFunc="@(u => u == null ? "" : $"{u.DisplayName} ({u.Email})")"
                                 ResetValueOnEmptyText="true"
                                 Clearable="true" />
            </MudItem>
            <MudItem xs="12" md="6">
                <MudTextField T="string" @bind-Value="_manualOid"
                              Label="Or enter Entra OID manually"
                              HelperText="Use this for users who haven't logged in yet" />
            </MudItem>
            <MudItem xs="12">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddAccess">
                    Grant Access
                </MudButton>
            </MudItem>
        </MudGrid>
    </div>
}

@code {
    [Parameter] public int Id { get; set; }

    private RiseAppCard? _card;
    private List<RiseAppCardAccess> _accessList = new();
    private bool _initialized;
    private string? _adminOid;
    private RiseUser? _selectedUser;
    private string? _manualOid;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        _adminOid = authState.User
            .FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
            ?? authState.User.FindFirst("oid")?.Value;

        if (string.IsNullOrEmpty(_adminOid))
        {
            Nav.NavigateTo("/");
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();

        var isAdmin = await db.RiseAdminUsers.AnyAsync(a => a.EntraOid == _adminOid);
        if (!isAdmin)
        {
            Nav.NavigateTo("/");
            return;
        }

        _card = await db.RiseAppCards.FindAsync(Id);
        if (_card == null)
        {
            Nav.NavigateTo("/admin");
            return;
        }

        _accessList = await db.RiseAppCardAccesses
            .Where(a => a.AppCardId == Id)
            .OrderBy(a => a.DisplayName)
            .ToListAsync();

        _initialized = true;
    }

    private async Task<IEnumerable<RiseUser>> SearchUsers(string? text, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(text)) return Enumerable.Empty<RiseUser>();
        await using var db = await DbFactory.CreateDbContextAsync();
        return await db.RiseUsers
            .Where(u => (u.DisplayName != null && u.DisplayName.Contains(text))
                     || (u.Email != null && u.Email.Contains(text)))
            .Take(10)
            .ToListAsync(token);
    }

    private async Task RemoveAccess(RiseAppCardAccess entry)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Database.ExecuteSqlRawAsync(
                "DELETE FROM rise_app_card_access WHERE id = {0}", entry.Id);
            _accessList.Remove(entry);
            Snackbar.Add("Access removed.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Remove failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task AddAccess()
    {
        var oidToAdd = _selectedUser?.EntraOid ?? _manualOid?.Trim();
        if (string.IsNullOrEmpty(oidToAdd))
        {
            Snackbar.Add("Select a user or enter an OID.", Severity.Warning);
            return;
        }

        if (_accessList.Any(e => e.EntraOid == oidToAdd))
        {
            Snackbar.Add("This user already has access.", Severity.Warning);
            return;
        }

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var now = DateTime.UtcNow;
            await db.Database.ExecuteSqlRawAsync(
                @"INSERT IGNORE INTO rise_app_card_access
                    (app_card_id, entra_oid, email, display_name, granted_at, granted_by_oid)
                  VALUES ({0}, {1}, {2}, {3}, {4}, {5})",
                Id, oidToAdd,
                _selectedUser?.Email ?? "",
                _selectedUser?.DisplayName ?? "",
                now,
                _adminOid ?? "");

            _accessList.Add(new RiseAppCardAccess
            {
                AppCardId = Id,
                EntraOid = oidToAdd,
                Email = _selectedUser?.Email,
                DisplayName = _selectedUser?.DisplayName,
                GrantedAt = now,
                GrantedByOid = _adminOid,
                AppCard = _card!
            });

            _selectedUser = null;
            _manualOid = null;
            Snackbar.Add("Access granted.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Grant failed: {ex.Message}", Severity.Error);
        }
    }
}
