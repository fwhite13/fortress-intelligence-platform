# Debian-based Dockerfile for RISE Portal
# Build context: ~/projects/fip/ (repo root)
ARG DEBIAN_IMAGE=742932328420.dkr.ecr.us-east-1.amazonaws.com/debian:bookworm-slim
FROM ${DEBIAN_IMAGE} AS build
WORKDIR /src

# Install .NET 8 SDK dependencies + curl
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libicu72 \
    libssl3 \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install .NET 8 SDK via dotnet-install.sh
ENV DOTNET_ROOT=/usr/local/lib/dotnet
ENV PATH="$PATH:/usr/local/lib/dotnet"
RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
    | bash -s -- --channel 8.0 --install-dir /usr/local/lib/dotnet \
    && dotnet --info

# Copy project file for restore caching
COPY rise-portal/src/RisePortal.Web/RisePortal.Web.csproj /src/rise-portal/src/RisePortal.Web/

# Restore
WORKDIR /src/rise-portal/src/RisePortal.Web
RUN dotnet restore "RisePortal.Web.csproj"

# Copy full source
COPY rise-portal/src/ /src/rise-portal/src/

# Publish
WORKDIR /src/rise-portal/src/RisePortal.Web
RUN dotnet publish "RisePortal.Web.csproj" -c Release -o /app/publish /p:UseAppHost=false

# Runtime stage
ARG DEBIAN_IMAGE=742932328420.dkr.ecr.us-east-1.amazonaws.com/debian:bookworm-slim
FROM ${DEBIAN_IMAGE} AS final
WORKDIR /app
EXPOSE 8080

# Install .NET 8 ASP.NET Core Runtime dependencies + curl for healthcheck
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    libicu72 \
    libssl3 \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Install .NET 8 ASP.NET Core Runtime
ENV DOTNET_ROOT=/usr/local/lib/dotnet
ENV PATH="$PATH:/usr/local/lib/dotnet"
RUN curl -sSL https://dot.net/v1/dotnet-install.sh \
    | bash -s -- --channel 8.0 --runtime aspnetcore --install-dir /usr/local/lib/dotnet \
    && dotnet --info

ENV ASPNETCORE_URLS=http://+:8080
RUN mkdir -p /app/keys && chmod 755 /app/keys
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "RisePortal.Web.dll"]
