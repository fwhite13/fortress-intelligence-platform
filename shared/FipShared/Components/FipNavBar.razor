@using FipShared.Models
@using MudBlazor
@using Microsoft.AspNetCore.Hosting
@using Microsoft.Extensions.Configuration
@namespace FipShared.Components
@inject IWebHostEnvironment HostEnv
@inject IConfiguration Configuration

<div class="fip-navbar">
    <div class="fip-navbar__left">
        <MudIconButton Icon="@Icons.Material.Filled.Menu"
                       Color="Color.Inherit"
                       OnClick="OnMenuClick"
                       aria-label="Open menu" />

        <div class="fip-navbar__brand">
            <svg class="fip-navbar__shield" width="28" height="32" viewBox="0 0 28 32" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                <path d="M14 1L2 6V16C2 22.627 7.373 29.254 14 31C20.627 29.254 26 22.627 26 16V6L14 1Z" fill="currentColor" stroke="var(--color-gold)" stroke-width="1.5"/>
                <path d="M14 7L8 10V16C8 19.314 10.686 22.627 14 23.5C17.314 22.627 20 19.314 20 16V10L14 7Z" fill="var(--color-gold)" opacity="0.85"/>
            </svg>
            <span class="fip-navbar__module-name">@(ModuleDisplayName ?? ActiveModule.ShortName())</span>
        </div>
    </div>

    <div class="fip-navbar__right">
        <MudMenu Icon="@Icons.Material.Filled.Apps"
                 Color="Color.Inherit"
                 AnchorOrigin="Origin.BottomRight"
                 TransformOrigin="Origin.TopRight"
                 aria-label="Switch app">
            @if (WaffleOverride != null)
            {
                @WaffleOverride
            }
            else
            {
                @foreach (var module in Enum.GetValues<FipModule>())
                {
                    if (IsVisible(module))
                    {
                        <MudMenuItem Href="@module.Url()">
                            <div class="fip-waffle-item">
                                <MudText Typo="Typo.body1">@module.ShortName()</MudText>
                                <MudText Typo="Typo.caption" Class="fip-waffle-sublabel">@module.FullName()</MudText>
                            </div>
                        </MudMenuItem>
                    }
                }
            }
        </MudMenu>

        <MudMenu AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            <ActivatorContent>
                <MudAvatar Color="Color.Primary" Size="Size.Small" Class="fip-navbar__avatar">
                    @(string.IsNullOrWhiteSpace(UserInitial) ? "?" : UserInitial.Substring(0, 1).ToUpperInvariant())
                </MudAvatar>
            </ActivatorContent>
            <ChildContent>
                <div class="fip-avatar-header">
                    <MudText Typo="Typo.body1">@UserName</MudText>
                    <MudText Typo="Typo.caption">@UserEmail</MudText>
                </div>
                <MudDivider />
                <MudMenuItem OnClick="HandleSignOut">Sign out</MudMenuItem>
            </ChildContent>
        </MudMenu>
    </div>
</div>

@if (IsDev)
{
    <div class="fip-dev-banner" @onclick="OpenDebugDialog" @onclick:stopPropagation="true" style="cursor: pointer;" title="Click for debug info">⚠ Development Environment</div>
    @if (_debugDialogOpen)
    {
        <MudDialog @bind-IsVisible="_debugDialogOpen" Options="@(new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true })">
            <TitleContent><MudText Typo="Typo.h6">Dev Environment Info</MudText></TitleContent>
            <DialogContent>
                <MudStack Spacing="2">
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Environment</MudText>
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@(HostEnv.EnvironmentName)</MudText>
                    </div>
                    <div>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Version</MudText>
                        <MudText Typo="Typo.body2" Style="font-family: monospace;">@(Configuration["BUILD_VERSION"] ?? Configuration["ASPNETCORE_ENVIRONMENT"] ?? "dev")</MudText>
                    </div>
                </MudStack>
            </DialogContent>
            <DialogActions>
                <MudButton OnClick="@(() => _debugDialogOpen = false)" Color="Color.Primary">Close</MudButton>
            </DialogActions>
        </MudDialog>
    }
}

@code {
    [Parameter, EditorRequired] public FipModule ActiveModule { get; set; }
    [Parameter] public string? ModuleDisplayName { get; set; }
    [Parameter] public string UserInitial { get; set; } = string.Empty;
    [Parameter] public string UserName { get; set; } = string.Empty;
    [Parameter] public string UserEmail { get; set; } = string.Empty;
    [Parameter] public IEnumerable<FipModule>? HiddenModules { get; set; }
    [Parameter] public RenderFragment? WaffleOverride { get; set; }
    [Parameter] public EventCallback OnMenuClick { get; set; }
    [Parameter] public EventCallback OnSignOut { get; set; }
    [Parameter] public bool IsDev { get; set; } = false;

    private bool _debugDialogOpen = false;

    private void OpenDebugDialog()
    {
        _debugDialogOpen = true;
        StateHasChanged();
    }

    private bool IsVisible(FipModule module) =>
        module == ActiveModule || HiddenModules == null || !HiddenModules.Contains(module);

    private async Task HandleSignOut()
    {
        await OnSignOut.InvokeAsync();
    }
}
