@using Microsoft.AspNetCore.Components.Routing
@inject TaskService TaskSvc
@inject UserSessionService UserSession

<div class="famos-nav-group">
    <div class="famos-nav-section-label">
        Main
    </div>

    <NavLink href="/" Match="NavLinkMatch.All" class="famos-nav-item" ActiveClass="famos-nav-item--active">
        <span class="famos-nav-icon">
            <MudIcon Icon="@FamosIcons.Dashboard" Size="Size.Small" />
        </span>
        Dashboard
    </NavLink>

    <NavLink href="/pipeline" Match="NavLinkMatch.Prefix" class="famos-nav-item" ActiveClass="famos-nav-item--active">
        <span class="famos-nav-icon">
            <MudIcon Icon="@FamosIcons.Pipeline" Size="Size.Small" />
        </span>
        Pipeline
    </NavLink>

    <NavLink href="/tasks" Match="NavLinkMatch.Prefix" class="famos-nav-item" ActiveClass="famos-nav-item--active">
        <span class="famos-nav-icon">
            <MudIcon Icon="@FamosIcons.Tasks" Size="Size.Small" />
        </span>
        <span style="flex:1;">Task Center</span>
        @if (_openTaskCount > 0)
        {
            <span class="famos-nav-badge" style="background:var(--red); color:#fff; min-width:18px; text-align:center;">
                @_openTaskCount
            </span>
        }
    </NavLink>

    <div class="famos-nav-divider"></div>

    <NavLink href="/accounts" Match="NavLinkMatch.Prefix"
             class="famos-nav-item" ActiveClass="famos-nav-item--active">
        <span class="famos-nav-icon">
            <MudIcon Icon="@FamosIcons.Accounts" Size="Size.Small" />
        </span>
        Accounts
    </NavLink>

    <NavLink href="/notes" Match="NavLinkMatch.Prefix" class="famos-nav-item" ActiveClass="famos-nav-item--active">
        <span class="famos-nav-icon">
            <MudIcon Icon="@Icons.Material.Outlined.StickyNote2" Size="Size.Small" />
        </span>
        Team Notes
    </NavLink>

    <span class="famos-nav-item famos-nav-item--disabled">
        <span class="famos-nav-icon">
            <MudIcon Icon="@FamosIcons.BarChart" Size="Size.Small" />
        </span>
        Reports
        <span class="famos-nav-badge">Soon</span>
    </span>
</div>

@code {
    private int _openTaskCount = 0;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var userId = await UserSession.GetUserIdAsync();
            _openTaskCount = await TaskSvc.GetOpenTaskCountForUserAsync(userId);
        }
        catch { /* Non-fatal — badge just won't show */ }
    }
}
