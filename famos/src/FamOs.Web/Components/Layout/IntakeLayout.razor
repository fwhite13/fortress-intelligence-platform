@inherits LayoutComponentBase
@namespace FamOs.Web.Components.Layout

<div class="intake-standalone-root">
    <header class="intake-standalone-header">
        <div class="intake-standalone-header-inner">
            <div class="intake-standalone-brand">
                <div class="intake-tig-logo-box">
                    <img src="images/affinity/tig-logo.svg" class="intake-tig-logo" alt="TIG Insurance Group" />
                </div>
                <span class="intake-standalone-brand-name">Titan Insurance Group</span>
            </div>
        </div>
    </header>
    <main class="intake-standalone-main">
        @Body
    </main>
    <footer class="intake-standalone-footer">
        <p>© @DateTime.UtcNow.Year TIG Insurance Group. Secure application. Questions? Call us at 1-800-TIG-TRUCK.</p>
    </footer>
</div>

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />
