@using FamOs.Web.Data.Entities

<div class="famos-kcard @(IsUrgent ? "famos-kcard--urgent" : "") @(IsStaleUrgent ? "famos-kcard--stale-urgent" : IsStaleWarn ? "famos-kcard--stale-warn" : "")"
     @onclick="OnCardClick">
    <div style="display:flex; justify-content:space-between; align-items:flex-start;">
        <div class="famos-kcard-name" style="flex:1; min-width:0;">@Opportunity.Name</div>
        @if (!string.IsNullOrEmpty(Opportunity.OwnerUserId))
        {
            var initials = GetInitials(Opportunity.OwnerUserId);
            <div style="width:24px; height:24px; border-radius:50%; background:#C0272D;
                        color:#fff; font-size:10px; font-weight:700; flex-shrink:0;
                        display:flex; align-items:center; justify-content:center;
                        margin-left:6px;">
                @initials
            </div>
        }
    </div>
    @if (Opportunity.EstimatedPremium.HasValue)
    {
        <div class="famos-kcard-detail">$@Opportunity.EstimatedPremium.Value.ToString("N0")</div>
    }
    @if (Opportunity.EffectiveDateTarget.HasValue)
    {
        <div class="famos-kcard-detail">Eff: @Opportunity.EffectiveDateTarget.Value.ToString("MMM d, yyyy")</div>
    }
    <div class="famos-kcard-footer">
        <SignalChip Signal="Opportunity.DominantSignal" />
        @if (IsStaleUrgent)
        {
            <span class="famos-stale-badge famos-stale-urgent">@DaysStale&#x202F;d stale</span>
        }
        else if (IsStaleWarn)
        {
            <span class="famos-stale-badge famos-stale-warn">@DaysStale&#x202F;d stale</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Opportunity Opportunity { get; set; } = default!;
    [Parameter] public EventCallback<Opportunity> OnClick { get; set; }

    private bool IsUrgent => Opportunity.DominantSignal is
        FamOs.Web.Domain.DominantSignal.TimeRisk or
        FamOs.Web.Domain.DominantSignal.Urgent or
        FamOs.Web.Domain.DominantSignal.AtRisk;

    private DateTime StaleReference =>
        Opportunity.LastStageTransitionAt ?? Opportunity.UpdatedAt;

    private int DaysStale => (int)(DateTime.UtcNow - StaleReference).TotalDays;

    private bool IsStaleWarn   => DaysStale >= 14 && DaysStale < 21;
    private bool IsStaleUrgent => DaysStale >= 21;
    private bool IsAnyStale    => IsStaleWarn || IsStaleUrgent;

    private async Task OnCardClick() => await OnClick.InvokeAsync(Opportunity);

    private static string GetInitials(string userId)
    {
        var atIdx = userId.IndexOf('@');
        var local = atIdx > 0 ? userId[..atIdx] : userId;
        var parts = local.Split(new[] { '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2)
            return $"{parts[0][0]}{parts[1][0]}".ToUpper();
        return local.Length >= 2
            ? local[..2].ToUpper()
            : local.ToUpper();
    }
}
