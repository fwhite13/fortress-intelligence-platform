@page "/accounts"
@attribute [Authorize]
@inject IAccountSyncService AccountSync
@inject UserAffinityService AffinitySvc
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDbContextFactory<FamOs.Web.Data.FamOsDbContext> DbFactory
@inject IDialogService DialogService
@using FamOs.Web.Data.Entities
@using FamOs.Web.Services
@using FamOs.Web.Theme
@using Microsoft.EntityFrameworkCore
@using FamOs.Web.Components.Dialogs

<PageTitle>Accounts — FAM OS</PageTitle>

<div class="famos-page-header famos-page-header-row mb-4">
    <div>
        <h2 class="famos-page-h2">Accounts</h2>
        <p class="famos-page-sub">@_filteredAccounts.Count of @_accounts.Count member companies</p>
    </div>
    <div style="display:flex; gap:8px;">
        <MudButton Class="famos-btn-outline-sm"
                   StartIcon="@Icons.Material.Filled.FilterList"
                   OnClick="@(() => _showFilters = !_showFilters)">
            @(_showFilters ? "Hide Filters" : "Filters")
        </MudButton>
        <MudButton Class="famos-btn-outline-sm"
                   StartIcon="@FamosIcons.Download"
                   OnClick="SyncNow"
                   Disabled="_syncing">
            @(_syncing ? "Syncing..." : "Sync from HubSpot")
        </MudButton>
    </div>
</div>

@if (_showFilters)
{
    <div class="famos-filter-panel">
        <MudTextField Class="famos-input-filter"
                      @bind-Value="_search" @bind-Value:event="oninput"
                      Placeholder="Search accounts..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@FamosIcons.Search"
                      Clearable="true"
                      Style="min-width:220px;" />

        <MudSelect T="string"
                   @bind-Value="_filterState"
                   Label="State"
                   Clearable="true"
                   Style="min-width:140px;">
            @foreach (var state in _distinctStates)
            {
                <MudSelectItem T="string" Value="@state">@state</MudSelectItem>
            }
        </MudSelect>

        <MudSelect T="string"
                   @bind-Value="_filterOpps"
                   Label="Active Opps"
                   Style="min-width:140px;">
            <MudSelectItem T="string" Value="@("All")">All</MudSelectItem>
            <MudSelectItem T="string" Value="@("HasOpps")">Has Opps</MudSelectItem>
            <MudSelectItem T="string" Value="@("NoOpps")">No Opps</MudSelectItem>
        </MudSelect>

        <MudButton Class="famos-btn-primary-sm" OnClick="ApplyFilters">Apply</MudButton>
        <MudButton Class="famos-btn-outline-sm" OnClick="ClearFilters">Clear</MudButton>
    </div>
}

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (!_accounts.Any())
{
    <div class="famos-empty-state" style="margin-top:40px;">
        <MudIcon Icon="@FamosIcons.Accounts" Class="famos-empty-icon" />
        <div>No accounts synced yet.</div>
        <div style="margin-top:8px;">
            <MudButton Class="famos-btn-primary" OnClick="SyncNow" Disabled="_syncing">
                Sync from HubSpot
            </MudButton>
        </div>
    </div>
}
else
{
    <MudPaper Elevation="0" Style="border:1px solid var(--border); border-radius:12px; overflow:hidden;">

        @* Header row *@
        <div class="famos-account-table-header">
            <div class="famos-account-col-name famos-sort-header" @onclick='() => SortBy("Company")'>
                Company @SortIcon("Company")
            </div>
            <div class="famos-account-col-location famos-sort-header" @onclick='() => SortBy("Location")'>
                Location @SortIcon("Location")
            </div>
            <div class="famos-account-col-opps famos-sort-header" @onclick='() => SortBy("ActiveOpps")'>
                Active Opps @SortIcon("ActiveOpps")
            </div>
            <div class="famos-account-col-sync famos-sort-header" @onclick='() => SortBy("LastSynced")'>
                Last Synced @SortIcon("LastSynced")
            </div>
            <div class="famos-account-col-action"></div>
        </div>

        @foreach (var account in _filteredAccounts)
        {
            <div class="famos-account-row"
                 @onclick="async () => await GoToAccount(account)">
                <div class="famos-account-col-name">
                    <span class="famos-text-navy famos-fw-600">@account.CompanyName</span>
                </div>
                <div class="famos-account-col-location">
                    @if (!string.IsNullOrEmpty(account.City) || !string.IsNullOrEmpty(account.State))
                    {
                        <span class="famos-meta-text">
                            @(account.City)@(account.City != null && account.State != null ? ", " : "")@(account.State)
                        </span>
                    }
                    else
                    {
                        <span class="famos-meta-text">—</span>
                    }
                </div>
                <div class="famos-account-col-opps">
                    @if (account.ActiveOppCount > 0)
                    {
                        <MudChip T="string" Size="Size.Small"
                                 Style="background:rgba(192,39,45,0.1); color:#C0272D; font-weight:600; font-size:11px;">
                            @account.ActiveOppCount active
                        </MudChip>
                    }
                    else
                    {
                        <span class="famos-meta-text">No active opps</span>
                    }
                </div>
                <div class="famos-account-col-sync">
                    <span class="famos-meta-text">
                        @(account.LastSyncedAt.HasValue
                            ? account.LastSyncedAt.Value.ToLocalTime().ToString("MMM d, h:mm tt")
                            : "Never")
                    </span>
                </div>
                <div class="famos-account-col-action">
                    <MudIcon Icon="@FamosIcons.ChevronRight"
                             Style="font-size:16px; color:var(--muted);" />
                </div>
            </div>
        }

    </MudPaper>

    @if (_lastSyncTime.HasValue)
    {
        <div class="famos-meta-text" style="margin-top:8px; text-align:right;">
            Last HubSpot sync: @_lastSyncTime.Value.ToLocalTime().ToString("MMM d, yyyy 'at' h:mm tt")
        </div>
    }
}

@code {
    private List<Account> _accounts         = new();
    private bool          _loading          = true;
    private bool          _syncing          = false;
    private string        _search           = "";
    private DateTime?     _lastSyncTime;
    private bool          _showFilters      = false;
    private string        _filterState      = "";
    private string        _filterOpps       = "All";
    private string        _sortColumn       = "Company";
    private bool          _sortAsc          = true;

    private IEnumerable<string> _distinctStates =>
        _accounts
            .Where(a => !string.IsNullOrEmpty(a.State))
            .Select(a => a.State!)
            .Distinct()
            .OrderBy(s => s);

    private List<Account> _filteredAccounts
    {
        get
        {
            var query = _accounts.AsEnumerable();

            // Text search
            if (!string.IsNullOrWhiteSpace(_search))
                query = query.Where(a =>
                    a.CompanyName.Contains(_search, StringComparison.OrdinalIgnoreCase) ||
                    (a.City?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false) ||
                    (a.State?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false));

            // State filter
            if (!string.IsNullOrWhiteSpace(_filterState))
                query = query.Where(a => a.State == _filterState);

            // Active opps filter
            if (_filterOpps == "HasOpps")
                query = query.Where(a => a.ActiveOppCount > 0);
            else if (_filterOpps == "NoOpps")
                query = query.Where(a => a.ActiveOppCount == 0);

            // Sort
            query = _sortColumn switch
            {
                "Company"    => _sortAsc ? query.OrderBy(a => a.CompanyName)    : query.OrderByDescending(a => a.CompanyName),
                "Location"   => _sortAsc ? query.OrderBy(a => a.State).ThenBy(a => a.City) : query.OrderByDescending(a => a.State).ThenByDescending(a => a.City),
                "ActiveOpps" => _sortAsc ? query.OrderBy(a => a.ActiveOppCount) : query.OrderByDescending(a => a.ActiveOppCount),
                "LastSynced" => _sortAsc ? query.OrderBy(a => a.LastSyncedAt)   : query.OrderByDescending(a => a.LastSyncedAt),
                _            => query.OrderBy(a => a.CompanyName),
            };

            return query.ToList();
        }
    }

    private void SortBy(string column)
    {
        if (_sortColumn == column) _sortAsc = !_sortAsc;
        else { _sortColumn = column; _sortAsc = true; }
    }

    private RenderFragment SortIcon(string column) => builder =>
    {
        if (_sortColumn != column) return;
        builder.OpenElement(0, "span");
        builder.AddContent(1, _sortAsc ? " ▲" : " ▼");
        builder.CloseElement();
    };

    private void ApplyFilters() { /* filters are reactive via _filteredAccounts */ }

    private void ClearFilters()
    {
        _search      = "";
        _filterState = "";
        _filterOpps  = "All";
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();
        await using var db = await DbFactory.CreateDbContextAsync();
        _accounts = await db.Accounts
            .Where(a => a.AffinityId == affinityId)
            .OrderBy(a => a.CompanyName)
            .ToListAsync();
        _lastSyncTime = _accounts.Any() ? _accounts.Max(a => a.LastSyncedAt) : null;
        _loading = false;
    }

    private async Task SyncNow()
    {
        _syncing = true;
        try
        {
            var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();
            await AccountSync.SyncAsync(affinityId);
            await LoadAsync();
            Snackbar.Add("Accounts synced from HubSpot.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Sync failed: {ex.Message}", Severity.Error);
        }
        finally { _syncing = false; }
    }

    private async Task GoToAccount(Account account)
    {
        if (account.ActiveOppCount == 0)
        {
            var parameters = new DialogParameters<OpportunityCreateDialog>
            {
                { x => x.InitialCompanyName, account.CompanyName }
            };
            var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
            await DialogService.ShowAsync<OpportunityCreateDialog>("New Opportunity", parameters, options);
        }
        else if (account.ActiveOppCount == 1)
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();
            var opp = await db.Opportunities
                .Where(o => !o.IsClosed
                    && o.AffinityId == affinityId
                    && EF.Functions.Like(o.Name, $"%{account.CompanyName}%"))
                .Select(o => o.Id)
                .FirstOrDefaultAsync();
            if (opp != default)
                Nav.NavigateTo($"/opportunity/{opp}");
            else
                Nav.NavigateTo($"/pipeline?company={Uri.EscapeDataString(account.CompanyName)}");
        }
        else
        {
            Nav.NavigateTo($"/pipeline?company={Uri.EscapeDataString(account.CompanyName)}");
        }
    }
}
