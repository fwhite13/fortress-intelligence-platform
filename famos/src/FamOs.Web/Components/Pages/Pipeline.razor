@page "/pipeline"
@attribute [Authorize]
@implements IAsyncDisposable
@inject OpportunityService OppService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject UserAffinityService AffinitySvc
@inject IJSRuntime JS
@inject IOptions<AffinityConfig> AffinityOptions
@inject TeamNoteService NotesSvc
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@using FamOs.Web.Data.Entities
@using Microsoft.Extensions.Options
@using FamOs.Web.Services
@using FamOs.Web.Domain
@using FamOs.Web.Theme

<PageTitle>Pipeline — FAM OS</PageTitle>

<div class="famos-page-header famos-page-header-row mb-4">
    <div>
        <h2 class="famos-page-h2">Pipeline</h2>
        <p class="famos-page-sub">@_stageSummary.Values.Sum() active opportunities</p>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
        <MudTextField Class="famos-input-filter"
                      Value="_search"
                      ValueChanged="@((string v) => OnSearchChanged(v))"
                      Placeholder="Search pipeline..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@FamosIcons.Search"
                      Clearable="true"
                      Style="min-width:220px;" />
        <MudButton Class="famos-btn-primary" OnClick="OpenCreateDialog"
                   StartIcon="@FamosIcons.Add">
            New Opportunity
        </MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="famos-pipeline-board">
        @foreach (var col in _columns)
        {
            var page = _pages.TryGetValue(col.Stage, out var p) ? p : null;
            <div class="famos-pipeline-column">
                <div class="famos-pipeline-column-header">
                    <span class="famos-kcol-dot" style="background:@GetStageColor(col.Stage);"></span>
                    <span class="famos-kcol-label">@col.DisplayName</span>
                    <span class="famos-kcol-count">
                        @(_stageSummary.TryGetValue(col.Stage, out var cnt) ? cnt : 0)
                    </span>
                </div>
                <div style="padding:8px;">
                    @if (page == null || !page.Items.Any())
                    {
                        <div class="famos-pipeline-empty">No opportunities in this stage.</div>
                    }
                    else
                    {
                        @foreach (var opp in page.Items)
                        {
                            <OpportunityCard Opportunity="opp" OnClick="OpenDrawer" />
                        }
                        @if (page.HasMore)
                        {
                            <div style="text-align:center; margin-top:6px;">
                                <MudButton Class="famos-btn-outline-sm"
                                           OnClick="() => LoadMoreStage(col.Stage)"
                                           Disabled="_loadingMore.Contains(col.Stage)">
                                    @(_loadingMore.Contains(col.Stage) ? "Loading..." : $"Load more ({page.TotalCount - page.Items.Count} remaining)")
                                </MudButton>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

<MudDrawer @bind-Open="_drawerOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="480px"
           Elevation="2"
           CloseOnEscapeKey="true"
           Class="famos-side-drawer">

    @if (_selectedOpp != null)
    {
        <div class="famos-drawer-header-dark">
            <div style="flex:1; min-width:0;">
                <div class="famos-drawer-title-lg">@_selectedOpp.Name</div>
                <div class="famos-drawer-subtitle">
                    @GetStageDisplayName(_selectedOpp.LifecycleStage)
                    @if (_selectedOpp.OwnerUserId is { Length: > 0 })
                    {
                        <span> · @(AffinityOptions.Value.Users.FirstOrDefault(u => u.UserId == _selectedOpp.OwnerUserId)?.DisplayName ?? _selectedOpp.OwnerUserId)</span>
                    }
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           OnClick="CloseDrawer"
                           Size="Size.Small"
                           Style="color:rgba(255,255,255,0.7);" />
        </div>

        <div class="famos-drawer-stats-row">
            <div class="famos-drawer-stat">
                <div class="famos-drawer-stat-label">EST. PREMIUM</div>
                <div class="famos-drawer-stat-value">
                    @(_selectedOpp.EstimatedPremium.HasValue ? $"${_selectedOpp.EstimatedPremium.Value:N0}" : "—")
                </div>
            </div>
            <div class="famos-drawer-stat">
                <div class="famos-drawer-stat-label">QUOTES</div>
                <div class="famos-drawer-stat-value">
                    @(_detailOpp?.Quotes.Count(q => q.PremiumAmount > 0).ToString() ?? "—")
                </div>
            </div>
            <div class="famos-drawer-stat">
                <div class="famos-drawer-stat-label">DAYS IN STAGE</div>
                <div class="famos-drawer-stat-value">@DrawerDaysInStage</div>
            </div>
            <div class="famos-drawer-stat">
                <div class="famos-drawer-stat-label">STAGE</div>
                <div class="famos-drawer-stat-value" style="font-size:12px;">@GetStageDisplayName(_selectedOpp.LifecycleStage)</div>
            </div>
        </div>

        <div class="famos-drawer-body">

            @if (_detailOpp?.Contacts.Any() == true)
            {
                var primary = _detailOpp.Contacts.FirstOrDefault(c => c.Id == _detailOpp.PrimaryContactId)
                              ?? _detailOpp.Contacts.First();
                <div class="famos-drawer-section">
                    <div class="famos-drawer-section-title">PRIMARY CONTACT</div>
                    <div class="famos-drawer-contact-row">
                        <div class="famos-drawer-contact-name">@primary.FullName</div>
                        @if (!string.IsNullOrEmpty(primary.Email))
                        {
                            <div class="famos-drawer-contact-email">@primary.Email</div>
                        }
                    </div>
                </div>
            }

            @if (DrawerCoverageLines.Any())
            {
                <div class="famos-drawer-section">
                    <div class="famos-drawer-section-title">COVERAGE LINES</div>
                    <div class="famos-drawer-pills">
                        @foreach (var line in DrawerCoverageLines)
                        {
                            <span class="famos-drawer-pill">@line</span>
                        }
                    </div>
                </div>
            }

            <div class="famos-drawer-section">
                <div class="famos-drawer-section-title">TEAM NOTES</div>
                @if (_drawerNotesLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                }
                else
                {
                    @foreach (var note in _drawerNotes.Take(5))
                    {
                        <div class="famos-drawer-note">
                            <div class="famos-drawer-note-header">
                                <span class="famos-drawer-note-author">@note.AuthorId</span>
                                <span class="famos-drawer-note-tag @(note.TeamTag == "TIG" ? "famos-tag-tig" : "famos-tag-higg")">@note.TeamTag</span>
                                <span class="famos-drawer-note-date">@note.CreatedAt.ToLocalTime().ToString("MMM d")</span>
                            </div>
                            <div class="famos-drawer-note-text">@note.NoteText</div>
                        </div>
                    }
                    <div class="famos-drawer-note-compose">
                        <MudTextField @bind-Value="_drawerNoteText"
                                      Placeholder="Add a note..."
                                      Variant="Variant.Outlined"
                                      Lines="2"
                                      FullWidth="true"
                                      Class="mb-2" />
                        <MudButton Class="famos-btn-primary"
                                   Size="Size.Small"
                                   OnClick="PostDrawerNoteAsync"
                                   Disabled="@(string.IsNullOrWhiteSpace(_drawerNoteText) || _drawerNotePosting)">
                            Post
                        </MudButton>
                    </div>
                }
            </div>

        </div>

        <div class="famos-drawer-footer">
            <MudButton Class="famos-btn-outline" Size="Size.Small" OnClick="CloseDrawer">Close</MudButton>
            <MudButton Class="famos-btn-danger" Size="Size.Small" OnClick="@(() => ShowMarkLostDialog(_selectedOpp))">Mark Lost</MudButton>
            <MudButton Class="famos-btn-outline" Size="Size.Small"
                       OnClick="@(() => { Nav.NavigateTo($"/opportunity/{_selectedOpp.Id}#quotes"); CloseDrawer(); })">
                View Quotes
            </MudButton>
            <MudButton Class="famos-btn-primary" Size="Size.Small"
                       OnClick="@(() => { Nav.NavigateTo($"/opportunity/{_selectedOpp.Id}"); CloseDrawer(); })">
                Full Details →
            </MudButton>
        </div>
    }

</MudDrawer>

@code {
    private bool _loading = true;
    private Dictionary<LifecycleStage, int>              _stageSummary = new();
    private Dictionary<LifecycleStage, OpportunityPage>  _pages        = new();
    private HashSet<LifecycleStage>                      _loadingMore  = new();
    private string _search = "";

    private Opportunity? _selectedOpp   = null;
    private bool         _drawerOpen    = false;
    private Opportunity? _detailOpp     = null;
    private bool         _drawerLoading = false;

    // Notes state
    private List<TeamNote> _drawerNotes        = new();
    private bool           _drawerNotesLoading = false;
    private bool           _drawerNotePosting  = false;
    private string         _drawerNoteText     = "";

    // Computed properties for drawer
    private string DrawerDaysInStage => _selectedOpp?.LastStageTransitionAt.HasValue == true
        ? ((int)(DateTime.UtcNow - _selectedOpp.LastStageTransitionAt!.Value).TotalDays).ToString()
        : "—";

    private List<string> DrawerCoverageLines => _detailOpp?.Submissions
        .Where(s => !string.IsNullOrEmpty(s.CoverageTypes))
        .SelectMany(s => s.CoverageTypes!.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .ToList() ?? new();

    private static readonly (LifecycleStage Stage, string DisplayName)[] _columns =
    {
        (LifecycleStage.Intake,           "Intake"),
        (LifecycleStage.UnderwritingPrep, "App Review"),
        (LifecycleStage.Marketed,         "Submitted"),
        (LifecycleStage.QuotesReceived,   "Quotes In"),
        (LifecycleStage.ClientDecision,   "Proposal"),
        (LifecycleStage.Binding,          "Binding"),
        (LifecycleStage.Bound,            "Bound"),
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();

        // Load counts first (cheap) — one query
        _stageSummary = await OppService.GetStageSummaryAsync(affinityId, _search);

        // Load page 0 of each stage in parallel
        var tasks = _columns
            .Select(col => OppService.GetStagePageAsync(col.Stage, 0, affinityId, _search))
            .ToArray();
        var pages = await Task.WhenAll(tasks);

        _pages = _columns
            .Zip(pages, (col, page) => (col.Stage, page))
            .ToDictionary(x => x.Stage, x => x.page);

        _loading = false;
    }

    private async Task LoadMoreStage(LifecycleStage stage)
    {
        if (!_pages.TryGetValue(stage, out var current)) return;
        _loadingMore.Add(stage);
        StateHasChanged();

        var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();
        var nextPage = await OppService.GetStagePageAsync(
            stage, current.PageIndex + 1, affinityId, _search);

        // Append new items to existing page
        _pages[stage] = new OpportunityPage
        {
            Items      = current.Items.Concat(nextPage.Items).ToList(),
            TotalCount = nextPage.TotalCount,
            PageIndex  = nextPage.PageIndex,
            PageSize   = nextPage.PageSize,
            HasMore    = nextPage.HasMore,
        };

        _loadingMore.Remove(stage);
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<OpportunityCreateDialog>("New Opportunity");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var oppId = (Guid)result.Data!;
            Nav.NavigateTo($"/opportunity/{oppId}");
        }
    }

    private async Task OpenDrawer(Opportunity opp)
    {
        _selectedOpp        = opp;
        _drawerOpen         = true;
        _drawerLoading      = true;
        _drawerNotes        = new();
        _drawerNotesLoading = true;
        _drawerNoteText     = "";
        StateHasChanged();

        _detailOpp          = await OppService.GetByIdAsync(opp.Id);
        _drawerLoading      = false;

        _drawerNotes        = await NotesSvc.GetNotesAsync(opp.Id);
        _drawerNotesLoading = false;
        StateHasChanged();
    }

    private void CloseDrawer()
    {
        _drawerOpen         = false;
        _selectedOpp        = null;
        _detailOpp          = null;
        _drawerLoading      = false;
        _drawerNotes        = new();
        _drawerNotesLoading = false;
        _drawerNotePosting  = false;
        _drawerNoteText     = "";
    }

    private async Task PostDrawerNoteAsync()
    {
        if (string.IsNullOrWhiteSpace(_drawerNoteText) || _selectedOpp == null) return;
        _drawerNotePosting = true;
        try
        {
            var userId = await UserSession.GetUserIdAsync();
            await NotesSvc.PostNoteAsync(userId, _drawerNoteText, _selectedOpp.Id);
            _drawerNoteText = "";
            _drawerNotes    = await NotesSvc.GetNotesAsync(_selectedOpp.Id);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to post note: {ex.Message}", Severity.Error);
        }
        finally
        {
            _drawerNotePosting = false;
            StateHasChanged();
        }
    }

    private async Task ShowMarkLostDialog(Opportunity opp)
    {
        var parameters = new DialogParameters<MarkLostConfirmDialog>
        {
            { x => x.AccountName, opp.Name }
        };
        var result = await DialogService.ShowAsync<MarkLostConfirmDialog>("Mark Lost", parameters);
        var dialogResult = await result.Result;
        if (dialogResult is { Canceled: false })
        {
            Nav.NavigateTo($"/opportunity/{opp.Id}");
            CloseDrawer();
        }
    }

    private static string GetStageDisplayName(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake           => "Intake",
        LifecycleStage.UnderwritingPrep => "App Review",
        LifecycleStage.Marketed         => "Submitted",
        LifecycleStage.QuotesReceived   => "Quotes In",
        LifecycleStage.ClientDecision   => "Proposal",
        LifecycleStage.Binding          => "Binding",
        LifecycleStage.Bound            => "Bound",
        _                               => stage.ToString(),
    };

    private static string GetStageColor(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake           => "#1d4ed8",
        LifecycleStage.UnderwritingPrep => "#6d28d9",
        LifecycleStage.Marketed         => "#d97706",
        LifecycleStage.QuotesReceived   => "#0369a1",
        LifecycleStage.ClientDecision   => "#9333ea",
        LifecycleStage.Binding          => "#C0272D",
        LifecycleStage.Bound            => "#059669",
        _                               => "#6b7585",
    };

    private DotNetObjectReference<Pipeline>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerDrawerEscape", _dotNetRef);
        }
    }

    [JSInvokable]
    public void CloseDrawerFromJs()
    {
        CloseDrawer();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("unregisterDrawerEscape");
        _dotNetRef?.Dispose();
    }
}
