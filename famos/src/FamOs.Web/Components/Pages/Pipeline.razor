@page "/pipeline"
@attribute [Authorize]
@implements IAsyncDisposable
@inject OpportunityService OppService
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject UserAffinityService AffinitySvc
@inject IJSRuntime JS
@inject IOptions<AffinityConfig> AffinityOptions
@using FamOs.Web.Data.Entities
@using Microsoft.Extensions.Options
@using FamOs.Web.Services
@using FamOs.Web.Domain
@using FamOs.Web.Theme

<PageTitle>Pipeline — FAM OS</PageTitle>

<div class="famos-page-header famos-page-header-row mb-4">
    <div>
        <h2 class="famos-page-h2">Pipeline</h2>
        <p class="famos-page-sub">@_stageSummary.Values.Sum() active opportunities</p>
    </div>
    <div style="display:flex; gap:8px; align-items:center;">
        <MudTextField Class="famos-input-filter"
                      Value="_search"
                      ValueChanged="@((string v) => OnSearchChanged(v))"
                      Placeholder="Search pipeline..."
                      Adornment="Adornment.Start"
                      AdornmentIcon="@FamosIcons.Search"
                      Clearable="true"
                      Style="min-width:220px;" />
        <MudButton Class="famos-btn-primary" OnClick="OpenCreateDialog"
                   StartIcon="@FamosIcons.Add">
            New Opportunity
        </MudButton>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else
{
    <div class="famos-pipeline-board">
        @foreach (var col in _columns)
        {
            var page = _pages.TryGetValue(col.Stage, out var p) ? p : null;
            <div class="famos-pipeline-column">
                <div class="famos-pipeline-column-header">
                    <span class="famos-kcol-dot" style="background:@GetStageColor(col.Stage);"></span>
                    <span class="famos-kcol-label">@col.DisplayName</span>
                    <span class="famos-kcol-count">
                        @(_stageSummary.TryGetValue(col.Stage, out var cnt) ? cnt : 0)
                    </span>
                </div>
                <div style="padding:8px;">
                    @if (page == null || !page.Items.Any())
                    {
                        <div class="famos-pipeline-empty">No opportunities in this stage.</div>
                    }
                    else
                    {
                        @foreach (var opp in page.Items)
                        {
                            <OpportunityCard Opportunity="opp" OnClick="OpenDrawer" />
                        }
                        @if (page.HasMore)
                        {
                            <div style="text-align:center; margin-top:6px;">
                                <MudButton Class="famos-btn-outline-sm"
                                           OnClick="() => LoadMoreStage(col.Stage)"
                                           Disabled="_loadingMore.Contains(col.Stage)">
                                    @(_loadingMore.Contains(col.Stage) ? "Loading..." : $"Load more ({page.TotalCount - page.Items.Count} remaining)")
                                </MudButton>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    </div>
}

<MudDrawer @bind-Open="_drawerOpen"
           Anchor="Anchor.End"
           Variant="DrawerVariant.Temporary"
           Width="420px"
           Elevation="2"
           CloseOnEscapeKey="true"
           Class="famos-side-drawer">

    @if (_selectedOpp != null)
    {
        <div class="famos-drawer-header">
            <div style="flex:1; min-width:0;">
                <div class="famos-drawer-title">@_selectedOpp.Name</div>
                <div class="famos-drawer-stage">
                    @GetStageDisplayName(_selectedOpp.LifecycleStage)
                </div>
            </div>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           OnClick="CloseDrawer"
                           Size="Size.Small" />
        </div>

        <div class="famos-drawer-body">

            <div class="famos-drawer-section">
                @if (_selectedOpp.EstimatedPremium.HasValue)
                {
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Est. Premium</span>
                        <span class="famos-drawer-value">$@_selectedOpp.EstimatedPremium.Value.ToString("N0")</span>
                    </div>
                }
                @if (_selectedOpp.EffectiveDateTarget.HasValue)
                {
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Effective Date</span>
                        <span class="famos-drawer-value">@_selectedOpp.EffectiveDateTarget.Value.ToString("MMM d, yyyy")</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_selectedOpp.OwnerUserId))
                {
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Account Manager</span>
                        <span class="famos-drawer-value">
                            @(AffinityOptions.Value.Users.FirstOrDefault(u => u.UserId == _selectedOpp.OwnerUserId)?.DisplayName ?? _selectedOpp.OwnerUserId)
                        </span>
                    </div>
                }
                <div class="famos-drawer-row">
                    <span class="famos-drawer-label">Status</span>
                    <span class="famos-drawer-value">
                        <SignalChip Signal="_selectedOpp.DominantSignal" />
                    </span>
                </div>
                @if (_selectedOpp.LastStageTransitionAt.HasValue)
                {
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">In Stage Since</span>
                        <span class="famos-drawer-value">
                            @_selectedOpp.LastStageTransitionAt.Value.ToLocalTime().ToString("MMM d, yyyy")
                        </span>
                    </div>
                }
            </div>

            <div class="famos-drawer-section">
                <div class="famos-drawer-section-title" style="padding: 0 20px 6px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--famos-text-muted, #6b7585);">Pipeline Activity</div>
                @if (_drawerLoading)
                {
                    <div style="padding:12px 20px;">
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                else if (_detailOpp != null)
                {
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Carriers Submitted</span>
                        <span class="famos-drawer-value">@(_detailOpp.Submissions.Count > 0 ? _detailOpp.Submissions.Count.ToString() : "—")</span>
                    </div>
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Quotes Received</span>
                        <span class="famos-drawer-value">@(_detailOpp.Quotes.Count > 0 ? _detailOpp.Quotes.Count.ToString() : "—")</span>
                    </div>
                    <div class="famos-drawer-row">
                        <span class="famos-drawer-label">Open Tasks</span>
                        <span class="famos-drawer-value">@(_detailOpp.Tasks.Count > 0 ? _detailOpp.Tasks.Count.ToString() : "—")</span>
                    </div>
                }
            </div>

            <div class="famos-drawer-section">
                <div class="famos-drawer-section-title" style="padding: 0 20px 6px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--famos-text-muted, #6b7585);">Contacts</div>
                @if (_drawerLoading)
                {
                    <div style="padding:12px 20px;">
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    </div>
                }
                else if (_detailOpp != null)
                {
                    @if (!_detailOpp.Contacts.Any())
                    {
                        <div style="padding: 6px 20px; color:var(--famos-text-muted, #6b7585); font-size:13px;">No contacts on record</div>
                    }
                    else
                    {
                        @foreach (var contact in _detailOpp.Contacts.Take(3))
                        {
                            <div class="famos-drawer-row">
                                <span class="famos-drawer-label">@contact.FullName</span>
                                <span class="famos-drawer-value" style="font-size:12px; color:var(--famos-text-muted, #6b7585);">@contact.ContactType.ToString()</span>
                            </div>
                        }
                    }
                }
            </div>

            @if (!_drawerLoading && _detailOpp != null && _detailOpp.Activities.Any())
            {
                <div class="famos-drawer-section">
                    <div class="famos-drawer-section-title" style="padding: 0 20px 6px; font-size:11px; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--famos-text-muted, #6b7585);">Recent Activity</div>
                    @foreach (var act in _detailOpp.Activities.Take(3))
                    {
                        <div class="famos-drawer-row" style="align-items:flex-start; flex-direction:column; gap:2px; padding: 6px 20px;">
                            <span class="famos-drawer-value" style="font-size:13px;">
                                @(act.Description != null && act.Description.Length > 60
                                    ? act.Description.Substring(0, 60) + "…"
                                    : (act.Description ?? act.EventType))
                            </span>
                            <span style="font-size:11px; color:var(--famos-text-muted, #6b7585);">@act.OccurredAt.ToLocalTime().ToString("MMM d, yyyy")</span>
                        </div>
                    }
                </div>
            }
            else if (_drawerLoading)
            {
                <div style="padding:12px 20px;">
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                </div>
            }

            <div style="padding: 16px 20px 20px;">
                <MudButton Class="famos-btn-primary"
                           FullWidth="true"
                           OnClick="@(() => { Nav.NavigateTo($"/opportunity/{_selectedOpp.Id}"); CloseDrawer(); })">
                    View Full Details
                </MudButton>
            </div>

        </div>
    }

</MudDrawer>

@code {
    private bool _loading = true;
    private Dictionary<LifecycleStage, int>              _stageSummary = new();
    private Dictionary<LifecycleStage, OpportunityPage>  _pages        = new();
    private HashSet<LifecycleStage>                      _loadingMore  = new();
    private string _search = "";

    private Opportunity? _selectedOpp   = null;
    private bool         _drawerOpen    = false;
    private Opportunity? _detailOpp     = null;
    private bool         _drawerLoading = false;

    private static readonly (LifecycleStage Stage, string DisplayName)[] _columns =
    {
        (LifecycleStage.Intake,           "Intake"),
        (LifecycleStage.UnderwritingPrep, "App Review"),
        (LifecycleStage.Marketed,         "Submitted"),
        (LifecycleStage.QuotesReceived,   "Quotes In"),
        (LifecycleStage.ClientDecision,   "Proposal"),
        (LifecycleStage.Binding,          "Binding"),
        (LifecycleStage.Bound,            "Bound"),
    };

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task OnSearchChanged(string value)
    {
        _search = value ?? "";
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();

        // Load counts first (cheap) — one query
        _stageSummary = await OppService.GetStageSummaryAsync(affinityId, _search);

        // Load page 0 of each stage in parallel
        var tasks = _columns
            .Select(col => OppService.GetStagePageAsync(col.Stage, 0, affinityId, _search))
            .ToArray();
        var pages = await Task.WhenAll(tasks);

        _pages = _columns
            .Zip(pages, (col, page) => (col.Stage, page))
            .ToDictionary(x => x.Stage, x => x.page);

        _loading = false;
    }

    private async Task LoadMoreStage(LifecycleStage stage)
    {
        if (!_pages.TryGetValue(stage, out var current)) return;
        _loadingMore.Add(stage);
        StateHasChanged();

        var affinityId = await AffinitySvc.GetCurrentAffinityIdAsync();
        var nextPage = await OppService.GetStagePageAsync(
            stage, current.PageIndex + 1, affinityId, _search);

        // Append new items to existing page
        _pages[stage] = new OpportunityPage
        {
            Items      = current.Items.Concat(nextPage.Items).ToList(),
            TotalCount = nextPage.TotalCount,
            PageIndex  = nextPage.PageIndex,
            PageSize   = nextPage.PageSize,
            HasMore    = nextPage.HasMore,
        };

        _loadingMore.Remove(stage);
        StateHasChanged();
    }

    private async Task OpenCreateDialog()
    {
        var dialog = await DialogService.ShowAsync<OpportunityCreateDialog>("New Opportunity");
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            var oppId = (Guid)result.Data!;
            Nav.NavigateTo($"/opportunity/{oppId}");
        }
    }

    private async Task OpenDrawer(Opportunity opp)
    {
        _selectedOpp   = opp;
        _drawerOpen    = true;
        _drawerLoading = true;
        StateHasChanged();
        _detailOpp     = await OppService.GetByIdAsync(opp.Id);
        _drawerLoading = false;
        StateHasChanged();
    }

    private void CloseDrawer()
    {
        _drawerOpen    = false;
        _selectedOpp   = null;
        _detailOpp     = null;
        _drawerLoading = false;
    }

    private static string GetStageDisplayName(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake           => "Intake",
        LifecycleStage.UnderwritingPrep => "App Review",
        LifecycleStage.Marketed         => "Submitted",
        LifecycleStage.QuotesReceived   => "Quotes In",
        LifecycleStage.ClientDecision   => "Proposal",
        LifecycleStage.Binding          => "Binding",
        LifecycleStage.Bound            => "Bound",
        _                               => stage.ToString(),
    };

    private static string GetStageColor(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake           => "#1d4ed8",
        LifecycleStage.UnderwritingPrep => "#6d28d9",
        LifecycleStage.Marketed         => "#d97706",
        LifecycleStage.QuotesReceived   => "#0369a1",
        LifecycleStage.ClientDecision   => "#9333ea",
        LifecycleStage.Binding          => "#C0272D",
        LifecycleStage.Bound            => "#059669",
        _                               => "#6b7585",
    };

    private DotNetObjectReference<Pipeline>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerDrawerEscape", _dotNetRef);
        }
    }

    [JSInvokable]
    public void CloseDrawerFromJs()
    {
        CloseDrawer();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("unregisterDrawerEscape");
        _dotNetRef?.Dispose();
    }
}
