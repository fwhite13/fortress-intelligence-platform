@page "/intake-questionnaire"
@rendermode InteractiveServer
@layout FamOs.Web.Components.Layout.IntakeLayout
@attribute [Microsoft.AspNetCore.Authorization.AllowAnonymous]
@namespace FamOs.Web.Components.Pages
@using FamOs.Web.Components.Pages.IntakeQuestionnaire

<HeadContent>
    <title>TIG Insurance Application</title>
    <link rel="stylesheet" href="css/intake-standalone.css" />
</HeadContent>

<IntakeQuestionnaire Mode="QuestionnaireMode.Prospect" OpportunityId="@(OpportunityId ?? "")" />

@code {
    [Parameter, SupplyParameterFromQuery] public string? OpportunityId { get; set; }
}
