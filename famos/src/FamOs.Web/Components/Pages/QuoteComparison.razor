@page "/quote-comparison"
@attribute [Authorize]

<PageTitle>Quote Comparison — FAM OS</PageTitle>

<div class="famos-page-header">
    <h2 class="famos-page-h2">Quote Comparison</h2>
    <p class="famos-page-sub">Side-by-side carrier quote analysis</p>
</div>

<div class="famos-empty-state" style="margin-top:48px;">
    <MudIcon Icon="@Icons.Material.Outlined.CompareArrows" Style="font-size:48px; color:var(--muted);" />
    <div style="font-size:16px; font-weight:600; color:#002050;">Full workflow coming soon</div>
    <p style="max-width:400px; font-size:13px; color:var(--muted); text-align:center;">
        Quote Comparison will enable side-by-side carrier quote analysis, best-value selection,
        and one-click proposal generation. Jay Jernigan is spec'ing the full workflow.
    </p>
    <div style="border:1px solid var(--border); border-radius:12px; overflow:hidden;
                width:100%; max-width:560px; margin-top:16px; opacity:0.5;">
        <div style="display:grid; grid-template-columns:140px 1fr 1fr 1fr;
                    background:#f8f9fa; padding:10px 12px; font-size:11px; font-weight:700; color:var(--muted);">
            <span>Coverage</span><span style="text-align:center;">Carrier A</span>
            <span style="text-align:center;">Carrier B</span><span style="text-align:center;">Carrier C</span>
        </div>
        @foreach (var row in new[]{"GL Premium","WC Premium","Umbrella","Total"})
        {
            <div style="display:grid; grid-template-columns:140px 1fr 1fr 1fr;
                        padding:8px 12px; font-size:12px; border-top:1px solid var(--border);">
                <span style="color:var(--muted);">@row</span>
                <span style="text-align:center; color:#002050;">—</span>
                <span style="text-align:center; color:#002050;">—</span>
                <span style="text-align:center; color:#002050;">—</span>
            </div>
        }
    </div>
</div>

@code { }
