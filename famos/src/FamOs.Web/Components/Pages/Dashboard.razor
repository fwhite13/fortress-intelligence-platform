@page "/"
@attribute [Authorize]
@inject DashboardService DashboardSvc
@inject UserSessionService UserSession
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@using FamOs.Web.Services
@using FamOs.Web.Domain

<PageTitle>Dashboard — FAM OS</PageTitle>

@* ══ ZONE 1: Page Header ══════════════════════════════════════════════ *@
<div class="famos-page-header famos-page-header-row">
    <div>
        <nav class="famos-breadcrumb">
            <span>Titan Insurance Group</span>
            <span class="famos-breadcrumb-sep">→</span>
            <span>Dashboard</span>
        </nav>
        <h2 class="famos-page-h2">Dashboard</h2>
        <p class="famos-page-sub">@GetGreeting()</p>
    </div>
    <div class="famos-header-right">
        <div class="famos-header-meta">
            @_userName · TIG Program Manager · @DateTime.Now.ToString("MMMM yyyy")
        </div>
        <div class="famos-header-actions">
            <MudButton Class="famos-btn-ghost" OnClick="@(() => Nav.NavigateTo("/pipeline"))">
                Pipeline View →
            </MudButton>
            <MudButton Class="famos-btn-primary" OnClick="@(() => Nav.NavigateTo("/pipeline?new=true"))">
                New Opportunity
            </MudButton>
        </div>
    </div>
</div>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
}
else if (_summary != null)
{
    @* ══ ZONE 2: Stat Cards (4 cards) ════════════════════════════════════ *@
    <div class="famos-stat-grid">
        @* Card 1: Active Pipeline *@
        <div class="famos-stat-card" style="border-left: 3px solid #CC2200;">
            <div class="famos-stat-label">Active Pipeline</div>
            <div class="famos-stat-value">@_summary.ActivePipelineCount</div>
            <div class="famos-stat-sub">Active opportunities</div>
            @if (_summary.StaleCount > 0)
            {
                <span class="famos-stat-badge" style="background:#FFF8E1;color:#92400E;">
                    @_summary.StaleCount stale
                </span>
            }
        </div>

        @* Card 2: Submission Queue *@
        <div class="famos-stat-card" style="border-left: 3px solid #E8A020;">
            <div class="famos-stat-label">Submission Queue</div>
            <div class="famos-stat-value">@_summary.SubmissionQueueCount</div>
            <div class="famos-stat-sub">Need submission</div>
            @if (_summary.SubmissionQueueCount > 0)
            {
                <span class="famos-stat-badge" style="background:#FFEBEE;color:#CC2200;">
                    @_summary.SubmissionQueueCount awaiting
                </span>
            }
        </div>

        @* Card 3: Bound Premium YTD *@
        <div class="famos-stat-card" style="border-left: 3px solid #2E7D32;">
            <div class="famos-stat-label">Bound Premium YTD</div>
            <div class="famos-stat-value">@FormatPremium(_summary.BoundPremiumYtd)</div>
            <div class="famos-stat-sub">@GetYoyComparison()</div>
            @if (_yoyPercent > 0)
            {
                <span class="famos-stat-badge" style="background:#E8F5E9;color:#2E7D32;">
                    +@_yoyPercent%
                </span>
            }
        </div>

        @* Card 4: All Accounts *@
        <div class="famos-stat-card" style="border-left: 3px solid #888888;">
            <div class="famos-stat-label">All Accounts</div>
            <div class="famos-stat-value">@_summary.TotalAccountCount</div>
            <div class="famos-stat-sub">Member companies</div>
            @if (_summary.NewAccountsYtd > 0)
            {
                <span class="famos-stat-badge" style="background:#E8F5E9;color:#2E7D32;">
                    +@_summary.NewAccountsYtd YTD
                </span>
            }
        </div>
    </div>

    @* ══ ZONE 3: 3-Column Panel Grid ═════════════════════════════════════ *@
    <div class="famos-dashboard-panels">
        @* Panel A: Accounts to Route *@
        <div class="famos-panel">
            <div class="famos-panel-header">
                <h3>Accounts to Route</h3>
            </div>
            <div class="famos-panel-body">
                @if (_summary.AccountsToRoute.Any())
                {
                    @foreach (var acct in _summary.AccountsToRoute)
                    {
                        <div class="famos-route-row">
                            <div class="famos-route-info">
                                <div class="famos-route-company">@acct.CompanyName</div>
                                <div class="famos-route-desc">@acct.Description</div>
                            </div>
                            <span class="famos-route-pill">@acct.Destination</span>
                            <MudButton Size="Size.Small" Variant="Variant.Filled"
                                       Color="Color.Error"
                                       OnClick="@(() => Nav.NavigateTo(acct.CtaUrl))">
                                @acct.CtaText
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="famos-empty-state">
                        No accounts need routing right now.
                    </MudAlert>
                }
            </div>
        </div>

        @* Panel B: Pipeline by Stage *@
        <div class="famos-panel">
            <div class="famos-panel-header">
                <h3>Pipeline by Stage</h3>
            </div>
            <div class="famos-panel-body">
                @* B1: Horizontal bar chart *@
                @foreach (var row in _summary.PipelineByStage)
                {
                    var pct = _maxStageCount > 0 ? (row.Count * 100 / _maxStageCount) : 0;
                    var color = GetStageColor(row.Stage);
                    <div class="famos-stage-bar-row" @onclick="@(() => Nav.NavigateTo($"/pipeline?stage={(int)row.Stage}"))">
                        <span class="famos-stage-bar-label">@GetStageName(row.Stage)</span>
                        <div class="famos-stage-bar-track">
                            <div class="famos-stage-bar-fill" style="width: @pct%; background: @color;"></div>
                        </div>
                        <span class="famos-stage-bar-count">@row.Count</span>
                    </div>
                }

                @* B2: Overview table *@
                <div class="famos-pipeline-divider"></div>
                <table class="famos-pipeline-overview">
                    <thead>
                        <tr>
                            <th>Stage</th>
                            <th>Count</th>
                            <th>Est. Premium</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in _summary.PipelineByStage)
                        {
                            var color = GetStageColor(row.Stage);
                            <tr @onclick="@(() => Nav.NavigateTo($"/pipeline?stage={(int)row.Stage}"))">
                                <td>
                                    <span class="famos-stage-pill" style="background:@color;">
                                        @GetStageName(row.Stage)
                                    </span>
                                </td>
                                <td>@row.Count</td>
                                <td>@FormatPremium(row.TotalPremium)</td>
                            </tr>
                        }
                        <tr class="famos-total-row">
                            <td>Total</td>
                            <td>@_summary.PipelineByStage.Sum(s => s.Count)</td>
                            <td>@FormatPremium(_summary.PipelineByStage.Sum(s => s.TotalPremium))</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>

        @* Panel C: Next Tasks *@
        <div class="famos-panel">
            <div class="famos-panel-header">
                <h3>Next Tasks</h3>
            </div>
            <div class="famos-panel-body">
                @if (_summary.NextTasks.Any())
                {
                    @foreach (var task in _summary.NextTasks)
                    {
                        var (bgColor, txtColor) = GetTaskBadgeColors(task.Priority);
                        <div class="famos-task-row">
                            <span class="famos-task-badge" style="background:@bgColor;color:@txtColor;">
                                @task.Priority
                            </span>
                            <div class="famos-task-info">
                                <div class="famos-task-name">@task.TaskName</div>
                                <div class="famos-task-desc">@task.Description</div>
                            </div>
                            <MudButton Size="Size.Small" Variant="Variant.Filled"
                                       Color="@(task.Priority == "URGENT" ? Color.Error : Color.Default)"
                                       OnClick="@(() => Nav.NavigateTo($"/pipeline?opp={task.OpportunityId}"))">
                                @task.CtaText
                            </MudButton>
                        </div>
                    }
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="famos-empty-state">
                        You're all caught up. No open tasks.
                    </MudAlert>
                }
            </div>
        </div>
    </div>

    @* ══ ZONE 4: Recent Activity ══════════════════════════════════════════ *@
    <div class="famos-panel famos-panel-wide">
        <div class="famos-panel-header">
            <h3>Recent Activity</h3>
        </div>
        <div class="famos-panel-body">
            @if (_summary.RecentActivity.Any())
            {
                <div class="famos-activity-grid">
                    @foreach (var evt in _summary.RecentActivity)
                    {
                        <div class="famos-activity-row" @onclick="@(() => Nav.NavigateTo($"/pipeline?opp={evt.OpportunityId}"))">
                            <span class="famos-activity-dot" style="background: @evt.DotColor;"></span>
                            <div class="famos-activity-info">
                                <div class="famos-activity-title">@evt.Title</div>
                                <div class="famos-activity-desc">@evt.Description</div>
                            </div>
                            <span class="famos-activity-time">@RelativeTime(evt.OccurredAt)</span>
                        </div>
                    }
                </div>
            }
            else
            {
                <MudAlert Severity="Severity.Info">No recent activity.</MudAlert>
            }
        </div>
    </div>
}

@code {
    private DashboardSummaryDto? _summary;
    private bool _loading = true;
    private string _userName = "";
    private string _firstName = "";
    private int _maxStageCount;
    private int _yoyPercent;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _userName = await UserSession.GetUserNameAsync();
            _firstName = _userName.Split(' ').FirstOrDefault() ?? "User";

            _summary = await DashboardSvc.GetSummaryAsync();
            _maxStageCount = _summary.PipelineByStage.Any()
                ? _summary.PipelineByStage.Max(s => s.Count)
                : 1;

            // Calculate YoY percentage
            if (_summary.BoundPremiumLastYear > 0)
            {
                _yoyPercent = (int)((_summary.BoundPremiumYtd - _summary.BoundPremiumLastYear)
                    / _summary.BoundPremiumLastYear * 100);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading dashboard: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        var greeting = hour switch
        {
            >= 5 and < 12 => "Good morning",
            >= 12 and < 18 => "Good afternoon",
            _ => "Good evening"
        };
        var context = hour switch
        {
            >= 5 and < 12 => "Let's see what needs attention today.",
            >= 12 and < 18 => "Here's where things stand.",
            _ => "Wrapping up for the day."
        };
        return $"{greeting}, {_firstName}. {context}";
    }

    private string GetYoyComparison()
    {
        if (_yoyPercent > 0) return $"+{_yoyPercent}% vs last year";
        if (_yoyPercent < 0) return $"{_yoyPercent}% vs last year";
        return "vs last year";
    }

    private static string FormatPremium(decimal premium)
    {
        if (premium >= 1_000_000) return $"${premium / 1_000_000:N1}M";
        if (premium >= 1_000) return $"${premium / 1_000:N0}K";
        return $"${premium:N0}";
    }

    private static string GetStageName(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake => "Prospect",
        LifecycleStage.UnderwritingPrep => "DGT Active",
        LifecycleStage.Marketed => "Marketing",
        LifecycleStage.QuotesReceived => "Quoted",
        LifecycleStage.ClientDecision => "Proposal",
        LifecycleStage.Binding => "Binding",
        LifecycleStage.Bound => "Bound",
        LifecycleStage.ClosedNotBound => "Lost",
        _ => stage.ToString()
    };

    private static string GetStageColor(LifecycleStage stage) => stage switch
    {
        LifecycleStage.Intake => "#6B7280",
        LifecycleStage.UnderwritingPrep => "#F59E0B",
        LifecycleStage.Marketed => "#F59E0B",
        LifecycleStage.QuotesReceived => "#10B981",
        LifecycleStage.ClientDecision => "#8B5CF6",
        LifecycleStage.Binding => "#3B82F6",
        LifecycleStage.Bound => "#111111",
        LifecycleStage.ClosedNotBound => "#9CA3AF",
        _ => "#6B7280"
    };

    private static (string bg, string txt) GetTaskBadgeColors(string priority) => priority switch
    {
        "URGENT" => ("#FFEBEE", "#CC2200"),
        "HIGH" => ("#FFF8E1", "#92400E"),
        "NORMAL" => ("#E3F2FD", "#1565C0"),
        _ => ("#F3F4F6", "#374151")
    };

    private static string RelativeTime(DateTime dt)
    {
        var span = DateTime.UtcNow - dt;
        if (span.TotalMinutes < 1) return "just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dt.ToString("MMM d");
    }
}
