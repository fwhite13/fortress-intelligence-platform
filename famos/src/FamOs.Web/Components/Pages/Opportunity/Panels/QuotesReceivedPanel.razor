@namespace FamOs.Web.Components.Panels
@inject LifecycleCommandService Lifecycle
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using FamOs.Web.Data.Entities
@using FamOs.Web.Domain
@using FamOs.Web.Theme

<div class="famos-panel">

    <div class="famos-panel-header">
        <span class="famos-panel-title">Received Quotes</span>
    </div>

    @if (!HasAnyContent)
    {
        <div class="famos-empty-state">No quotes yet. Upload a carrier PDF above to get started.</div>
    }
    else
    {
        <div class="famos-quote-table">
            <div class="famos-quote-header-row">
                <div class="famos-quote-col-carrier">CARRIER</div>
                <div class="famos-quote-col-premium">PREMIUM</div>
                <div class="famos-quote-col-status">STATUS</div>
                <div class="famos-quote-col-actions">ACTIONS</div>
            </div>

            @* Completed quotes from Opportunity.Quotes *@
            @foreach (var quote in Opportunity.Quotes.OrderByDescending(q => q.ReceivedAt))
            {
                <div class="famos-quote-row">
                    <div class="famos-quote-col-carrier">@quote.CarrierName</div>
                    <div class="famos-quote-col-premium">$@quote.PremiumAmount.ToString("N0")</div>
                    <div class="famos-quote-col-status">
                        <span class="famos-status-badge famos-status-complete">Complete</span>
                    </div>
                    <div class="famos-quote-col-actions">
                        <MudButton Size="Size.Small" Class="famos-btn-outline" OnClick="@(() => EditQuote(quote.Id))">Edit</MudButton>
                    </div>
                </div>
            }

            @* In-flight and errored submissions *@
            @foreach (var sub in InFlightSubmissions)
            {
                <div class="famos-quote-row">
                    <div class="famos-quote-col-carrier">@sub.CarrierName</div>
                    <div class="famos-quote-col-premium">—</div>
                    <div class="famos-quote-col-status">
                        @if (sub.Status == SubmissionStatus.Error)
                        {
                            <MudTooltip Text="Processing failed — click Resubmit to try again" Placement="Placement.Top">
                                <span class="famos-status-badge famos-status-error">Error</span>
                            </MudTooltip>
                        }
                        else
                        {
                            <span class="famos-status-badge famos-status-processing">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                @(sub.Status == SubmissionStatus.Uploading ? "Uploading" : "Processing")
                            </span>
                        }
                    </div>
                    <div class="famos-quote-col-actions">
                        @if (sub.Status == SubmissionStatus.Error)
                        {
                            <MudButton Size="Size.Small" Class="famos-btn-outline" OnClick="@(async () => await ResubmitAsync(sub.Id))">Resubmit</MudButton>
                            <MudButton Size="Size.Small" Class="famos-btn-danger" OnClick="@(async () => await DeleteSubmissionAsync(sub.Id))">Delete</MudButton>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="mt-3">
            <MudButton Class="@(HasCompleteQuotes ? "famos-btn-primary" : "famos-btn-primary famos-btn-disabled")"
                       Disabled="@(!HasCompleteQuotes)"
                       OnClick="@(() => Nav.NavigateTo($"/quote-comparison/{Opportunity.AccountId}"))">
                Compare Quotes and Create Proposal
            </MudButton>
            @if (!HasCompleteQuotes)
            {
                <span class="famos-meta-text ml-2">Available once quotes are processed</span>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public Opportunity Opportunity { get; set; } = default!;
    [Parameter] public EventCallback OnAdvanced { get; set; }

    private bool HasCompleteQuotes => Opportunity.Quotes.Any();

    private IEnumerable<Submission> InFlightSubmissions => Opportunity.Submissions
        .Where(s => s.Status is SubmissionStatus.Uploading or SubmissionStatus.Processing or SubmissionStatus.Error)
        .OrderByDescending(s => s.UpdatedAt);

    private bool HasAnyContent => Opportunity.Quotes.Any() || InFlightSubmissions.Any();

    private void EditQuote(Guid quoteId)
    {
        Snackbar.Add("Quote editor coming soon.", Severity.Info);
    }

    private async Task ResubmitAsync(Guid submissionId)
    {
        try
        {
            await Lifecycle.ResetSubmissionScraperAsync(submissionId);
            await OnAdvanced.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Resubmit failed: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    private async Task DeleteSubmissionAsync(Guid submissionId)
    {
        try
        {
            await Lifecycle.ResetSubmissionScraperAsync(submissionId);
            await OnAdvanced.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }
}
