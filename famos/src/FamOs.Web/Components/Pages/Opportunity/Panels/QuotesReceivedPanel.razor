@namespace FamOs.Web.Components.Panels
@inject LifecycleCommandService Lifecycle
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using FamOs.Web.Data.Entities
@using FamOs.Web.Domain
@using FamOs.Web.Theme

<div class="famos-panel">

    <div class="famos-panel-header">
        <span class="famos-panel-title">Received Quotes</span>
    </div>

    @if (!HasAnyContent)
    {
        <div class="famos-empty-state">No quotes yet. Upload a carrier PDF above to get started.</div>
    }
    else
    {
        <div class="famos-quote-table">
            <div class="famos-quote-header-row">
                <div class="famos-quote-col-check">
                    <MudCheckBox T="bool" Value="@AllSelected" ValueChanged="@ToggleSelectAll"
                                 Size="Size.Small" />
                </div>
                <div class="famos-quote-col-carrier">CARRIER</div>
                <div class="famos-quote-col-coverages">COVERAGES</div>
                <div class="famos-quote-col-premium">PREMIUM</div>
                <div class="famos-quote-col-status">STATUS</div>
                <div class="famos-quote-col-actions">ACTIONS</div>
            </div>

            @foreach (var quote in Opportunity.Quotes.OrderByDescending(q => q.ReceivedAt))
            {
                var subStatus = GetQuoteSubmissionStatus(quote);
                var isComplete = quote.PremiumAmount > 0;
                var isError = subStatus == SubmissionStatus.Error;

                <div class="famos-quote-row">
                    <div class="famos-quote-col-check">
                        <MudCheckBox T="bool" Value="@_selectedQuoteIds.Contains(quote.Id)"
                                     ValueChanged="@(v => ToggleQuote(quote.Id, v))"
                                     Size="Size.Small" />
                    </div>
                    <div class="famos-quote-col-carrier">@quote.CarrierName</div>
                    <div class="famos-quote-col-coverages">
                        <span class="famos-meta-text">@(string.IsNullOrEmpty(quote.CoverageDetails) ? "—" : quote.CoverageDetails)</span>
                    </div>
                    <div class="famos-quote-col-premium">
                        @if (isComplete)
                        {
                            <span>$@quote.PremiumAmount.ToString("N0")</span>
                        }
                        else
                        {
                            <span class="famos-meta-text">—</span>
                        }
                    </div>
                    <div class="famos-quote-col-status">
                        @if (isComplete)
                        {
                            <span class="famos-status-badge famos-status-complete">Complete</span>
                        }
                        else if (isError)
                        {
                            <MudTooltip Text="Processing failed — click Reset to re-upload" Placement="Placement.Top">
                                <span class="famos-status-badge famos-status-error">Error</span>
                            </MudTooltip>
                        }
                        else
                        {
                            <span class="famos-status-badge famos-status-processing">
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Style="width:14px;height:14px;" Class="mr-1" />
                                @(subStatus == SubmissionStatus.Uploading ? "Uploading" : "Processing")
                            </span>
                        }
                    </div>
                    <div class="famos-quote-col-actions">
                        @if (isComplete)
                        {
                            <MudTooltip Text="Edit">
                                <MudIconButton Icon="@FamosIcons.Edit" Size="Size.Small"
                                               OnClick="@(() => EditQuote(quote.Id))" />
                            </MudTooltip>
                        }
                        else if (isError)
                        {
                            <MudTooltip Text="Reset — re-upload PDF in Quote Scraper">
                                <MudIconButton Icon="@FamosIcons.Retry" Size="Size.Small"
                                               OnClick="@(async () => await ResubmitAsync(quote.SubmissionId))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete">
                                <MudIconButton Icon="@FamosIcons.Delete" Size="Size.Small" Color="Color.Error"
                                               OnClick="@(async () => await DeleteQuoteAsync(quote.Id, quote.SubmissionId))" />
                            </MudTooltip>
                        }
                    </div>
                </div>
            }
        </div>

        <div style="padding: 16px 20px;">
            <MudButton Class="famos-btn-primary"
                       Disabled="@(!CanCompare)"
                       OnClick="@(() => Nav.NavigateTo($"/quote-comparison/{Opportunity.Id}"))">
                Compare Quotes and Create Proposal
            </MudButton>
            @if (!CanCompare)
            {
                <span class="famos-meta-text ml-2">Select quotes to compare</span>
            }
        </div>
    }

</div>

@code {
    [Parameter, EditorRequired] public Opportunity Opportunity { get; set; } = default!;
    [Parameter] public EventCallback OnAdvanced { get; set; }

    private HashSet<Guid> _selectedQuoteIds = new();

    private bool AllSelected => Opportunity.Quotes.Any() &&
        Opportunity.Quotes.All(q => _selectedQuoteIds.Contains(q.Id));

    private bool CanCompare => _selectedQuoteIds.Any();

    private bool HasAnyContent => Opportunity.Quotes.Any();

    private void ToggleSelectAll(bool value)
    {
        if (value)
            _selectedQuoteIds = Opportunity.Quotes.Select(q => q.Id).ToHashSet();
        else
            _selectedQuoteIds.Clear();
    }

    private void ToggleQuote(Guid id, bool value)
    {
        if (value) _selectedQuoteIds.Add(id);
        else _selectedQuoteIds.Remove(id);
    }

    private SubmissionStatus? GetQuoteSubmissionStatus(Quote quote)
    {
        if (quote.PremiumAmount > 0) return null;
        var sub = Opportunity.Submissions.FirstOrDefault(s => s.Id == quote.SubmissionId);
        return sub?.Status;
    }

    private void EditQuote(Guid quoteId)
    {
        Snackbar.Add("Quote editor coming soon.", Severity.Info);
    }

    private async Task ResubmitAsync(Guid submissionId)
    {
        Snackbar.Add("To resubmit, go to the Quote Scraper panel and upload a new PDF for this carrier.", Severity.Info);
        await Task.CompletedTask;
    }

    private async Task DeleteQuoteAsync(Guid quoteId, Guid submissionId)
    {
        try
        {
            var userId = await UserSession.GetUserIdAsync();
            await Lifecycle.DeleteQuoteAndSubmissionAsync(quoteId, submissionId, userId);
            await OnAdvanced.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
            await InvokeAsync(StateHasChanged);
        }
    }
}
