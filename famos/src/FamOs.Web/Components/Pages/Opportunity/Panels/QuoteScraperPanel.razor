@namespace FamOs.Web.Components.Panels
@inject IQuoteScraperService Scraper
@inject LifecycleCommandService Lifecycle
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@using FamOs.Web.Data.Entities
@using FamOs.Web.Services
@using FamOs.Web.Theme

<MudCard Class="mb-4" Elevation="0"
         Style="border:1px solid var(--border); border-radius:12px;">
    <MudCardHeader>
        <CardHeaderContent>
            <MudText Typo="Typo.subtitle2" Class="famos-text-navy">
                Quote PDF Scraper
            </MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary">
                Upload a carrier quote PDF to extract coverage data automatically.
            </MudText>
        </CardHeaderContent>
    </MudCardHeader>
    <MudCardContent>

        @if (!Opportunity.Submissions.Any())
        {
            <MudAlert Severity="Severity.Info">
                Add carrier submissions first (in Underwriting Prep).
            </MudAlert>
        }
        else
        {
            <MudGrid Spacing="2">
                <MudItem xs="12" sm="5">
                    <MudSelect @bind-Value="_selectedSubId"
                               Label="Carrier" Class="famos-select">
                        @foreach (var sub in Opportunity.Submissions)
                        {
                            <MudSelectItem Value="sub.Id">@sub.CarrierName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" sm="7">
                    <MudFileUpload T="IBrowserFile" FilesChanged="OnFileSelected" Accept=".pdf"
                                   MaximumFileCount="1">
                        <ActivatorContent>
                            <MudButton Class="famos-btn-outline"
                                       StartIcon="@FamosIcons.Upload"
                                       Disabled="@(_uploading || _selectedSubId == Guid.Empty)">
                                @(_selectedFile == null ? "Choose PDF" : _selectedFile.Name)
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    @if (_selectedFile != null)
                    {
                        <MudButton Class="famos-btn-primary"
                                   OnClick="UploadAndSubmit"
                                   Disabled="_uploading"
                                   Style="margin-left:8px; margin-top:4px;">
                            @(_uploading ? "Uploading..." : "Upload & Scrape")
                        </MudButton>
                    }
                </MudItem>
            </MudGrid>

            @if (Opportunity.Submissions.Any(s => s.Status is SubmissionStatus.Uploading or SubmissionStatus.Processing or SubmissionStatus.Error))
            {
                <MudDivider Class="my-3" />
                <div class="famos-label mb-2">Scraper Jobs</div>
                @foreach (var sub in Opportunity.Submissions.Where(s => s.Status is SubmissionStatus.Uploading or SubmissionStatus.Processing or SubmissionStatus.Error))
                {
                    <div style="display:flex; align-items:center; gap:12px; margin-bottom:8px;">
                        <span class="famos-meta-text" style="min-width:120px;">@sub.CarrierName</span>
                        @if (sub.Status == SubmissionStatus.Error)
                        {
                            <span style="color:#CC2200; font-size:12px;">@sub.ScraperError</span>
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                OnClick="@(async () => await ResetSubmission(sub.Id))">Reset</MudButton>
                        }
                        else
                        {
                            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Style="max-width:120px;" />
                            <span class="famos-meta-text">@(sub.Status == SubmissionStatus.Uploading ? "Uploading..." : "Processing...")</span>
                        }
                    </div>
                }
            }

            @if (_uploading)
            {
                <MudDivider Class="my-3" />
                <div style="display:flex; align-items:center; gap:12px;">
                    <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Small" />
                    <div>
                        <div class="famos-text-navy famos-fw-600" style="font-size:13px;">
                            Scraping quote data...
                        </div>
                        <div class="famos-meta-text" style="font-size:12px;">@_statusMessage</div>
                    </div>
                </div>
                <MudAlert Severity="Severity.Info" Class="mt-3" Dense="true">
                    Large carrier quotes may take 10–30 minutes. You can navigate away — the PDF has been submitted.
                </MudAlert>
            }

            @if (_autoRecordedPremium.HasValue)
            {
                <MudDivider Class="my-3" />
                <MudAlert Severity="Severity.Success" Class="mt-2">
                    Quote recorded: <strong>$@_autoRecordedPremium.Value.ToString("N0")</strong> premium.
                    The opportunity has advanced to Quotes Received.
                </MudAlert>
            }

            @if (_showManualEntry)
            {
                <MudDivider Class="my-3" />
                <div class="intake-section-label mb-2">Enter Premium to Record Quote</div>
                <MudGrid Spacing="2">
                    <MudItem xs="8">
                        <MudNumericField @bind-Value="_manualPremium" Label="Premium ($)" Class="famos-input" />
                    </MudItem>
                    <MudItem xs="4">
                        <MudButton Class="famos-btn-primary" OnClick="@(async () => await RecordManually())"
                                   Disabled="@(!_manualPremium.HasValue || _manualPremium <= 0)">
                            Record Quote
                        </MudButton>
                    </MudItem>
                </MudGrid>
            }

            @if (_scrapeError != null)
            {
                <MudAlert Severity="Severity.Error" Class="mt-3">@_scrapeError</MudAlert>
            }
        }

    </MudCardContent>
</MudCard>

@code {
    [Parameter, EditorRequired] public Opportunity Opportunity { get; set; } = default!;
    [Parameter] public EventCallback OnUpdated { get; set; }

    private Guid   _selectedSubId;
    private IBrowserFile? _selectedFile;
    private bool   _uploading;
    private string _statusMessage = "";
    private string? _activeRequestId;
    private string? _scrapeError;
    private decimal? _manualPremium;
    private decimal? _autoRecordedPremium;
    private bool     _showManualEntry;

    protected override async Task OnInitializedAsync()
    {
        // Resume polling for any submission in Processing state
        var processing = Opportunity.Submissions
            .FirstOrDefault(s => s.Status == SubmissionStatus.Processing
                              && !string.IsNullOrEmpty(s.FortressRequestId));
        if (processing != null)
        {
            _selectedSubId = processing.Id;
            _activeRequestId = processing.FortressRequestId!;
            _uploading = true;
            _statusMessage = "Resuming — checking job status...";
            _ = InvokeAsync(() => PollUntilCompleteAsync(processing.Id, processing.FortressRequestId!));
        }
    }

    protected override void OnParametersSet()
    {
        // Restore previously recorded premium from the selected submission's quote
        if (_selectedSubId != Guid.Empty)
        {
            var sub = Opportunity.Submissions.FirstOrDefault(s => s.Id == _selectedSubId);
            var quote = sub != null
                ? Opportunity.Quotes.FirstOrDefault(q => q.SubmissionId == sub.Id)
                : null;
            if (quote != null && !_autoRecordedPremium.HasValue)
                _autoRecordedPremium = quote.PremiumAmount;
        }
    }

    private void OnFileSelected(IBrowserFile file)
    {
        _selectedFile = file;
        _scrapeError  = null;
        StateHasChanged();
    }

    private async Task UploadAndSubmit()
    {
        if (_selectedFile == null || _selectedSubId == Guid.Empty) return;

        _uploading = true;
        _scrapeError = null;
        _statusMessage = "Uploading PDF...";
        StateHasChanged();

        var userId = await UserSession.GetUserIdAsync();

        try
        {
            // Step 1: Set status to Uploading in DB immediately
            await Lifecycle.UpdateSubmissionStatusAsync(_selectedSubId, SubmissionStatus.Uploading, null, userId);
            await OnUpdated.InvokeAsync(); // refresh parent so list shows Uploading

            // Step 2: Get upload link
            _statusMessage = "Requesting upload slot...";
            StateHasChanged();
            var refId = $"famos-sub-{_selectedSubId:N}-{DateTimeOffset.UtcNow.ToUnixTimeMilliseconds()}";
            var (uploadUrl, fileKey) = await Scraper.GetUploadLinkAsync(_selectedFile.Name, refId);

            // Step 3: Upload to S3
            _statusMessage = "Uploading to secure storage...";
            StateHasChanged();
            await Scraper.UploadToS3Async(uploadUrl, _selectedFile);

            // Step 4: Submit to Fortress API
            _statusMessage = "Submitting for extraction...";
            StateHasChanged();
            var projectRequestId = await Scraper.SubmitRequestAsync(fileKey, refId);

            // Step 5: Persist projectRequestId IMMEDIATELY — before any polling
            await Lifecycle.PersistFortressRequestIdAsync(_selectedSubId, projectRequestId);
            _activeRequestId = projectRequestId;
            _statusMessage = "Extraction in progress (may take 10–30 min)...";
            await OnUpdated.InvokeAsync(); // refresh parent — now shows Processing
            StateHasChanged();

            // Step 6: Start polling
            await PollUntilCompleteAsync(_selectedSubId, projectRequestId);
        }
        catch (Exception ex)
        {
            try { await Lifecycle.SetSubmissionErrorAsync(_selectedSubId, ex.Message); }
            catch { /* ignore secondary errors */ }
            _scrapeError = $"Upload failed: {ex.Message}";
            _uploading = false;
            await OnUpdated.InvokeAsync();
            StateHasChanged();
        }
    }

    private async Task PollUntilCompleteAsync(Guid submissionId, string requestId)
    {
        var userId = await UserSession.GetUserIdAsync();
        try
        {
            var pollStart = DateTime.UtcNow;
            var maxPollSecs = 1800; // 30 min total timeout

            while (true)
            {
                var elapsed = DateTime.UtcNow - pollStart;
                if (elapsed.TotalSeconds >= maxPollSecs)
                {
                    // Timeout but don't error — job may still complete, user can reload
                    _scrapeError = "Taking longer than expected. You can navigate away — we'll resume polling when you return.";
                    _showManualEntry = true;
                    _uploading = false;
                    StateHasChanged();
                    return;
                }

                var intervalMs = elapsed.TotalSeconds < 120 ? 5000 : 30000;
                await Task.Delay(intervalMs);

                var elapsedMin = (int)elapsed.TotalMinutes;
                var elapsedSec = (int)elapsed.TotalSeconds % 60;
                _statusMessage = elapsedMin > 0
                    ? $"Processing... ({elapsedMin}m {elapsedSec}s)"
                    : $"Processing... ({(int)elapsed.TotalSeconds}s)";
                await InvokeAsync(StateHasChanged);

                QuoteScraperResult? result;
                try { result = await Scraper.PollResultAsync(requestId); }
                catch (Exception ex)
                {
                    await Lifecycle.SetSubmissionErrorAsync(submissionId, $"Polling error: {ex.Message}");
                    _scrapeError = $"Polling failed: {ex.Message}";
                    _uploading = false;
                    await OnUpdated.InvokeAsync();
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (result == null) continue; // still in progress

                if (result.Status == "Failed" || string.IsNullOrWhiteSpace(result.RawJson) || result.RawJson.Trim() == "{}")
                {
                    await Lifecycle.SetSubmissionErrorAsync(submissionId, $"Extraction failed: {result.Status}");
                    _scrapeError = "Extraction failed. Use Reset to try again.";
                    _uploading = false;
                    await OnUpdated.InvokeAsync();
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                // Success path
                await Lifecycle.SaveSubmissionScraperResultAsync(submissionId, result.RawJson, userId);

                var parsedPremium = TryParsePremium(result.RawJson);
                if (parsedPremium.HasValue && parsedPremium.Value > 0)
                {
                    var sub = Opportunity.Submissions.First(s => s.Id == submissionId);
                    try
                    {
                        await Lifecycle.RecordQuoteAsync(Opportunity.Id, submissionId, sub.CarrierName,
                            parsedPremium.Value, null, userId);
                        Snackbar.Add($"Quote from {sub.CarrierName} recorded — ${parsedPremium.Value:N0}.", Severity.Success);
                        _autoRecordedPremium = parsedPremium;
                    }
                    catch (LifecycleValidationException ex)
                    {
                        Snackbar.Add(ex.Message, Severity.Error);
                        _showManualEntry = true;
                    }
                }
                else
                {
                    await Lifecycle.UpdateSubmissionStatusAsync(submissionId, SubmissionStatus.QuoteReceived, null, userId);
                    _showManualEntry = true;
                    Snackbar.Add("Extraction completed. Enter premium manually.", Severity.Warning);
                }

                _uploading = false;
                await OnUpdated.InvokeAsync();
                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (Exception ex)
        {
            try { await Lifecycle.SetSubmissionErrorAsync(submissionId, ex.Message); }
            catch { /* ignore */ }
            _scrapeError = $"Error: {ex.Message}";
            _uploading = false;
            await OnUpdated.InvokeAsync();
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ResetSubmission(Guid submissionId)
    {
        try
        {
            await Lifecycle.ResetSubmissionScraperAsync(submissionId);
            _scrapeError = null;
            _selectedFile = null;
            await OnUpdated.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Reset failed: {ex.Message}", Severity.Error);
            StateHasChanged();
        }
    }

    private static decimal? TryParsePremium(string rawJson)
    {
        try
        {
            using var doc = System.Text.Json.JsonDocument.Parse(rawJson);
            var root = doc.RootElement;
            foreach (var path in new[] { "results", "data", "coverages" })
            {
                if (root.TryGetProperty(path, out var node))
                {
                    if (node.ValueKind == System.Text.Json.JsonValueKind.Array && node.GetArrayLength() > 0)
                        node = node[0];
                    foreach (var premKey in new[] { "premium", "totalPremium", "annualPremium", "total_premium" })
                    {
                        if (node.TryGetProperty(premKey, out var premNode))
                        {
                            if (premNode.TryGetDecimal(out var d)) return d;
                            if (decimal.TryParse(premNode.GetString(), out var s)) return s;
                        }
                    }
                }
            }
        }
        catch { }
        return null;
    }

    private async Task RecordManually()
    {
        if (!_manualPremium.HasValue) return;
        var sub = Opportunity.Submissions.First(s => s.Id == _selectedSubId);
        var userId = await UserSession.GetUserIdAsync();
        try
        {
            await Lifecycle.RecordQuoteAsync(Opportunity.Id, _selectedSubId, sub.CarrierName,
                _manualPremium.Value, null, userId);
            Snackbar.Add($"Quote from {sub.CarrierName} recorded — ${_manualPremium.Value:N0}.", Severity.Success);
            _showManualEntry = false;
            await OnUpdated.InvokeAsync();
        }
        catch (LifecycleValidationException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
