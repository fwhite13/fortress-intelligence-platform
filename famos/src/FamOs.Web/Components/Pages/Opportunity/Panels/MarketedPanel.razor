@namespace FamOs.Web.Components.Panels
@inject LifecycleCommandService Lifecycle
@inject UserSessionService UserSession
@inject ISnackbar Snackbar
@using FamOs.Web.Data.Entities
@using FamOs.Web.Domain
@using FamOs.Web.Theme

<div class="intake-form-container">

    <div class="section-header mb-3">
        <MudText Typo="Typo.h6" Class="famos-text-navy">Submitted to Market</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Carriers grouped by coverage line. Quote status updates automatically via scraper.
        </MudText>
    </div>

    @if (!Opportunity.Submissions.Any())
    {
        <div class="famos-empty-state">
            <MudIcon Icon="@FamosIcons.Warning" Class="famos-empty-icon" />
            <div>No submissions found. This may be a data issue — contact support.</div>
        </div>
    }
    else
    {
        @foreach (var carrierGroup in Opportunity.Submissions
            .Where(s => !string.IsNullOrEmpty(s.CoverageLine))
            .GroupBy(s => s.CarrierName)
            .OrderBy(g => g.Key))
        {
            var carrierStatus = LifecycleCommandService.GetCarrierStatus(carrierGroup);
            var isExpanded = _expandedCarrier == carrierGroup.Key;

            <div class="carrier-group" style="border:1px solid var(--border); border-radius:8px; margin-bottom:12px; overflow:hidden;">
                <div class="carrier-header" style="display:flex; justify-content:space-between; align-items:center;
                            padding:12px 16px; cursor:pointer; background:var(--cream);"
                     @onclick="() => ToggleCarrier(carrierGroup.Key)">
                    <div style="display:flex; align-items:center; gap:12px;">
                        <MudText Typo="Typo.body1" Class="famos-fw-600">@carrierGroup.Key</MudText>
                        <MudChip T="string" Size="Size.Small" Color="@GetCarrierStatusColor(carrierStatus)">
                            @GetCarrierStatusLabel(carrierStatus)
                        </MudChip>
                    </div>
                    <MudIcon Icon="@(isExpanded ? FamosIcons.ExpandLess : FamosIcons.ExpandMore)"
                             Style="font-size:20px; color:var(--muted);" />
                </div>

                @if (isExpanded)
                {
                    <div style="padding:8px 16px 12px; border-top:1px solid var(--border);">
                        @foreach (var line in carrierGroup.OrderBy(l => l.CoverageLine))
                        {
                            <div class="submission-line-row" style="display:flex; justify-content:space-between; align-items:center; padding:8px 0; border-bottom:1px solid var(--border-light);">
                                <div style="display:flex; align-items:center; gap:12px;">
                                    <MudText Typo="Typo.body2" Class="famos-fw-500">@line.CoverageLine</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@GetLineStatusColor(line.LineStatus)">
                                        @GetLineStatusLabel(line.LineStatus)
                                    </MudChip>
                                    @if (line.LineStatus == LineStatus.QuoteReceived)
                                    {
                                        var quoteCount = Opportunity.Quotes.Count(q => q.SubmissionId == line.Id);
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @quoteCount quote@(quoteCount != 1 ? "s" : "")
                                        </MudText>
                                    }
                                </div>
                                <div>
                                    @if (line.LineStatus == LineStatus.Pending)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning"
                                                   OnClick="@(async () => await MarkLineDeclined(line.Id))">
                                            Mark Declined
                                        </MudButton>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public Opportunity Opportunity { get; set; } = default!;
    [Parameter] public EventCallback OnAdvanced { get; set; }

    private string? _expandedCarrier;

    private void ToggleCarrier(string carrier) =>
        _expandedCarrier = _expandedCarrier == carrier ? null : carrier;

    private async Task MarkLineDeclined(Guid submissionId)
    {
        try
        {
            var userId = await UserSession.GetUserIdAsync();
            await Lifecycle.MarkLineDeclinedAsync(submissionId, userId);
            var sub = Opportunity.Submissions.FirstOrDefault(s => s.Id == submissionId);
            if (sub != null) sub.LineStatus = LineStatus.Declined;
            Snackbar.Add("Line marked as declined", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private static Color GetCarrierStatusColor(LineStatusSummary status) => status switch
    {
        LineStatusSummary.Complete => Color.Success,
        LineStatusSummary.Declined => Color.Error,
        _ => Color.Default
    };

    private static string GetCarrierStatusLabel(LineStatusSummary status) => status switch
    {
        LineStatusSummary.Complete => "Complete",
        LineStatusSummary.Declined => "All Declined",
        _ => "Pending"
    };

    private static Color GetLineStatusColor(LineStatus status) => status switch
    {
        LineStatus.QuoteReceived => Color.Success,
        LineStatus.Declined      => Color.Error,
        _ => Color.Default
    };

    private static string GetLineStatusLabel(LineStatus status) => status switch
    {
        LineStatus.QuoteReceived => "Quote Received",
        LineStatus.Declined      => "Declined",
        _ => "Pending"
    };
}
