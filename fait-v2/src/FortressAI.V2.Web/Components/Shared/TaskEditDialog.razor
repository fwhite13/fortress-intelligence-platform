@inject IScheduledTaskService TaskService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="_form" Class="task-edit-dialog__form">
            <MudTextField @bind-Value="_name"
                          Label="Task Name"
                          Required="true"
                          RequiredError="Name is required."
                          MaxLength="200"
                          Class="task-edit-dialog__field" />

            <MudTextField @bind-Value="_prompt"
                          Label="Prompt"
                          HelperText="What should the AI assistant do when this task runs?"
                          Required="true"
                          RequiredError="Prompt is required."
                          Lines="4"
                          Class="task-edit-dialog__field mt-3" />

            <MudRadioGroup @bind-Value="_scheduleType" Class="task-edit-dialog__schedule-toggle mt-3">
                <MudRadio Value="@("recurring")" Color="Color.Primary">Recurring</MudRadio>
                <MudRadio Value="@("on_demand")" Color="Color.Primary">On Demand</MudRadio>
            </MudRadioGroup>

            @if (_scheduleType == "recurring")
            {
                <MudTextField @bind-Value="_cronExpression"
                              Label="Cron Expression"
                              Required="true"
                              RequiredError="Cron expression is required for recurring tasks."
                              HelperText='Examples: "0 9 * * 1-5" (weekdays 9am) · "0 * * * *" (hourly) · "0 8 * * *" (daily 8am)'
                              Class="task-edit-dialog__field mt-3" />
            }

            <div class="task-edit-dialog__alerts mt-3">
                <MudSwitch @bind-Value="_alertOnCompletion"
                           Label="Alert on completion"
                           Color="Color.Primary"
                           Class="task-edit-dialog__switch" />
                <MudSwitch @bind-Value="_alertOnFailure"
                           Label="Alert on failure"
                           Color="Color.Error"
                           Class="task-edit-dialog__switch" />
            </div>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Class="task-edit-dialog__cancel">Cancel</MudButton>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   OnClick="SaveAsync"
                   Disabled="_saving"
                   Class="task-edit-dialog__save">
            @(_saving ? "Saving..." : (Task is null ? "Create" : "Save"))
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public ScheduledTask? Task { get; set; }
    [Parameter] public string UserId { get; set; } = string.Empty;

    private MudForm? _form;
    private string _name = string.Empty;
    private string _prompt = string.Empty;
    private string _scheduleType = "on_demand";
    private string? _cronExpression;
    private bool _alertOnCompletion = false;
    private bool _alertOnFailure = true;
    private bool _saving = false;

    protected override void OnParametersSet()
    {
        if (Task is not null)
        {
            _name = Task.Name;
            _prompt = Task.Prompt;
            _scheduleType = Task.ScheduleType;
            _cronExpression = Task.CronExpression;
            _alertOnCompletion = Task.AlertOnCompletion;
            _alertOnFailure = Task.AlertOnFailure;
        }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is not null)
            await _form.Validate();
        if (_form?.IsValid != true) return;
        if (_scheduleType == "recurring" && string.IsNullOrWhiteSpace(_cronExpression)) return;

        _saving = true;
        try
        {
            if (Task is null)
            {
                await TaskService.CreateTaskAsync(
                    UserId, _name, _prompt, _scheduleType,
                    _scheduleType == "recurring" ? _cronExpression : null,
                    _alertOnCompletion, _alertOnFailure);
                Snackbar.Add("Task created.", Severity.Success);
            }
            else
            {
                await TaskService.UpdateTaskAsync(
                    Task.Id, UserId, _name, _prompt,
                    _scheduleType == "recurring" ? _cronExpression : null,
                    Task.IsActive, _alertOnCompletion, _alertOnFailure);
                Snackbar.Add("Task saved.", Severity.Success);
            }
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch
        {
            Snackbar.Add("Failed to save task.", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
