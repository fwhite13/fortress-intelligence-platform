@using DocumentFormat.OpenXml.Packaging
@using DocumentFormat.OpenXml.Wordprocessing
@using DocumentFormat.OpenXml.Presentation
@using ClosedXML.Excel
@using System.Text
@using System.IO
@inject IHttpClientFactory HttpClientFactory
@inject IJSRuntime JS

@if (Artifact == null)
{
    @* nothing — parent controls visibility *@
}
else
{
    <div class="artifact-preview-panel">
        <div class="artifact-preview-panel-header">
            <MudIcon Icon="@GetTypeIcon(Artifact.Type)" />
            <span class="artifact-preview-panel-title">@Artifact.FileName</span>
        </div>

        @* Excel sheet tab nav *@
        @if (_rendererType == RendererType.Excel && _sheets.Count > 1)
        {
            <div class="artifact-preview-tabs">
                @for (int i = 0; i < _sheets.Count; i++)
                {
                    var idx = i;
                    <button class="artifact-preview-tab @(idx == _activeSheet ? "artifact-preview-tab-active" : "")"
                            @onclick="@(() => SelectSheet(idx))">
                        @_sheets[idx].Name
                    </button>
                }
            </div>
        }

        @* PowerPoint back button *@
        @if (_rendererType == RendererType.PowerPoint && _selectedSlide != null)
        {
            <div class="artifact-preview-tabs">
                <button class="artifact-preview-tab" @onclick="@(() => _selectedSlide = null)">
                    &larr; All Slides
                </button>
                <span class="artifact-preview-tab artifact-preview-tab-active">Slide @_selectedSlide.Number</span>
            </div>
        }

        <div class="artifact-preview-panel-content">
            @if (_loading)
            {
                <div style="display:flex;align-items:center;justify-content:center;height:100%;">
                    <MudProgressCircular Indeterminate="true" Color="MudBlazor.Color.Primary" />
                </div>
            }
            else if (_error != null)
            {
                <div class="artifact-download-pane">
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="artifact-download-icon" />
                    <p class="artifact-download-name">@_error</p>
                    @if (DownloadUrl != null)
                    {
                        <a href="@DownloadUrl" class="artifact-download-btn" download>
                            <MudIcon Icon="@Icons.Material.Filled.Download" /> Download
                        </a>
                    }
                </div>
            }
            else if (_rendererType == RendererType.Html)
            {
                <iframe src="@DownloadUrl" sandbox="allow-scripts" class="artifact-preview-iframe" title="@Artifact.FileName"></iframe>
            }
            else if (_rendererType == RendererType.Word)
            {
                <div class="artifact-preview-word-html">
                    @((MarkupString)(_wordHtml ?? ""))
                </div>
            }
            else if (_rendererType == RendererType.Excel)
            {
                @if (_sheets.Count > 0 && _activeSheet < _sheets.Count)
                {
                    var sheet = _sheets[_activeSheet];
                    <div class="artifact-preview-table-wrap">
                        <table class="artifact-preview-table">
                            @if (sheet.Rows.Count > 0)
                            {
                                <thead>
                                    <tr>
                                        @foreach (var cell in sheet.Rows[0])
                                        {
                                            <th>@cell</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in sheet.Rows.Skip(1))
                                    {
                                        <tr>
                                            @foreach (var cell in row)
                                            {
                                                <td>@cell</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            }
                        </table>
                    </div>
                }
            }
            else if (_rendererType == RendererType.PowerPoint)
            {
                @if (_selectedSlide != null)
                {
                    <div class="artifact-preview-word-html">
                        <p><strong>Slide @_selectedSlide.Number — @_selectedSlide.Title</strong></p>
                        <pre class="artifact-preview-code-wrap">@_selectedSlide.Content</pre>
                    </div>
                }
                else
                {
                    <div class="artifact-preview-slides">
                        @foreach (var slide in _slides)
                        {
                            var s = slide;
                            <div class="artifact-preview-slide-card" @onclick="@(() => _selectedSlide = s)">
                                <div class="artifact-preview-slide-num">Slide @s.Number</div>
                                <div class="artifact-preview-slide-title">@(string.IsNullOrEmpty(s.Title) ? "(no title)" : s.Title)</div>
                            </div>
                        }
                    </div>
                }
            }
            else if (_rendererType == RendererType.Code || _rendererType == RendererType.Json)
            {
                <pre class="artifact-preview-code-wrap"><code class="language-@_codeLang" id="prism-@_elementId">@_contentText</code></pre>
                @if (_truncated)
                {
                    <div class="artifact-preview-truncated">Preview truncated to 50 KB</div>
                }
            }
            else if (_rendererType == RendererType.Chart)
            {
                <div class="artifact-preview-chart-wrap">
                    <canvas id="chart-@_elementId"></canvas>
                </div>
            }
            else
            {
                @* Download-only fallback *@
                <div class="artifact-download-pane">
                    <MudIcon Icon="@GetTypeIcon(Artifact.Type)" Class="artifact-download-icon" />
                    <p class="artifact-download-name">@Artifact.FileName</p>
                    <p class="artifact-download-size">@FormatSize(Artifact.SizeBytes)</p>
                    @if (DownloadUrl != null)
                    {
                        <a href="@DownloadUrl" class="artifact-download-btn" download>
                            <MudIcon Icon="@Icons.Material.Filled.Download" /> Download
                        </a>
                    }
                </div>
            }
        </div>
    </div>
}

<style>
    .artifact-preview-panel { display: flex; flex-direction: column; height: 100%; }
    .artifact-preview-panel-header { display: flex; align-items: center; gap: var(--space-2); padding: var(--space-3) var(--space-4); border-bottom: 1px solid var(--color-border); background: var(--color-surface); flex-shrink: 0; }
    .artifact-preview-panel-title { font-size: 0.875rem; font-weight: 600; color: var(--color-text-primary); flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .artifact-preview-panel-content { flex: 1; overflow: auto; padding: var(--space-4); }
    .artifact-preview-iframe { width: 100%; height: 100%; border: none; }
    .artifact-preview-table-wrap { overflow: auto; }
    .artifact-preview-table { border-collapse: collapse; font-size: 0.75rem; font-family: var(--font-mono); }
    .artifact-preview-table th, .artifact-preview-table td { border: 1px solid var(--color-border); padding: var(--space-1) var(--space-2); white-space: nowrap; }
    .artifact-preview-table th { background: var(--color-surface-sunken); font-weight: 600; }
    .artifact-preview-tabs { display: flex; gap: var(--space-1); padding: var(--space-2) var(--space-4); border-bottom: 1px solid var(--color-border); overflow-x: auto; flex-shrink: 0; }
    .artifact-preview-tab { padding: var(--space-1) var(--space-3); border-radius: var(--radius-md); border: 1px solid var(--color-border); background: transparent; color: var(--color-text-secondary); font-size: 0.75rem; cursor: pointer; transition: background var(--transition-fast); }
    .artifact-preview-tab:hover { background: var(--color-surface-sunken); color: var(--color-text-primary); }
    .artifact-preview-tab-active { border-color: var(--color-accent); background: var(--color-accent-light); color: var(--color-accent); }
    .artifact-preview-slides { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: var(--space-4); padding: var(--space-4); }
    .artifact-preview-slide-card { border: 1px solid var(--color-border); border-radius: var(--radius-md); padding: var(--space-3); cursor: pointer; background: var(--color-surface); transition: background var(--transition-fast); }
    .artifact-preview-slide-card:hover { background: var(--color-surface-sunken); }
    .artifact-preview-slide-num { font-size: 0.75rem; color: var(--color-text-secondary); margin-bottom: var(--space-1); }
    .artifact-preview-slide-title { font-size: 0.875rem; font-weight: 500; color: var(--color-text-primary); }
    .artifact-preview-code-wrap { margin: 0; overflow: auto; font-family: var(--font-mono); font-size: 0.75rem; line-height: 1.6; }
    .artifact-download-pane { display: flex; flex-direction: column; align-items: center; justify-content: center; height: 100%; gap: var(--space-4); color: var(--color-text-secondary); }
    .artifact-download-icon { font-size: 3rem !important; color: var(--color-accent); }
    .artifact-download-name { font-size: 0.9rem; font-weight: 500; color: var(--color-text-primary); }
    .artifact-download-size { font-size: 0.75rem; color: var(--color-text-secondary); }
    .artifact-download-btn { display: inline-flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4); border-radius: var(--radius-md); background: var(--color-accent); color: var(--color-text-on-accent); text-decoration: none; font-size: 0.875rem; font-weight: 500; transition: background var(--transition-fast); }
    .artifact-download-btn:hover { background: var(--color-accent-hover); }
    .artifact-preview-word-html { padding: var(--space-4); font-family: var(--font-primary); line-height: 1.7; }
    .artifact-preview-chart-wrap { width: 100%; max-height: 400px; display: flex; align-items: center; justify-content: center; }
    .artifact-preview-truncated { padding: var(--space-2) var(--space-4); background: var(--color-warning-bg); color: var(--color-warning); font-size: 0.75rem; border-top: 1px solid var(--color-border); flex-shrink: 0; }
</style>

@code {
    [Parameter] public ArtifactRecord? Artifact { get; set; }
    [Parameter] public string? DownloadUrl { get; set; }

    private enum RendererType { None, Html, Word, Excel, PowerPoint, Code, Json, Chart }

    private record SheetData(string Name, List<List<string>> Rows);
    private record SlideData(int Number, string Title, string Content);

    private RendererType _rendererType = RendererType.None;
    private bool _loading = false;
    private string? _error;
    private string _elementId = Guid.NewGuid().ToString("N")[..8];

    // Word
    private string? _wordHtml;

    // Excel
    private List<SheetData> _sheets = new();
    private int _activeSheet = 0;

    // PowerPoint
    private List<SlideData> _slides = new();
    private SlideData? _selectedSlide;

    // Code / JSON / Chart
    private string? _contentText;
    private string _codeLang = "none";
    private bool _truncated = false;
    private string? _chartJson;

    private string? _prevArtifactId;
    private bool _contentReady = false;

    protected override async Task OnParametersSetAsync()
    {
        if (Artifact == null || Artifact.Id == _prevArtifactId) return;
        _prevArtifactId = Artifact.Id;
        _contentReady = false;
        _error = null;
        _wordHtml = null;
        _sheets = new();
        _activeSheet = 0;
        _slides = new();
        _selectedSlide = null;
        _contentText = null;
        _chartJson = null;
        _truncated = false;
        _elementId = Guid.NewGuid().ToString("N")[..8];

        _rendererType = ResolveRenderer(Artifact);
        _codeLang = GetCodeLang();

        if (DownloadUrl == null)
        {
            _rendererType = RendererType.None;
            return;
        }

        if (_rendererType == RendererType.Html)
        {
            _contentReady = true;
            return;
        }

        _loading = true;
        StateHasChanged();

        try
        {
            await LoadContentAsync();
            _contentReady = true;
        }
        catch (Exception ex)
        {
            _error = $"Preview unavailable: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_contentReady) return;

        if (_rendererType == RendererType.Code || _rendererType == RendererType.Json)
        {
            try { await JS.InvokeVoidAsync("artifactPreview.initPrism", $"prism-{_elementId}"); }
            catch { /* best-effort */ }
            _contentReady = false;
        }
        else if (_rendererType == RendererType.Chart && _chartJson != null)
        {
            try { await JS.InvokeVoidAsync("artifactPreview.initChart", $"chart-{_elementId}", _chartJson); }
            catch { /* best-effort */ }
            _contentReady = false;
        }
    }

    private async Task LoadContentAsync()
    {
        var http = HttpClientFactory.CreateClient();
        var bytes = await http.GetByteArrayAsync(DownloadUrl);

        switch (_rendererType)
        {
            case RendererType.Word:
                _wordHtml = ExtractWordHtml(bytes);
                break;
            case RendererType.Excel:
                _sheets = ExtractExcelSheets(bytes);
                break;
            case RendererType.PowerPoint:
                _slides = ExtractPptSlides(bytes);
                break;
            case RendererType.Code:
            case RendererType.Json:
            case RendererType.Chart:
                const int maxBytes = 50 * 1024;
                if (bytes.Length > maxBytes)
                {
                    _contentText = Encoding.UTF8.GetString(bytes, 0, maxBytes);
                    _truncated = true;
                }
                else
                {
                    _contentText = Encoding.UTF8.GetString(bytes);
                }
                if (_rendererType == RendererType.Chart)
                    _chartJson = _contentText;
                break;
        }
    }

    private static string ExtractWordHtml(byte[] bytes)
    {
        using var ms = new MemoryStream(bytes);
        using var doc = WordprocessingDocument.Open(ms, false);
        var body = doc.MainDocumentPart?.Document?.Body;
        if (body == null) return "<p>(empty document)</p>";

        var sb = new StringBuilder();
        int pageBreaks = 0;
        foreach (var para in body.Elements<Paragraph>())
        {
            // Detect page break
            var breaks = para.Descendants<Break>()
                .Where(b => b.Type?.Value == BreakValues.Page);
            if (breaks.Any())
            {
                pageBreaks++;
                if (pageBreaks >= 3) break;
            }

            var text = para.InnerText;
            if (string.IsNullOrWhiteSpace(text))
            {
                sb.Append("<p>&nbsp;</p>");
                continue;
            }

            // Check for heading style
            var styleId = para.ParagraphProperties?.ParagraphStyleId?.Val?.Value ?? "";
            if (styleId.StartsWith("Heading", StringComparison.OrdinalIgnoreCase) ||
                styleId.StartsWith("heading", StringComparison.OrdinalIgnoreCase))
            {
                sb.Append($"<h3>{System.Net.WebUtility.HtmlEncode(text)}</h3>");
            }
            else
            {
                sb.Append($"<p>{System.Net.WebUtility.HtmlEncode(text)}</p>");
            }
        }
        return sb.Length > 0 ? sb.ToString() : "<p>(empty document)</p>";
    }

    private static List<SheetData> ExtractExcelSheets(byte[] bytes)
    {
        using var ms = new MemoryStream(bytes);
        using var wb = new XLWorkbook(ms);
        var sheets = new List<SheetData>();
        foreach (var ws in wb.Worksheets)
        {
            var rows = new List<List<string>>();
            int rowCount = 0;
            foreach (var row in ws.RowsUsed())
            {
                if (rowCount++ >= 50) break;
                var cells = new List<string>();
                int colCount = 0;
                foreach (var cell in row.CellsUsed())
                {
                    if (colCount++ >= 20) break;
                    cells.Add(cell.GetString());
                }
                // Pad to consistent column count
                rows.Add(cells);
            }
            sheets.Add(new SheetData(ws.Name, rows));
        }
        return sheets;
    }

    private static List<SlideData> ExtractPptSlides(byte[] bytes)
    {
        using var ms = new MemoryStream(bytes);
        using var prs = PresentationDocument.Open(ms, false);
        var ppt = prs.PresentationPart?.Presentation;
        if (ppt == null) return new();

        var slides = new List<SlideData>();
        int num = 1;
        var slideIds = ppt.SlideIdList?.Elements<SlideId>() ?? Enumerable.Empty<SlideId>();
        foreach (var slideId in slideIds)
        {
            var relId = slideId.RelationshipId?.Value;
            if (relId == null) { num++; continue; }

            var slidePart = prs.PresentationPart!.GetPartById(relId) as SlidePart;
            if (slidePart == null) { num++; continue; }

            var shapes = slidePart.Slide?.CommonSlideData?.ShapeTree?.Elements<DocumentFormat.OpenXml.Presentation.Shape>()
                ?? Enumerable.Empty<DocumentFormat.OpenXml.Presentation.Shape>();

            string title = "";
            var contentParts = new List<string>();

            foreach (var shape in shapes)
            {
                var ph = shape.NonVisualShapeProperties?.ApplicationNonVisualDrawingProperties
                    ?.PlaceholderShape;
                var text = ExtractShapeText(shape);
                if (string.IsNullOrWhiteSpace(text)) continue;

                if (ph?.Type?.Value == PlaceholderValues.Title ||
                    ph?.Type?.Value == PlaceholderValues.CenteredTitle)
                {
                    title = text;
                }
                else
                {
                    contentParts.Add(text);
                }
            }

            slides.Add(new SlideData(num++, title, string.Join("\n\n", contentParts)));
        }
        return slides;
    }

    private static string ExtractShapeText(DocumentFormat.OpenXml.Presentation.Shape shape)
    {
        var sb = new StringBuilder();
        var txBody = shape.TextBody;
        if (txBody == null) return "";
        foreach (var para in txBody.Elements<DocumentFormat.OpenXml.Drawing.Paragraph>())
        {
            var line = string.Concat(para.Elements<DocumentFormat.OpenXml.Drawing.Run>()
                .Select(r => r.Text?.Text ?? ""));
            if (!string.IsNullOrWhiteSpace(line))
                sb.AppendLine(line);
        }
        return sb.ToString().Trim();
    }

    private void SelectSheet(int idx)
    {
        _activeSheet = idx;
    }

    private static RendererType ResolveRenderer(ArtifactRecord artifact)
    {
        var fn = artifact.FileName.ToLowerInvariant();
        var type = artifact.Type.ToLowerInvariant();

        if (fn.EndsWith(".chart.json")) return RendererType.Chart;

        return type switch
        {
            "docx" => RendererType.Word,
            "xlsx" => RendererType.Excel,
            "pptx" => RendererType.PowerPoint,
            "html" => RendererType.Html,
            "json" => RendererType.Json,
            "code" or "cs" or "js" or "ts" or "py" or "yaml" or "sh" or "txt" => RendererType.Code,
            _ => ResolveByExtension(fn),
        };
    }

    private static RendererType ResolveByExtension(string fn)
    {
        var ext = Path.GetExtension(fn).TrimStart('.').ToLowerInvariant();
        return ext switch
        {
            "docx" => RendererType.Word,
            "xlsx" => RendererType.Excel,
            "pptx" => RendererType.PowerPoint,
            "html" or "htm" => RendererType.Html,
            "json" => RendererType.Json,
            "cs" or "js" or "ts" or "py" or "yaml" or "yml" or "sh" or "txt" => RendererType.Code,
            _ => RendererType.None,
        };
    }

    private string GetCodeLang()
    {
        var fn = Artifact?.FileName.ToLowerInvariant() ?? "";
        var ext = Path.GetExtension(fn).TrimStart('.');
        return ext switch
        {
            "cs" => "csharp",
            "js" => "javascript",
            "ts" => "typescript",
            "py" => "python",
            "yaml" or "yml" => "yaml",
            "sh" => "bash",
            "json" => "json",
            _ => "none",
        };
    }

    private static string GetTypeIcon(string type) => type switch
    {
        "docx" => Icons.Material.Filled.Description,
        "xlsx" => Icons.Material.Filled.TableChart,
        "pptx" => Icons.Material.Filled.Slideshow,
        "html" => Icons.Material.Filled.Code,
        "json" => Icons.Material.Filled.DataObject,
        "code" => Icons.Material.Filled.Code,
        _ => Icons.Material.Filled.InsertDriveFile,
    };

    private static string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024:N0} KB";
        return $"{bytes / (1024 * 1024.0):N1} MB";
    }
}
