@using FortressAI.V2.Web.Services
@inject IHttpClientFactory HttpClientFactory
@inject ILogger<ApprovalDialog> Logger

<div class="approval-dialog">
    <div class="approval-dialog__header">
        <span class="approval-dialog__icon">⚠️</span>
        <span class="approval-dialog__title">Action Requires Approval</span>
        <span class="approval-dialog__type-badge">@Request.ActionType</span>
    </div>
    <div class="approval-dialog__summary">
        @Request.ActionSummary
    </div>
    @if (!string.IsNullOrEmpty(Request.ActionDetails))
    {
        <div class="approval-dialog__details-toggle" @onclick="ToggleDetails">
            <span>@(_showDetails ? "Hide" : "Show") details</span>
            <MudIcon Icon="@(_showDetails ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)" Class="approval-dialog__chevron" />
        </div>
        @if (_showDetails)
        {
            <pre class="approval-dialog__details">@Request.ActionDetails</pre>
        }
    }
    <div class="approval-dialog__actions">
        <button class="approval-dialog__btn approval-dialog__btn--deny"
                @onclick="() => RespondAsync(false)"
                disabled="@_isResponding">
            @if (_isResponding && !_respondingApprove)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="approval-dialog__spinner" />
            }
            <span>Deny</span>
        </button>
        <button class="approval-dialog__btn approval-dialog__btn--approve"
                @onclick="() => RespondAsync(true)"
                disabled="@_isResponding">
            @if (_isResponding && _respondingApprove)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="approval-dialog__spinner" />
            }
            <span>Approve</span>
        </button>
    </div>
</div>

<style>
    .approval-dialog {
        border: 1px solid var(--color-warning, #f59e0b);
        border-radius: var(--radius-md);
        background: var(--color-surface);
        padding: var(--space-4);
        margin: var(--space-3) 0;
        max-width: 600px;
    }

    .approval-dialog__header {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        margin-bottom: var(--space-3);
    }

    .approval-dialog__icon {
        font-size: var(--font-size-lg);
    }

    .approval-dialog__title {
        font-weight: 600;
        font-size: var(--font-size-sm);
        color: var(--color-text-primary);
        flex: 1;
    }

    .approval-dialog__type-badge {
        font-size: var(--font-size-xs);
        padding: 2px var(--space-2);
        border-radius: var(--radius-sm);
        background: var(--color-surface-sunken);
        border: 1px solid var(--color-border);
        color: var(--color-text-secondary);
        font-family: monospace;
    }

    .approval-dialog__summary {
        font-size: var(--font-size-sm);
        color: var(--color-text-primary);
        margin-bottom: var(--space-3);
        line-height: 1.5;
    }

    .approval-dialog__details-toggle {
        display: flex;
        align-items: center;
        gap: var(--space-1);
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        cursor: pointer;
        margin-bottom: var(--space-2);
        user-select: none;
    }

    .approval-dialog__details-toggle:hover {
        color: var(--color-text-primary);
    }

    .approval-dialog__chevron {
        font-size: var(--font-size-sm);
    }

    .approval-dialog__details {
        font-size: var(--font-size-xs);
        color: var(--color-text-secondary);
        background: var(--color-surface-sunken);
        border: 1px solid var(--color-border);
        border-radius: var(--radius-sm);
        padding: var(--space-3);
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-all;
        margin-bottom: var(--space-3);
    }

    .approval-dialog__actions {
        display: flex;
        gap: var(--space-3);
        justify-content: flex-end;
    }

    .approval-dialog__btn {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-4);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        font-size: var(--font-size-sm);
        font-weight: 500;
        cursor: pointer;
        transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
    }

    .approval-dialog__btn:disabled {
        opacity: 0.6;
        cursor: not-allowed;
    }

    .approval-dialog__btn--deny {
        background: transparent;
        color: var(--color-error);
        border-color: var(--color-error);
    }

    .approval-dialog__btn--deny:hover:not(:disabled) {
        background: var(--color-error-bg, rgba(239, 68, 68, 0.08));
    }

    .approval-dialog__btn--approve {
        background: var(--color-accent);
        color: var(--color-on-accent, #fff);
        border-color: var(--color-accent);
    }

    .approval-dialog__btn--approve:hover:not(:disabled) {
        background: var(--color-accent-hover, var(--color-accent));
        filter: brightness(1.08);
    }

    .approval-dialog__spinner {
        width: 14px !important;
        height: 14px !important;
    }
</style>

@code {
    [Parameter, EditorRequired] public CCInterventionRequest Request { get; set; } = default!;
    [Parameter] public EventCallback<bool> OnRespond { get; set; }
    [Parameter] public string HarnessUrl { get; set; } = "";

    private bool _showDetails = false;
    private bool _isResponding = false;
    private bool _respondingApprove = false;

    private void ToggleDetails() => _showDetails = !_showDetails;

    private async Task RespondAsync(bool approved)
    {
        if (_isResponding) return;
        _isResponding = true;
        _respondingApprove = approved;
        StateHasChanged();

        try
        {
            if (!string.IsNullOrEmpty(HarnessUrl))
            {
                var client = HttpClientFactory.CreateClient("HarnessClient");
                await client.PostAsJsonAsync($"{HarnessUrl}/intervention/respond", new
                {
                    interventionId = Request.InterventionId,
                    approved
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ApprovalDialog: failed to POST respond to harness — calling OnRespond anyway");
        }
        finally
        {
            _isResponding = false;
        }

        await OnRespond.InvokeAsync(approved);
    }
}
