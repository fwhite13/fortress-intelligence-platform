@using FortressAI.V2.Web.Models
@using FortressAI.V2.Web.Services
@using FortressAI.V2.Web.Data.Models
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client

@* Main chat component — lives in DualPaneLayout's ChatContent slot *@

<div class="chat-container">

    @* Agent selector toolbar *@
    <div class="chat-agent-toolbar">
        <div class="chat-agent-pills">
            <button class="chat-agent-pill @(_activeAgent == ActiveAgent.MainAssistant ? "chat-agent-pill-active" : "")"
                    @onclick="@(() => SetAgent(ActiveAgent.MainAssistant))"
                    title="Main assistant">
                <MudIcon Icon="@Icons.Material.Filled.Chat" Class="chat-pill-icon" />
                <span class="chat-pill-label">Assistant</span>
            </button>
            <button class="chat-agent-pill @(_activeAgent == ActiveAgent.DesignAgent ? "chat-agent-pill-active" : "")"
                    @onclick="@(() => SetAgent(ActiveAgent.DesignAgent))"
                    title="Design Agent — create UI with Stitch">
                <MudIcon Icon="@Icons.Material.Filled.Palette" Class="chat-pill-icon" />
                <span class="chat-pill-label">Design Agent</span>
            </button>
        </div>
        @if (_activeAgent == ActiveAgent.DesignAgent)
        {
            <AgentPluginBadge AgentName="Design Agent" IsActive="true" />
        }
    </div>

    @if (_activeAgent == ActiveAgent.DesignAgent)
    {
        <DesignAgentView />
    }
    else
    {

    @* Message history — scrollable *@
    <div class="chat-messages" @ref="_messagesRef">
        @if (!_messages.Any())
        {
            <div class="chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Chat" Class="chat-empty-icon" />
                <p class="chat-empty-title">What can I help you with?</p>
                <p class="chat-empty-subtitle">Ask anything, or start with one of your recent topics.</p>
            </div>
        }
        else
        {
            @foreach (var msg in _messages)
            {
                <MessageBubble Message="@msg" />
            }
            @if (_isStreaming)
            {
                <div class="chat-streaming-indicator">
                    <span class="chat-streaming-text">@_streamingContent</span>
                    <span class="chat-streaming-cursor">▋</span>
                </div>
            }
        }

        @* CC progress indicator *@
        @if (_ccRunning)
        {
            <div class="chat-artifact-progress">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <span class="chat-artifact-progress-step">@_ccCurrentStep</span>
                <MudButton Size="Size.Small" OnClick="CancelCCTask" Class="chat-artifact-cancel-btn">Cancel</MudButton>
            </div>
        }

        @* Artifact result card *@
        @if (_lastArtifact != null)
        {
            <div class="chat-artifact-result">
                <MudIcon Icon="@GetArtifactIcon(_lastArtifact.Type)" Class="chat-artifact-icon" />
                <span class="chat-artifact-filename">@_lastArtifact.FileName</span>
                @if (_lastArtifact.Type == "html")
                {
                    <MudButton Size="Size.Small" OnClick="PreviewArtifact" Class="chat-artifact-action-btn">Preview</MudButton>
                }
                <MudButton Size="Size.Small" OnClick="DownloadArtifact" Class="chat-artifact-action-btn">Download</MudButton>
            </div>
        }
    </div>

    @* Input bar — sticky bottom *@
    <div class="chat-input-bar">
        @* Top row: KB toggles *@
        <div class="chat-input-top-row">
            <div class="chat-kb-pills">
                <button @onclick="ToggleFortressKb" title="Search Fortress knowledge base" style="@GetFortressKbStyle()">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="chat-pill-icon" />
                    <span class="chat-pill-label">Fortress KB</span>
                </button>
                <button @onclick="TogglePersonalKb" title="My personal knowledge base" style="@GetPersonalKbStyle()">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="chat-pill-icon" />
                    <span class="chat-pill-label">My KB</span>
                </button>
            </div>
        </div>
        @* Bottom row: text input + send *@
        <div class="chat-input-bottom-row">
            <textarea class="chat-input-field"
                      @bind="_inputText"
                      @bind:event="oninput"
                      @onkeydown="HandleKeyDown"
                      placeholder="Message your assistant..."
                      rows="1"
                      disabled="@(_isStreaming || _ccRunning)"></textarea>
            <button class="chat-send-btn"
                    @onclick="SendMessage"
                    disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning)"
                    title="Send message">
                <MudIcon Icon="@Icons.Material.Filled.Send" Class="chat-send-icon" />
            </button>
        </div>
    </div>

    } @* end else (MainAssistant) *@

</div>

<style>
    .chat-agent-toolbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: var(--space-2) var(--space-4);
        border-bottom: 1px solid var(--color-border);
        background: var(--color-surface);
    }

    .chat-agent-pills {
        display: flex;
        gap: var(--space-2);
    }

    .chat-agent-pill {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-1) var(--space-3);
        height: var(--pill-height-sm);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-text-secondary);
        font-size: var(--font-size-sm);
        cursor: pointer;
        transition: background var(--transition-base), color var(--transition-base), border-color var(--transition-base);
    }

    .chat-agent-pill:hover {
        background: var(--color-surface-hover);
        color: var(--color-text-primary);
    }

    .chat-agent-pill-active {
        border-color: var(--color-accent);
        background: var(--color-accent-bg);
        color: var(--color-accent);
    }
</style>

@code {
    [Inject] private IUserAgentRuntime AgentRuntime { get; set; } = default!;
    [Inject] private IForgeKbService ForgeKbService { get; set; } = default!;
    [Inject] private ProjectStateService ProjectState { get; set; } = default!;
    [Inject] private ICCExecutionService CCExecutionService { get; set; } = default!;
    [Inject] private IArtifactService ArtifactService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<ChatMessage> _messages = new();
    private string _inputText = "";
    private bool _isStreaming = false;
    private string _streamingContent = "";
    private ElementReference _messagesRef;
    private string _userId = "";
    private string _userDisplayName = "";
    private bool _fortressKbEnabled = false;
    private bool _personalKbEnabled = true;
    private ActiveAgent _activeAgent = ActiveAgent.MainAssistant;

    // CC task state
    private bool _ccRunning = false;
    private string _ccCurrentStep = "Generating artifact...";
    private CancellationTokenSource? _ccCts;
    private ArtifactRecord? _lastArtifact;
    private HubConnection? _hubConnection;

    private static readonly string[] ArtifactKeywords = { "create", "generate", "write", "make", "build" };
    private static readonly string[] ArtifactTypeHints = { "word doc", "docx", "excel", "spreadsheet", "xlsx", "presentation", "pptx", "powerpoint", "report", "html", "webpage" };

    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null) return;
        var auth = await AuthState;
        _userId = auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
               ?? auth.User.FindFirst("oid")?.Value ?? "";
        _userDisplayName = auth.User.FindFirst("name")?.Value
                        ?? auth.User.FindFirst("preferred_username")?.Value ?? "User";

        await ConnectSignalRAsync();
    }

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavManager.ToAbsoluteUri("/hubs/cc-progress"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<CCProgressUpdate>("ReceiveProgress", update =>
            {
                _ccCurrentStep = update.CurrentStep;
                InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception)
        {
            // SignalR is non-critical — progress updates are best-effort
        }
    }

    private string GetFortressKbStyle() =>
        _fortressKbEnabled
            ? "display: flex; align-items: center; padding: 0 var(--space-3); height: var(--pill-height-sm); border-radius: var(--radius-md); border: 1px solid var(--color-gold); background: var(--color-gold-muted); color: var(--color-gold); cursor: pointer;"
            : "display: flex; align-items: center; padding: 0 var(--space-3); height: var(--pill-height-sm); border-radius: var(--radius-md); border: 1px solid var(--color-border); background: transparent; color: var(--color-text-secondary); cursor: pointer;";

    private string GetPersonalKbStyle() =>
        _personalKbEnabled
            ? "display: flex; align-items: center; padding: 0 var(--space-3); height: var(--pill-height-sm); border-radius: var(--radius-md); border: 1px solid var(--color-gold); background: var(--color-gold-muted); color: var(--color-gold); cursor: pointer;"
            : "display: flex; align-items: center; padding: 0 var(--space-3); height: var(--pill-height-sm); border-radius: var(--radius-md); border: 1px solid var(--color-border); background: transparent; color: var(--color-text-secondary); cursor: pointer;";

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning) return;

        var userMessage = _inputText.Trim();
        _inputText = "";
        _messages.Add(new ChatMessage(Role: "user", Content: userMessage));
        _lastArtifact = null;
        StateHasChanged();

        if (IsArtifactRequest(userMessage))
        {
            await RunCCTaskAsync(userMessage);
        }
        else
        {
            await RunStreamingTurnAsync(userMessage);
        }
    }

    private bool IsArtifactRequest(string message)
    {
        var lower = message.ToLowerInvariant();
        bool hasKeyword = ArtifactKeywords.Any(k => lower.Contains(k));
        bool hasTypeHint = ArtifactTypeHints.Any(t => lower.Contains(t));
        return hasKeyword && hasTypeHint;
    }

    private async Task RunStreamingTurnAsync(string userMessage)
    {
        _isStreaming = true;
        _streamingContent = "";
        StateHasChanged();

        var assistantContent = new System.Text.StringBuilder();
        try
        {
            var request = new TurnRequest(
                Message: BuildContextualMessage(userMessage),
                SystemPrompt: BuildSystemPrompt()
            );
            await foreach (var evt in AgentRuntime.SendTurnAsync(_userId, request))
            {
                if (evt.Type == "text" && evt.Content != null)
                {
                    assistantContent.Append(evt.Content);
                    _streamingContent = assistantContent.ToString();
                    StateHasChanged();
                }
                else if (evt.Type == "done" || evt.Type == "error")
                {
                    break;
                }
            }
        }
        finally
        {
            _isStreaming = false;
            if (assistantContent.Length > 0)
                _messages.Add(new ChatMessage(Role: "assistant", Content: assistantContent.ToString()));
            _streamingContent = "";
            StateHasChanged();
        }
    }

    private async Task RunCCTaskAsync(string userMessage)
    {
        _ccRunning = true;
        _ccCurrentStep = "Starting artifact generation...";
        _ccCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var envelope = BuildEnvelope(_userId, _userDisplayName);
            var result = await CCExecutionService.DispatchTaskAsync(
                _userId,
                userMessage,
                envelope,
                cancellationToken: _ccCts.Token);

            if (result.Success && result.ArtifactS3Key != null)
            {
                _lastArtifact = await ArtifactService.RecordArtifactAsync(
                    _userId, result, userMessage, _ccCts.Token);

                var responseMsg = $"I've generated **{_lastArtifact.FileName}** for you. Use the buttons below to preview or download it.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: responseMsg));
            }
            else
            {
                var errorMsg = result.Error ?? "The artifact generation did not produce a file. Please try again with a more specific request.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: $"Artifact generation failed: {errorMsg}"));
            }
        }
        catch (OperationCanceledException)
        {
            _messages.Add(new ChatMessage(Role: "assistant", Content: "Artifact generation was cancelled."));
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage(Role: "assistant", Content: $"An error occurred during artifact generation: {ex.Message}"));
        }
        finally
        {
            _ccRunning = false;
            _ccCts?.Dispose();
            _ccCts = null;
            StateHasChanged();
        }
    }

    private void CancelCCTask()
    {
        _ccCts?.Cancel();
    }

    private async Task DownloadArtifact()
    {
        if (_lastArtifact == null) return;
        try
        {
            var url = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
            NavManager.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            // download URL generation failure — silently ignore
        }
    }

    private async Task PreviewArtifact()
    {
        if (_lastArtifact == null || _lastArtifact.Type != "html") return;
        try
        {
            var url = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
            NavManager.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            // preview URL generation failure — silently ignore
        }
    }

    private static string GetArtifactIcon(string type) => type switch
    {
        "docx" => Icons.Material.Filled.Description,
        "xlsx" => Icons.Material.Filled.TableChart,
        "pptx" => Icons.Material.Filled.Slideshow,
        "html" => Icons.Material.Filled.Code,
        "json" => Icons.Material.Filled.DataObject,
        "code" => Icons.Material.Filled.Code,
        _      => Icons.Material.Filled.InsertDriveFile,
    };

    private CCContextEnvelope BuildEnvelope(string userId, string displayName)
    {
        return new CCContextEnvelope
        {
            UserId = userId,
            UserDisplayName = displayName,
            KbIds = new List<string>(),
            EnabledMcpServers = new List<string>(),
            MemorySummary = null,
            TaskInstructions = @"You are an AI assistant generating a document artifact.
Generate the requested document and write it to the working directory.
Use python-docx for .docx, openpyxl for .xlsx, python-pptx for .pptx.
For HTML, write a clean self-contained HTML file.
The filename should be descriptive of the content.",
        };
    }

    private string BuildContextualMessage(string userInput)
    {
        return string.IsNullOrEmpty(ProjectState.ActiveProjectContext)
            ? userInput
            : $"[ACTIVE PROJECT CONTEXT]\n{ProjectState.ActiveProjectContext}\n\n[USER MESSAGE]\n{userInput}";
    }

    private string? BuildSystemPrompt()
    {
        var parts = new List<string>();
        if (_fortressKbEnabled) parts.Add("Search the Fortress knowledge base for relevant context.");
        if (_personalKbEnabled) parts.Add("Search the user's personal knowledge base for relevant context.");
        return parts.Any() ? string.Join(" ", parts) : null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private void ToggleFortressKb() => _fortressKbEnabled = !_fortressKbEnabled;
    private void TogglePersonalKb() => _personalKbEnabled = !_personalKbEnabled;

    private void SetAgent(ActiveAgent agent) => _activeAgent = agent;

    public async ValueTask DisposeAsync()
    {
        _ccCts?.Cancel();
        _ccCts?.Dispose();
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
