@code {
    [Inject] private IUserAgentRuntime AgentRuntime { get; set; } = default!;
    [Inject] private IForgeKbService ForgeKbService { get; set; } = default!;
    [Inject] private ProjectStateService ProjectState { get; set; } = default!;
    [Inject] private ICCExecutionService CCExecutionService { get; set; } = default!;
    [Inject] private IArtifactService ArtifactService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private IUserService UserService { get; set; } = default!;
    [Inject] private IDbContextFactory<FaitV2DbContext> DbFactory { get; set; } = default!;
    [Inject] private ILogger<ChatView> _logger { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<ChatMessage> _messages = new();
    private string? _initError = null;
    private string? _conversationId;
    private string _inputText = "";
    private bool _isStreaming = false;
    private string _streamingContent = "";
    private ElementReference _messagesRef;
    private string _userId = "";
    private string _userDisplayName = "";
    private bool _fortressKbEnabled = false;
    private bool _personalKbEnabled = true;
    private ActiveAgent _activeAgent = ActiveAgent.MainAssistant;

    // Plugin state
    private List<AgentPlugin> _availablePlugins = new();
    private string? _selectedPluginId = null;

    // §6.1 — Plugin agent switching state
    private string? _activePluginAgentId = null;      // currently active plugin agent
    private string? _suggestedAgentId = null;         // agent suggested by last assistant turn
    private string? _suggestedAgentName = null;       // display name of suggested agent

    // CC task state
    private bool _ccRunning = false;
    private bool _harnessReady = false;
    private string _ccCurrentStep = "Generating artifact...";
    private CancellationTokenSource? _ccCts;
    private ArtifactRecord? _lastArtifact;
    private string? _artifactPreviewUrl = null;
    private bool _isPanelOpen = false;
    private HubConnection? _hubConnection;

    // Intervention gate state
    private CCInterventionRequest? _pendingIntervention = null;
    private string _harnessBaseUrl = "";

    // ConversationTask tracking
    private string? _activeTaskId;
    private bool _taskCreated = false;
    private bool _titlePending = false;
    private string? _taskProjectId;
    private string? _taskProjectName;

    private bool _forceTaskMode = false;

    private static readonly string[] ArtifactKeywords = { "create", "generate", "write", "make", "build" };
    private static readonly string[] ArtifactTypeHints = { "word doc", "docx", "excel", "spreadsheet", "xlsx", "presentation", "pptx", "powerpoint", "report", "html", "webpage" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState == null) return;
            var auth = await AuthState;
            var entraOid = auth.User.FindFirst("oid")?.Value
                       ?? auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                       ?? "";
            _logger.LogInformation("ChatView init: entraOid={EntraOid}", entraOid);

            // CRITICAL: resolve internal DB user ID — NOT entraOid
            var user = await UserService.GetByEntraOidAsync(entraOid);
            _userId = user?.Id ?? "";
            _logger.LogInformation("ChatView init: userId resolved={UserId}", _userId);
            if (string.IsNullOrEmpty(_userId))
            {
                _logger.LogError("Could not resolve internal userId for entraOid {EntraOid}", entraOid);
                _initError = "Could not resolve your user account. Please reload the page.";
                return;
            }

            _userDisplayName = auth.User.FindFirst("name")?.Value
                            ?? auth.User.FindFirst("preferred_username")?.Value ?? "User";

            var userRoles = auth.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "roles")
                .Select(c => c.Value);
            _availablePlugins = await PluginAgentService.GetAvailablePluginsAsync(_userId, userRoles);

            // §15 — Load or create active conversation and restore history
            var conv = await ConversationService.GetOrCreateActiveConversationAsync(_userId);
            _conversationId = conv.Id;
            _logger.LogInformation("ChatView init: conversationId={ConvId}", _conversationId);
            var history = await ConversationService.GetFullHistoryAsync(_conversationId);
            _messages = history
                .Where(m => !m.IsCompactionSummary)
                .Select(m => new ChatMessage(m.Role, m.Content))
                .ToList();
            _logger.LogInformation("ChatView init: history loaded, {Count} messages", _messages.Count);

            // Pre-warm harness — fire and forget, spinner guards input until ready
            var capturedUserId = _userId;
            _ = Task.Run(async () =>
            {
                try
                {
                    _logger.LogInformation("ChatView: pre-warming harness for userId={UserId}", capturedUserId);
                    using var warmupCts = new CancellationTokenSource(TimeSpan.FromSeconds(90));
                    await AgentRuntime.EnsureRunningAsync(capturedUserId, warmupCts.Token);
                    _logger.LogInformation("ChatView: harness pre-warm complete for userId={UserId}", capturedUserId);
                }
                catch (Exception ex)
                {
                    _logger.LogWarning(ex, "ChatView: harness pre-warm failed for userId={UserId} — will retry on first message", capturedUserId);
                }
                finally
                {
                    _harnessReady = true;
                    await InvokeAsync(StateHasChanged);
                }
            });

            await ConnectSignalRAsync();

            // Resolve harness base URL for ApprovalDialog response posting
            try
            {
                var session = await AgentRuntime.GetSessionAsync(_userId);
                if (session != null && !string.IsNullOrEmpty(session.PrivateIp))
                    _harnessBaseUrl = $"http://{session.PrivateIp}:{session.Port}";
            }
            catch { /* non-fatal — ApprovalDialog will skip POST if URL is empty */ }

            _logger.LogInformation("ChatView init: complete");
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ChatView OnInitializedAsync failed for entraOid {EntraOid}", 
                AuthState == null ? "(no AuthState)" : "(see above)");
            _initError = ex.Message;
            StateHasChanged();
        }
    }

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavManager.ToAbsoluteUri("/hubs/cc-progress"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<CCProgressUpdate>("ReceiveProgress", update =>
            {
                _ccCurrentStep = update.CurrentStep;
                InvokeAsync(StateHasChanged);
            });

            _hubConnection.On<CCInterventionRequest>("ReceiveInterventionRequired", async (request) =>
            {
                _pendingIntervention = request;
                await InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception)
        {
            // SignalR is non-critical — progress updates are best-effort
        }
    }

    private async Task SendMessage()
    {
        _logger.LogInformation("SendMessage called: inputLen={Len}, isStreaming={IsStreaming}, userId={UserId}",
            _inputText?.Length ?? 0, _isStreaming, _userId);
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning || !_harnessReady) return;
        if (string.IsNullOrWhiteSpace(_userId)) return;

        var userMessage = _inputText.Trim();
        _inputText = "";
        _messages.Add(new ChatMessage(Role: "user", Content: userMessage));
        _lastArtifact = null;
        StateHasChanged();

        // Create ConversationTask row on first message
        if (!_taskCreated && !string.IsNullOrEmpty(_userId))
        {
            _taskCreated = true;
            var newTask = new ConversationTask
            {
                UserId = _userId,
                Title = "New conversation",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };
            _activeTaskId = newTask.Id; // optimistic — Id is set before DB write
            _titlePending = true;
            // Load project info for badge if task has a project
            _ = LoadTaskProjectAsync(_activeTaskId);
            _ = Task.Run(async () =>
            {
                try
                {
                    await using var db = await DbFactory.CreateDbContextAsync();
                    db.ConversationTasks.Add(newTask);
                    await db.SaveChangesAsync();
                }
                catch (Exception ex) { _logger.LogWarning(ex, "Failed to create conversation task"); }
            });
        }

        if (IsArtifactRequest(userMessage))
        {
            await RunCCTaskAsync(userMessage);
        }
        else
        {
            await RunStreamingTurnAsync(userMessage);
        }
    }

    private bool IsArtifactRequest(string message)
    {
        var lower = message.ToLowerInvariant();
        bool hasKeyword = ArtifactKeywords.Any(k => lower.Contains(k));
        bool hasTypeHint = ArtifactTypeHints.Any(t => lower.Contains(t));
        return hasKeyword && hasTypeHint;
    }

    private async Task RunStreamingTurnAsync(string userMessage)
    {
        _logger.LogInformation("RunStreamingTurnAsync: starting for userId={UserId}", _userId);
        _isStreaming = true;
        _streamingContent = "";
        StateHasChanged();

        var assistantContent = new System.Text.StringBuilder();
        int? tokensIn = null;
        int? tokensOut = null;
        try
        {
            // Persist user message to DB
            if (!string.IsNullOrEmpty(_conversationId))
                await ConversationService.AppendMessageAsync(_conversationId, "user", userMessage, EstimateTokens(userMessage));

            // Build context from DB (compaction-aware)
            _logger.LogInformation("RunStreamingTurnAsync: building context history");
            List<FortressAI.V2.Web.Services.ChatHistoryEntry> contextHistory;
            if (!string.IsNullOrEmpty(_conversationId))
            {
                var contextMessages = await ConversationService.GetMessagesForContextAsync(_conversationId);
                if (contextMessages.Count > 0 && contextMessages.Last().Role != "user")
                    _logger.LogWarning("GetMessagesForContextAsync last message is not user role — SkipLast(1) may exclude wrong message. Last role={LastRole}", contextMessages.Last().Role);
                contextHistory = contextMessages
                    .Where(m => m.Role != "system" || m.IsCompactionSummary)
                    .SkipLast(1)  // exclude the just-appended user message
                    .Select(m => new FortressAI.V2.Web.Services.ChatHistoryEntry(m.Role, m.Content))
                    .ToList();
                _logger.LogInformation("Context history: {Count} messages sent to harness for turn", contextHistory.Count);
            }
            else
            {
                contextHistory = _messages
                    .Where(m => m.Role != "system")
                    .SkipLast(1)
                    .Select(m => new FortressAI.V2.Web.Services.ChatHistoryEntry(m.Role, m.Content))
                    .ToList();
            }

            var request = new TurnRequest(
                UserId: _userId,
                Message: BuildContextualMessage(userMessage),
                SystemPrompt: BuildSystemPrompt(),
                TaskMode: false,
                ForceTaskMode: _forceTaskMode,
                History: contextHistory,
                PluginAgentId: _activePluginAgentId   // §6.1
            );
            _forceTaskMode = false; // reset after send
            _logger.LogInformation("RunStreamingTurnAsync: calling SendTurnAsync for userId={UserId}, requestMessageLen={Len}, historyCount={HistCount}",
                _userId, request.Message?.Length ?? 0, request.History?.Count ?? 0);
            int evtCount = 0;
            await foreach (var evt in AgentRuntime.SendTurnAsync(_userId, request))
            {
                evtCount++;
                _logger.LogInformation("RunStreamingTurnAsync: received event #{EvtCount} type={Type} contentLen={ContentLen} error={Error}",
                    evtCount, evt.Type, evt.Content?.Length ?? 0, evt.ErrorMessage ?? "");
                if (evt.Type == "text" && evt.Content != null)
                {
                    assistantContent.Append(evt.Content);
                    _streamingContent = assistantContent.ToString();
                    StateHasChanged();
                }
                else if (evt.Type == "done" || evt.Type == "error")
                {
                    if (evt.Type == "error" && !string.IsNullOrEmpty(evt.ErrorMessage))
                    {
                        _logger.LogError("Harness returned error for user {UserId}: {Error}", _userId, evt.ErrorMessage);
                        _messages.Add(new ChatMessage(Role: "assistant", Content: $"⚠️ {evt.ErrorMessage}"));
                        StateHasChanged();
                    }
                    tokensIn  = evt.InputTokens;
                    tokensOut = evt.OutputTokens;
                    break;
                }
            }
            _logger.LogInformation("RunStreamingTurnAsync: SendTurnAsync enumeration complete — totalEvents={EvtCount}, contentLen={ContentLen} for userId={UserId}",
                evtCount, assistantContent.Length, _userId);
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "RunStreamingTurnAsync failed for userId={UserId}", _userId);
            _streamingContent = "";
            _messages.Add(new ChatMessage(Role: "assistant", Content: $"⚠️ Error: {ex.Message}"));
            StateHasChanged();
        }
        finally
        {
            _isStreaming = false;
            var fullResponse = assistantContent.ToString();
            // §6.1 — detect agent suggestion in assistant response
            if (fullResponse.Length > 0)
                DetectAgentSuggestion(fullResponse);
            if (fullResponse.Length > 0)
            {
                _messages.Add(new ChatMessage(
                    Role: "assistant",
                    Content: fullResponse,
                    TokensIn: tokensIn,
                    TokensOut: tokensOut));
                // Persist assistant message to DB
                if (!string.IsNullOrEmpty(_conversationId))
                {
                    await ConversationService.AppendMessageAsync(_conversationId, "assistant", fullResponse, EstimateTokens(fullResponse));
                    await ConversationService.UpdateTokenCountAsync(_conversationId, EstimateTokens(userMessage) + EstimateTokens(fullResponse));
                    // Fire-and-forget compaction check — use fresh scope to avoid captured-scoped-service disposal
                    var convIdCapture = _conversationId;
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await using var scope = ScopeFactory.CreateAsyncScope();
                            var compaction = scope.ServiceProvider.GetRequiredService<ICompactionService>();
                            await compaction.CompactIfNeededAsync(convIdCapture);
                        }
                        catch (OperationCanceledException) { /* expected */ }
                        catch (Exception ex)
                        {
                            _logger.LogWarning(ex, "Compaction failed for conversation {ConvId}", convIdCapture);
                        }
                    });

                    // Fire title generation after the first exchange only
                    if (!string.IsNullOrEmpty(_activeTaskId) && _titlePending)
                    {
                        _titlePending = false;   // clear before firing so it never double-fires
                        var capturedTaskId = _activeTaskId;
                        var capturedUserId = _userId;
                        var capturedUserMsg = userMessage;
                        var capturedResponse = fullResponse;
                        var capturedScopeFactory = ScopeFactory;
                        _ = Task.Run(async () =>
                        {
                            await using var scope = capturedScopeFactory.CreateAsyncScope();
                            var svc = scope.ServiceProvider.GetRequiredService<IConversationTitleService>();
                            await svc.CreateTaskAndUpdateTitleAsync(capturedUserId, capturedTaskId, capturedUserMsg, capturedResponse);
                            // Notify sidebar to refresh after title is written
                            var notifier = scope.ServiceProvider.GetRequiredService<ITaskListNotifier>();
                            notifier.NotifyChanged();
                        });
                    }
                }
            }
            _streamingContent = "";
            StateHasChanged();
        }
    }

    private static int EstimateTokens(string text) => (int)Math.Ceiling(text.Length / 4.0);

    private async Task RunCCTaskAsync(string userMessage)
    {
        _ccRunning = true;
        _ccCurrentStep = "Starting artifact generation...";
        _ccCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            // Persist user message to DB (mirrors RunStreamingTurnAsync)
            if (!string.IsNullOrEmpty(_conversationId))
            {
                try
                {
                    await ConversationService.AppendMessageAsync(_conversationId, "user", userMessage, EstimateTokens(userMessage));
                }
                catch (Exception persistEx)
                {
                    _logger.LogWarning(persistEx, "RunCCTaskAsync: failed to persist user message — non-fatal");
                }
            }

            var envelope = BuildEnvelope(_userId, _userDisplayName);
            if (_selectedPluginId != null)
            {
                var pluginEnvelope = await ContextEnvelopeSvc.BuildEnvelopeAsync(
                    _userId, _userDisplayName, envelope.TaskInstructions,
                    _selectedPluginId, _ccCts!.Token);
                envelope.EnabledMcpServers = pluginEnvelope.EnabledMcpServers;
                envelope.MemorySummary = pluginEnvelope.MemorySummary;
            }
            var result = await CCExecutionService.DispatchTaskAsync(
                _userId,
                userMessage,
                envelope,
                cancellationToken: _ccCts.Token);

            if (result.Success && result.ArtifactS3Key != null)
            {
                _lastArtifact = await ArtifactService.RecordArtifactAsync(
                    _userId, result, userMessage, _ccCts.Token);
                await OpenArtifactPreview();

                var responseMsg = $"I've generated **{_lastArtifact.FileName}** for you. Use the buttons below to preview or download it.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: responseMsg));
            }
            else
            {
                var errorMsg = result.Error ?? "The artifact generation did not produce a file. Please try again with a more specific request.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: $"Artifact generation failed: {errorMsg}"));
            }

            // Persist assistant response to DB
            var assistantResponseText = _messages.LastOrDefault(m => m.Role == "assistant")?.Content;
            if (!string.IsNullOrEmpty(_conversationId) && !string.IsNullOrEmpty(assistantResponseText))
            {
                try
                {
                    await ConversationService.AppendMessageAsync(_conversationId, "assistant", assistantResponseText, EstimateTokens(assistantResponseText));
                }
                catch (Exception persistEx)
                {
                    _logger.LogWarning(persistEx, "RunCCTaskAsync: failed to persist assistant response — non-fatal");
                }
            }
        }
        catch (OperationCanceledException)
        {
            _messages.Add(new ChatMessage(Role: "assistant", Content: "Artifact generation was cancelled."));
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "RunCCTaskAsync failed for userId={UserId}", _userId);
            _messages.Add(new ChatMessage(Role: "assistant", Content: $"⚠️ Error: {ex.Message}"));
        }
        finally
        {
            _ccRunning = false;
            _ccCts?.Dispose();
            _ccCts = null;
            StateHasChanged();
        }
    }

    private void CancelCCTask()
    {
        _ccCts?.Cancel();
    }

    private async Task HandleInterventionResponse(bool approved)
    {
        _pendingIntervention = null;
        var action = approved ? "approved" : "denied";
        _messages.Add(new ChatMessage(Role: "assistant", Content: $"[Intervention {action}]"));
        await InvokeAsync(StateHasChanged);
    }

    private async Task DownloadArtifact()
    {
        if (_lastArtifact == null) return;
        try
        {
            var url = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
            NavManager.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            // download URL generation failure — silently ignore
        }
    }

    private async Task OpenArtifactPreview()
    {
        if (_lastArtifact == null) return;
        try
        {
            _artifactPreviewUrl = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
        }
        catch (Exception)
        {
            _artifactPreviewUrl = null;
        }
        _isPanelOpen = true;
        StateHasChanged();
    }

    private static string GetArtifactIcon(string type) => type switch
    {
        "docx" => Icons.Material.Filled.Description,
        "xlsx" => Icons.Material.Filled.TableChart,
        "pptx" => Icons.Material.Filled.Slideshow,
        "html" => Icons.Material.Filled.Code,
        "json" => Icons.Material.Filled.DataObject,
        "code" => Icons.Material.Filled.Code,
        _      => Icons.Material.Filled.InsertDriveFile,
    };

    private CCContextEnvelope BuildEnvelope(string userId, string displayName)
    {
        return new CCContextEnvelope
        {
            UserId = userId,
            UserDisplayName = displayName,
            KbIds = new List<string>(),
            EnabledMcpServers = new List<string>(),
            MemorySummary = null,
            TaskInstructions = @"You are an AI assistant generating a document artifact.
Generate the requested document and write it to the working directory.
Use python-docx for .docx, openpyxl for .xlsx, python-pptx for .pptx.
For HTML, write a clean self-contained HTML file.
The filename should be descriptive of the content.",
        };
    }

    private string BuildContextualMessage(string userInput)
    {
        return string.IsNullOrEmpty(ProjectState.ActiveProjectContext)
            ? userInput
            : $"[ACTIVE PROJECT CONTEXT]\n{ProjectState.ActiveProjectContext}\n\n[USER MESSAGE]\n{userInput}";
    }

    private string? BuildSystemPrompt()
    {
        var parts = new List<string>();
        if (_fortressKbEnabled) parts.Add("Search the Fortress knowledge base for relevant context.");
        if (_personalKbEnabled) parts.Add("Search the user's personal knowledge base for relevant context.");
        return parts.Any() ? string.Join(" ", parts) : null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private async Task RunAsTask()
    {
        _forceTaskMode = true;
        await SendMessage();
    }

    private void ToggleFortressKb() => _fortressKbEnabled = !_fortressKbEnabled;
    private void TogglePersonalKb() => _personalKbEnabled = !_personalKbEnabled;

    private void SetAgent(ActiveAgent agent) => _activeAgent = agent;

    private Task LoadTaskProjectAsync(string taskId)
    {
        return Task.Run(async () =>
        {
            if (string.IsNullOrEmpty(taskId)) return;
            try
            {
                await using var scope = ScopeFactory.CreateAsyncScope();
                var dbFactory = scope.ServiceProvider.GetRequiredService<IDbContextFactory<FaitV2DbContext>>();
                await using var ctx = await dbFactory.CreateDbContextAsync();
                var task = await ctx.ConversationTasks
                    .Include(t => t.Project)
                    .FirstOrDefaultAsync(t => t.Id == taskId);
                if (task?.Project != null)
                {
                    _taskProjectId = task.ProjectId;
                    _taskProjectName = task.Project.Name;
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch
            {
                // non-fatal — badge simply won't show
            }
        });
    }

    private void DetectAgentSuggestion(string response)
    {
        _suggestedAgentId = null;
        _suggestedAgentName = null;

        var lower = response.ToLowerInvariant();
        if (!lower.Contains("hand it off") && !lower.Contains("want me to switch") && !lower.Contains("specialist agent"))
            return;

        // Match known plugin agent names from available plugins
        foreach (var plugin in _availablePlugins)
        {
            if (lower.Contains(plugin.Name.ToLowerInvariant()))
            {
                _suggestedAgentId = plugin.Id;
                _suggestedAgentName = plugin.Name;
                return;
            }
        }
    }

    private void AcceptAgentSuggestion()
    {
        if (_suggestedAgentId != null)
        {
            _activePluginAgentId = _suggestedAgentId;
            _selectedPluginId = _suggestedAgentId;
        }
        _suggestedAgentId = null;
        _suggestedAgentName = null;
    }

    private void DismissAgentSuggestion()
    {
        _suggestedAgentId = null;
        _suggestedAgentName = null;
    }

    private void DismissAgent()
    {
        _activePluginAgentId = null;
        _selectedPluginId = null;
    }

    public async ValueTask DisposeAsync()
    {
        _ccCts?.Cancel();
        _ccCts?.Dispose();
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
