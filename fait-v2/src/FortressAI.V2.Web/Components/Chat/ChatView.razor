@code {
    [Inject] private IUserAgentRuntime AgentRuntime { get; set; } = default!;
    [Inject] private IForgeKbService ForgeKbService { get; set; } = default!;
    [Inject] private ProjectStateService ProjectState { get; set; } = default!;
    [Inject] private ICCExecutionService CCExecutionService { get; set; } = default!;
    [Inject] private IArtifactService ArtifactService { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
    [Inject] private IUserService UserService { get; set; } = default!;
    [Inject] private ILogger<ChatView> _logger { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private List<ChatMessage> _messages = new();
    private string? _conversationId;
    private string _inputText = "";
    private bool _isStreaming = false;
    private string _streamingContent = "";
    private ElementReference _messagesRef;
    private string _userId = "";
    private string _userDisplayName = "";
    private bool _fortressKbEnabled = false;
    private bool _personalKbEnabled = true;
    private ActiveAgent _activeAgent = ActiveAgent.MainAssistant;

    // Plugin state
    private List<AgentPlugin> _availablePlugins = new();
    private string? _selectedPluginId = null;

    // CC task state
    private bool _ccRunning = false;
    private string _ccCurrentStep = "Generating artifact...";
    private CancellationTokenSource? _ccCts;
    private ArtifactRecord? _lastArtifact;
    private HubConnection? _hubConnection;

    private static readonly string[] ArtifactKeywords = { "create", "generate", "write", "make", "build" };
    private static readonly string[] ArtifactTypeHints = { "word doc", "docx", "excel", "spreadsheet", "xlsx", "presentation", "pptx", "powerpoint", "report", "html", "webpage" };

    protected override async Task OnInitializedAsync()
    {
        try
        {
            if (AuthState == null) return;
            var auth = await AuthState;
            var entraOid = auth.User.FindFirst("oid")?.Value
                       ?? auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                       ?? "";

            // CRITICAL: resolve internal DB user ID — NOT entraOid
            var user = await UserService.GetByEntraOidAsync(entraOid);
            _userId = user?.Id ?? "";
            if (string.IsNullOrEmpty(_userId))
            {
                _logger.LogError("Could not resolve internal userId for entraOid {EntraOid}", entraOid);
                return; // bail — don't proceed with empty userId
            }

            _userDisplayName = auth.User.FindFirst("name")?.Value
                            ?? auth.User.FindFirst("preferred_username")?.Value ?? "User";

            var userRoles = auth.User.Claims
                .Where(c => c.Type == System.Security.Claims.ClaimTypes.Role || c.Type == "roles")
                .Select(c => c.Value);
            _availablePlugins = await PluginAgentService.GetAvailablePluginsAsync(_userId, userRoles);

            // §15 — Load or create active conversation and restore history
            var conv = await ConversationService.GetOrCreateActiveConversationAsync(_userId);
            _conversationId = conv.Id;
            var history = await ConversationService.GetFullHistoryAsync(_conversationId);
            _messages = history
                .Where(m => !m.IsCompactionSummary)
                .Select(m => new ChatMessage(m.Role, m.Content))
                .ToList();

            await ConnectSignalRAsync();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "ChatView OnInitializedAsync failed");
            throw;
        }
    }

    private async Task ConnectSignalRAsync()
    {
        try
        {
            _hubConnection = new HubConnectionBuilder()
                .WithUrl(NavManager.ToAbsoluteUri("/hubs/cc-progress"))
                .WithAutomaticReconnect()
                .Build();

            _hubConnection.On<CCProgressUpdate>("ReceiveProgress", update =>
            {
                _ccCurrentStep = update.CurrentStep;
                InvokeAsync(StateHasChanged);
            });

            await _hubConnection.StartAsync();
        }
        catch (Exception)
        {
            // SignalR is non-critical — progress updates are best-effort
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning) return;
        if (string.IsNullOrWhiteSpace(_userId)) return;

        var userMessage = _inputText.Trim();
        _inputText = "";
        _messages.Add(new ChatMessage(Role: "user", Content: userMessage));
        _lastArtifact = null;
        StateHasChanged();

        if (IsArtifactRequest(userMessage))
        {
            await RunCCTaskAsync(userMessage);
        }
        else
        {
            await RunStreamingTurnAsync(userMessage);
        }
    }

    private bool IsArtifactRequest(string message)
    {
        var lower = message.ToLowerInvariant();
        bool hasKeyword = ArtifactKeywords.Any(k => lower.Contains(k));
        bool hasTypeHint = ArtifactTypeHints.Any(t => lower.Contains(t));
        return hasKeyword && hasTypeHint;
    }

    private async Task RunStreamingTurnAsync(string userMessage)
    {
        _isStreaming = true;
        _streamingContent = "";
        StateHasChanged();

        var assistantContent = new System.Text.StringBuilder();
        try
        {
            // Persist user message to DB
            if (!string.IsNullOrEmpty(_conversationId))
                await ConversationService.AppendMessageAsync(_conversationId, "user", userMessage, EstimateTokens(userMessage));

            // Build context from DB (compaction-aware)
            List<FortressAI.V2.Web.Services.ChatHistoryEntry> contextHistory;
            if (!string.IsNullOrEmpty(_conversationId))
            {
                var contextMessages = await ConversationService.GetMessagesForContextAsync(_conversationId);
                contextHistory = contextMessages
                    .Where(m => m.Role != "system" || m.IsCompactionSummary)
                    .SkipLast(1)  // exclude the just-appended user message
                    .Select(m => new FortressAI.V2.Web.Services.ChatHistoryEntry(m.Role, m.Content))
                    .ToList();
            }
            else
            {
                contextHistory = _messages
                    .Where(m => m.Role != "system")
                    .SkipLast(1)
                    .Select(m => new FortressAI.V2.Web.Services.ChatHistoryEntry(m.Role, m.Content))
                    .ToList();
            }

            var request = new TurnRequest(
                UserId: _userId,
                Message: BuildContextualMessage(userMessage),
                SystemPrompt: BuildSystemPrompt(),
                TaskMode: false,
                History: contextHistory
            );
            await foreach (var evt in AgentRuntime.SendTurnAsync(_userId, request))
            {
                if (evt.Type == "text" && evt.Content != null)
                {
                    assistantContent.Append(evt.Content);
                    _streamingContent = assistantContent.ToString();
                    StateHasChanged();
                }
                else if (evt.Type == "done" || evt.Type == "error")
                {
                    if (evt.Type == "error" && !string.IsNullOrEmpty(evt.ErrorMessage))
                    {
                        _logger.LogError("Harness returned error for user {UserId}: {Error}", _userId, evt.ErrorMessage);
                        _messages.Add(new ChatMessage(Role: "assistant", Content: $"⚠️ {evt.ErrorMessage}"));
                        StateHasChanged();
                    }
                    break;
                }
            }
        }
        finally
        {
            _isStreaming = false;
            var fullResponse = assistantContent.ToString();
            if (fullResponse.Length > 0)
            {
                _messages.Add(new ChatMessage(Role: "assistant", Content: fullResponse));
                // Persist assistant message to DB
                if (!string.IsNullOrEmpty(_conversationId))
                {
                    await ConversationService.AppendMessageAsync(_conversationId, "assistant", fullResponse, EstimateTokens(fullResponse));
                    await ConversationService.UpdateTokenCountAsync(_conversationId, EstimateTokens(userMessage) + EstimateTokens(fullResponse));
                    // Fire-and-forget compaction check — use fresh scope to avoid captured-scoped-service disposal
                    var convIdCapture = _conversationId;
                    _ = Task.Run(async () =>
                    {
                        try
                        {
                            await using var scope = ScopeFactory.CreateAsyncScope();
                            var compaction = scope.ServiceProvider.GetRequiredService<ICompactionService>();
                            await compaction.CompactIfNeededAsync(convIdCapture);
                        }
                        catch (OperationCanceledException) { /* expected */ }
                        catch (Exception ex)
                        {
                            _logger.LogWarning(ex, "Compaction failed for conversation {ConvId}", convIdCapture);
                        }
                    });
                }
            }
            _streamingContent = "";
            StateHasChanged();
        }
    }

    private static int EstimateTokens(string text) => (int)Math.Ceiling(text.Length / 4.0);

    private async Task RunCCTaskAsync(string userMessage)
    {
        _ccRunning = true;
        _ccCurrentStep = "Starting artifact generation...";
        _ccCts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var envelope = BuildEnvelope(_userId, _userDisplayName);
            if (_selectedPluginId != null)
            {
                var pluginEnvelope = await ContextEnvelopeSvc.BuildEnvelopeAsync(
                    _userId, _userDisplayName, envelope.TaskInstructions,
                    _selectedPluginId, _ccCts!.Token);
                envelope.EnabledMcpServers = pluginEnvelope.EnabledMcpServers;
                envelope.MemorySummary = pluginEnvelope.MemorySummary;
            }
            var result = await CCExecutionService.DispatchTaskAsync(
                _userId,
                userMessage,
                envelope,
                cancellationToken: _ccCts.Token);

            if (result.Success && result.ArtifactS3Key != null)
            {
                _lastArtifact = await ArtifactService.RecordArtifactAsync(
                    _userId, result, userMessage, _ccCts.Token);

                var responseMsg = $"I've generated **{_lastArtifact.FileName}** for you. Use the buttons below to preview or download it.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: responseMsg));
            }
            else
            {
                var errorMsg = result.Error ?? "The artifact generation did not produce a file. Please try again with a more specific request.";
                _messages.Add(new ChatMessage(Role: "assistant", Content: $"Artifact generation failed: {errorMsg}"));
            }
        }
        catch (OperationCanceledException)
        {
            _messages.Add(new ChatMessage(Role: "assistant", Content: "Artifact generation was cancelled."));
        }
        catch (Exception ex)
        {
            _messages.Add(new ChatMessage(Role: "assistant", Content: $"An error occurred during artifact generation: {ex.Message}"));
        }
        finally
        {
            _ccRunning = false;
            _ccCts?.Dispose();
            _ccCts = null;
            StateHasChanged();
        }
    }

    private void CancelCCTask()
    {
        _ccCts?.Cancel();
    }

    private async Task DownloadArtifact()
    {
        if (_lastArtifact == null) return;
        try
        {
            var url = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
            NavManager.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            // download URL generation failure — silently ignore
        }
    }

    private async Task PreviewArtifact()
    {
        if (_lastArtifact == null || _lastArtifact.Type != "html") return;
        try
        {
            var url = await ArtifactService.GetDownloadUrlAsync(_userId, _lastArtifact.Id);
            NavManager.NavigateTo(url, forceLoad: true);
        }
        catch (Exception)
        {
            // preview URL generation failure — silently ignore
        }
    }

    private static string GetArtifactIcon(string type) => type switch
    {
        "docx" => Icons.Material.Filled.Description,
        "xlsx" => Icons.Material.Filled.TableChart,
        "pptx" => Icons.Material.Filled.Slideshow,
        "html" => Icons.Material.Filled.Code,
        "json" => Icons.Material.Filled.DataObject,
        "code" => Icons.Material.Filled.Code,
        _      => Icons.Material.Filled.InsertDriveFile,
    };

    private CCContextEnvelope BuildEnvelope(string userId, string displayName)
    {
        return new CCContextEnvelope
        {
            UserId = userId,
            UserDisplayName = displayName,
            KbIds = new List<string>(),
            EnabledMcpServers = new List<string>(),
            MemorySummary = null,
            TaskInstructions = @"You are an AI assistant generating a document artifact.
Generate the requested document and write it to the working directory.
Use python-docx for .docx, openpyxl for .xlsx, python-pptx for .pptx.
For HTML, write a clean self-contained HTML file.
The filename should be descriptive of the content.",
        };
    }

    private string BuildContextualMessage(string userInput)
    {
        return string.IsNullOrEmpty(ProjectState.ActiveProjectContext)
            ? userInput
            : $"[ACTIVE PROJECT CONTEXT]\n{ProjectState.ActiveProjectContext}\n\n[USER MESSAGE]\n{userInput}";
    }

    private string? BuildSystemPrompt()
    {
        var parts = new List<string>();
        if (_fortressKbEnabled) parts.Add("Search the Fortress knowledge base for relevant context.");
        if (_personalKbEnabled) parts.Add("Search the user's personal knowledge base for relevant context.");
        return parts.Any() ? string.Join(" ", parts) : null;
    }

    private async Task HandleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendMessage();
    }

    private void ToggleFortressKb() => _fortressKbEnabled = !_fortressKbEnabled;
    private void TogglePersonalKb() => _personalKbEnabled = !_personalKbEnabled;

    private void SetAgent(ActiveAgent agent) => _activeAgent = agent;

    public async ValueTask DisposeAsync()
    {
        _ccCts?.Cancel();
        _ccCts?.Dispose();
        if (_hubConnection != null)
            await _hubConnection.DisposeAsync();
    }
}
