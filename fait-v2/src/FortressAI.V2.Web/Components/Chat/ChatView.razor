@using FortressAI.V2.Web.Models
@using FortressAI.V2.Web.Services
@using FortressAI.V2.Web.Data.Models
@using FortressAI.V2.Web.Components.Layout
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.SignalR.Client
@using Microsoft.EntityFrameworkCore
@implements IAsyncDisposable
@inject IPluginAgentService PluginAgentService
@inject IContextEnvelopeService ContextEnvelopeSvc
@inject IConversationService ConversationService
@inject IServiceScopeFactory ScopeFactory

@* Main chat component — lives in DualPaneLayout's ChatContent slot *@

<DualPaneLayout @bind-IsPanelOpen="_isPanelOpen"
                PreviewTitle="@(_lastArtifact?.FileName ?? "Preview")">
    <ChatContent>
<div class="chat-container">

    @* Agent selector toolbar *@
    <div class="chat-agent-toolbar">
        <div class="chat-agent-pills">
            <button class="chat-agent-pill @(_activeAgent == ActiveAgent.MainAssistant ? "chat-agent-pill-active" : "")"
                    @onclick="@(() => SetAgent(ActiveAgent.MainAssistant))"
                    title="Main assistant">
                <MudIcon Icon="@Icons.Material.Filled.Chat" Class="chat-pill-icon" />
                <span class="chat-pill-label">Assistant</span>
            </button>
            <button class="chat-agent-pill @(_activeAgent == ActiveAgent.DesignAgent ? "chat-agent-pill-active" : "")"
                    @onclick="@(() => SetAgent(ActiveAgent.DesignAgent))"
                    title="Design Agent — create UI with Stitch">
                <MudIcon Icon="@Icons.Material.Filled.Palette" Class="chat-pill-icon" />
                <span class="chat-pill-label">Design Agent</span>
            </button>
        </div>
        @if (_activeAgent == ActiveAgent.DesignAgent)
        {
            <AgentPluginBadge AgentName="Design Agent" IsActive="true" />
        }
        @if (_activePluginAgentId != null)
        {
            var activeName = _availablePlugins.FirstOrDefault(p => p.Id == _activePluginAgentId)?.Name ?? "Plugin Agent";
            <AgentPluginBadge AgentName="@activeName" IsActive="true" />
            <button class="agent-dismiss-btn" @onclick="DismissAgent">
                × Back to main assistant
            </button>
        }
        @if (!string.IsNullOrEmpty(_taskProjectId))
        {
            <a href="/projects/@_taskProjectId" class="chat-project-badge">
                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Class="chat-project-badge__icon" />
                <span class="chat-project-badge__name">@_taskProjectName</span>
            </a>
        }
    </div>

    @if (_activeAgent == ActiveAgent.DesignAgent)
    {
        <DesignAgentView />
    }
    else
    {

    @* Message history — scrollable *@
    <div class="chat-messages" @ref="_messagesRef">
        @if (!_harnessReady && _initError == null)
        {
            <div class="chat-empty-state">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" Size="Size.Medium" Class="mb-3" />
                <p class="chat-empty-title">Setting up your assistant...</p>
                <p class="chat-empty-subtitle">This takes about 30–60 seconds on first load.</p>
            </div>
        }
        @if (_initError != null)
        {
            <div class="chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Class="chat-empty-icon" />
                <p class="chat-empty-title">Something went wrong</p>
                <p class="chat-empty-subtitle">@_initError</p>
            </div>
        }
        else if (!_messages.Any() && _harnessReady)
        {
            <div class="chat-empty-state">
                <MudIcon Icon="@Icons.Material.Filled.Chat" Class="chat-welcome-icon" />
                <p class="chat-empty-title">What can I help you with?</p>
                <p class="chat-empty-subtitle">What are we working on today?</p>
            </div>
        }
        else
        {
            @foreach (var msg in _messages)
            {
                <MessageBubble Message="@msg" IsStreaming="@(msg == _messages.LastOrDefault() && _isStreaming)" />
            }
            @if (_isStreaming)
            {
                <div class="chat-streaming-indicator">
                    <span class="chat-streaming-text">@_streamingContent</span>
                    <span class="chat-streaming-cursor">▋</span>
                </div>
            }
        }

        @* CC progress indicator *@
        @if (_ccRunning && _activeTaskId != null)
        {
            <TaskProgressTimeline UserId="@_userId" TaskId="@_activeTaskId" OnCancel="CancelCCTask" />
        }
        else if (_ccRunning)
        {
            <div class="chat-artifact-progress">
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                <span class="chat-artifact-progress-step">@_ccCurrentStep</span>
                <MudButton Size="Size.Small" OnClick="CancelCCTask" Class="chat-artifact-cancel-btn">Cancel</MudButton>
            </div>
        }

        @* Intervention approval gate *@
        @if (_pendingIntervention != null)
        {
            <ApprovalDialog Request="@_pendingIntervention"
                            HarnessUrl="@_harnessBaseUrl"
                            OnRespond="HandleInterventionResponse" />
        }

        @* Artifact result card *@
        @if (_lastArtifact != null)
        {
            <ArtifactCard Artifact="_lastArtifact"
                          OnPreview="OpenArtifactPreview"
                          OnDownload="DownloadArtifact" />
        }
    </div>

    @* Plugin selector *@
    @if (_availablePlugins.Count > 0)
    {
        <div class="chat-plugin-bar">
            <span class="chat-plugin-label">Plugin:</span>
            <div class="chat-plugin-pills">
                <button class="chat-plugin-pill @(_selectedPluginId == null ? "chat-plugin-pill-active" : "")"
                        @onclick="@(() => _selectedPluginId = null)">
                    None (Main Assistant)
                </button>
                @foreach (var plugin in _availablePlugins)
                {
                    <button class="chat-plugin-pill @(_selectedPluginId == plugin.Id ? "chat-plugin-pill-active" : "")"
                            @onclick="@(() => _selectedPluginId = plugin.Id)"
                            title="@plugin.Description">
                        @plugin.Name
                    </button>
                }
            </div>
            @if (_selectedPluginId != null)
            {
                <span class="chat-plugin-active-badge">[@(_availablePlugins.FirstOrDefault(p => p.Id == _selectedPluginId)?.Name ?? "")]</span>
            }
        </div>
    }

    @* §6.1 — agent suggestion quick-reply *@
    @if (_suggestedAgentId != null)
    {
        <div class="agent-suggest-bar">
            <button class="agent-suggest-btn" @onclick="AcceptAgentSuggestion">
                Switch to @_suggestedAgentName
            </button>
            <button class="agent-suggest-dismiss" @onclick="DismissAgentSuggestion">
                No thanks
            </button>
        </div>
    }

    @* §6.1 — agent suggestion quick-reply *@
    @if (_suggestedAgentId != null)
    {
        <div class="agent-suggest-bar">
            <button class="agent-suggest-btn" @onclick="AcceptAgentSuggestion">
                Switch to @_suggestedAgentName
            </button>
            <button class="agent-suggest-dismiss" @onclick="DismissAgentSuggestion">
                No thanks
            </button>
        </div>
    }

    @* Input bar — sticky bottom *@
    <div class="chat-input-bar">
        @* Top row: KB toggles *@
        <div class="chat-input-top-row">
            <div class="chat-kb-pills">
                <button @onclick="ToggleFortressKb" title="Search Fortress knowledge base"
                        class="chat-kb-pill @(_fortressKbEnabled ? "chat-kb-pill-active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Class="chat-pill-icon" />
                    <span class="chat-pill-label">Fortress KB</span>
                </button>
                <button @onclick="TogglePersonalKb" title="My personal knowledge base"
                        class="chat-kb-pill @(_personalKbEnabled ? "chat-kb-pill-active" : "")">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Class="chat-pill-icon" />
                    <span class="chat-pill-label">My KB</span>
                </button>
            </div>
        </div>
        @* Bottom row: text input + send *@
        <div class="chat-input-bottom-row">
            <textarea class="chat-input-field"
                      value="@_inputText"
                      @oninput="@(e => _inputText = e.Value?.ToString() ?? string.Empty)"
                      @onkeydown="HandleKeyDown"
                      placeholder="Message your assistant..."
                      rows="1"
                      disabled="@(_isStreaming || _ccRunning || !_harnessReady)"></textarea>
            <button class="chat-run-as-task-btn"
                    type="button"
                    @onclick="RunAsTask"
                    disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning || !_harnessReady)"
                    title="Run as Task (force Claude Code)">
                <span class="chat-run-as-task-icon">⚡</span>
                <span class="chat-run-as-task-label">Run as Task</span>
            </button>
            <button class="chat-send-btn"
                    type="button"
                    @onclick="SendMessage"
                    disabled="@(string.IsNullOrWhiteSpace(_inputText) || _isStreaming || _ccRunning || !_harnessReady)"
                    title="Send message">
                <MudIcon Icon="@Icons.Material.Filled.Send" Class="chat-send-icon" />
            </button>
        </div>
    </div>

    } @* end else (MainAssistant) *@

</div>

<style>
