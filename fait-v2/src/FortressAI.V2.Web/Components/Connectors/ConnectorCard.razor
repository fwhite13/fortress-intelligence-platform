@namespace FortressAI.V2.Web.Components.Connectors

<div class="connector-card">
    <div class="connector-card__header">
        <MudIcon Icon="@GetIcon()" Class="connector-card__icon" />
        <div class="connector-card__meta">
            <span class="connector-card__name">@Connector.DisplayName</span>
            <span class="connector-card__status @GetStatusCssClass()">@GetStatusLabel()</span>
        </div>
    </div>

    <p class="connector-card__description">@Connector.Description</p>

    <div class="connector-card__scopes">
        @if (Connector.CanRead)
        {
            <span class="connector-card__scope-pill connector-card__scope-pill--read">Read</span>
        }
        @if (Connector.CanWrite)
        {
            <span class="connector-card__scope-pill connector-card__scope-pill--write">Write</span>
        }
    </div>

    <div class="connector-card__actions">
        @if (Connector.AuthType == ConnectorAuthType.None || Connector.AuthType == ConnectorAuthType.ApiKey)
        {
            <span class="connector-card__managed-badge">Managed</span>
        }
        else if (Connector.IsConnected)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Error"
                       Size="Size.Small"
                       Class="connector-card__btn connector-card__btn--revoke"
                       OnClick="@(() => OnRevoke.InvokeAsync(Connector))">Revoke</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       Class="connector-card__btn connector-card__btn--connect"
                       OnClick="@(() => OnConnect.InvokeAsync(Connector))">Connect</MudButton>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ConnectorViewModel Connector { get; set; } = null!;
    [Parameter] public EventCallback<ConnectorViewModel> OnRevoke { get; set; }
    [Parameter] public EventCallback<ConnectorViewModel> OnConnect { get; set; }

    private string GetIcon() => Connector.Name switch
    {
        "forge-kb" => Icons.Material.Outlined.Hub,
        "ms365"    => Icons.Material.Outlined.Work,
        "search"   => Icons.Material.Outlined.Search,
        "ado"      => Icons.Material.Outlined.AccountTree,
        _          => Icons.Material.Outlined.Cable
    };

    private string GetStatusLabel() => Connector.IsConnected ? "Connected" : "Not Connected";

    private string GetStatusCssClass() => Connector.IsConnected
        ? "connector-card__status--connected"
        : "connector-card__status--disconnected";
}
