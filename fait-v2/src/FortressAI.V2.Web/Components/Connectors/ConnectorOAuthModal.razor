@namespace FortressAI.V2.Web.Components.Connectors

<MudDialog Options="_dialogOptions">
    <TitleContent>
        <MudText Typo="Typo.h6">Connect @ConnectorName</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body1">
            OAuth authorization for <strong>@ConnectorName</strong> is coming soon.
            Your admin will enable this connector.
        </MudText>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Close">OK</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter, EditorRequired] public string ConnectorName { get; set; } = string.Empty;
    [Parameter] public EventCallback OnClose { get; set; }

    private DialogOptions _dialogOptions = new() { MaxWidth = MaxWidth.Small, FullWidth = false };

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }
}
