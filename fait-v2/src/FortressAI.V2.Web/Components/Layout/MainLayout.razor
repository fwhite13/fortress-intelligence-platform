@using Microsoft.AspNetCore.Components.Authorization
@using FortressAI.V2.Web.Theme
@using FortressAI.V2.Web.Services
@using FortressAI.V2.Web.Data
@using FortressAI.V2.Web.Data.Models
@using FipShared.Components
@using FipShared.Models
@using Microsoft.EntityFrameworkCore
@inherits LayoutComponentBase
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IProjectService ProjectService
@inject ProjectStateService ProjectState
@inject FaitV2DbContext Db
@inject ILogger<MainLayout> Logger
@implements IDisposable

<MudThemeProvider Theme="_theme" @bind-IsDarkMode="_isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <FipNavBar ActiveModule="FipModule.FAIT"
               ModuleDisplayName="FAIT v2"
               UserInitial="@_userInitial"
               UserName="@_userName"
               UserEmail="@_userEmail"
               OnMenuClick="ToggleDrawer"
               OnSignOut="Logout"
               IsDev="@_isDev" />

    <MudDrawer @bind-Open="_drawerOpen"
               Variant="DrawerVariant.Mini"
               MiniWidth="56px"
               ClipMode="DrawerClipMode.Always"
               Elevation="2"
               Class="fait-v2-drawer">

        <div class="fait-v2-drawer__content">
            <MudDrawerHeader Class="fait-v2-drawer__header">
                <div class="fait-v2-drawer__brand">
                    <MudText Typo="Typo.h6" Class="fait-v2-drawer__title">FAIT v2</MudText>
                    <MudText Typo="Typo.caption" Class="fait-v2-drawer__subtitle">Fortress AI</MudText>
                </div>
            </MudDrawerHeader>

            <div class="fait-v2-drawer__nav">
                <MudNavMenu>
                    <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Dashboard">Dashboard</MudNavLink>
                    <MudNavLink Href="/memory" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Memory">Memory</MudNavLink>
                    <MudNavLink Href="/tasks" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Schedule">Scheduled Tasks</MudNavLink>
                    <MudNavLink Href="/workspace" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.FolderOpen">Workspace</MudNavLink>
                    <MudNavLink Href="/knowledge-base" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Storage">Knowledge Base</MudNavLink>
                    <MudNavLink Href="/connectors" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Cable">Connectors</MudNavLink>
                </MudNavMenu>
            </div>

            <div class="fait-v2-drawer__new-task">
                <MudButton StartIcon="@Icons.Material.Outlined.Add"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="fait-v2-drawer__new-task-btn"
                           OnClick="CreateNewTask">
                    New Task
                </MudButton>
            </div>

            <div class="fait-v2-drawer__recent-tasks">
                <div class="fait-v2-drawer__section-header">
                    <span class="fait-v2-drawer__section-title">Recent Tasks</span>
                </div>
                @if (_recentTasks.Count == 0)
                {
                    <div class="fait-v2-drawer__section-empty">No tasks yet</div>
                }
                else
                {
                    @foreach (var task in _recentTasks)
                    {
                        var t = task;
                        <div class="fait-v2-drawer__task-item"
                             title="@t.Title"
                             @onclick="() => SelectTask(t)">
                            <span class="fait-v2-drawer__task-title">@t.Title</span>
                            <span class="fait-v2-drawer__task-date">@t.CreatedAt.ToString("MMM d")</span>
                        </div>
                    }
                    <a href="/task-history" class="fait-v2-drawer__see-all">See All Tasks</a>
                }
            </div>

            <div class="fait-v2-drawer__projects">
                <div class="fait-v2-drawer__section-header">
                    <span class="fait-v2-drawer__section-title">Projects</span>
                    <button class="fait-v2-drawer__section-add mud-icon-button"
                            title="New project"
                            type="button"
                            @onclick="OpenNewProjectDialog">
                        <MudIcon Icon="@Icons.Material.Outlined.Add" Size="Size.Small" />
                    </button>
                </div>
                @if (_projects.Count == 0)
                {
                    <div class="fait-v2-drawer__section-empty">No projects yet</div>
                }
                else
                {
                    @foreach (var project in _projects)
                    {
                        var isActive = _selectedProjectId == project.Id;
                        <div class="fait-v2-drawer__project-item @(isActive ? "fait-v2-drawer__project-item--active" : "")"
                             @onclick="() => SelectProjectAsync(project)">
                            <MudIcon Icon="@Icons.Material.Outlined.FolderOpen"
                                     Size="Size.Small"
                                     Class="fait-v2-drawer__project-icon" />
                            <span class="fait-v2-drawer__project-name">@project.Name</span>
                        </div>
                    }
                }
            </div>

            <div class="fait-v2-drawer__feedback">
                <div class="fait-v2-drawer__feedback-btn" @onclick="OpenFeedbackModal">
                    <MudIcon Icon="@Icons.Material.Outlined.BugReport" Size="Size.Small" Class="fait-v2-drawer__feedback-icon" />
                    <span class="fait-v2-drawer__feedback-label">Report a bug</span>
                </div>
            </div>

            <div class="fait-v2-drawer__footer">
                <MudIconButton Icon="@(_isDarkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                               Color="Color.Inherit"
                               OnClick="ToggleDarkMode"
                               Size="Size.Small"
                               aria-label="Toggle dark mode"
                               Class="fait-v2-drawer__theme-toggle" />
                <MudText Typo="Typo.caption" Class="fait-v2-drawer__footer-text">Fortress Intelligence Platform</MudText>
            </div>
        </div>
    </MudDrawer>

    <MudMainContent Class="fait-v2-main">
        @Body
    </MudMainContent>
</MudLayout>

<FeedbackModal @ref="_feedbackModal" />

<MudDialog @bind-Visible="_showNewProjectDialog">
    <TitleContent>New Project</TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_newProjectName" Label="Project name" Required="true" />
        <MudTextField @bind-Value="_newProjectDescription" Label="Description (optional)" Lines="2" Class="mt-2" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="() => _showNewProjectDialog = false">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   Disabled="@string.IsNullOrWhiteSpace(_newProjectName)"
                   OnClick="CreateProject">Create</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private bool _drawerOpen = true;
    private bool _isDarkMode = false;
    private bool _isDev = false;
    private string _userInitial = "F";
    private string _userName = "User";
    private string _userEmail = "";
    private string _entraOid = "";
    private List<ProjectSummary> _projects = new();
    private string? _selectedProjectId;
    private bool _showNewProjectDialog;
    private string _newProjectName = string.Empty;
    private string? _newProjectDescription;
    private FeedbackModal? _feedbackModal;
    private List<ConversationTask> _recentTasks = new();
    private string? _activeTaskId;

    private MudTheme _theme = FipTheme.Create();

    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        _isDev = Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development";

        if (AuthenticationState != null)
        {
            var authState = await AuthenticationState;
            var user = authState.User;
            if (user.Identity?.IsAuthenticated == true)
            {
                _userEmail = user.FindFirst("preferred_username")?.Value
                          ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                          ?? "";
                _userName = user.FindFirst("name")?.Value
                         ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                         ?? _userEmail.Split('@')[0];
                _userInitial = _userName.Length > 0 ? _userName[0].ToString().ToUpperInvariant() : "F";

                _entraOid = user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                         ?? user.FindFirst("oid")?.Value ?? "";
            }
        }

        if (!string.IsNullOrEmpty(_entraOid))
        {
            try { _projects = await ProjectService.GetUserProjectsAsync(_entraOid); }
            catch { /* non-critical — leave empty */ }

            try
            {
                var dbUser = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == _entraOid);
                if (dbUser != null)
                {
                    _recentTasks = await Db.ConversationTasks
                        .Where(t => t.UserId == dbUser.Id)
                        .OrderByDescending(t => t.UpdatedAt)
                        .Take(10)
                        .ToListAsync();
                }
            }
            catch { /* non-critical */ }
        }
    }

    private async Task SelectProjectAsync(ProjectSummary project)
    {
        _selectedProjectId = project.Id;
        var context = await ProjectService.GetProjectContextAsync(project.Id);
        ProjectState.SetActiveProject(project.Id, context);
        StateHasChanged();
    }

    private void OpenFeedbackModal()
    {
        _feedbackModal?.Open();
    }

    private void OpenNewProjectDialog()
    {
        _newProjectName = string.Empty;
        _newProjectDescription = null;
        _showNewProjectDialog = true;
        StateHasChanged();
    }

    private async Task CreateProject()
    {
        if (string.IsNullOrWhiteSpace(_newProjectName)) return;
        var project = await ProjectService.CreateProjectAsync(_entraOid, _newProjectName, _newProjectDescription);
        _projects.Add(new ProjectSummary
        {
            Id = project.Id,
            Name = project.Name,
            Description = project.Description,
            UpdatedAt = project.UpdatedAt,
        });
        _showNewProjectDialog = false;
        await SelectProjectAsync(_projects.Last());
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                var savedDark = await JS.InvokeAsync<string?>("localStorage.getItem", "fait-v2-dark-mode");
                _isDarkMode = savedDark == "true";

                var savedDrawer = await JS.InvokeAsync<string?>("localStorage.getItem", "fait-v2-drawer-open");
                // Default open (true) if no saved value
                _drawerOpen = savedDrawer == null || savedDrawer == "true";

                StateHasChanged();
            }
            catch { /* localStorage not available in prerender */ }
        }
    }

    private async Task ToggleDarkMode()
    {
        _isDarkMode = !_isDarkMode;
        await JS.InvokeVoidAsync("localStorage.setItem", "fait-v2-dark-mode", _isDarkMode.ToString().ToLower());
    }

    private async Task ToggleDrawer()
    {
        _drawerOpen = !_drawerOpen;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "fait-v2-drawer-open", _drawerOpen.ToString().ToLower());
        }
        catch { /* localStorage not available */ }
    }

    private void Logout()
    {
        Nav.NavigateTo("MicrosoftIdentity/Account/SignOut", forceLoad: true);
    }

    private async Task CreateNewTask()
    {
        try
        {
            var dbUser = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == _entraOid);
            if (dbUser != null)
            {
                var newTask = new ConversationTask
                {
                    UserId = dbUser.Id,
                    Title = "New Task",
                    CreatedAt = DateTime.UtcNow,
                    UpdatedAt = DateTime.UtcNow
                };
                Db.ConversationTasks.Add(newTask);
                await Db.SaveChangesAsync();
                _activeTaskId = newTask.Id;
                _recentTasks.Insert(0, newTask);
                if (_recentTasks.Count > 10) _recentTasks.RemoveAt(10);
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to create new task");
        }
    }

    private void SelectTask(ConversationTask task)
    {
        _activeTaskId = task.Id;
        StateHasChanged();
    }

    public void Dispose() { }
}
