@using Microsoft.AspNetCore.Components.Authorization

<div class="memory-manager">
    <div class="memory-manager-header">
        <h2 class="memory-manager-title">Memory</h2>
        <p class="memory-manager-subtitle">Organize what your assistant knows about you.</p>
    </div>
    <div class="memory-manager-body">
        <TopicList UserId="@_userId"
                   SelectedTopicSlug="@_selectedSlug"
                   OnTopicSelected="HandleTopicSelected"
                   OnTopicCreated="HandleTopicCreated" />
        @if (_selectedSlug != null)
        {
            <TopicEditor UserId="@_userId" TopicSlug="@_selectedSlug" />
        }
        else
        {
            <div class="memory-empty-select">
                <p>Select a topic to view its content.</p>
            </div>
        }
    </div>
</div>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _userId = "";
    private string? _selectedSlug = null;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null) return;
        var auth = await AuthState;
        _userId = auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
               ?? auth.User.FindFirst("oid")?.Value ?? "";
    }

    private void HandleTopicSelected(string slug) => _selectedSlug = string.IsNullOrEmpty(slug) ? null : slug;
    private void HandleTopicCreated(string slug) => _selectedSlug = slug;
}
