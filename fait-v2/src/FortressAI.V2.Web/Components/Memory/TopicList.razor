@inject IMemoryFileService MemoryService

<div class="topic-list-panel">
    <div class="topic-list-header">
        <span class="topic-list-label">Topics</span>
        <button class="topic-add-btn" @onclick="StartCreate" title="New topic">
            <MudIcon Icon="@Icons.Material.Filled.Add" Class="topic-add-icon" />
        </button>
    </div>

    @if (_creating)
    {
        <div class="topic-create-row">
            <input class="topic-create-input"
                   @bind="_newSlug"
                   @bind:event="oninput"
                   placeholder="topic-name"
                   @onkeydown="HandleCreateKey" />
            <button class="topic-create-confirm" @onclick="ConfirmCreate" title="Create">
                <MudIcon Icon="@Icons.Material.Filled.Check" Class="topic-action-icon" />
            </button>
            <button class="topic-create-cancel" @onclick="CancelCreate" title="Cancel">
                <MudIcon Icon="@Icons.Material.Filled.Close" Class="topic-action-icon" />
            </button>
        </div>
    }

    @if (_loading)
    {
        <div class="topic-list-loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Small" />
        </div>
    }
    else if (!_topics.Any())
    {
        <p class="topic-list-empty">No topics yet. Create one to get started.</p>
    }
    else
    {
        @foreach (var topic in _topics)
        {
            <div class="topic-item @(topic.TopicSlug == SelectedTopicSlug ? "topic-item-selected" : "")"
                 @onclick="() => SelectTopic(topic.TopicSlug)">
                <span class="topic-item-name">@topic.TopicSlug</span>
                <button class="topic-item-delete"
                        @onclick:stopPropagation="true"
                        @onclick="() => DeleteTopic(topic.TopicSlug)"
                        title="Delete topic">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Class="topic-action-icon" />
                </button>
            </div>
        }
    }
</div>

@code {
    [Parameter, EditorRequired] public string UserId { get; set; } = "";
    [Parameter] public string? SelectedTopicSlug { get; set; }
    [Parameter] public EventCallback<string> OnTopicSelected { get; set; }
    [Parameter] public EventCallback<string> OnTopicCreated { get; set; }

    private IReadOnlyList<MemoryTopicEntry> _topics = Array.Empty<MemoryTopicEntry>();
    private bool _loading = true;
    private bool _creating = false;
    private string _newSlug = "";

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(UserId))
            await LoadTopics();
    }

    private async Task LoadTopics()
    {
        _loading = true;
        _topics = await MemoryService.GetTopicsAsync(UserId);
        _loading = false;
    }

    private void StartCreate() { _creating = true; _newSlug = ""; }
    private void CancelCreate() { _creating = false; _newSlug = ""; }

    private async Task ConfirmCreate()
    {
        if (string.IsNullOrWhiteSpace(_newSlug)) return;
        var slug = _newSlug.Trim().ToLower().Replace(" ", "-");
        // Create topic with empty content skeleton
        await MemoryService.UpsertTopicAsync(UserId, slug, $"# {slug}\n\n");
        _creating = false;
        _newSlug = "";
        await LoadTopics();
        await OnTopicCreated.InvokeAsync(slug);
    }

    private async Task HandleCreateKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ConfirmCreate();
        else if (e.Key == "Escape") CancelCreate();
    }

    private async Task SelectTopic(string slug) => await OnTopicSelected.InvokeAsync(slug);

    private async Task DeleteTopic(string slug)
    {
        await MemoryService.DeleteTopicAsync(UserId, slug);
        await LoadTopics();
        if (SelectedTopicSlug == slug)
            await OnTopicSelected.InvokeAsync("");
    }
}
