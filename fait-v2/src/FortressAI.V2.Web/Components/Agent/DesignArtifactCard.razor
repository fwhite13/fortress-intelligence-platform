@* DesignArtifactCard — shown in chat history after a design is generated *@

<div class="artifact-card">
    <div class="artifact-card-preview">
        <iframe class="artifact-card-iframe"
                srcdoc="@Html"
                sandbox="allow-same-origin"
                title="@ArtifactName preview"
                loading="lazy"></iframe>
        <div class="artifact-card-preview-overlay"></div>
    </div>

    <div class="artifact-card-footer">
        <div class="artifact-card-name">
            <MudIcon Icon="@Icons.Material.Filled.Code" Class="artifact-card-name-icon" />
            <span class="artifact-card-name-text">@ArtifactName</span>
            @if (IsFallback)
            {
                <span class="artifact-card-fallback-tag">CC-native</span>
            }
        </div>

        <div class="artifact-card-actions">
            <button class="artifact-card-btn artifact-card-btn-preview"
                    @onclick="HandleOpenPreview"
                    title="Open in preview">
                <MudIcon Icon="@Icons.Material.Filled.OpenInNew" Class="artifact-card-btn-icon" />
                <span>Preview</span>
            </button>
            <button class="artifact-card-btn artifact-card-btn-download"
                    @onclick="HandleDownload"
                    title="Download HTML">
                <MudIcon Icon="@Icons.Material.Filled.Download" Class="artifact-card-btn-icon" />
                <span>Download</span>
            </button>
        </div>
    </div>
</div>

<style>
    .artifact-card {
        border: 1px solid var(--color-border);
        border-radius: var(--radius-lg);
        overflow: hidden;
        background: var(--color-surface);
        max-width: 420px;
    }

    .artifact-card-preview {
        position: relative;
        height: 200px;
        overflow: hidden;
        background: var(--color-bg-secondary);
    }

    .artifact-card-iframe {
        width: 100%;
        height: 400px;
        border: none;
        transform: scale(0.5);
        transform-origin: top left;
        pointer-events: none;
    }

    .artifact-card-preview-overlay {
        position: absolute;
        inset: 0;
        background: transparent;
    }

    .artifact-card-footer {
        padding: var(--space-3) var(--space-4);
        display: flex;
        flex-direction: column;
        gap: var(--space-3);
    }

    .artifact-card-name {
        display: flex;
        align-items: center;
        gap: var(--space-2);
        color: var(--color-text-primary);
        font-size: var(--font-size-sm);
        font-weight: 500;
    }

    .artifact-card-name-icon {
        font-size: 16px !important;
        width: 16px !important;
        height: 16px !important;
        color: var(--color-text-secondary);
    }

    .artifact-card-name-text {
        flex: 1;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .artifact-card-fallback-tag {
        font-size: var(--font-size-xs);
        padding: 1px var(--space-2);
        border-radius: var(--radius-sm);
        background: var(--color-gold-muted);
        color: var(--color-gold);
        border: 1px solid var(--color-gold);
    }

    .artifact-card-actions {
        display: flex;
        gap: var(--space-2);
    }

    .artifact-card-btn {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-md);
        border: 1px solid var(--color-border);
        background: transparent;
        color: var(--color-text-secondary);
        font-size: var(--font-size-sm);
        cursor: pointer;
        transition: background var(--transition-base), color var(--transition-base);
    }

    .artifact-card-btn:hover {
        background: var(--color-surface-hover);
        color: var(--color-text-primary);
    }

    .artifact-card-btn-preview {
        border-color: var(--color-accent);
        color: var(--color-accent);
    }

    .artifact-card-btn-preview:hover {
        background: var(--color-accent-bg);
    }

    .artifact-card-btn-icon {
        font-size: 14px !important;
        width: 14px !important;
        height: 14px !important;
    }
</style>

@code {
    [Parameter] public string ArtifactName { get; set; } = string.Empty;
    [Parameter] public string Html { get; set; } = string.Empty;
    [Parameter] public bool IsFallback { get; set; }
    [Parameter] public EventCallback OnOpenPreview { get; set; }

    [Inject] private IJSRuntime JS { get; set; } = default!;

    private async Task HandleOpenPreview()
    {
        await OnOpenPreview.InvokeAsync();
    }

    private async Task HandleDownload()
    {
        var fileName = string.IsNullOrWhiteSpace(ArtifactName) ? "design.html" : $"{ArtifactName}.html";
        var bytes = System.Text.Encoding.UTF8.GetBytes(Html);
        var base64 = Convert.ToBase64String(bytes);
        await JS.InvokeVoidAsync("downloadBase64", fileName, "text/html", base64);
    }
}
