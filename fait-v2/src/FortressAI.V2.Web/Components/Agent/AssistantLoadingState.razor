@implements IAsyncDisposable

<div class="loading-state-container">
    <div class="loading-state-card">
        @* Fortress brand spinner *@
        <div class="loading-spinner">
            <div class="loading-spinner-ring"></div>
        </div>

        @* Status message *@
        <p class="loading-status-message">@_statusMessage</p>

        @* Contextual subtitle *@
        <p class="loading-subtitle">Your assistant remembers where you left off.</p>

        @* Error state *@
        @if (_timedOut)
        {
            <div class="loading-error-state">
                <p class="loading-error-message">Taking longer than expected.</p>
                <button class="loading-retry-btn" @onclick="Retry">Try again</button>
            </div>
        }
    </div>
</div>

@code {
    [Parameter] public EventCallback OnReady { get; set; }

    private string _statusMessage = "Starting your assistant...";
    private bool _timedOut = false;
    private CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        await RunReadinessCheckAsync(_cts.Token);
    }

    private async Task RunReadinessCheckAsync(CancellationToken ct)
    {
        try
        {
            // Brief UX pause so the loading screen doesn't flash
            await Task.Delay(800, ct);

            // Check provisioning status via service (server-side, no HTTP round-trip)
            var isReady = await ProvisioningStatusService.CheckReadyAsync(ct);

            if (!ct.IsCancellationRequested)
            {
                if (!isReady)
                {
                    NavManager.NavigateTo("/onboarding", replace: true);
                    return;
                }
                await OnReady.InvokeAsync();
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed — swallow
        }
        catch (Exception ex)
        {
            Log.LogError(ex, "AssistantLoadingState readiness check failed");
            _timedOut = true;
            StateHasChanged();
        }
    }

    private async Task Retry()
    {
        _timedOut = false;
        _cts.Cancel();
        _cts = new CancellationTokenSource();
        _statusMessage = "Starting your assistant...";
        StateHasChanged();
        await RunReadinessCheckAsync(_cts.Token);
    }

    public ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        return ValueTask.CompletedTask;
    }

    [Inject] private IProvisioningStatusService ProvisioningStatusService { get; set; } = default!;
    [Inject] private ILogger<AssistantLoadingState> Log { get; set; } = default!;
    [Inject] private NavigationManager NavManager { get; set; } = default!;
}
