@page "/kb-management"
@page "/knowledge-base"
@implements IDisposable
@attribute [Authorize]
@using FortressAI.V2.Web.Data
@using FortressAI.V2.Web.Data.Models
@using FortressAI.V2.Web.Components.Dialogs
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<FaitV2DbContext> DbFactory
@inject KbForgeService Forge
@inject KbDocumentService KbDocumentService
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<KnowledgeBase> _logger

<PageTitle>Knowledge Base — FAIT</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-4">
    <div class="kb-page-header">
        <div class="kb-page-header__badge">FORGE</div>
        <div class="kb-page-header__title-row">
            <MudText Typo="Typo.h5" Style="font-weight: var(--font-semibold);">Knowledge Base</MudText>
        </div>
    </div>
    <MudText Typo="Typo.body2" Class="mb-4" Style="color: var(--color-text-secondary);">
        Manage your personal, team, and corporate knowledge entries.
    </MudText>

    @if (!string.IsNullOrEmpty(_authError))
    {
        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined">
            @_authError
        </MudAlert>
    }
    else if (_loading)
    {
        <div class="kb-page-loading">
            <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
        </div>
    }
    else
    {
        <MudTabs Elevation="2" Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4"
                 @bind-ActivePanelIndex="_activeTab">

            <!-- ══ MY KB TAB ══════════════════════════════════════════════════ -->
            <MudTabPanel Text="My KB" Icon="@Icons.Material.Filled.Person">
                <div style="display: flex; gap: 12px; align-items: center; margin-bottom: 16px; flex-wrap: wrap;">
                    <MudTextField @bind-Value="_personalSearch"
                                  Placeholder="Search entries..."
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Variant="Variant.Outlined"
                                  Clearable="true"
                                  Style="max-width: 400px;"
                                  Immediate="true" />
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="OpenNewPersonalEntry">
                        + New Note
                    </MudButton>
                    <MudFileUpload T="IBrowserFile"
                                   Accept=".pdf,.docx,.xlsx,.pptx,.rtf,.txt,.md,.csv,.json,.xml,.yaml,.yml,.log,.cs,.js,.ts,.tsx,.jsx,.py,.html,.css,.java,.cpp,.c,.h,.go,.rs,.rb,.php,.swift,.kt,.sh,.bash,.ps1,.r,.scala,.vue,.svelte,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.tiff,.tif"
                                   FilesChanged="UploadPersonalDocument"
                                   Hidden="false"
                                   InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                                   InputStyle="opacity:0">
                        <ActivatorContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       StartIcon="@Icons.Material.Filled.Upload"
                                       Disabled="_uploadingPersonalDoc">
                                @if (_uploadingPersonalDoc)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>Uploading…</span>
                                }
                                else
                                {
                                    <span>Upload Document</span>
                                }
                            </MudButton>
                        </ActivatorContent>
                    </MudFileUpload>
                    <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary); margin-top: 4px;">
                        Supported: PDF, DOCX, TXT, MD, PPTX, JPG, PNG, GIF, WEBP · Max 10 MB · PPTX auto-converted to PDF · Ingestion takes 1–5 minutes
                    </MudText>
                </div>

                @{
                    var filteredPersonal = FilterEntries(_personalEntries, _personalSearch);
                }

                @if (!filteredPersonal.Any() && !_personalDocuments.Any())
                {
                    <div class="kb-empty-state">
                        <MudIcon Icon="@Icons.Material.Filled.LibraryBooks" Style="font-size: 48px; opacity: 0.4;" />
                        <MudText Typo="Typo.body1" Class="mt-3">
                            @(string.IsNullOrWhiteSpace(_personalSearch)
                                ? "Your personal knowledge base is empty. Add your first entry."
                                : "No entries match your search.")
                        </MudText>
                    </div>
                }
                else
                {
                    @foreach (var entry in filteredPersonal)
                    {
                        <MudCard Elevation="1" Class="mb-3">
                            <MudCardContent>
                                <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                    <div style="flex: 1; min-width: 0;">
                                        <MudText Typo="Typo.h6" Style="font-weight: 600;">@entry.Title</MudText>
                                        <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary); margin: 4px 0 8px; overflow-wrap: break-word;">
                                            @(entry.Content.Length > 100 ? entry.Content[..100] + "…" : entry.Content)
                                        </MudText>
                                        <div style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
                                            @if (!string.IsNullOrWhiteSpace(entry.Tags))
                                            {
                                                @foreach (var tag in entry.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@tag</MudChip>
                                                }
                                            }
                                            <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary); margin-left: 8px;">
                                                @entry.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                            </MudText>
                                        </div>
                                    </div>
                                    <div style="display: flex; gap: 4px; margin-left: 12px;">
                                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                       Size="Size.Small"
                                                       aria-label="Edit"
                                                       OnClick="() => OpenEditEntry(entry)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       aria-label="Delete"
                                                       OnClick="() => DeleteEntry(entry)" />
                                    </div>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    }
                }

                @if (_personalDocumentsLoadError != null)
                {
                    <MudDivider Class="my-4" />
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mb-3">
                        @_personalDocumentsLoadError
                    </MudAlert>
                }
                else if (_personalDocuments.Any())
                {
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin-bottom: 12px;">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                        Knowledge Documents
                    </MudText>
                    @foreach (var doc in _personalDocuments)
                    {
                        <MudPaper Elevation="1" Class="mb-2 pa-3" Style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Style="color: var(--color-text-secondary);" />
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 500;">@doc.Filename</MudText>
                                    <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);">
                                        @FormatFileSize(doc.Size) · @doc.LastModified.ToLocalTime().ToString("MMM d, yyyy")
                                    </MudText>
                                </div>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           aria-label="Delete document"
                                           OnClick="() => DeletePersonalDocument(doc.S3Key)" />
                        </MudPaper>
                    }
                }
            </MudTabPanel>

            <!-- ══ TEAMS TAB ══════════════════════════════════════════════════ -->
            <MudTabPanel Text="Teams" Icon="@Icons.Material.Filled.FolderShared">
                @if (_selectedTeam == null)
                {
                    <div class="kb-teams-header">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.CreateNewFolder"
                                   OnClick="OpenNewTeam">
                            New Team
                        </MudButton>
                    </div>

                    @if (!_teams.Any())
                    {
                        <div class="kb-empty-state">
                            <MudIcon Icon="@Icons.Material.Filled.FolderOff" Style="font-size: 48px; opacity: 0.4;" />
                            <MudText Typo="Typo.body1" Class="mt-3">
                                No teams yet. Create a team to share KB entries.
                            </MudText>
                        </div>
                    }
                    else
                    {
                        @foreach (var team in _teams)
                        {
                            <MudCard Elevation="1" Class="mb-3" Style="cursor: pointer;"
                                     @onclick="() => SelectTeam(team)">
                                <MudCardContent>
                                    <div class="kb-team-card-row">
                                        <div>
                                            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 4px;">
                                                <MudText Typo="Typo.h6" Style="font-weight: 600;">@team.Name</MudText>
                                                @if (team.CreatorId == _userId)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">Owner</MudChip>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(team.Description))
                                            {
                                                <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">@team.Description</MudText>
                                            }
                                        </div>
                                        <div style="text-align: right;">
                                            <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);">
                                                <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" Style="vertical-align: middle;" />
                                                @team.Members.Count @(team.Members.Count == 1 ? "member" : "members")
                                            </MudText>
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    }
                }
                else
                {
                    <div class="kb-detail-back">
                        <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
                                   Variant="Variant.Text"
                                   OnClick="BackToTeams">
                            Back to Teams
                        </MudButton>
                    </div>

                    <div style="margin-bottom: 20px;">
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: var(--color-gold);">@_selectedTeam.Name</MudText>
                        @if (!string.IsNullOrWhiteSpace(_selectedTeam.Description))
                        {
                            <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">@_selectedTeam.Description</MudText>
                        }
                    </div>

                    <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
                        <MudButton Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="OpenNewTeamEntry">
                            + New Note
                        </MudButton>
                        <MudFileUpload T="IBrowserFile"
                                       Accept=".pdf,.docx,.xlsx,.pptx,.rtf,.txt,.md,.csv,.json,.xml,.yaml,.yml,.log,.cs,.js,.ts,.tsx,.jsx,.py,.html,.css,.java,.cpp,.c,.h,.go,.rs,.rb,.php,.swift,.kt,.sh,.bash,.ps1,.r,.scala,.vue,.svelte,.png,.jpg,.jpeg,.gif,.webp,.svg,.bmp,.tiff,.tif"
                                       FilesChanged="UploadTeamDocument"
                                       Hidden="false"
                                       InputClass="absolute mud-width-full mud-height-full overflow-hidden z-10"
                                       InputStyle="opacity:0">
                            <ActivatorContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.Upload"
                                           Disabled="_uploadingTeamDoc">
                                    @if (_uploadingTeamDoc)
                                    {
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        <span>Uploading…</span>
                                    }
                                    else
                                    {
                                        <span>Upload Document</span>
                                    }
                                </MudButton>
                            </ActivatorContent>
                        </MudFileUpload>
                        @if (_selectedTeam.CreatorId == _userId)
                        {
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       StartIcon="@Icons.Material.Filled.PersonAdd"
                                       OnClick="OpenAddMember">
                                Add Member
                            </MudButton>
                        }
                    </div>

                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin-bottom: 12px;">Entries</MudText>

                    @if (_loadingTeamEntries)
                    {
                        <div style="display: flex; justify-content: center; padding: 24px 0;">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        </div>
                    }
                    else if (!_teamEntries.Any())
                    {
                        <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary); margin-bottom: 20px;">
                            No entries in this team yet. Add the first one.
                        </MudText>
                    }
                    else
                    {
                        @foreach (var entry in _teamEntries)
                        {
                            <MudCard Elevation="1" Class="mb-3">
                                <MudCardContent>
                                    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
                                        <div style="flex: 1; min-width: 0;">
                                            <MudText Typo="Typo.h6" Style="font-weight: 600;">@entry.Title</MudText>
                                            <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary); margin: 4px 0 8px; overflow-wrap: break-word;">
                                                @(entry.Content.Length > 100 ? entry.Content[..100] + "…" : entry.Content)
                                            </MudText>
                                            <div style="display: flex; flex-wrap: wrap; gap: 4px; align-items: center;">
                                                @if (!string.IsNullOrWhiteSpace(entry.Tags))
                                                {
                                                    @foreach (var tag in entry.Tags.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">@tag</MudChip>
                                                    }
                                                }
                                                <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary); margin-left: 8px;">
                                                    @entry.CreatedAt.ToLocalTime().ToString("MMM d, yyyy")
                                                </MudText>
                                            </div>
                                        </div>
                                        <div style="display: flex; gap: 4px; margin-left: 12px;">
                                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                                           Size="Size.Small"
                                                           aria-label="Edit"
                                                           OnClick="() => OpenEditEntry(entry)" />
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Size="Size.Small"
                                                           Color="Color.Error"
                                                           aria-label="Delete"
                                                           OnClick="() => DeleteEntry(entry)" />
                                        </div>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    }

                    @if (_teamDocuments.Any())
                    {
                        <MudDivider Class="my-3" />
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin-bottom: 12px;">
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" Style="vertical-align: middle; margin-right: 4px;" />
                            Knowledge Documents
                        </MudText>
                        @foreach (var doc in _teamDocuments)
                        {
                            <MudPaper Elevation="1" Class="mb-2 pa-3" Style="display: flex; justify-content: space-between; align-items: center;">
                                <div style="display: flex; align-items: center; gap: 10px;">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Style="color: var(--color-text-secondary);" />
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@doc.Filename</MudText>
                                        <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);">
                                            @FormatFileSize(doc.Size) · @doc.LastModified.ToLocalTime().ToString("MMM d, yyyy")
                                        </MudText>
                                    </div>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="Delete document"
                                               OnClick="() => DeleteTeamDocument(doc.S3Key)" />
                            </MudPaper>
                        }
                    }

                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600; margin-bottom: 12px;">Members</MudText>

                    @foreach (var member in _selectedTeam.Members)
                    {
                        <MudPaper Elevation="1" Class="mb-2 pa-3" Style="display: flex; justify-content: space-between; align-items: center;">
                            <div style="display: flex; align-items: center; gap: 10px;">
                                <MudIcon Icon="@Icons.Material.Filled.Person" Style="color: var(--color-text-secondary);" />
                                <div>
                                    <MudText Typo="Typo.body2">@(_memberDisplayNames.TryGetValue(member.UserId, out var mdn) ? mdn : member.UserId)</MudText>
                                </div>
                                <MudChip T="string"
                                         Size="Size.Small"
                                         Color="@(member.Role == KbTeamRole.Owner ? Color.Warning : Color.Default)"
                                         Variant="Variant.Outlined">
                                    @member.Role.ToString()
                                </MudChip>
                            </div>
                            @if (_selectedTeam.CreatorId == _userId && member.UserId != _userId)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.PersonRemove"
                                               Size="Size.Small"
                                               Color="Color.Error"
                                               aria-label="Remove member"
                                               OnClick="() => RemoveMember(member.UserId)" />
                            }
                        </MudPaper>
                    }
                }
            </MudTabPanel>

        </MudTabs>
    }
</MudContainer>

<style>
    .kb-page-header {
        display: flex;
        align-items: center;
        gap: var(--space-3);
        margin-bottom: var(--space-4);
    }

    .kb-page-header__badge {
        background: var(--color-gold);
        color: var(--color-text-on-primary);
        font-weight: var(--font-bold);
        font-size: var(--text-xs);
        padding: var(--space-1) var(--space-2);
        border-radius: var(--radius-sm);
        letter-spacing: var(--tracking-wide);
    }

    .kb-page-header__title-row {
        display: flex;
        align-items: center;
        gap: var(--space-2);
    }

    .kb-page-loading {
        display: flex;
        justify-content: center;
        padding: var(--space-12) 0;
    }

    .kb-empty-state {
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: var(--space-12) 0;
        text-align: center;
        color: var(--color-text-secondary);
    }

    .kb-teams-header {
        display: flex;
        justify-content: flex-end;
        margin-bottom: var(--space-4);
    }

    .kb-team-card-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .kb-detail-back {
        margin-bottom: var(--space-4);
    }
</style>

@code {
    // ── State ─────────────────────────────────────────────────────────────────

    private bool _loading = true;
    private int _activeTab = 0;
    private string _userId = "";
    private string? _authError;

    // Personal KB
    private List<KbEntry> _personalEntries = new();
    private string _personalSearch = "";

    // Teams
    private List<KbTeam> _teams = new();
    private KbTeam? _selectedTeam;
    private List<KbEntry> _teamEntries = new();
    private bool _loadingTeamEntries = false;
    private Dictionary<string, string> _memberDisplayNames = new();

    // Document management
    private List<KbDocumentInfo> _personalDocuments = new();
    private List<KbDocumentInfo> _teamDocuments = new();
    private bool _uploadingPersonalDoc = false;
    private bool _uploadingTeamDoc = false;
    private string? _personalDocumentsLoadError = null;

    // Status auto-refresh
    private Timer? _statusRefreshTimer;

    // ── Lifecycle ─────────────────────────────────────────────────────────────

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (string.IsNullOrEmpty(oid))
        {
            _logger.LogWarning("KnowledgeBase: could not extract OID from auth claims");
            _authError = "Please log in to access the Knowledge Base.";
            _loading = false;
            return;
        }

        if (!string.IsNullOrEmpty(oid))
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var dbUser = await db.Users.FirstOrDefaultAsync(u => u.EntraOid == oid);
            if (dbUser == null)
                _logger.LogWarning("KnowledgeBase: no user record found for oid={Oid}", oid);
            _userId = dbUser?.Id ?? "";
        }

        _logger.LogInformation("KnowledgeBase init: resolved userId={UserId} from oid={Oid}", _userId, oid);

        if (string.IsNullOrEmpty(_userId))
        {
            _authError = "Please log in to access the Knowledge Base.";
            _loading = false;
            return;
        }

        try
        {
            var personalTask = Forge.GetPersonalEntriesAsync(_userId);
            var teamsTask    = Forge.GetUserTeamsAsync(_userId);

            await Task.WhenAll(personalTask, teamsTask);

            _personalEntries = personalTask.Result;
            _teams           = teamsTask.Result;

            try
            {
                _personalDocuments = await KbDocumentService.ListDocumentsAsync(KbTier.Personal, _userId);
                _personalDocumentsLoadError = null;
                _logger.LogInformation("KnowledgeBase init: loaded personalEntries={PersonalCount} teams={TeamCount} personalDocs={DocCount} for userId={UserId}",
                    _personalEntries.Count, _teams.Count, _personalDocuments.Count, _userId);
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to load personal KB documents");
                _personalDocumentsLoadError = "Failed to load your documents. Please refresh the page.";
                Snackbar.Add("Could not load your KB documents — check connectivity or permissions.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading knowledge base: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    public void Dispose()
    {
        _statusRefreshTimer?.Dispose();
    }

    // ── Helpers ───────────────────────────────────────────────────────────────

    private static List<KbEntry> FilterEntries(List<KbEntry> entries, string query)
    {
        if (string.IsNullOrWhiteSpace(query))
            return entries;

        var q = query.Trim().ToLowerInvariant();
        return entries
            .Where(e => e.Title.ToLowerInvariant().Contains(q) || e.Content.ToLowerInvariant().Contains(q))
            .ToList();
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024):F1} MB";
    }

    // ── Personal entry actions ────────────────────────────────────────────────

    private async Task OpenNewPersonalEntry()
    {
        var parameters = new DialogParameters<KbEntryDialog>();
        var dialog = await DialogService.ShowAsync<KbEntryDialog>("New Entry", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is KbEntryDialogResult r)
            await SaveEntry(KbTier.Personal, null, r.Title, r.Content, r.Tags);
    }

    private async Task OpenEditEntry(KbEntry entry)
    {
        var parameters = new DialogParameters<KbEntryDialog>
        {
            { x => x.IsEdit, true },
            { x => x.Title, entry.Title },
            { x => x.Content, entry.Content },
            { x => x.Tags, entry.Tags ?? "" }
        };
        var dialog = await DialogService.ShowAsync<KbEntryDialog>("Edit Entry", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is KbEntryDialogResult r)
            await UpdateEntry(entry, r.Title, r.Content, r.Tags);
    }

    private async Task SaveEntry(KbTier tier, string? teamId, string title, string content, string rawTags)
    {
        try
        {
            var tags = string.IsNullOrWhiteSpace(rawTags) ? null : rawTags.Trim();
            await Forge.CreateEntryAsync(_userId, tier, title, content, tags, teamId);
            Snackbar.Add("Entry created.", Severity.Success);
            await ReloadAfterEntryChange(tier, isEdit: false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task UpdateEntry(KbEntry entry, string title, string content, string rawTags)
    {
        try
        {
            var tags = string.IsNullOrWhiteSpace(rawTags) ? null : rawTags.Trim();
            await Forge.UpdateEntryAsync(_userId, entry.Id, title, content, tags);
            Snackbar.Add("Entry updated.", Severity.Success);
            await ReloadAfterEntryChange(entry.Tier, isEdit: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task DeleteEntry(KbEntry entry)
    {
        try
        {
            await Forge.DeleteEntryAsync(_userId, entry.Id);
            Snackbar.Add("Entry deleted.", Severity.Success);
            await ReloadAfterEntryChange(entry.Tier, isEdit: false);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ReloadAfterEntryChange(KbTier tier, bool isEdit)
    {
        if (tier == KbTier.Personal || (!isEdit && _selectedTeam == null))
            _personalEntries = await Forge.GetPersonalEntriesAsync(_userId);

        if (_selectedTeam != null)
        {
            _loadingTeamEntries = true;
            try
            {
                _teamEntries = await Forge.GetTeamEntriesAsync(_userId, _selectedTeam.Id);
            }
            finally
            {
                _loadingTeamEntries = false;
            }
        }
    }

    // ── Document actions ──────────────────────────────────────────────────────

    private async Task UploadPersonalDocument(IBrowserFile file)
    {
        _uploadingPersonalDoc = true;
        StateHasChanged();
        try
        {
            const long maxSize = 10 * 1024 * 1024;
            var fileBytes = new byte[file.Size];
            await using var rawStream = file.OpenReadStream(maxSize);
            await rawStream.ReadExactlyAsync(fileBytes, 0, (int)file.Size);
            await using var safeStream = new MemoryStream(fileBytes);

            if (file.Name.EndsWith(".pptx", StringComparison.OrdinalIgnoreCase))
                Snackbar.Add("Converting PPTX to PDF for KB compatibility...", Severity.Info);

            await KbDocumentService.UploadDocumentAsync(safeStream, file.Name, file.ContentType, KbTier.Personal, _userId);
            await KbDocumentService.StartIngestionAsync();
            Snackbar.Add("Document uploaded. It will be searchable in 1–5 minutes as it's being processed.", Severity.Success);
            _personalDocuments = await KbDocumentService.ListDocumentsAsync(KbTier.Personal, _userId);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _uploadingPersonalDoc = false;
            StateHasChanged();
        }
    }

    private async Task DeletePersonalDocument(string s3Key)
    {
        try
        {
            await KbDocumentService.DeleteDocumentAsync(s3Key);
            try { await KbDocumentService.StartIngestionAsync(); }
            catch (Exception ex) { _logger.LogWarning(ex, "Ingestion trigger after delete failed (non-fatal)"); }
            Snackbar.Add("Document deleted. Vector store will sync in 1–5 minutes.", Severity.Success);
            _personalDocuments = await KbDocumentService.ListDocumentsAsync(KbTier.Personal, _userId);
            StateHasChanged();
        }
        catch (Exception ex) { Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error); }
    }

