            await rawStream.ReadExactlyAsync(fileBytes, 0, (int)file.Size);
            await using var safeStream = new MemoryStream(fileBytes);

            if (file.Name.EndsWith(".pptx", StringComparison.OrdinalIgnoreCase))
                Snackbar.Add("Converting PPTX to PDF for KB compatibility...", Severity.Info);

            await KbDocumentService.UploadDocumentAsync(safeStream, file.Name, file.ContentType, KbTier.Team, _userId, _selectedTeam.Id);
            await KbDocumentService.StartIngestionAsync(KbTier.Team);
            Snackbar.Add("Document uploaded. It will be searchable in 1–5 minutes as it's being processed.", Severity.Success);
