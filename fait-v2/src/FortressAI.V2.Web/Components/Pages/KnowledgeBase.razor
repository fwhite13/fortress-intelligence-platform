    // ── Team actions ──────────────────────────────────────────────────────────

    private async Task OpenNewTeam()
    {
        var parameters = new DialogParameters<KbTeamDialog>();
        var dialog = await DialogService.ShowAsync<KbTeamDialog>("New Team", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is KbTeamDialogResult r)
            await CreateTeam(r.Name, r.Description);
    }

    private async Task CreateTeam(string name, string? description)
    {
        try
        {
            var desc = string.IsNullOrWhiteSpace(description) ? null : description.Trim();
            await Forge.CreateTeamAsync(_userId, name.Trim(), desc);
            Snackbar.Add("Team created!", Severity.Success);
            _teams = await Forge.GetUserTeamsAsync(_userId);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            _logger.LogError(ex, "CreateTeam failed for user {UserId}", _userId);
            Snackbar.Add($"Failed to create team: {ex.Message}", Severity.Error);
        }
    }

    private async Task SelectTeam(KbTeam team)
    {
        _selectedTeam       = team;
        _loadingTeamEntries = true;
        StateHasChanged();
        try
        {
            _teamEntries   = await Forge.GetTeamEntriesAsync(_userId, team.Id);
            _teamDocuments = await KbDocumentService.ListDocumentsAsync(KbTier.Team, _userId, team.Id);

            var userIds = team.Members.Select(m => m.UserId).ToList();
            await using var db = await DbFactory.CreateDbContextAsync();
            var users = await db.Users
                .Where(u => userIds.Contains(u.Id))
                .Select(u => new { u.Id, Name = u.DisplayName ?? u.Email })
                .ToListAsync();
            _memberDisplayNames = users.ToDictionary(u => u.Id, u => u.Name);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _loadingTeamEntries = false;
        }
    }

    private void BackToTeams()
    {
        _selectedTeam       = null;
        _memberDisplayNames = new();
        _teamEntries        = new();
    }

    private async Task OpenNewTeamEntry()
    {
        var parameters = new DialogParameters<KbEntryDialog>();
        var dialog = await DialogService.ShowAsync<KbEntryDialog>("Add Entry", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is KbEntryDialogResult r)
            await SaveEntry(KbTier.Team, _selectedTeam!.Id, r.Title, r.Content, r.Tags);
    }

    // ── Member actions ────────────────────────────────────────────────────────

    private async Task OpenAddMember()
    {
        var existingMemberIds = _selectedTeam?.Members.Select(m => m.UserId).ToHashSet() ?? new HashSet<string>();
        await using var db = await DbFactory.CreateDbContextAsync();
        var availableUsers = await db.Users
            .Where(u => u.Id != _userId && !existingMemberIds.Contains(u.Id))
            .OrderBy(u => u.DisplayName ?? u.Email)
            .ToListAsync();

        var parameters = new DialogParameters<KbAddMemberDialog>
        {
            { x => x.AvailableUsers, availableUsers }
        };
        var dialog = await DialogService.ShowAsync<KbAddMemberDialog>("Add Member", parameters);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled && result.Data is string newMemberId)
            await AddMember(newMemberId);
    }

    private async Task AddMember(string memberId)
    {
        try
        {
            await Forge.AddMemberAsync(_userId, _selectedTeam!.Id, memberId);
            Snackbar.Add("Member added successfully.", Severity.Success);
            _teams        = await Forge.GetUserTeamsAsync(_userId);
            _selectedTeam = _teams.FirstOrDefault(p => p.Id == _selectedTeam!.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RemoveMember(string memberId)
    {
        try
        {
            await Forge.RemoveMemberAsync(_userId, _selectedTeam!.Id, memberId);
            Snackbar.Add("Member removed.", Severity.Success);
            _teams        = await Forge.GetUserTeamsAsync(_userId);
            _selectedTeam = _teams.FirstOrDefault(p => p.Id == _selectedTeam!.Id);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }
}
