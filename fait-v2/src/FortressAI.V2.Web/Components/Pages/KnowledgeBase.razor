            _uploadingTeamDoc = false;
            StateHasChanged();
        }
    }

    private async Task DeleteTeamDocument(string s3Key)
    {
        if (_selectedTeam == null) return;
        try
        {
            await KbDocumentService.DeleteDocumentAsync(s3Key);
            try { await KbDocumentService.StartIngestionAsync(KbTier.Team); }
