@page "/onboarding"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject IUserProvisioningService ProvisioningService
@inject NavigationManager Nav
@inject ILogger<Onboarding> Logger
@inject FaitV2DbContext Db

<PageTitle>Welcome — FAIT v2</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="fait-v2-page fait-v2-onboarding">
    <MudText Typo="Typo.h5" Class="fait-v2-page__title">Welcome to FAIT v2</MudText>
    <MudText Typo="Typo.body2" Class="fait-v2-page__subtitle">Let's set up your AI assistant. This takes about 2 minutes.</MudText>

    <MudPaper Class="fait-v2-onboarding__wizard" Elevation="2">
        <MudStepper @ref="_stepper"
                    Class="fait-v2-onboarding__stepper"
                    ActiveIndex="@_resumeStep"
                    CurrentStepColor="Color.Primary"
                    CompletedStepColor="Color.Success"
                    OnPreviewInteraction="HandleStepInteraction">
            <ChildContent>
            <!-- Step 1: Role & Responsibilities -->
            <MudStep Title="Role" SecondaryText="Who you are">
                <MudStack Spacing="4" Class="fait-v2-onboarding__step-content">
                    <MudText Typo="Typo.h6">Role &amp; Responsibilities</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Help your assistant understand what you do so it can serve you better.
                    </MudText>
                    <MudTextField @bind-Value="_role"
                                  Label="What is your role?"
                                  Placeholder='e.g., "Claims Adjuster", "Underwriter"'
                                  Variant="Variant.Outlined"
                                  Class="fait-v2-onboarding__field" />
                    <MudTextField @bind-Value="_responsibilities"
                                  Label="What are your main responsibilities?"
                                  Placeholder="Describe what you do day-to-day..."
                                  Variant="Variant.Outlined"
                                  Lines="4"
                                  Class="fait-v2-onboarding__field" />
                </MudStack>
            </MudStep>

            <!-- Step 2: Preferences -->
            <MudStep Title="Preferences" SecondaryText="How you like to work">
                <MudStack Spacing="4" Class="fait-v2-onboarding__step-content">
                    <MudText Typo="Typo.h6">Communication Preferences</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Tailor how your assistant communicates with you.
                    </MudText>
                    <MudSelect @bind-Value="_communicationStyle"
                               Label="How would you like your assistant to communicate?"
                               Variant="Variant.Outlined"
                               Class="fait-v2-onboarding__field">
                        <MudSelectItem Value="@("Concise")">Concise — Short, direct answers</MudSelectItem>
                        <MudSelectItem Value="@("Balanced")">Balanced — Clear and thorough</MudSelectItem>
                        <MudSelectItem Value="@("Detailed")">Detailed — Comprehensive explanations</MudSelectItem>
                    </MudSelect>
                    <MudSelect @bind-Value="_responseFormat"
                               Label="Preferred response format?"
                               Variant="Variant.Outlined"
                               Class="fait-v2-onboarding__field">
                        <MudSelectItem Value="@("Bullet points")">Bullet points — Scannable lists</MudSelectItem>
                        <MudSelectItem Value="@("Prose")">Prose — Flowing paragraphs</MudSelectItem>
                        <MudSelectItem Value="@("Mixed")">Mixed — Best of both</MudSelectItem>
                    </MudSelect>
                    <div class="fait-v2-onboarding__toggle-row">
                        <MudText Typo="Typo.body1">Show source citations?</MudText>
                        <MudToggleIconButton @bind-Toggled="_showCitations"
                                            Icon="@Icons.Material.Filled.BookmarkBorder"
                                            ToggledIcon="@Icons.Material.Filled.Bookmark"
                                            Color="Color.Default"
                                            ToggledColor="Color.Primary"
                                            aria-label="Toggle source citations" />
                    </div>
                </MudStack>
            </MudStep>

            <!-- Step 3: Use Cases -->
            <MudStep Title="Use Cases" SecondaryText="How you'll use AI">
                <MudStack Spacing="4" Class="fait-v2-onboarding__step-content">
                    <MudText Typo="Typo.h6">Primary Use Cases</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        Select the tasks you'll primarily use your assistant for.
                    </MudText>
                    <div class="fait-v2-onboarding__use-cases">
                        @foreach (var useCase in _useCaseOptions)
                        {
                            <MudCheckBox T="bool"
                                         Value="_selectedUseCases.Contains(useCase)"
                                         ValueChanged="(bool v) => ToggleUseCase(useCase, v)"
                                         Label="@useCase"
                                         Color="Color.Primary"
                                         Class="fait-v2-onboarding__use-case-item" />
                        }
                    </div>
                    <MudTextField @bind-Value="_additionalContext"
                                  Label="Anything else you'd like your assistant to know? (optional)"
                                  Placeholder="Any other context about your work, preferences, or goals..."
                                  Variant="Variant.Outlined"
                                  Lines="3"
                                  Class="fait-v2-onboarding__field" />
                </MudStack>
            </MudStep>

            <!-- Step 4: Personalization -->
            <MudStep Title="Personalization" SecondaryText="Make it yours">
                <MudStack Spacing="4" Class="fait-v2-onboarding__step-content">
                    <MudText Typo="Typo.h6">Personalize Your Assistant</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        A few final touches to make your workspace feel like home.
                    </MudText>
                    <MudTextField @bind-Value="_preferredName"
                                  Label="What should your assistant call you?"
                                  Placeholder="@($"Defaults to: {_displayName.Split(' ').FirstOrDefault() ?? _displayName}")"
                                  Variant="Variant.Outlined"
                                  Class="fait-v2-onboarding__field" />
                    <MudTextField @bind-Value="_assistantName"
                                  Label="Assistant name"
                                  Placeholder="Aria"
                                  Variant="Variant.Outlined"
                                  Class="fait-v2-onboarding__field" />
                    <div class="fait-v2-onboarding__color-section">
                        <MudText Typo="Typo.body2" Class="fait-v2-onboarding__color-label">Accent color (optional)</MudText>
                        <div class="fait-v2-onboarding__color-swatches">
                            @foreach (var color in _accentColorOptions)
                            {
                                <button type="button"
                                        class="fait-v2-onboarding__color-swatch @(_accentColor == color.Value ? "fait-v2-onboarding__color-swatch--selected" : "")"
                                        style="background-color: @color.Value"
                                        title="@color.Label"
                                        aria-label="@color.Label accent color"
                                        @onclick="() => _accentColor = color.Value">
                                </button>
                            }
                        </div>
                    </div>

                    @if (_isProvisioning)
                    {
                        <div class="fait-v2-onboarding__provisioning">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Small" Class="fait-v2-onboarding__spinner" />
                            <MudText Typo="Typo.body2" Class="fait-v2-onboarding__provisioning-text">Setting up your workspace...</MudText>
                        </div>
                    }

                    @if (_provisionError)
                    {
                        <MudAlert Severity="Severity.Error" Class="fait-v2-onboarding__error">
                            @_errorMessage
                            <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="RetryProvisioning" Class="fait-v2-onboarding__retry-btn">
                                Retry
                            </MudButton>
                        </MudAlert>
                    }
                </MudStack>
            </MudStep>
            </ChildContent>
            <CompletedContent>
                <div class="fait-v2-onboarding__complete">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Class="fait-v2-onboarding__complete-icon" />
                    <MudText Typo="Typo.h6" Class="fait-v2-onboarding__complete-title">You're all set!</MudText>
                    <MudText Typo="Typo.body2" Class="fait-v2-onboarding__complete-text">Redirecting to your dashboard...</MudText>
                </div>
            </CompletedContent>
        </MudStepper>
    </MudPaper>
</MudContainer>

@code {
    private MudStepper? _stepper;
    private int _resumeStep = 0;

    // Step 1 — Role
    private string _role = "";
    private string _responsibilities = "";

    // Step 2 — Preferences
    private string _communicationStyle = "Balanced";
    private string _responseFormat = "Mixed";
    private bool _showCitations = true;

    // Step 3 — Use Cases
    private HashSet<string> _selectedUseCases = new();
    private string _additionalContext = "";
    private readonly List<string> _useCaseOptions = new()
    {
        "Document Analysis", "Research", "Writing",
        "Data Analysis", "Meeting Summaries", "Task Planning"
    };

    // Step 4 — Personalization
    private string _preferredName = "";
    private string _assistantName = "Aria";
    private string _accentColor = "#0066CC";

    // Status
    private bool _isProvisioning = false;
    private bool _provisionError = false;
    private string _errorMessage = "";

    // Entra info
    private string _entraOid = "";
    private string _email = "";
    private string _displayName = "";

    private record ColorOption(string Label, string Value);
    private readonly List<ColorOption> _accentColorOptions = new()
    {
        new("Fortress Blue", "#0066CC"),
        new("Royal Purple", "#6B46C1"),
        new("Forest Green", "#16A34A"),
        new("Crimson", "#DC2626"),
        new("Gold", "#D97706"),
        new("Steel", "#475569"),
    };

    [CascadingParameter]
    private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null) return;
        var auth = await AuthState;
        var user = auth.User;
        if (user.Identity?.IsAuthenticated != true) return;

        _entraOid = user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                 ?? user.FindFirst("oid")?.Value ?? "";
        _email = user.FindFirst("preferred_username")?.Value
              ?? user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        _displayName = user.FindFirst("name")?.Value
                    ?? user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    ?? _email.Split('@')[0];

        _preferredName = _displayName.Split(' ').FirstOrDefault() ?? _displayName;

        if (string.IsNullOrWhiteSpace(_entraOid))
        {
            _errorMessage = "Unable to determine your identity. Please sign out and sign in again.";
            _provisionError = true;
            StateHasChanged();
            return;
        }

        // Load resume step
        var existingUser = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == _entraOid);
        if (existingUser != null)
        {
            _resumeStep = existingUser.OnboardingStep ?? 0;
        }
    }

    private void ToggleUseCase(string useCase, bool selected)
    {
        if (selected) _selectedUseCases.Add(useCase);
        else _selectedUseCases.Remove(useCase);
    }

    private async Task<bool> HandleStepInteraction(StepperInteractionEventArgs args)
    {
        if (args.Action == StepAction.Complete)
        {
            // Persist progress (next step index = current + 1)
            await PersistOnboardingStepAsync(args.StepIndex + 1);

            if (args.StepIndex == 3) // last step (0-indexed, 4 steps total)
            {
                await FinishWizard();
                return !_provisionError;
            }
        }
        return true;
    }

    private async Task FinishWizard()
    {
        _isProvisioning = true;
        _provisionError = false;
        StateHasChanged();

        try
        {
            var wizardData = BuildWizardData();
            var userId = await GetOrCreateUserId();

            await ProvisioningService.ProvisionAsync(
                userId: userId,
                entraOid: _entraOid,
                email: _email,
                displayName: _displayName,
                wizardData: wizardData
            );

            // Clear onboarding step — fully onboarded
            await PersistOnboardingStepAsync(0);

            _isProvisioning = false;
            StateHasChanged();

            await Task.Delay(800);
            Nav.NavigateTo("/", forceLoad: false);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Provisioning failed for user {EntraOid}", _entraOid);
            _isProvisioning = false;
            _provisionError = true;
            _errorMessage = "Something went wrong setting up your workspace. Please try again.";
            StateHasChanged();
        }
    }

    private async Task<string> GetOrCreateUserId()
    {
        var existingUser = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == _entraOid);
        if (existingUser != null) return existingUser.Id;
        return Guid.NewGuid().ToString();
    }

    private WizardData BuildWizardData() => new WizardData(
        Role: _role,
        Responsibilities: _responsibilities,
        CommunicationStyle: _communicationStyle,
        ResponseFormat: _responseFormat,
        ShowCitations: _showCitations,
        UseCases: _selectedUseCases.ToList(),
        PreferredName: string.IsNullOrWhiteSpace(_preferredName) ? _displayName.Split(' ').FirstOrDefault() ?? _displayName : _preferredName,
        AssistantName: _assistantName,
        AdditionalContext: _additionalContext,
        AccentColor: _accentColor
    );

    private async Task RetryProvisioning()
    {
        _provisionError = false;
        await FinishWizard();
    }

    private async Task PersistOnboardingStepAsync(int step)
    {
        try
        {
            var user = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == _entraOid);
            if (user != null)
            {
                user.OnboardingStep = step;
                await Db.SaveChangesAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to persist onboarding step {Step}", step);
            // Non-critical — don't rethrow
        }
    }
}
