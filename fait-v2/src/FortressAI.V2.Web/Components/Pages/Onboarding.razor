@page "/onboarding"

<PageTitle>Onboarding — FAIT v2</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="fait-v2-page fait-v2-onboarding">
    <MudText Typo="Typo.h5" Class="fait-v2-page__title">Welcome to FAIT v2</MudText>
    <MudText Typo="Typo.body2" Class="fait-v2-page__subtitle">Let's set up your AI assistant.</MudText>

    <MudPaper Class="fait-v2-onboarding__stepper" Elevation="1">
        <MudStack Spacing="3">
            <MudText Typo="Typo.body1"><strong>Step 1:</strong> Role &amp; Responsibilities</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Tell us about your role. — Wizard placeholder, Phase A2 —</MudText>
            <MudDivider />
            <MudText Typo="Typo.body1"><strong>Step 2:</strong> Preferences</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Set your preferences. — Wizard placeholder, Phase A2 —</MudText>
            <MudDivider />
            <MudText Typo="Typo.body1"><strong>Step 3:</strong> Use Cases</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Choose your use cases. — Wizard placeholder, Phase A2 —</MudText>
            <MudDivider />
            <MudText Typo="Typo.body1"><strong>Step 4:</strong> Personalization</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Personalize your assistant. — Wizard placeholder, Phase A2 —</MudText>
        </MudStack>
    </MudPaper>
</MudContainer>
