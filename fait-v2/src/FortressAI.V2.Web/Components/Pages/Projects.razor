@page "/projects"
@attribute [Authorize]
@using FortressAI.V2.Web.Data
@using FortressAI.V2.Web.Data.Models
@using FortressAI.V2.Web.Services
@using FortressAI.V2.Web.Components.Dialogs
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.EntityFrameworkCore
@inject IProjectService ProjectSvc
@inject IDbContextFactory<FaitV2DbContext> DbFactory
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IDialogService DialogService

<PageTitle>Projects — FAIT v2</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1><MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" /> Projects</h1>
        <button class="btn btn-accent" @onclick="NewProject">
            <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /> New Project
        </button>
    </div>

    @if (_projects == null)
    {
        <div class="loading-state">
            <MudProgressCircular Size="Size.Small" Indeterminate="true" /> Loading projects...
        </div>
    }
    else if (!_projects.Any())
    {
        <div class="empty-state">
            <MudIcon Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small" />
            <h3>No projects yet</h3>
            <p>Create a project to organize your tasks with custom instructions and documents.</p>
            <button class="btn btn-accent" @onclick="NewProject">
                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" /> Create Your First Project
            </button>
        </div>
    }
    else
    {
        <div class="projects-grid">
            @foreach (var project in _projects)
            {
                <div class="project-card" @onclick="@(() => GoToProject(project.Id))">
                    <div class="project-card-header">
                        <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" />
                        <h3>@project.Name</h3>
                    </div>
                    @if (!string.IsNullOrEmpty(project.Description))
                    {
                        <p class="project-description">@project.Description</p>
                    }
                    <div class="project-card-meta">
                        <span><MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" /> @project.Documents.Count docs</span>
                        <span><MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" /> @project.ConversationTasks.Count tasks</span>
                    </div>
                    <div class="project-card-date">
                        Updated @project.UpdatedAt.ToString("MMM d, yyyy")
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<Project>? _projects;
    private string _userId = "";

    protected override async Task OnInitializedAsync()
    {
        await ResolveUserAsync();
        if (!string.IsNullOrEmpty(_userId))
            _projects = await ProjectSvc.GetUserProjectsFullAsync(_userId);
        else
            _projects = new();
    }

    private async Task ResolveUserAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var oid = authState.User.FindFirst("oid")?.Value
               ?? authState.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
        if (string.IsNullOrEmpty(oid)) return;

        await using var db = await DbFactory.CreateDbContextAsync();
        var dbUser = await db.Users.FirstOrDefaultAsync(u => u.EntraOid == oid);
        _userId = dbUser?.Id ?? "";
    }

    private async Task NewProject()
    {
        var parameters = new DialogParameters
        {
            ["Name"] = "",
            ["Description"] = ""
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProjectDialog>("New Project", parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled && result.Data is ProjectDialogResult data)
        {
            var project = await ProjectSvc.CreateProjectFullAsync(
                _userId, data.Name, data.Description,
                customInstructions: null, model: "claude-sonnet-4-6");
            Nav.NavigateTo($"/projects/{project.Id}");
        }
    }

    private void GoToProject(string id) => Nav.NavigateTo($"/projects/{id}");
}
