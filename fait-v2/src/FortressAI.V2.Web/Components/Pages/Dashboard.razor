@page "/"
@attribute [Authorize]
@using FortressAI.V2.Web.Components.Layout
@using FortressAI.V2.Web.Components.Chat
@using FortressAI.V2.Web.Components.Agent
@using FortressAI.V2.Web.Services
@using Microsoft.AspNetCore.Components.Authorization

<PageTitle>Dashboard — FAIT v2</PageTitle>

@if (!_agentReady)
{
    <AssistantLoadingState OnReady="HandleAgentReady" />
}
else
{
    @if (_kbs.Count > 0)
    {
        <div class="kb-status-bar">
            <MudIcon Icon="@Icons.Material.Filled.Storage" Class="kb-status-icon" />
            <span class="kb-status-label">Knowledge Bases:</span>
            @foreach (var kb in _kbs)
            {
                <span class="kb-status-pill">@kb.Description</span>
            }
        </div>
    }

    @if (_activeRecurringCount > 0 || _nextScheduledRun.HasValue)
    {
        <div class="dashboard-tasks-widget">
            <MudIcon Icon="@Icons.Material.Outlined.Schedule" Class="dashboard-tasks-widget__icon" />
            <span class="dashboard-tasks-widget__text">
                <strong>@_activeRecurringCount</strong> active recurring @(_activeRecurringCount == 1 ? "task" : "tasks")
                @if (_nextScheduledRun.HasValue)
                {
                    <span> · Next run: @FormatRelative(_nextScheduledRun)</span>
                }
            </span>
            <MudLink Href="/tasks" Class="dashboard-tasks-widget__link">View tasks</MudLink>
        </div>
    }

    <div class="agent-cards-row">
        <div class="agent-card @(_selectedAgent == "main" ? "agent-card-active" : "")" @onclick='() => _selectedAgent = "main"'>
            <MudIcon Icon="@Icons.Material.Filled.SmartToy" Class="agent-card-icon" />
            <span class="agent-card-name">Main Assistant</span>
        </div>
        <div class="agent-card @(_selectedAgent == "design" ? "agent-card-active" : "")" @onclick='() => _selectedAgent = "design"'>
            <MudIcon Icon="@Icons.Material.Filled.Palette" Class="agent-card-icon" />
            <span class="agent-card-name">Design Agent</span>
        </div>
        <div class="agent-card @(_selectedAgent == "marketing" ? "agent-card-active" : "")" @onclick='() => _selectedAgent = "marketing"'>
            <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="agent-card-icon" />
            <span class="agent-card-name">Marketing</span>
        </div>
    </div>
    @if (_selectedAgent == "design")
    {
        <DesignAgentView />
    }
    else if (_selectedAgent == "marketing")
    {
        @* Marketing Assistant — dedicated view not yet built; falls back to main ChatView with plugin context (Sprint 4) *@
        <DualPaneLayout @bind-IsPanelOpen="_previewOpen" PreviewTitle="@_previewTitle">
            <ChatContent><ChatView /></ChatContent>
            <PreviewContent><MemoryManagerView /></PreviewContent>
        </DualPaneLayout>
    }
    else
    {
        <DualPaneLayout @bind-IsPanelOpen="_previewOpen"
                        PreviewTitle="@_previewTitle">
            <ChatContent>
                <ChatView />
            </ChatContent>
            <PreviewContent>
                <MemoryManagerView />
            </PreviewContent>
        </DualPaneLayout>
    }
}

@code {
    [Inject] private IForgeKbService ForgeKbService { get; set; } = default!;
    [Inject] private IScheduledTaskService TaskService { get; set; } = default!;
    [Inject] private IUserService UserService { get; set; } = default!;
    [Inject] private ILogger<Dashboard> _logger { get; set; } = default!;
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private bool _previewOpen = true;
    private string _previewTitle = "Memory";
    private bool _agentReady = false;
    private string _selectedAgent = "main";
    private IReadOnlyList<KbInfo> _kbs = Array.Empty<KbInfo>();
    private string _entraOid = "";
    private int _activeRecurringCount = 0;
    private DateTime? _nextScheduledRun;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState != null)
        {
            var auth = await AuthState;
            _entraOid = auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                     ?? auth.User.FindFirst("oid")?.Value ?? "";
        }

        if (!string.IsNullOrEmpty(_entraOid))
        {
            var dbUser = await UserService.GetByEntraOidAsync(_entraOid);
            if (dbUser == null)
            {
                _logger.LogError("Could not resolve internal userId for entraOid {EntraOid}", _entraOid);
                return;
            }
            var internalUserId = dbUser.Id;
            try
            {
                var tasks = await TaskService.GetUserTasksAsync(internalUserId);
                _activeRecurringCount = tasks.Count(t => t.ScheduleType == "recurring" && t.IsActive);
                _nextScheduledRun = tasks
                    .Where(t => t.IsActive && t.NextRunAt.HasValue && t.NextRunAt > DateTime.UtcNow)
                    .OrderBy(t => t.NextRunAt)
                    .FirstOrDefault()?.NextRunAt;
            }
            catch { /* non-critical */ }
        }
    }

    private async Task HandleAgentReady()
    {
        _agentReady = true;
        await LoadKbsAsync();
        StateHasChanged();
    }

    private async Task LoadKbsAsync()
    {
        try
        {
            _kbs = await ForgeKbService.ListKbsAsync(_entraOid);
        }
        catch (Exception)
        {
            // KB list is non-critical — swallow errors, leave _kbs empty
        }
    }

    private static string FormatRelative(DateTime? dt)
    {
        if (dt is null) return "—";
        var diff = dt.Value - DateTime.UtcNow;
        if (diff.TotalMinutes is > 0 and < 60) return $"in {(int)diff.TotalMinutes}m";
        if (diff.TotalHours is > 0 and < 24) return $"in {(int)diff.TotalHours}h";
        if (diff.TotalDays > 0) return $"in {(int)diff.TotalDays}d";
        return dt.Value.ToLocalTime().ToString("MMM d");
    }
}

<style>
    .agent-cards-row { display:flex; gap:var(--spacing-sm,8px); padding:var(--spacing-sm,8px) 0; flex-wrap:wrap; }
    .agent-card { display:flex; flex-direction:column; align-items:center; gap:var(--spacing-xs,4px); padding:var(--spacing-sm,8px) var(--spacing-md,12px); border:1px solid var(--color-border); border-radius:var(--radius-md,8px); cursor:pointer; transition:background var(--transition-fast,0.15s); }
    .agent-card:hover { background:var(--color-surface-sunken,#f3f4f6); }
    .agent-card-active { border-color:var(--color-primary); background:var(--color-primary-light,#EEF2F7); }
    .agent-card-name { font-size:var(--text-xs,0.75rem); font-weight:500; color:var(--color-text-secondary); }
    .agent-card-icon { color:var(--color-primary); }
</style>
