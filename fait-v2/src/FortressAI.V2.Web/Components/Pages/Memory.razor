@page "/memory"
@attribute [Authorize]
@using FortressAI.V2.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.JSInterop
@implements IAsyncDisposable
@inject IMemoryFileService MemoryFileService
@inject IUserService UserService
@inject IJSRuntime JSRuntime
@inject ISnackbar Snackbar
@inject ILogger<Memory> Logger

<PageTitle>Memory — FAIT v2</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="fait-v2-page">
    <div class="memory-page__header">
        <div class="memory-page__header-text">
            <MudText Typo="Typo.h5" Class="fait-v2-page__title">Memory Management</MudText>
            <MudText Typo="Typo.body2" Class="fait-v2-page__subtitle">View and manage your AI assistant's memory.</MudText>
        </div>
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Download"
                   Disabled="@_exporting"
                   OnClick="ExportMemoryAsync"
                   Class="memory-export-btn">
            @if (_exporting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="memory-export-btn__spinner" />
            }
            else
            {
                <span>Export Memory</span>
            }
        </MudButton>
    </div>

    <MudPaper Class="fait-v2-placeholder-card" Elevation="0">
        <MudText Typo="Typo.body2" Color="Color.Secondary">Memory Management UI — coming in Phase B2</MudText>
    </MudPaper>
</MudContainer>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private string _userId = "";
    private bool _exporting = false;

    protected override async Task OnInitializedAsync()
    {
        if (AuthState == null) return;
        var auth = await AuthState;
        var entraOid = auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
                   ?? auth.User.FindFirst("oid")?.Value ?? "";
        var user = await UserService.GetByEntraOidAsync(entraOid);
        _userId = user?.Id ?? "";
        if (string.IsNullOrEmpty(_userId))
            Logger.LogError("Could not resolve internal userId for entraOid {EntraOid}", entraOid);
    }

    private async Task ExportMemoryAsync()
    {
        if (_exporting || string.IsNullOrEmpty(_userId)) return;
        _exporting = true;
        try
        {
            var bytes = await MemoryFileService.ExportZipAsync(_userId);
            var base64 = Convert.ToBase64String(bytes);
            var fileName = $"fait-memory-{_userId}-{DateTime.UtcNow:yyyyMMdd}.zip";
            await JSRuntime.InvokeVoidAsync("downloadBase64", fileName, "application/zip", base64);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Memory export failed for userId {UserId}", _userId);
            Snackbar.Add("Export failed: " + ex.Message, Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    public ValueTask DisposeAsync() => ValueTask.CompletedTask;
}

<style>
    .memory-page__header {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: var(--space-4, 16px);
        margin-bottom: var(--space-4, 16px);
    }

    .memory-page__header-text {
        display: flex;
        flex-direction: column;
    }

    .memory-export-btn {
        align-self: center;
        border-color: var(--fait-v2-primary);
        color: var(--fait-v2-primary);
        white-space: nowrap;
    }

    .memory-export-btn:hover:not(:disabled) {
        background-color: color-mix(in srgb, var(--fait-v2-primary) 8%, transparent);
    }

    .memory-export-btn__spinner {
        margin-right: var(--space-1, 4px);
    }
</style>
