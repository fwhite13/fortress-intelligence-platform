@page "/task-history"
@attribute [Authorize]
@using Microsoft.EntityFrameworkCore
@inject FaitV2DbContext Db
@inject AuthenticationStateProvider AuthState

<PageTitle>Task History — FAIT v2</PageTitle>

<div class="fait-v2-page task-history-page">
    <MudText Typo="Typo.h5" Class="task-history-page__title">Task History</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_tasks.Count == 0)
    {
        <div class="task-history-page__empty">
            <MudIcon Icon="@Icons.Material.Outlined.Assignment" Size="Size.Large" />
            <MudText Typo="Typo.body1">No tasks yet. Start a conversation to create your first task.</MudText>
        </div>
    }
    else
    {
        <MudList T="ConversationTask" Dense="true">
            @foreach (var task in _tasks)
            {
                <MudListItem T="ConversationTask">
                    <div class="task-history-page__item">
                        <MudIcon Icon="@Icons.Material.Outlined.Chat" Size="Size.Small" Class="task-history-page__item-icon" />
                        <div class="task-history-page__item-content">
                            <MudText Typo="Typo.body1">@task.Title</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@task.CreatedAt.ToString("MMM d, yyyy h:mm tt")</MudText>
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    }
</div>

@code {
    private List<ConversationTask> _tasks = new();
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthState.GetAuthenticationStateAsync();
        var entraOid = auth.User.FindFirst("oid")?.Value
                    ?? auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

        if (!string.IsNullOrEmpty(entraOid))
        {
            try
            {
                var user = await Db.Users.FirstOrDefaultAsync(u => u.EntraOid == entraOid);
                if (user != null)
                {
                    _tasks = await Db.ConversationTasks
                        .Where(t => t.UserId == user.Id)
                        .OrderByDescending(t => t.UpdatedAt)
                        .ToListAsync();
                }
            }
            catch { /* non-critical */ }
        }

        _loading = false;
    }
}
