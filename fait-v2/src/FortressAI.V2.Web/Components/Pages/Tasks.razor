@page "/tasks"
@attribute [Authorize]
@inject IScheduledTaskService TaskService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject Microsoft.AspNetCore.Components.Authorization.AuthenticationStateProvider AuthStateProvider

<PageTitle>Scheduled Tasks — FAIT v2</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="fait-v2-page">
    <div class="tasks-page__header">
        <div class="tasks-page__header-text">
            <MudText Typo="Typo.h5" Class="fait-v2-page__title">Scheduled Tasks</MudText>
            <MudText Typo="Typo.body2" Class="fait-v2-page__subtitle">Automate recurring work with your AI assistant.</MudText>
        </div>
        <MudButton Variant="Variant.Filled"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Outlined.Add"
                   Class="tasks-page__new-btn"
                   OnClick="OpenCreateDialog">
            New Task
        </MudButton>
    </div>

    @if (_loading)
    {
        <div class="tasks-page__loading">
            <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
        </div>
    }
    else
    {
        <MudTabs Elevation="0" Rounded="false" ApplyEffectsToContainer="true" Class="tasks-page__tabs">
            <MudTabPanel Text="Recurring" Icon="@Icons.Material.Outlined.Repeat" BadgeData="@_recurringCount" BadgeColor="Color.Primary">
                @if (_recurringTasks.Count == 0)
                {
                    <div class="tasks-page__empty">
                        <MudIcon Icon="@Icons.Material.Outlined.Repeat" Class="tasks-page__empty-icon" />
                        <MudText Typo="Typo.body1" Class="tasks-page__empty-text">No recurring tasks yet.</MudText>
                        <MudText Typo="Typo.body2" Class="tasks-page__empty-sub">Create a task with a cron schedule to run it automatically.</MudText>
                    </div>
                }
                else
                {
                    <div class="tasks-page__table-wrap">
                        <MudTable Items="_recurringTasks" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="tasks-page__table" Elevation="0">
                            <HeaderContent>
                                <MudTh>Task Name</MudTh>
                                <MudTh>Schedule</MudTh>
                                <MudTh>Next Run</MudTh>
                                <MudTh>Last Status</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Task Name">
                                    <span class="tasks-page__task-name">@context.Name</span>
                                </MudTd>
                                <MudTd DataLabel="Schedule">
                                    <span class="tasks-page__cron">@context.CronExpression</span>
                                </MudTd>
                                <MudTd DataLabel="Next Run">
                                    <span class="tasks-page__next-run">@FormatRelative(context.NextRunAt)</span>
                                </MudTd>
                                <MudTd DataLabel="Last Status">
                                    <MudChip T="string" Color="@StatusColor(context.LastRunStatus)" Size="Size.Small"
                                             Class="tasks-page__status-chip">
                                        @(context.LastRunStatus ?? "—")
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Actions">
                                    <div class="tasks-page__actions">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit"
                                                       Size="Size.Small"
                                                       title="Edit"
                                                       OnClick="() => OpenEditDialog(context)" />
                                        <MudIconButton Icon="@(context.IsActive ? Icons.Material.Outlined.PauseCircle : Icons.Material.Outlined.PlayCircle)"
                                                       Size="Size.Small"
                                                       title="@(context.IsActive ? "Pause" : "Resume")"
                                                       OnClick="() => ToggleActiveAsync(context)" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow"
                                                       Size="Size.Small"
                                                       title="Run Now"
                                                       OnClick="() => RunNowAsync(context)" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       title="Delete"
                                                       OnClick="() => ConfirmDeleteAsync(context)" />
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    @* Mobile card layout *@
                    <div class="tasks-page__card-list">
                        @foreach (var t in _recurringTasks)
                        {
                            <MudCard Class="tasks-page__card" Elevation="1">
                                <MudCardContent Class="tasks-page__card-content">
                                    <div class="tasks-page__card-row tasks-page__card-row--title">
                                        <span class="tasks-page__task-name">@t.Name</span>
                                        <MudChip T="string" Color="@StatusColor(t.LastRunStatus)" Size="Size.Small"
                                                 Class="tasks-page__status-chip">
                                            @(t.LastRunStatus ?? "—")
                                        </MudChip>
                                    </div>
                                    <div class="tasks-page__card-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.Schedule" Size="Size.Small" Class="tasks-page__card-meta-icon" />
                                        <span class="tasks-page__card-meta">@t.CronExpression</span>
                                    </div>
                                    <div class="tasks-page__card-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" Class="tasks-page__card-meta-icon" />
                                        <span class="tasks-page__card-meta">Next: @FormatRelative(t.NextRunAt)</span>
                                    </div>
                                </MudCardContent>
                                <MudCardActions Class="tasks-page__card-actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" title="Edit" OnClick="() => OpenEditDialog(t)" />
                                    <MudIconButton Icon="@(t.IsActive ? Icons.Material.Outlined.PauseCircle : Icons.Material.Outlined.PlayCircle)"
                                                   Size="Size.Small" title="@(t.IsActive ? "Pause" : "Resume")"
                                                   OnClick="() => ToggleActiveAsync(t)" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" title="Run Now" OnClick="() => RunNowAsync(t)" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" title="Delete" OnClick="() => ConfirmDeleteAsync(t)" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="On-Demand" Icon="@Icons.Material.Outlined.TouchApp" BadgeData="@_onDemandCount" BadgeColor="Color.Secondary">
                @if (_onDemandTasks.Count == 0)
                {
                    <div class="tasks-page__empty">
                        <MudIcon Icon="@Icons.Material.Outlined.TouchApp" Class="tasks-page__empty-icon" />
                        <MudText Typo="Typo.body1" Class="tasks-page__empty-text">No on-demand tasks yet.</MudText>
                        <MudText Typo="Typo.body2" Class="tasks-page__empty-sub">Create a task you can trigger manually whenever needed.</MudText>
                    </div>
                }
                else
                {
                    <div class="tasks-page__table-wrap">
                        <MudTable Items="_onDemandTasks" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="tasks-page__table" Elevation="0">
                            <HeaderContent>
                                <MudTh>Task Name</MudTh>
                                <MudTh>Schedule</MudTh>
                                <MudTh>Last Run</MudTh>
                                <MudTh>Last Status</MudTh>
                                <MudTh>Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Task Name">
                                    <span class="tasks-page__task-name">@context.Name</span>
                                </MudTd>
                                <MudTd DataLabel="Schedule">
                                    <span class="tasks-page__on-demand-label">On demand</span>
                                </MudTd>
                                <MudTd DataLabel="Last Run">
                                    <span class="tasks-page__next-run">@FormatRelative(context.LastRunAt)</span>
                                </MudTd>
                                <MudTd DataLabel="Last Status">
                                    <MudChip T="string" Color="@StatusColor(context.LastRunStatus)" Size="Size.Small"
                                             Class="tasks-page__status-chip">
                                        @(context.LastRunStatus ?? "—")
                                    </MudChip>
                                </MudTd>
                                <MudTd DataLabel="Actions">
                                    <div class="tasks-page__actions">
                                        <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" title="Edit" OnClick="() => OpenEditDialog(context)" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" title="Run Now" OnClick="() => RunNowAsync(context)" />
                                        <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" title="Delete" OnClick="() => ConfirmDeleteAsync(context)" />
                                    </div>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    <div class="tasks-page__card-list">
                        @foreach (var t in _onDemandTasks)
                        {
                            <MudCard Class="tasks-page__card" Elevation="1">
                                <MudCardContent Class="tasks-page__card-content">
                                    <div class="tasks-page__card-row tasks-page__card-row--title">
                                        <span class="tasks-page__task-name">@t.Name</span>
                                        <MudChip T="string" Color="@StatusColor(t.LastRunStatus)" Size="Size.Small"
                                                 Class="tasks-page__status-chip">
                                            @(t.LastRunStatus ?? "—")
                                        </MudChip>
                                    </div>
                                    <div class="tasks-page__card-row">
                                        <span class="tasks-page__on-demand-label">On demand</span>
                                    </div>
                                    @if (t.LastRunAt.HasValue)
                                    {
                                        <div class="tasks-page__card-row">
                                            <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" Class="tasks-page__card-meta-icon" />
                                            <span class="tasks-page__card-meta">Last run: @FormatRelative(t.LastRunAt)</span>
                                        </div>
                                    }
                                </MudCardContent>
                                <MudCardActions Class="tasks-page__card-actions">
                                    <MudIconButton Icon="@Icons.Material.Outlined.Edit" Size="Size.Small" title="Edit" OnClick="() => OpenEditDialog(t)" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.PlayArrow" Size="Size.Small" title="Run Now" OnClick="() => RunNowAsync(t)" />
                                    <MudIconButton Icon="@Icons.Material.Outlined.Delete" Size="Size.Small" Color="Color.Error" title="Delete" OnClick="() => ConfirmDeleteAsync(t)" />
                                </MudCardActions>
                            </MudCard>
                        }
                    </div>
                }
            </MudTabPanel>

            <MudTabPanel Text="History" Icon="@Icons.Material.Outlined.History">
                @if (_historyLoading)
                {
                    <div class="tasks-page__loading">
                        <MudProgressCircular Indeterminate="true" Size="Size.Medium" />
                    </div>
                }
                else if (_runHistory.Count == 0)
                {
                    <div class="tasks-page__empty">
                        <MudIcon Icon="@Icons.Material.Outlined.History" Class="tasks-page__empty-icon" />
                        <MudText Typo="Typo.body1" Class="tasks-page__empty-text">No run history yet.</MudText>
                        <MudText Typo="Typo.body2" Class="tasks-page__empty-sub">Task runs will appear here once your tasks execute.</MudText>
                    </div>
                }
                else
                {
                    <div class="tasks-page__table-wrap">
                        <MudTable Items="_runHistory" Hover="true" Breakpoint="Breakpoint.Sm"
                                  Class="tasks-page__table" Elevation="0">
                            <HeaderContent>
                                <MudTh>Task Name</MudTh>
                                <MudTh>Started</MudTh>
                                <MudTh>Duration</MudTh>
                                <MudTh>Status</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd DataLabel="Task Name">
                                    <span class="tasks-page__task-name">@(context.Task?.Name ?? context.TaskId)</span>
                                </MudTd>
                                <MudTd DataLabel="Started">
                                    <span class="tasks-page__run-started">@context.StartedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                </MudTd>
                                <MudTd DataLabel="Duration">
                                    <span class="tasks-page__run-duration">@FormatDuration(context)</span>
                                </MudTd>
                                <MudTd DataLabel="Status">
                                    <MudChip T="string" Color="@StatusColor(context.Status)" Size="Size.Small"
                                             Class="tasks-page__status-chip">
                                        @context.Status
                                    </MudChip>
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>

                    <div class="tasks-page__card-list">
                        @foreach (var r in _runHistory)
                        {
                            <MudCard Class="tasks-page__card" Elevation="1">
                                <MudCardContent Class="tasks-page__card-content">
                                    <div class="tasks-page__card-row tasks-page__card-row--title">
                                        <span class="tasks-page__task-name">@(r.Task?.Name ?? r.TaskId)</span>
                                        <MudChip T="string" Color="@StatusColor(r.Status)" Size="Size.Small" Class="tasks-page__status-chip">@r.Status</MudChip>
                                    </div>
                                    <div class="tasks-page__card-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.AccessTime" Size="Size.Small" Class="tasks-page__card-meta-icon" />
                                        <span class="tasks-page__card-meta">@r.StartedAt.ToLocalTime().ToString("MMM d, h:mm tt")</span>
                                    </div>
                                    <div class="tasks-page__card-row">
                                        <MudIcon Icon="@Icons.Material.Outlined.Timer" Size="Size.Small" Class="tasks-page__card-meta-icon" />
                                        <span class="tasks-page__card-meta">@FormatDuration(r)</span>
                                    </div>
                                </MudCardContent>
                            </MudCard>
                        }
                    </div>
                }
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private bool _historyLoading = false;
    private string _userId = string.Empty;

    private List<ScheduledTask> _recurringTasks = new();
    private List<ScheduledTask> _onDemandTasks = new();
    private List<ScheduledTaskRun> _runHistory = new();

    private int? _recurringCount => _recurringTasks.Count > 0 ? _recurringTasks.Count : null;
    private int? _onDemandCount => _onDemandTasks.Count > 0 ? _onDemandTasks.Count : null;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
               ?? auth.User.FindFirst("oid")?.Value ?? "";
        await LoadTasksAsync();
        await LoadHistoryAsync();
    }

    private async Task LoadTasksAsync()
    {
        _loading = true;
        try
        {
            var all = await TaskService.GetUserTasksAsync(_userId);
            _recurringTasks = all.Where(t => t.ScheduleType == "recurring").ToList();
            _onDemandTasks = all.Where(t => t.ScheduleType == "on_demand").ToList();
        }
        catch
        {
            Snackbar.Add("Failed to load tasks.", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadHistoryAsync()
    {
        if (string.IsNullOrEmpty(_userId)) return;
        _historyLoading = true;
        try
        {
            _runHistory = await TaskService.GetAllRunHistoryAsync(_userId, 50);
        }
        catch
        {
            /* non-critical */
        }
        finally
        {
            _historyLoading = false;
        }
    }

    private async Task OpenCreateDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<TaskEditDialog>
        {
            { x => x.Task, null },
            { x => x.UserId, _userId }
        };
        var dialog = await DialogService.ShowAsync<TaskEditDialog>("New Task", parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled)
            await LoadTasksAsync();
    }

    private async Task OpenEditDialog(ScheduledTask task)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<TaskEditDialog>
        {
            { x => x.Task, task },
            { x => x.UserId, _userId }
        };
        var dialog = await DialogService.ShowAsync<TaskEditDialog>("Edit Task", parameters, options);
        var result = await dialog.Result;
        if (!result!.Canceled)
            await LoadTasksAsync();
    }

    private async Task ToggleActiveAsync(ScheduledTask task)
    {
        try
        {
            await TaskService.UpdateTaskAsync(
                task.Id, _userId, task.Name, task.Prompt,
                task.CronExpression, !task.IsActive,
                task.AlertOnCompletion, task.AlertOnFailure);
            await LoadTasksAsync();
            Snackbar.Add(task.IsActive ? "Task paused." : "Task resumed.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to update task.", Severity.Error);
        }
    }

    private async Task RunNowAsync(ScheduledTask task)
    {
        try
        {
            await TaskService.TriggerNowAsync(task.Id, _userId);
            Snackbar.Add($"Task \"{task.Name}\" queued to run.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to trigger task.", Severity.Error);
        }
    }

    private async Task ConfirmDeleteAsync(ScheduledTask task)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseOnEscapeKey = true };
        var parameters = new DialogParameters<ConfirmDialog>
        {
            { x => x.Message, $"Delete task \"{task.Name}\"? This cannot be undone." }
        };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>("Delete Task", parameters, options);
        var result = await dialog.Result;
        if (result!.Canceled) return;

        try
        {
            await TaskService.DeleteTaskAsync(task.Id, _userId);
            await LoadTasksAsync();
            Snackbar.Add("Task deleted.", Severity.Success);
        }
        catch
        {
            Snackbar.Add("Failed to delete task.", Severity.Error);
        }
    }

    private static Color StatusColor(string? status) => status switch
    {
        "success" => Color.Success,
        "failed" => Color.Error,
        "running" => Color.Warning,
        "cancelled" => Color.Default,
        _ => Color.Default,
    };

    private static string FormatRelative(DateTime? dt)
    {
        if (dt is null) return "—";
        var diff = dt.Value - DateTime.UtcNow;
        if (Math.Abs(diff.TotalSeconds) < 60) return "just now";
        if (diff.TotalMinutes is > 0 and < 60) return $"in {(int)diff.TotalMinutes}m";
        if (diff.TotalHours is > 0 and < 24) return $"in {(int)diff.TotalHours}h";
        if (diff.TotalDays is > 0 and < 7) return $"in {(int)diff.TotalDays}d";
        if (diff.TotalMinutes is < 0 and > -60) return $"{(int)-diff.TotalMinutes}m ago";
        if (diff.TotalHours is < 0 and > -24) return $"{(int)-diff.TotalHours}h ago";
        if (diff.TotalDays is < 0 and > -7) return $"{(int)-diff.TotalDays}d ago";
        return dt.Value.ToLocalTime().ToString("MMM d");
    }

    private static string FormatDuration(ScheduledTaskRun run)
    {
        if (run.CompletedAt is null) return "Running...";
        var span = run.CompletedAt.Value - run.StartedAt;
        if (span.TotalSeconds < 60) return $"{(int)span.TotalSeconds}s";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m {span.Seconds}s";
        return $"{(int)span.TotalHours}h {span.Minutes}m";
    }
}
