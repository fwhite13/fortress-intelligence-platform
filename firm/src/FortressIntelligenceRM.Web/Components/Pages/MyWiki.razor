@page "/my-wiki"
@attribute [Authorize]
@inject IUserWikiService UserWikiService
@inject ISnackbar Snackbar
@inject IConfiguration Configuration
@inject AuthenticationStateProvider AuthStateProvider
@inject IDialogService DialogService
@using FortressIntelligenceRM.Web.Services
@using System.Security.Claims
@using MudBlazor
@inject BrandingConfig Branding

<PageTitle>My Wiki — @Branding.ModuleName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
        <MudText Typo="Typo.h5" Class="org-context-title">My Wiki</MudText>
        <MudSpacer />
        <MudIconButton Icon="@Icons.Material.Outlined.HelpOutline"
                       Style="color: var(--color-accent, #d4af37);"
                       Size="Size.Medium"
                       Title="Help"
                       OnClick="() => _helpOpen = true"
                       aria-label="Help" />
    </MudStack>
    <MudText Typo="Typo.body2" Class="mb-4 org-context-subtitle">
        Your personal knowledge base. Add terms, names, acronyms, and context that are specific to your work. These entries help the AI produce more accurate transcriptions and summaries for your meetings.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudPaper Class="pa-4 mb-4 org-context-card" Elevation="0">
            <div class="d-flex justify-space-between align-center mb-3">
                <MudText Typo="Typo.subtitle1" Class="org-context-section-title">
                    @(_entries.Count > 0 ? $"{_entries.Count} entries" : "")
                </MudText>
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Add"
                           OnClick="@(async () => await OpenAddDialog())"
                           Class="org-context-add-btn">
                    Add Entry
                </MudButton>
            </div>

            @if (_entries.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="org-context-empty mb-4">
                    No entries yet. Add terms and definitions that the AI should know about when processing your meetings — like team member names, project codenames, or industry jargon.
                </MudText>
            }
            else
            {
                <MudTable Items="_entries" Dense="true" Hover="true" Class="org-context-table mb-3">
                    <HeaderContent>
                        <MudTh>Term</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh Class="org-context-actions-col">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Term">@context.Term</MudTd>
                        <MudTd DataLabel="Description">@context.Description</MudTd>
                        <MudTd DataLabel="Actions">
                            <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                           Size="Size.Small"
                                           Color="Color.Default"
                                           OnClick="@(async () => await OpenEditDialog(context))"
                                           Title="Edit" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                           Size="Size.Small"
                                           Color="Color.Error"
                                           OnClick="@(() => DeleteEntry(context))"
                                           Title="Delete" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }

            @if (_updatedAt.HasValue)
            {
                <MudText Typo="Typo.caption" Class="org-context-timestamp mb-2">
                    Last updated: @_updatedAt.Value.ToString("MMM d, yyyy h:mm tt") UTC
                </MudText>
            }

            <MudButton Variant="Variant.Filled"
                       Color="Color.Warning"
                       OnClick="SaveAllAsync"
                       Disabled="_saving"
                       StartIcon="@Icons.Material.Filled.Save"
                       Class="mt-2 org-context-save-btn">
                @(_saving ? "Saving..." : "Save All")
            </MudButton>
        </MudPaper>
    }
</MudContainer>

<HelpDrawer @bind-IsOpen="_helpOpen" Title="My Wiki — Help">
    <MyWikiHelpContent />
</HelpDrawer>

@code {
    private List<OrgContextEntry> _entries = [];
    private DateTime? _updatedAt;
    private bool _loading = true;
    private bool _helpOpen = false;
    private bool _saving;

    private string _entraOid = "";
    private string _tenantId = "";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        _entraOid = user.FindFirst("oid")?.Value
            ?? user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value
            ?? "";

        _tenantId = user.FindFirst("tid")?.Value
            ?? user.FindFirst("http://schemas.microsoft.com/identity/claims/tenantid")?.Value
            ?? Configuration["Firm:GraphTenantId"]
            ?? "";

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            if (!string.IsNullOrEmpty(_entraOid) && !string.IsNullOrEmpty(_tenantId))
            {
                _entries = await UserWikiService.GetEntriesAsync(_entraOid, _tenantId);
                _updatedAt = await UserWikiService.GetUpdatedAtAsync(_entraOid, _tenantId);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load personal wiki: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenAddDialog()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<OrgContextEntryDialog>("Add Entry", options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: (string term, string description) })
        {
            _entries.Add(new OrgContextEntry(term, description));
            await SaveEntriesAsync();
        }
    }

    private async Task OpenEditDialog(OrgContextEntry entry)
    {
        var parameters = new DialogParameters<OrgContextEntryDialog> { { x => x.Entry, entry } };
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<OrgContextEntryDialog>("Edit Entry", parameters, options);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: (string term, string description) })
        {
            var idx = _entries.IndexOf(entry);
            if (idx >= 0)
                _entries[idx] = new OrgContextEntry(term, description);
            await SaveEntriesAsync();
        }
    }

    private void DeleteEntry(OrgContextEntry entry)
    {
        _entries.Remove(entry);
    }

    private async Task SaveEntriesAsync()
    {
        _saving = true;
        try
        {
            if (string.IsNullOrEmpty(_entraOid) || string.IsNullOrEmpty(_tenantId))
            {
                Snackbar.Add("User identity not available. Cannot save.", Severity.Error);
                return;
            }

            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            var updatedBy = user.FindFirst("preferred_username")?.Value
                ?? user.FindFirst(ClaimTypes.Email)?.Value
                ?? _entraOid;

            await UserWikiService.UpsertEntriesAsync(_entraOid, _tenantId, _entries, updatedBy);
            _updatedAt = DateTime.UtcNow;
            Snackbar.Add("Personal wiki saved successfully.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveAllAsync()
    {
        await SaveEntriesAsync();
    }
}
