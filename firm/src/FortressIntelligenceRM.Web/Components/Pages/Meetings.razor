@page "/meetings"
@attribute [Authorize]
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject MeetingService MeetingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<Meetings> Logger
@inject VpBotService VpBotService

@inject CalendarService CalendarService
@inject IJSRuntime JS

@implements IDisposable
@using FortressIntelligenceRM.Web.Models
@using FortressIntelligenceRM.Web.Services
@using System.Security.Claims
@using System.Net.Http.Json

<PageTitle>Meetings — FIRM</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <MudStack Row AlignItems="AlignItems.Center" Class="mb-6">
        <MudText Typo="Typo.h5" Style="color: var(--color-text-primary); font-weight: 600;">My Meetings</MudText>
        <MudSpacer />
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;" OnClick="OpenJoinDialog">
            Join Now
        </MudButton>
        <MudButton Variant="Variant.Outlined" Style="border-color: #d4af37; color: #d4af37;" StartIcon="@Icons.Material.Filled.Refresh" OnClick="LoadMeetings">
            Refresh
        </MudButton>
        <MudButton Variant="Variant.Outlined" Style="border-color: #d4af37; color: #d4af37;" OnClick="OpenAddMeetingDialog">
            Add a Meeting
        </MudButton>
    </MudStack>

    @if (!_calendarLoading && _upcomingMeetings?.Count > 0)
    {
        <MudText Typo="Typo.h6" Class="mb-2 mt-4" Style="color: var(--color-text-primary);">
            Upcoming Meetings
            <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                           Size="Size.Small"
                           OnClick="LoadUpcomingMeetingsAsync" />
        </MudText>
        <MudGrid Class="mb-4">
            @foreach (var upcomingCard in _upcomingMeetings)
            {
                <MudItem xs="12" sm="6" md="4">
                    <MudCard Outlined="true" Style="background: var(--color-bg-elevated);">
                        <MudCardContent>
                            <div class="d-flex align-center gap-2 mb-1">
                                <MudChip T="string"
                                         Color="@(upcomingCard.Platform == "teams" ? Color.Secondary : upcomingCard.Platform == "zoom" ? Color.Info : upcomingCard.Platform == "meet" ? Color.Success : Color.Default)"
                                         Size="Size.Small">
                                    @(upcomingCard.Platform == "teams" ? "Teams" : upcomingCard.Platform == "zoom" ? "Zoom" : upcomingCard.Platform == "meet" ? "Meet" : upcomingCard.Platform)
                                </MudChip>
                                <MudText Typo="Typo.subtitle2" Style="color: var(--color-text-primary);">@upcomingCard.Subject</MudText>
                            </div>
                            <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--color-text-secondary);">
                                @FormatEastern(upcomingCard.StartDateTime) – @FormatEasternTimeOnly(upcomingCard.EndDateTime)
                            </MudText>
                            <MudChip T="string"
                                     Color="@(upcomingCard.Platform == "teams" ? Color.Info : Color.Warning)"
                                     Size="Size.Small" Class="mb-1">
                                @upcomingCard.ModeText
                            </MudChip>
                        </MudCardContent>
                        <MudCardActions>
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => AddCalendarMeetingToFirm(upcomingCard))">
                                Add to FIRM →
                            </MudButton>
                        </MudCardActions>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Warning" Indeterminate />
    }
    else if (!_meetings.Any())
    {
        <MudPaper Style="background: var(--color-bg-page); padding: 60px; text-align: center;" Elevation="0">
            <MudIcon Icon="@Icons.Material.Filled.VideoCall" Style="color: var(--color-border); font-size: 64px;" />
            <MudText Typo="Typo.h6" Class="mt-4" Style="color: var(--color-text-secondary);">No meetings yet.</MudText>
            <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);" Class="mt-2">
                Click "Add a Meeting" to get started.
            </MudText>
        </MudPaper>
    }
    else
    {
        <MudTable Items="@(_meetings.Skip((_page - 1) * _pageSize).Take(_pageSize).ToList())"
                  Style="background: var(--color-bg-page);" Elevation="0" T="FirmMeeting">
            <HeaderContent>
                <MudTh Style="color: var(--color-text-secondary);">Title</MudTh>
                <MudTh Style="color: var(--color-text-secondary);">Date</MudTh>
                <MudTh Style="color: var(--color-text-secondary);">Duration</MudTh>
                <MudTh Style="color: var(--color-text-secondary);">Status</MudTh>
                <MudTh Style="color: var(--color-text-secondary);">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Title">
                    <MudText Style="color: var(--color-text-primary);">@(context.Title ?? $"Meeting — {context.CreatedAt:yyyy-MM-dd}")</MudText>
                </MudTd>
                <MudTd DataLabel="Date">
                    <MudText Style="color: var(--color-text-secondary);">@context.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")</MudText>
                </MudTd>
                <MudTd DataLabel="Duration">
                    <MudText Style="color: var(--color-text-secondary);">@FormatDuration(context.DurationSeconds)</MudText>
                </MudTd>
                <MudTd DataLabel="Status">
                    @StatusBadge(context.Status)
                    @if (_calendarRemovedMeetingIds.Contains(context.Id))
                    {
                        <MudChip T="string" Color="Color.Warning" Size="Size.Small">⚠️ Removed from calendar</MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudStack Row>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility"
                                       Style="color: var(--color-gold);" Size="Size.Small"
                                       OnClick="@(() => Navigation.NavigateTo($"/meetings/{context.Id}"))" />
                        @if (context.Status == MeetingStatus.Complete)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Download"
                                           Style="color: var(--color-text-secondary);" Size="Size.Small"
                                           Href="@($"/api/meetings/{context.Id}/transcript/download")" />
                        }
                        @if (context.Status == MeetingStatus.Scheduled)
                        {
                            <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                       OnClick="@(() => JoinNow(context.Id))">Join Now</MudButton>
                        }
                        @if (context.Status is MeetingStatus.Scheduled or MeetingStatus.Complete or MeetingStatus.Failed)
                        {
                            <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                       OnClick="@(() => RemoveMeeting(context.Id))">Remove</MudButton>
                        }
                        else if (context.Status is MeetingStatus.Pending or MeetingStatus.Joining or MeetingStatus.Recording or MeetingStatus.WaitingTranscript or MeetingStatus.Transcribing or MeetingStatus.Summarizing)
                        {
                            <MudTooltip Text="Already in progress">
                                <MudButton Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined" Disabled="true">Join Now</MudButton>
                            </MudTooltip>
                            @if (context.Status == MeetingStatus.Recording)
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Outlined"
                                           OnClick="@(() => StopRecording(context.Id))"
                                           Disabled="@_stoppingMeetingIds.Contains(context.Id)">
                                    @(_stoppingMeetingIds.Contains(context.Id) ? "Stopping..." : "Stop Recording")
                                </MudButton>
                            }
                        }
                    </MudStack>
                </MudTd>
            </RowTemplate>
        </MudTable>

        @if (_meetings.Count > _pageSize)
        {
            <MudPagination Count="@((_meetings.Count + _pageSize - 1) / _pageSize)"
                           @bind-Selected="_page" Class="mt-4" />
        }
    }
</MudContainer>


@code {
    private List<FirmMeeting> _meetings = new();
    private bool _loading = true;
    private bool _joining = false;
    private int _page = 1;
    private const int _pageSize = 20;
    private string? _userId;
    private string? _entraOid;
    private string? _userEmail;
    private System.Threading.Timer? _pollTimer;
    private int _startupPollCount = 0;
    private List<UpcomingMeetingCard>? _upcomingMeetings;
    private bool _calendarLoading = true;
    private HashSet<long> _calendarRemovedMeetingIds = new();
    private HashSet<long> _stoppingMeetingIds = new();
    private Dictionary<string, string> _localStartTimes = new();
    private Dictionary<string, string> _localEndTimes = new();
    private Dictionary<long, string> _localCreatedTimes = new();


    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            // Log all claims for diagnostics
            var claimsList = string.Join(", ", user.Claims.Select(c => $"{c.Type.Split('/').Last()}={c.Value}"));
            Logger.LogInformation("FIRM Meetings: claims = {Claims}", claimsList);

            var entraOid = user.FindFirst("oid")?.Value
                ?? user.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;

            if (entraOid != null)
            {
                var email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                    ?? user.FindFirst("email")?.Value
                    ?? "";

                if (string.IsNullOrEmpty(email))
                {
                    var preferredUsername = user.FindFirst("preferred_username")?.Value ?? "";
                    // Only use preferred_username if it's a full email address (Cognito may return bare username like "fwhite")
                    if (preferredUsername.Contains('@'))
                        email = preferredUsername;
                }
                var displayName = user.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value
                    ?? user.FindFirst("name")?.Value ?? email;
                try
                {
                    var firmUser = await MeetingService.GetOrCreateUserAsync(entraOid, email, displayName);
                    _userId = firmUser?.Id.ToString();
                    _entraOid = entraOid;
                    _userEmail = email;
                    Logger.LogInformation("FIRM Meetings: resolved userId={UserId} for entraOid={OID}", _userId, entraOid);

                }
                catch (Exception dbEx)
                {
                    Logger.LogError(dbEx, "FIRM Meetings: GetOrCreateUserAsync failed for entraOid={OID}", entraOid);
                    Snackbar.Add("Error loading user profile. Please refresh.", Severity.Error);
                }
            }
            else
            {
                Logger.LogWarning("FIRM Meetings: entraOid not found in claims. User cannot load meetings.");
                Snackbar.Add("Unable to identify user. Please sign out and sign in again.", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM Meetings: error resolving user in OnInitializedAsync");
            Snackbar.Add("Error loading user profile. Please refresh.", Severity.Error);
        }
        finally
        {
            // Always load (or show empty state) — never leave _loading = true
            await LoadUpcomingMeetingsAsync();
            await LoadMeetings();
        }
        StartPolling();
    }

    private async Task LoadMeetings()
    {
        _loading = true;
        try
        {
            if (_userId == null)
            {
                _meetings = new();
                return;
            }
            _meetings = await MeetingService.GetMeetingsAsync(Guid.Parse(_userId));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM Meetings: error loading meetings for user {UserId}", _userId);
            Snackbar.Add($"Failed to load meetings: {ex.Message}", Severity.Error);
            _meetings = new();
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadUpcomingMeetingsAsync()
    {
        _calendarLoading = true;
        try
        {
            if (string.IsNullOrEmpty(_entraOid) || string.IsNullOrEmpty(_userEmail))
            {
                _calendarLoading = false;
                return;
            }
            var calendarMeetings = await CalendarService.GetUpcomingCalendarMeetingsAsync(_entraOid, _userEmail);
            _upcomingMeetings = calendarMeetings.Select(c => new UpcomingMeetingCard
            {
                CalendarEventId = c.CalendarEventId,
                Subject = c.Subject,
                StartDateTime = c.StartDateTime,
                EndDateTime = c.EndDateTime,
                JoinUrl = c.JoinUrl,
                Platform = c.Platform,
                ModeHint = c.Mode,
                ModeText = c.ModeText,
                Mode = c.Mode
            }).ToList();

            var calendarEventIds = _upcomingMeetings.Select(c => c.CalendarEventId).Where(id => !string.IsNullOrEmpty(id)).ToHashSet();
            _calendarRemovedMeetingIds = _meetings
                .Where(m => m.Status == MeetingStatus.Scheduled
                         && !string.IsNullOrEmpty(m.CalendarEventId)
                         && !calendarEventIds.Contains(m.CalendarEventId))
                .Select(m => m.Id)
                .ToHashSet();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FIRM: failed to load upcoming meetings from calendar");
        }
        finally
        {
            _calendarLoading = false;
        }
    }

    private async Task OpenJoinDialogPrefilled(string joinUrl)
    {
        var parameters = new DialogParameters { { "PrefilledUrl", joinUrl } };
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<JoinMeetingDialog>("Join Now", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ValueTuple<string, string?, string, string?> data)
        {
            await JoinMeetingWithParams(data.Item1, data.Item2);
        }
    }

    internal class UpcomingMeetingCard
    {
        public string CalendarEventId { get; set; } = "";
        public string Subject { get; set; } = "";
        public string StartDateTime { get; set; } = "";
        public string EndDateTime { get; set; } = "";
        public string JoinUrl { get; set; } = "";
        public string Platform { get; set; } = "";
        public string ModeHint { get; set; } = "";
        public string ModeText { get; set; } = "";
        public string Mode { get; set; } = "B";
    }

    private void StartPolling()
    {
        _pollTimer = new System.Threading.Timer(async _ =>
        {
            _startupPollCount++;
            var hasActive = _meetings.Any(m =>
                m.Status is MeetingStatus.Joining or MeetingStatus.Recording
                    or MeetingStatus.Transcribing or MeetingStatus.Summarizing);
            // Poll unconditionally for first 6 cycles (~60s startup window),
            // then revert to conditional polling based on active meetings
            if (_startupPollCount <= 6 || hasActive)
            {
                await LoadMeetings();
                await InvokeAsync(StateHasChanged);
            }
        }, null, TimeSpan.FromSeconds(10), TimeSpan.FromSeconds(10));
    }

    private async Task OpenJoinDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<JoinMeetingDialog>("Join Now", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ValueTuple<string, string?, string, string?> data)
        {
            await JoinMeetingWithParams(data.Item1, data.Item2);
        }
    }

    private async Task JoinMeetingWithParams(string meetingUrl, string? meetingTitle)
    {
        if (string.IsNullOrWhiteSpace(meetingUrl)) return;
        _joining = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await JoinMeetingDirectAsync(meetingUrl, meetingTitle);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in JoinMeetingWithParams for URL {Url}", meetingUrl);
            Snackbar.Add("Something went wrong — please try again.", Severity.Error);
        }
        finally
        {
            _joining = false;
        }
    }

    private async Task OpenAddMeetingDialog()
    {
        var options = new DialogOptions
        {
            CloseOnEscapeKey = true,
            MaxWidth = MaxWidth.Small,
            FullWidth = true
        };
        var dialog = await DialogService.ShowAsync<AddMeetingDialog>("Add a Meeting", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is ValueTuple<string, string?, DateTime, bool, string?> data)
        {
            await ScheduleMeetingWithParams(data.Item1, data.Item2, data.Item3, data.Item5);
        }
    }

    private async Task ScheduleMeetingWithParams(string meetingUrl, string? meetingTitle, DateTime scheduledDatetime, string? mode = null)
    {
        if (string.IsNullOrWhiteSpace(meetingUrl)) return;
        _joining = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await JoinMeetingDirectAsync(meetingUrl, meetingTitle, scheduledDatetime, mode: mode);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Exception in ScheduleMeetingWithParams for URL {Url}", meetingUrl);
            Snackbar.Add("Something went wrong — please try again.", Severity.Error);
        }
        finally
        {
            _joining = false;
        }
    }

    private static string FormatDuration(int? seconds)
    {
        if (!seconds.HasValue) return "—";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h {ts.Minutes}m" : $"{ts.Minutes} min";
    }

    private static readonly TimeZoneInfo _easternTz =
        TimeZoneInfo.FindSystemTimeZoneById("America/New_York");

    private static string FormatEastern(string isoUtc)
    {
        if (!DateTime.TryParse(isoUtc, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            return isoUtc;
        // Graph returns datetimes without 'Z' suffix — force UTC kind so ConvertTimeFromUtc works correctly
        var utc = parsed.Kind == DateTimeKind.Utc ? parsed : DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
        var eastern = TimeZoneInfo.ConvertTimeFromUtc(utc, _easternTz);
        return eastern.ToString("ddd MMM d · h:mm tt") + " ET";
    }

    private static string FormatEasternTimeOnly(string isoUtc)
    {
        if (!DateTime.TryParse(isoUtc, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsed))
            return isoUtc;
        // Graph returns datetimes without 'Z' suffix — force UTC kind so ConvertTimeFromUtc works correctly
        var utc = parsed.Kind == DateTimeKind.Utc ? parsed : DateTime.SpecifyKind(parsed, DateTimeKind.Utc);
        var eastern = TimeZoneInfo.ConvertTimeFromUtc(utc, _easternTz);
        return eastern.ToString("h:mm tt") + " ET";
    }

    private RenderFragment StatusBadge(MeetingStatus status) => builder =>
    {
        var (color, label) = status switch
        {
            MeetingStatus.Joining => ("#2196f3", "Joining"),
            MeetingStatus.Recording => ("#ff9800", "Recording"),
            MeetingStatus.Transcribing => ("#9c27b0", "Transcribing"),
            MeetingStatus.Summarizing => ("#00bcd4", "Summarizing"),
            MeetingStatus.Complete => ("#4caf50", "Complete"),
            MeetingStatus.Failed => ("#f44336", "Failed"),
            MeetingStatus.Scheduled => ("#607d8b", "Scheduled"),
            _ => ("#607d8b", status.ToString())
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style",
            $"background: {color}22; color: {color}; border: 1px solid {color}44; " +
            "padding: 2px 10px; border-radius: 12px; font-size: 12px; font-weight: 500;");
        builder.AddContent(2, label);
        builder.CloseElement();
    };

    private async Task JoinMeetingDirectAsync(string meetingUrl, string? title, DateTime? startDatetime = null, string? calendarEventId = null, string? mode = null)
    {
        if (string.IsNullOrEmpty(_userId))
        {
            Snackbar.Add("User identity not resolved. Please refresh the page.", Severity.Error);
            Logger.LogError("FIRM: JoinMeetingDirectAsync called with null _userId — identity not resolved at load");
            return;
        }
        var meeting = await MeetingService.CreateMeetingAsync(Guid.Parse(_userId), meetingUrl, title, startDatetime, calendarEventId);
        if (!string.IsNullOrEmpty(mode))
            await MeetingService.UpdateModeAsync(meeting.Id, mode);

        if (startDatetime.HasValue && startDatetime.Value.ToUniversalTime() > DateTime.UtcNow.AddMinutes(5))
        {
            await MeetingService.UpdateStatusAsync(meeting.Id, MeetingStatus.Scheduled);
            Snackbar.Add("Meeting scheduled!", Severity.Success);
        }
        else
        {
            try
            {
                var taskArn = await VpBotService.TriggerBotAsync(meeting.Id, meetingUrl);
                if (taskArn == null)
                {
                    // TriggerBotAsync returned null — ECS launch failed (it logged internally)
                    await MeetingService.UpdateStatusAsync(meeting.Id, MeetingStatus.Scheduled);
                    await InvokeAsync(() =>
                    {
                        Snackbar.Add("Bot failed to launch — meeting reset to Scheduled. Please try again.", Severity.Error);
                        StateHasChanged();
                    });
                }
                else
                {
                    await InvokeAsync(() =>
                    {
                        Snackbar.Add("Bot is joining!", Severity.Success);
                        StateHasChanged();
                    });
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "FIRM: TriggerBotAsync threw for meeting {Id}", meeting.Id);
                try
                {
                    await MeetingService.UpdateStatusAsync(meeting.Id, MeetingStatus.Scheduled);
                }
                catch (Exception dbEx)
                {
                    Logger.LogError(dbEx, "FIRM: Failed to reset meeting {Id} status to Scheduled after bot launch failure", meeting.Id);
                }
                await InvokeAsync(() =>
                {
                    Snackbar.Add("Bot failed to launch — meeting reset to Scheduled. Please try again.", Severity.Error);
                    StateHasChanged();
                });
            }
        }

        await LoadMeetings();
    }

    private async Task JoinNow(long meetingId)
    {
        if (string.IsNullOrEmpty(_userId))
        {
            Snackbar.Add("User identity not resolved. Please refresh the page.", Severity.Error);
            return;
        }
        try
        {
            var meeting = await MeetingService.GetMeetingAsync(meetingId, Guid.Parse(_userId));
            if (meeting == null)
            {
                Snackbar.Add("Meeting not found.", Severity.Error);
                return;
            }
            if (meeting.Status != MeetingStatus.Scheduled)
            {
                Snackbar.Add($"Meeting is not in Scheduled state (current: {meeting.Status}).", Severity.Warning);
                return;
            }

            if (meeting.Platform == "teams")
            {
                await MeetingService.UpdateStatusAsync(meetingId, MeetingStatus.WaitingTranscript);
                Snackbar.Add("Mode A meeting — start the Teams meeting when ready. FIRM will capture the transcript automatically.", Severity.Info);
            }
            else
            {
                var taskArn = await VpBotService.TriggerBotAsync(meetingId, meeting.MeetingUrl ?? "");
                if (taskArn == null)
                {
                    // TriggerBotAsync returned null — ECS launch failed (it logged internally)
                    Snackbar.Add("Failed to launch recording bot. Please try again.", Severity.Error);
                    return;
                }
                await MeetingService.UpdateStatusAsync(meetingId, MeetingStatus.Pending);
                Snackbar.Add("Bot is joining!", Severity.Success);
            }

            await LoadMeetings();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM: JoinNow failed for meeting {Id}", meetingId);
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task RemoveMeeting(long meetingId)
    {
        try
        {
            var http = HttpClientFactory.CreateClient("local");
            var response = await http.DeleteAsync($"/api/meetings/{meetingId}");
            if (response.IsSuccessStatusCode)
            {
                await LoadMeetings();
                Snackbar.Add("Meeting removed.", Severity.Success);
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed to remove meeting: {error}", Severity.Error);
                Logger.LogError("FIRM: RemoveMeeting failed for meeting {Id} — HTTP {Status}: {Body}",
                    meetingId, (int)response.StatusCode, error);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM: RemoveMeeting threw for meeting {Id}", meetingId);
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private async Task StopRecording(long meetingId)
    {
        _stoppingMeetingIds.Add(meetingId);
        await InvokeAsync(StateHasChanged);
        try
        {
            var http = HttpClientFactory.CreateClient("local");
            var response = await http.PostAsync($"/api/vp/stop/{meetingId}", null);
            var body = await response.Content.ReadAsStringAsync();
            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add("Stop signal sent. Recording will finish processing shortly.", Severity.Info);
            }
            else
            {
                Snackbar.Add($"Could not send stop signal: {body}", Severity.Warning);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM: StopRecording failed for meeting {Id}", meetingId);
            Snackbar.Add("Error sending stop signal. Please try again.", Severity.Error);
        }
        finally
        {
            _stoppingMeetingIds.Remove(meetingId);
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task AddCalendarMeetingToFirm(UpcomingMeetingCard card)
    {
        // For future meetings (> 5 min), POST directly to create Scheduled record
        // Graph returns datetimes without 'Z' suffix — force UTC kind for correct comparison
        if (DateTime.TryParse(card.StartDateTime, null, System.Globalization.DateTimeStyles.RoundtripKind, out var parsedStart))
        {
            var start = parsedStart.Kind == DateTimeKind.Utc ? parsedStart : DateTime.SpecifyKind(parsedStart, DateTimeKind.Utc);
            if (start > DateTime.UtcNow.AddMinutes(5))
            {
                try
                {
                    await JoinMeetingDirectAsync(card.JoinUrl, card.Subject, start, card.CalendarEventId, mode: card.Mode);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Exception in AddCalendarMeetingToFirm for card {CalendarEventId}", card.CalendarEventId);
                    Snackbar.Add("Something went wrong — please try again.", Severity.Error);
                }
                return;
            }
        }
        // Imminent/past meeting (or unparseable) — open dialog for immediate join
        await OpenJoinDialogPrefilled(card.JoinUrl);
    }

    public void Dispose() => _pollTimer?.Dispose();
}
