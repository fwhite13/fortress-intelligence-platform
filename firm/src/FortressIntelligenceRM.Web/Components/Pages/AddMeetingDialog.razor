@using MudBlazor
@using FortressIntelligenceRM.Web.Services
@inject BrandingConfig Branding
@inject IJSRuntime JS

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--color-text-primary);">Add a Meeting</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="MeetingUrl" Label="Meeting URL"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined"
                      Placeholder="https://teams.microsoft.com/l/meetup-join/..."
                      Required Class="mb-3"
                      Immediate="true"
                      @bind-Value:after="OnUrlChanged" />

        @if (_showHostToggle)
        {
            @* WI #9680: Mode A is mothballed (Firm:EnableModeA=false), so the "are you the host" choice that
               only picked Mode A is gone; every meeting added here uses the Notetaker (bot) path. *@
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3" Icon="@Icons.Material.Filled.Business">
                @Branding.OrgName-hosted Teams meeting detected — @Branding.NotetakerName will join to record.
            </MudAlert>
        }

        <MudTextField @bind-Value="MeetingTitle" Label="Meeting Title (optional)"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined"
                      Class="mb-3" />

        <MudText Typo="Typo.body2" Class="mt-2 mb-1" Style="color: var(--color-text-secondary);">
            Scheduled time (required)
        </MudText>
        <div class="d-flex gap-2 mb-1">
            <MudDatePicker @bind-Date="_startDate" Label="Date" Variant="Variant.Outlined"
                           Class="flex-1" MinDate="DateTime.Today"
                           Required
                           @bind-Date:after="RefreshTimezoneOffsetAsync" />
            <MudTimePicker @bind-Time="_startTime" Label="Time" Variant="Variant.Outlined"
                           Class="flex-1" AmPm="true"
                           Required
                           @bind-Time:after="RefreshTimezoneOffsetAsync" />
        </div>

        @if (_validationError != null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                @_validationError
            </MudAlert>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: var(--color-text-secondary);">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                   OnClick="Submit" Disabled="@(!IsValid())">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string MeetingUrl { get; set; } = "";
    [Parameter] public string? MeetingTitle { get; set; }

    private DateTime? _startDate;
    private TimeSpan? _startTime;
    private string? _validationError;
    private bool _showHostToggle = false;
    // Browser's minutes-behind-UTC (EDT = 240). The server runs in UTC, so the entered
    // date/time must be shifted by the *browser's* offset, not the server's local zone.
    private int _tzOffsetMinutes = 0;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await RefreshTimezoneOffsetAsync();
        StateHasChanged();
    }

    private async Task RefreshTimezoneOffsetAsync()
    {
        try
        {
            // Ask for the offset on the selected date so a meeting across a DST boundary
            // uses that day's offset, not today's.
            string? localIso = _startDate != null && _startTime != null
                ? (_startDate.Value.Date + _startTime.Value).ToString("yyyy-MM-ddTHH:mm")
                : null;
            _tzOffsetMinutes = await JS.InvokeAsync<int>("firmUtils.getTimezoneOffset", localIso);
        }
        catch (JSDisconnectedException) { }
        catch (JSException) { /* keep last known offset */ }
    }

    private void OnUrlChanged()
    {
        var tenantId = CalendarService.ExtractTenantIdFromUrl(MeetingUrl);
        _showHostToggle = !string.IsNullOrEmpty(tenantId) && Branding.IsHomeTenant(tenantId)
                          && MeetingUrl.Contains("teams.microsoft.com");
    }

    // WI #9680: always Mode B (the Notetaker joins), like JoinMeetingDialog: Mode A is mothballed.
    private static string GetDetectedMode() => "B";

    private DateTime? GetScheduledDatetime()
    {
        if (_startDate == null || _startTime == null) return null;
        var localDt = _startDate.Value.Date + _startTime.Value;
        // Apply browser timezone offset to convert local → UTC
        return DateTime.SpecifyKind(localDt.AddMinutes(_tzOffsetMinutes), DateTimeKind.Utc);
    }

    private bool IsValid()
    {
        if (string.IsNullOrWhiteSpace(MeetingUrl)) return false;
        var dt = GetScheduledDatetime();
        if (dt == null) return false;
        return dt.Value > DateTime.UtcNow.AddMinutes(5);
    }

    private void Submit()
    {
        _validationError = null;
        if (string.IsNullOrWhiteSpace(MeetingUrl))
        {
            _validationError = "Meeting URL is required.";
            return;
        }
        // WI #8575: strip pasted prefix text ("Join: https://...") and reject non-URLs inline.
        var cleanedUrl = CalendarService.ExtractMeetingUrl(MeetingUrl);
        if (cleanedUrl == null)
        {
            _validationError = MeetingService.InvalidMeetingUrlError;
            return;
        }
        var dt = GetScheduledDatetime();
        if (dt == null)
        {
            _validationError = "Please select a date and time.";
            return;
        }
        if (dt.Value <= DateTime.UtcNow.AddMinutes(5))
        {
            _validationError = "Use Join Now for immediate recording.";
            return;
        }
        var mode = GetDetectedMode();
        const bool isHost = false; // WI #9680: no host choice any more (it only picked Mode A); tuple shape kept for Meetings.razor
        MudDialog.Close(DialogResult.Ok((cleanedUrl, MeetingTitle, dt.Value, isHost, mode)));
    }

    private void Cancel() => MudDialog.Cancel();
}
