@using MudBlazor

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: #e8edf2;">Join a Meeting</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="MeetingUrl" Label="Teams Meeting URL"
                      Style="color: #e8edf2;" Variant="Variant.Outlined"
                      Placeholder="https://teams.microsoft.com/l/meetup-join/..."
                      Required Class="mb-3" />
        <MudTextField @bind-Value="MeetingTitle" Label="Meeting Title (optional)"
                      Style="color: #e8edf2;" Variant="Variant.Outlined" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: #8899aa;">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                   OnClick="Submit">
            Join Now
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string MeetingUrl { get; set; } = "";
    [Parameter] public string? MeetingTitle { get; set; }

    private void Submit() => MudDialog.Close(DialogResult.Ok((MeetingUrl, MeetingTitle)));
    private void Cancel() => MudDialog.Cancel();
}
