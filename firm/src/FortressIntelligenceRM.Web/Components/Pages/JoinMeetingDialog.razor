@using MudBlazor
@using FortressIntelligenceRM.Web.Services
@inject BrandingConfig Branding

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--color-text-primary);">Add a Meeting</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="MeetingUrl" Label="Meeting URL"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined"
                      Placeholder="https://teams.microsoft.com/l/meetup-join/..."
                      Required Class="mb-3"
                      Immediate="true" />

        @if (!string.IsNullOrWhiteSpace(MeetingUrl))
        {
            @if (DetectPlatform(MeetingUrl) == "teams")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Videocam">
                    Teams meeting detected — @Branding.NotetakerName will join to record.
                </MudAlert>
            }
            else if (DetectPlatform(MeetingUrl) == "zoom")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.SmartToy">
                    Zoom meeting detected — @Branding.NotetakerName will join as a participant to record.
                </MudAlert>
            }
            else if (DetectPlatform(MeetingUrl) == "meet")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.SmartToy">
                    Google Meet detected — @Branding.NotetakerName will join as a participant to record.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Warning">
                    Platform not recognized — please verify the meeting link.
                </MudAlert>
            }
        }

        <MudTextField @bind-Value="MeetingTitle" Label="Meeting Title (optional)"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined" />

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: var(--color-text-secondary);">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                   OnClick="Submit">
            Join Now
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string MeetingUrl { get; set; } = "";
    [Parameter] public string? MeetingTitle { get; set; }
    [Parameter] public string? PrefilledUrl { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(PrefilledUrl) && string.IsNullOrEmpty(MeetingUrl))
        {
            MeetingUrl = PrefilledUrl;
        }
    }

    private string DetectPlatform(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "unknown";
        if (url.Contains("teams.microsoft.com")) return "teams";
        if (url.Contains("zoom.us/j/")) return "zoom";
        if (url.Contains("meet.google.com/")) return "meet";
        return "unknown";
    }

    private void Submit()
    {
        var platform = DetectPlatform(MeetingUrl);
        // Mode B always — Mode A is mothballed
        string? effectiveMode = platform == "unknown" ? null : "B";

        MudDialog.Close(DialogResult.Ok((MeetingUrl, MeetingTitle, platform, effectiveMode)));
    }

    private void Cancel() => MudDialog.Cancel();
}
