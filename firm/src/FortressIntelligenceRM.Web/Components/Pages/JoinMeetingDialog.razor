@using MudBlazor
@using FortressIntelligenceRM.Web.Services

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--color-text-primary);">Add a Meeting</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="MeetingUrl" Label="Meeting URL"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined"
                      Placeholder="https://teams.microsoft.com/l/meetup-join/..."
                      Required Class="mb-3"
                      Immediate="true"
                      @bind-Value:after="OnUrlChanged" />

        @if (!string.IsNullOrWhiteSpace(MeetingUrl))
        {
            @if (DetectPlatform(MeetingUrl) == "teams")
            {
                <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true" Icon="@Icons.Material.Filled.Videocam">
                    Teams meeting detected.
                </MudAlert>
                @if (_showHostToggle)
                {
                    <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2" Icon="@Icons.Material.Filled.Business">
                        Fortress-hosted meeting detected.
                    </MudAlert>
                    <div class="d-flex align-center gap-3 mb-3">
                        <MudText Typo="Typo.body2" Style="color: var(--color-text-primary);">Are you the host?</MudText>
                        <MudToggleGroup T="string" @bind-Value="_isHostValue" SelectionMode="SelectionMode.SingleSelection">
                            <MudToggleItem Value="@("yes")" Text="Yes" />
                            <MudToggleItem Value="@("no")" Text="No" />
                        </MudToggleGroup>
                    </div>
                    <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);" Class="mb-2">
                        @if (_isHostValue == "yes")
                        {
                            <span>Mode A — FIRM captures transcript directly (no bot).</span>
                        }
                        else
                        {
                            <span>Mode B — Fortress Notetaker will join.</span>
                        }
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Style="color: var(--color-text-secondary);" Class="mb-3">
                        Fortress Notetaker will join to record.
                    </MudText>
                }
            }
            else if (DetectPlatform(MeetingUrl) == "zoom")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.SmartToy">
                    Zoom meeting detected — Fortress Notetaker will join as a participant to record.
                </MudAlert>
            }
            else if (DetectPlatform(MeetingUrl) == "meet")
            {
                <MudAlert Severity="Severity.Info" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.SmartToy">
                    Google Meet detected — Fortress Notetaker will join as a participant to record.
                </MudAlert>
            }
            else
            {
                <MudAlert Severity="Severity.Warning" Class="mb-3" Dense="true" Icon="@Icons.Material.Filled.Warning">
                    Platform not recognized — please verify the meeting link.
                </MudAlert>
            }
        }

        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => _showOverride = !_showOverride)"
                   Style="color: var(--color-text-secondary);" Class="mb-2">
            @(_showOverride ? "Hide Override ▲" : "Override ▾")
        </MudButton>

        @if (_showOverride)
        {
            <MudSelect @bind-Value="_platformOverride" Label="Platform Override" Variant="Variant.Outlined"
                       Class="mb-3" Style="color: var(--color-text-primary);">
                <MudSelectItem Value="@("auto")">Auto-detect</MudSelectItem>
                <MudSelectItem Value="@("teams-native")">Teams — native transcript (Mode A)</MudSelectItem>
                <MudSelectItem Value="@("teams-bot")">Teams — Fortress Notetaker (Mode B)</MudSelectItem>
                <MudSelectItem Value="@("zoom")">Zoom — Fortress Notetaker</MudSelectItem>
                <MudSelectItem Value="@("meet")" Disabled="true">Google Meet (coming soon)</MudSelectItem>
            </MudSelect>
        }

        <MudTextField @bind-Value="MeetingTitle" Label="Meeting Title (optional)"
                      Style="color: var(--color-text-primary);" Variant="Variant.Outlined" />

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: var(--color-text-secondary);">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                   OnClick="Submit">
            Join Now
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public string MeetingUrl { get; set; } = "";
    [Parameter] public string? MeetingTitle { get; set; }
    [Parameter] public string? PrefilledUrl { get; set; }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(PrefilledUrl) && string.IsNullOrEmpty(MeetingUrl))
        {
            MeetingUrl = PrefilledUrl;
            OnUrlChanged();
        }
    }

    private bool _showOverride = false;
    private string _platformOverride = "auto";
    private bool _showHostToggle = false;
    private string _isHostValue = "no";

    private void OnUrlChanged()
    {
        var tenantId = CalendarService.ExtractTenantIdFromUrl(MeetingUrl);
        _showHostToggle = !string.IsNullOrEmpty(tenantId) && CalendarService.IsFortressTenant(tenantId)
                          && MeetingUrl.Contains("teams.microsoft.com");
        if (!_showHostToggle) _isHostValue = "no";
    }

    private string DetectPlatform(string url)
    {
        if (string.IsNullOrWhiteSpace(url)) return "unknown";
        if (url.Contains("teams.microsoft.com")) return "teams";
        if (url.Contains("zoom.us/j/")) return "zoom";
        if (url.Contains("meet.google.com/")) return "meet";
        return "unknown";
    }

    private void Submit()
    {
        string effectivePlatform;
        string? effectiveMode;

        if (_platformOverride != "auto")
        {
            effectivePlatform = _platformOverride.Replace("teams-native", "teams").Replace("teams-bot", "teams");
            effectiveMode = _platformOverride == "teams-native" ? "A" : "B";
        }
        else
        {
            effectivePlatform = DetectPlatform(MeetingUrl);
            if (effectivePlatform == "teams")
            {
                var tenantId = CalendarService.ExtractTenantIdFromUrl(MeetingUrl);
                effectiveMode = (CalendarService.IsFortressTenant(tenantId) && _isHostValue == "yes") ? "A" : "B";
            }
            else
            {
                effectiveMode = effectivePlatform == "unknown" ? null : "B";
            }
        }

        MudDialog.Close(DialogResult.Ok((MeetingUrl, MeetingTitle, effectivePlatform, effectiveMode)));
    }

    private void Cancel() => MudDialog.Cancel();
}
