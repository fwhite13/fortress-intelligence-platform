@page "/meetings/{Id:long}"
@attribute [Authorize]
@inject MeetingService MeetingService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject ILogger<MeetingDetail> Logger
@inject IHttpClientFactory HttpClientFactory
@using FortressIntelligenceRM.Web.Models
@using FortressIntelligenceRM.Web.Services
@using System.Security.Claims
@using System.Text.Json

<PageTitle>@(_meeting?.Title ?? "Meeting") — FIRM</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/meetings" Style="color: var(--color-text-secondary);" Class="mb-4">
        Back to Meetings
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Warning" Indeterminate />
    }
    else if (_meeting == null)
    {
        <MudAlert Severity="Severity.Error" Style="background: var(--color-bg-card); color: #ff6b6b;">
            Meeting not found or you don't have permission to view it.
        </MudAlert>
    }
    else
    {
        <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-bottom: 24px;" Elevation="0">
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h5" Style="color: var(--color-text-primary); font-weight: 600;">
                    @(_meeting.Title ?? $"Meeting — {_meeting.CreatedAt:yyyy-MM-dd}")
                </MudText>
                <MudSpacer />
                @StatusBadge(_meeting.Status)
            </MudStack>
            <MudStack Row Class="mb-4" Style="gap: 24px; flex-wrap: wrap;">
                <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                    @_meeting.CreatedAt.ToLocalTime().ToString("MMM d, yyyy h:mm tt")
                </MudText>
                @if (_meeting.DurationSeconds.HasValue)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        @FormatDuration(_meeting.DurationSeconds)
                    </MudText>
                }
                <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">Teams</MudText>
                @if (_meeting.Participants.Any())
                {
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        @string.Join(", ", _meeting.Participants.Select(p => p.DisplayName))
                    </MudText>
                }
            </MudStack>

            @if (_meeting.Status == MeetingStatus.Failed && !string.IsNullOrEmpty(_meeting.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Style="background: var(--color-bg-card); color: #ff6b6b;" Class="mb-3">
                    @_meeting.ErrorMessage
                </MudAlert>
            }

            @if (_meeting.Status == MeetingStatus.Complete)
            {
                <MudStack Row Style="gap: 12px; flex-wrap: wrap;">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                               Style="border-color: var(--color-gold); color: var(--color-gold);"
                               Href="@($"/api/meetings/{_meeting.Id}/transcript/download")">
                        Transcript
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                               Style="border-color: var(--color-gold); color: var(--color-gold);"
                               Href="@($"/api/meetings/{_meeting.Id}/summary/download")">
                        Summary
                    </MudButton>
                    @if (!string.IsNullOrEmpty(_meeting.AudioS3Key))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AudioFile"
                                   Style="border-color: var(--color-border); color: var(--color-text-secondary);"
                                   OnClick="DownloadAudio">
                            Audio
                        </MudButton>
                    }
                </MudStack>
                <SharePanel MeetingId="@_meeting.Id" />
            }
        </MudPaper>

        <MudTabs Elevation="0" Style="background: transparent;">
            <MudTabPanel Text="Summary" Style="color: var(--color-text-primary);">
                <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-top: 8px;" Elevation="0">
                    @if (_meeting.Summary == null)
                    {
                        <MudText Style="color: var(--color-text-secondary); text-align: center; padding: 40px 0;">
                            @if (_meeting.Status is MeetingStatus.Summarizing or MeetingStatus.Transcribing
                                or MeetingStatus.Recording or MeetingStatus.Joining)
                            {
                                <span>Summary will be available when the meeting completes.</span>
                            }
                            else
                            {
                                <span>No summary available.</span>
                            }
                        </MudText>
                    }
                    else
                    {
                        @if (!string.IsNullOrEmpty(_meeting.Summary.SummaryText))
                        {
                            <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Overview</MudText>
                            <MudText Style="color: var(--color-text-primary); line-height: 1.7;" Class="mb-6">
                                @_meeting.Summary.SummaryText
                            </MudText>
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.KeyDecisionsJson))
                        {
                            var decisions = TryDeserializeStringList(_meeting.Summary.KeyDecisionsJson);
                            @if (decisions.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Key Decisions</MudText>
                                <MudList T="string" Style="margin-bottom: 24px;">
                                    @foreach (var d in decisions)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />@d
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.ActionItemsJson))
                        {
                            var items = TryDeserializeActionItems(_meeting.Summary.ActionItemsJson);
                            @if (items.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Action Items</MudText>
                                <MudList T="string" Style="margin-bottom: 24px;">
                                    @foreach (var item in items)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                            @if (!string.IsNullOrEmpty(item.Owner))
                                            {
                                                <strong style="color: var(--color-gold);">[@item.Owner]</strong>
                                                <span> @item.Description</span>
                                            }
                                            else { @item.Description }
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.FollowUpsJson))
                        {
                            var followUps = TryDeserializeStringList(_meeting.Summary.FollowUpsJson);
                            @if (followUps.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Follow-ups</MudText>
                                <MudList T="string">
                                    @foreach (var f in followUps)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mr-2" />@f
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                    }
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Transcript" Style="color: var(--color-text-primary);">
                <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-top: 8px;" Elevation="0">
                    @if (!_meeting.Transcripts.Any())
                    {
                        <MudText Style="color: var(--color-text-secondary); text-align: center; padding: 40px 0;">
                            No transcript available yet.
                        </MudText>
                    }
                    else
                    {
                        <MudTable Items="_meeting.Transcripts" Style="background: transparent;" Elevation="0"
                                  FixedHeader Height="500px">
                            <HeaderContent>
                                <MudTh Style="color: var(--color-text-secondary); width: 100px;">Time</MudTh>
                                <MudTh Style="color: var(--color-text-secondary); width: 160px;">Speaker</MudTh>
                                <MudTh Style="color: var(--color-text-secondary);">Text</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Style="color: var(--color-text-secondary); font-size: 12px; font-family: monospace;">
                                    @FormatTimestamp(context.StartTimeMs)
                                </MudTd>
                                <MudTd Style="color: var(--color-gold); font-size: 13px; font-weight: 500;">
                                    @(context.SpeakerName ?? context.SpeakerLabel ?? "Unknown")
                                </MudTd>
                                <MudTd Style="color: var(--color-text-primary); font-size: 14px; line-height: 1.5;">
                                    @context.Text
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public long Id { get; set; }
    private FirmMeeting? _meeting;
    private bool _loading = true;
    private bool _pushingTranscript = false;
    private bool _pushingSummary = false;

    // KB push status (loaded from /kb-status on init)
    private HashSet<string> _transcriptPushedTo = new();
    private HashSet<string> _summaryPushedTo = new();

    // KB selection state
    private bool _transcriptSelectPersonal = true;
    private bool _transcriptSelectTeam = false;
    private bool _summarySelectPersonal = true;
    private bool _summarySelectTeam = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var claimsUser = authState.User;
            var entraOid = claimsUser.FindFirst("oid")?.Value
                ?? claimsUser.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
            if (string.IsNullOrEmpty(entraOid)) { Navigation.NavigateTo("/"); return; }

            var email = claimsUser.FindFirst(ClaimTypes.Email)?.Value
                ?? claimsUser.FindFirst("email")?.Value
                ?? claimsUser.FindFirst("preferred_username")?.Value ?? "";
            var displayName = claimsUser.FindFirst(ClaimTypes.Name)?.Value
                ?? claimsUser.FindFirst("name")?.Value ?? email;
            FortressIntelligenceRM.Web.Models.FirmUser? user = null;
            try
            {
                user = await MeetingService.GetOrCreateUserAsync(entraOid, email, displayName);
            }
            catch (Exception dbEx)
            {
                Logger.LogError(dbEx, "FIRM MeetingDetail: GetOrCreateUserAsync failed for entraOid={OID}", entraOid);
                Snackbar.Add("Error loading user profile. Please refresh.", Severity.Error);
                return;
            }
            if (user == null) { Navigation.NavigateTo("/meetings"); return; }

            _meeting = await MeetingService.GetMeetingAsync(Id, user.Id);

            // Load KB push status
            if (_meeting != null && _meeting.Status == MeetingStatus.Complete)
            {
                try
                {
                    var http = HttpClientFactory.CreateClient("local");
                    var kbStatusResp = await http.GetFromJsonAsync<KbStatusResponse>($"/api/meetings/{Id}/kb-status");
                    if (kbStatusResp != null)
                    {
                        _transcriptPushedTo = kbStatusResp.Transcript?.ToHashSet() ?? new();
                        _summaryPushedTo    = kbStatusResp.Summary?.ToHashSet() ?? new();
                    }
                }
                catch { /* Non-fatal */ }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: error in OnInitializedAsync for meeting {MeetingId}", Id);
            Snackbar.Add("Error loading meeting. Please refresh.", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private void DownloadAudio()
    {
        if (_meeting == null) return;
        Navigation.NavigateTo($"/api/meetings/{_meeting.Id}/audio", forceLoad: true);
    }

    private bool TranscriptHasSelection() =>
        (_transcriptSelectPersonal && !_transcriptPushedTo.Contains("personal")) ||
        (_transcriptSelectTeam     && !_transcriptPushedTo.Contains("team"));

    private bool SummaryHasSelection() =>
        (_summarySelectPersonal && !_summaryPushedTo.Contains("personal")) ||
        (_summarySelectTeam     && !_summaryPushedTo.Contains("team"));

    private async Task PushTranscript()
    {
        if (_pushingTranscript || _meeting == null) return;
        _pushingTranscript = true;
        try
        {
            var scopes = new List<string>();
            if (_transcriptSelectPersonal && !_transcriptPushedTo.Contains("personal")) scopes.Add("personal");
            if (_transcriptSelectTeam     && !_transcriptPushedTo.Contains("team"))     scopes.Add("team");
            if (!scopes.Any()) return;

            var http = HttpClientFactory.CreateClient("local");
            var resp = await http.PostAsJsonAsync($"/api/meetings/{_meeting.Id}/push-to-kb",
                new { docType = "transcript", kbScopes = scopes });
            if (resp.IsSuccessStatusCode)
            {
                foreach (var s in scopes) _transcriptPushedTo.Add(s);
                Snackbar.Add($"Transcript added to {string.Join(" + ", scopes.Select(s => s == "personal" ? "My KB" : "Team KB"))}!", Severity.Success);
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed: {body}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _pushingTranscript = false; StateHasChanged(); }
    }

    private async Task PushSummary()
    {
        if (_pushingSummary || _meeting == null) return;
        _pushingSummary = true;
        try
        {
            var scopes = new List<string>();
            if (_summarySelectPersonal && !_summaryPushedTo.Contains("personal")) scopes.Add("personal");
            if (_summarySelectTeam     && !_summaryPushedTo.Contains("team"))     scopes.Add("team");
            if (!scopes.Any()) return;

            var http = HttpClientFactory.CreateClient("local");
            var resp = await http.PostAsJsonAsync($"/api/meetings/{_meeting.Id}/push-to-kb",
                new { docType = "summary", kbScopes = scopes });
            if (resp.IsSuccessStatusCode)
            {
                foreach (var s in scopes) _summaryPushedTo.Add(s);
                Snackbar.Add($"Summary added to {string.Join(" + ", scopes.Select(s => s == "personal" ? "My KB" : "Team KB"))}!", Severity.Success);
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                Snackbar.Add($"Failed: {body}", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add($"Error: {ex.Message}", Severity.Error); }
        finally { _pushingSummary = false; StateHasChanged(); }
    }

    private record KbStatusResponse(List<string>? Transcript, List<string>? Summary);

    private static string FormatDuration(int? seconds)
    {
        if (!seconds.HasValue) return "";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h {ts.Minutes}m" : $"{ts.Minutes} min";
    }

    private static string FormatTimestamp(long? ms)
    {
        if (!ms.HasValue) return "00:00:00";
        return TimeSpan.FromMilliseconds(ms.Value).ToString(@"hh\:mm\:ss");
    }

    private static List<string> TryDeserializeStringList(string json)
    {
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch { return new(); }
    }

    private static List<ActionItemDisplay> TryDeserializeActionItems(string json)
    {
        try { return JsonSerializer.Deserialize<List<ActionItemDisplay>>(json) ?? new(); }
        catch { return new(); }
    }

    private record ActionItemDisplay(string? Description, string? Owner);

    private RenderFragment StatusBadge(MeetingStatus status) => builder =>
    {
        var (color, label) = status switch
        {
            MeetingStatus.Joining => ("#2196f3", "Joining"),
            MeetingStatus.Recording => ("#ff9800", "Recording"),
            MeetingStatus.Transcribing => ("#9c27b0", "Transcribing"),
            MeetingStatus.Summarizing => ("#00bcd4", "Summarizing"),
            MeetingStatus.Complete => ("#4caf50", "Complete"),
            MeetingStatus.Failed => ("#f44336", "Failed"),
            MeetingStatus.Scheduled => ("#607d8b", "Scheduled"),
            _ => ("#607d8b", status.ToString())
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style",
            $"background: {color}22; color: {color}; border: 1px solid {color}44; " +
            "padding: 4px 14px; border-radius: 12px; font-size: 13px; font-weight: 500;");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
}
