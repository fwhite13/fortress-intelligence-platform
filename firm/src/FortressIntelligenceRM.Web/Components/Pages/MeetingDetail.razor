@page "/meetings/{Id:long}"
@attribute [Authorize]
@inject MeetingService MeetingService
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ISnackbar Snackbar
@inject ILogger<MeetingDetail> Logger
@inject FirmKbService FirmKbService
@inject IJSRuntime JS
@inject IConfiguration Configuration
@inject IMindmapService MindmapService
@inject IFaitV2IntegrationService FaitV2Service
@using FortressIntelligenceRM.Web.Models
@using FortressIntelligenceRM.Web.Services
@using System.Security.Claims
@using System.Text.Json
@using System.Text.Json.Serialization

<PageTitle>@(_meeting?.Title ?? "Meeting") — FIRM</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="pa-6">
    <MudButton StartIcon="@Icons.Material.Filled.ArrowBack"
               Href="/meetings" Style="color: var(--color-text-secondary);" Class="mb-4">
        Back to Meetings
    </MudButton>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Warning" Indeterminate />
    }
    else if (_meeting == null)
    {
        <MudAlert Severity="Severity.Error" Style="background: var(--color-bg-card); color: #ff6b6b;">
            Meeting not found or you don't have permission to view it.
        </MudAlert>
    }
    else
    {
        <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-bottom: 24px;" Elevation="0">
            <MudStack Row AlignItems="AlignItems.Center" Class="mb-2">
                <MudText Typo="Typo.h5" Style="color: var(--color-text-primary); font-weight: 600;">
                    @(_meeting.Title ?? $"Meeting — {_meeting.CreatedAt:yyyy-MM-dd}")
                </MudText>
                <MudSpacer />
                @StatusBadge(_meeting.Status)
            </MudStack>
            <MudStack Row Class="mb-4" Style="gap: 24px; flex-wrap: wrap;">
                <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                    @(_localCreatedAt ?? _meeting.CreatedAt.ToString("MMM d, yyyy h:mm tt"))
                </MudText>
                @if (_meeting.DurationSeconds.HasValue)
                {
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        @FormatDuration(_meeting.DurationSeconds)
                    </MudText>
                }
                <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">Teams</MudText>
                @if (_meeting.Participants.Any())
                {
                    <MudText Typo="Typo.body2" Style="color: var(--color-text-secondary);">
                        @string.Join(", ", _meeting.Participants.Select(p => p.DisplayName))
                    </MudText>
                }
            </MudStack>

            @if (_meeting.Status == MeetingStatus.Failed && !string.IsNullOrEmpty(_meeting.ErrorMessage))
            {
                <MudAlert Severity="Severity.Error" Style="background: var(--color-bg-card); color: #ff6b6b;" Class="mb-3">
                    @_meeting.ErrorMessage
                </MudAlert>
            }

            @if (_meeting.Status == MeetingStatus.Complete)
            {
                <MudStack Row Style="gap: 12px; flex-wrap: wrap;">
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                               Style="border-color: var(--color-gold); color: var(--color-gold);"
                               Href="@($"/api/meetings/{_meeting.Id}/transcript/download")">
                        Transcript
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download"
                               Style="border-color: var(--color-gold); color: var(--color-gold);"
                               Href="@($"/api/meetings/{_meeting.Id}/summary/download")">
                        Summary
                    </MudButton>
                    @if (!string.IsNullOrEmpty(_meeting.AudioS3Key))
                    {
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AudioFile"
                                   Style="border-color: var(--color-border); color: var(--color-text-secondary);"
                                   OnClick="DownloadAudio">
                            Audio
                        </MudButton>
                    }
                    @if (_isAdmin && !string.IsNullOrEmpty(_meeting.AudioS3Key))
                    {
                        <MudButton Variant="Variant.Outlined"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Color="Color.Warning"
                                   Disabled="_retranscribing"
                                   OnClick="RetranscribeAsync">
                            @(_retranscribing ? "Retranscribing..." : "Retranscribe")
                        </MudButton>
                    }
                </MudStack>
                @if (_retranscribeError != null)
                {
                    <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">@_retranscribeError</MudAlert>
                }
                @if (CanSendToFaitV2)
                {
                    <div class="mt-3">
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   StartIcon="@Icons.Material.Outlined.Send"
                                   OnClick="SendToFaitV2"
                                   Disabled="_isSending">
                            @(_isSending ? "Sending..." : "Send to FAIT v2 Assistant")
                        </MudButton>
                        @if (_sendResult != null)
                        {
                            <MudAlert Severity="@(_sendSuccess ? Severity.Success : Severity.Error)"
                                      Dense="true" Class="mt-2">
                                @_sendResult
                            </MudAlert>
                        }
                    </div>
                }
                <SharePanel MeetingId="@_meeting.Id" />
            }
        </MudPaper>

        <MudTabs Elevation="0" Style="background: transparent;">
            <MudTabPanel Text="Summary" Style="color: var(--color-text-primary);">
                <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-top: 8px;" Elevation="0">
                    @if (_meeting.Summary == null)
                    {
                        <MudText Style="color: var(--color-text-secondary); text-align: center; padding: 40px 0;">
                            @if (_meeting.Status is MeetingStatus.Summarizing or MeetingStatus.Transcribing
                                or MeetingStatus.Recording or MeetingStatus.Joining)
                            {
                                <span>Summary will be available when the meeting completes.</span>
                            }
                            else
                            {
                                <span>No summary available.</span>
                            }
                        </MudText>
                    }
                    else if (!string.IsNullOrEmpty(_meeting.Summary.SummaryText))
                    {
                        <div class="firm-summary-markdown">
                            @RenderMarkdown(_meeting.Summary.SummaryText)
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_meeting.Summary.KeyDecisionsJson) ||
                             !string.IsNullOrEmpty(_meeting.Summary.ActionItemsJson))
                    {
                        @* Legacy fallback: structured sections for pre-#1723 meetings that lack SummaryText *@
                        @if (!string.IsNullOrEmpty(_meeting.Summary.KeyDecisionsJson))
                        {
                            var decisions = TryDeserializeStringList(_meeting.Summary.KeyDecisionsJson);
                            @if (decisions.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Key Decisions</MudText>
                                <MudList T="string" Style="margin-bottom: 24px;">
                                    @foreach (var d in decisions)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" Class="mr-2" />@d
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.ActionItemsJson))
                        {
                            var items = TryDeserializeActionItems(_meeting.Summary.ActionItemsJson);
                            @if (items.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Action Items</MudText>
                                <MudList T="string" Style="margin-bottom: 24px;">
                                    @foreach (var item in items)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.AssignmentTurnedIn" Color="Color.Warning" Size="Size.Small" Class="mr-2" />
                                            @if (!string.IsNullOrEmpty(item.Owner))
                                            {
                                                <strong style="color: var(--color-gold);">[@item.Owner]</strong>
                                                <span> @item.Description</span>
                                            }
                                            else { @item.Description }
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.FollowUpsJson))
                        {
                            var followUps = TryDeserializeStringList(_meeting.Summary.FollowUpsJson);
                            @if (followUps.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Follow-ups</MudText>
                                <MudList T="string">
                                    @foreach (var f in followUps)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="mr-2" />@f
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                        @if (!string.IsNullOrEmpty(_meeting.Summary.OpenQuestionsJson))
                        {
                            var openQuestions = TryDeserializeStringList(_meeting.Summary.OpenQuestionsJson);
                            @if (openQuestions.Any())
                            {
                                <MudText Typo="Typo.h6" Style="color: var(--color-gold);" Class="mb-2">Open Questions</MudText>
                                <MudList T="string">
                                    @foreach (var q in openQuestions)
                                    {
                                        <MudListItem T="string" Style="color: var(--color-text-primary);">
                                            <MudIcon Icon="@Icons.Material.Filled.HelpOutline" Size="Size.Small" Class="mr-2" />@q
                                        </MudListItem>
                                    }
                                </MudList>
                            }
                        }
                    }
                    else
                    {
                        <MudText Style="color: var(--color-text-secondary); text-align: center; padding: 40px 0;">
                            No summary available.
                        </MudText>
                    }
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Transcript" Style="color: var(--color-text-primary);">
                <MudPaper Style="background: var(--color-bg-page); padding: 24px; margin-top: 8px;" Elevation="0">
                    @if (!_meeting.Transcripts.Any())
                    {
                        <MudText Style="color: var(--color-text-secondary); text-align: center; padding: 40px 0;">
                            No transcript available yet.
                        </MudText>
                    }
                    else
                    {
                        <MudTable Items="_meeting.Transcripts" Style="background: transparent;" Elevation="0"
                                  FixedHeader Height="500px">
                            <HeaderContent>
                                <MudTh Style="color: var(--color-text-secondary); width: 100px;">Time</MudTh>
                                <MudTh Style="color: var(--color-text-secondary); width: 160px;">Speaker</MudTh>
                                <MudTh Style="color: var(--color-text-secondary);">Text</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd Style="color: var(--color-text-secondary); font-size: 12px; font-family: monospace;">
                                    @FormatTimestamp(context.StartTimeMs)
                                </MudTd>
                                <MudTd Style="color: var(--color-gold); font-size: 13px; font-weight: 500;">
                                    @(context.SpeakerName ?? context.SpeakerLabel ?? "Unknown")
                                </MudTd>
                                <MudTd Style="color: var(--color-text-primary); font-size: 14px; line-height: 1.5;">
                                    @context.Text
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    }
                </MudPaper>
            </MudTabPanel>

            <MudTabPanel Text="Mind Map" Style="color: var(--color-text-primary);" OnClick="OnMindMapTabSelected">
                <MudPaper Class="pa-4" Style="background: transparent;" Elevation="0">
                    @if (_meeting!.Status != MeetingStatus.Complete)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">Mind map will be available when the meeting completes.</MudText>
                    }
                    else if (_mindmapLoading)
                    {
                        <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    }
                    else if (_mindmapError != null)
                    {
                        <MudText Color="Color.Error" Typo="Typo.body2">@_mindmapError</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-2" OnClick="RegenerateMindmap">Regenerate</MudButton>
                    }
                    else
                    {
                        @if (_mindmapJson == null)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">No mind map yet.</MudText>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="RegenerateMindmap">Generate Mind Map</MudButton>
                        }
                        else
                        {
                            <div style="display: flex; justify-content: flex-end; gap: 8px; margin-bottom: 8px;">
                                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" OnClick="RegenerateMindmap">Regenerate</MudButton>
                                <MudButton Variant="Variant.Text" Color="Color.Default" Size="Size.Small" Href="@($"/api/meetings/{_meeting.Id}/mindmap/export?format=freemind")" Target="_blank">Export .mm</MudButton>
                            </div>
                        }
                        @* Container always in DOM once meeting is complete — JS needs it present before render *@
                        <div id="mindmap-container" style="width: 100%; height: 520px; border-radius: 8px; overflow: hidden; @(_mindmapJson == null ? "display:none;" : "")"></div>
                    }
                </MudPaper>
            </MudTabPanel>
        </MudTabs>
    }
</MudContainer>

@code {
    [Parameter] public long Id { get; set; }
    private FirmMeeting? _meeting;
    private bool _loading = true;
    private string? _localCreatedAt;
    private bool _pushingTranscript = false;
    private bool _pushingSummary = false;
    private bool _isAdmin = false;
    private bool _retranscribing = false;
    private string? _retranscribeError = null;
    private string? _mindmapJson = null;
    private bool _mindmapLoading = false;
    private string? _mindmapError = null;
    private bool _mindmapTabOpened = false;
    private FortressIntelligenceRM.Web.Models.FirmUser? _user;

    // KB push status (loaded from /kb-status on init)
    private HashSet<string> _transcriptPushedTo = new();
    private HashSet<string> _summaryPushedTo = new();

    // FAIT v2 push state
    private bool _isSending = false;
    private string? _sendResult;
    private bool _sendSuccess;

    private bool CanSendToFaitV2 =>
        _meeting?.Status == MeetingStatus.Complete &&
        (_isAdmin || (_user != null && _meeting?.CreatorEntraOid != null &&
            string.Equals(_meeting.CreatorEntraOid, _user.EntraOid, StringComparison.OrdinalIgnoreCase)));

    // KB selection state
    private bool _transcriptSelectPersonal = true;
    private bool _transcriptSelectTeam = false;
    private bool _summarySelectPersonal = true;
    private bool _summarySelectTeam = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var claimsUser = authState.User;
            var entraOid = claimsUser.FindFirst("oid")?.Value
                ?? claimsUser.FindFirst("http://schemas.microsoft.com/identity/claims/objectidentifier")?.Value;
            if (string.IsNullOrEmpty(entraOid)) { Navigation.NavigateTo("/"); return; }

            var email = claimsUser.FindFirst(ClaimTypes.Email)?.Value
                ?? claimsUser.FindFirst("email")?.Value
                ?? claimsUser.FindFirst("preferred_username")?.Value ?? "";
            var displayName = claimsUser.FindFirst(ClaimTypes.Name)?.Value
                ?? claimsUser.FindFirst("name")?.Value ?? email;
            FortressIntelligenceRM.Web.Models.FirmUser? user = null;
            try
            {
                user = await MeetingService.GetOrCreateUserAsync(entraOid, email, displayName);
            }
            catch (Exception dbEx)
            {
                Logger.LogError(dbEx, "FIRM MeetingDetail: GetOrCreateUserAsync failed for entraOid={OID}", entraOid);
                Snackbar.Add("Error loading user profile. Please refresh.", Severity.Error);
                return;
            }
            if (user == null) { Navigation.NavigateTo("/meetings"); return; }
            _user = user;

            // Admin check — same pattern as OrgContext.razor
            var adminOid = Configuration["Firm:AdminEntraOid"];
            var adminOids = (adminOid ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
            _isAdmin = adminOids.Any(oid => string.Equals(oid, entraOid, StringComparison.OrdinalIgnoreCase))
                       || claimsUser.IsInRole("admin")
                       || claimsUser.IsInRole("Admin")
                       || claimsUser.HasClaim("roles", "admin");

            _meeting = await MeetingService.GetMeetingAsync(Id, user.Id);

            // Load KB push status
            if (_meeting != null && _meeting.Status == MeetingStatus.Complete)
            {
                try
                {
                    _transcriptPushedTo = await FirmKbService.GetPushedScopesAsync(Id, "transcript");
                    _summaryPushedTo    = await FirmKbService.GetPushedScopesAsync(Id, "summary");
                }
                catch { /* Non-fatal */ }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: error in OnInitializedAsync for meeting {MeetingId}", Id);
            Snackbar.Add("Error loading meeting. Please refresh.", Severity.Error);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        if (_meeting?.CreatedAt != null)
        {
            try
            {
                _localCreatedAt = await JS.InvokeAsync<string>("firmUtils.formatLocalDateTime",
                    _meeting.CreatedAt.ToUniversalTime().ToString("O"));
                StateHasChanged();
            }
            catch { /* JS not ready — leave _localCreatedAt null, fallback in markup */ }
        }
    }

    private void DownloadAudio()
    {
        if (_meeting == null) return;
        Navigation.NavigateTo($"/api/meetings/{_meeting.Id}/audio", forceLoad: true);
    }

    private async Task RetranscribeAsync()
    {
        if (_meeting == null || _user == null || _retranscribing) return;

        var confirmed = await JS.InvokeAsync<bool>("confirm",
            $"Retranscribe meeting '{_meeting.Title}'? This will overwrite the existing transcript and summary.");

        if (!confirmed) return;

        _retranscribing = true;
        _retranscribeError = null;
        StateHasChanged();

        try
        {
            var (success, error) = await MeetingService.RetranscribeAsync(_meeting.Id, _user.Id);

            if (success)
            {
                // Reload meeting to get updated status
                _meeting = await MeetingService.GetMeetingAsync(_meeting.Id, _user.Id) ?? _meeting;
                Snackbar.Add("Retranscription started. Check back in a few minutes.", Severity.Success);

                // Background poll — check every 10s for up to 10 minutes
                _ = Task.Run(async () =>
                {
                    for (int i = 0; i < 60; i++)
                    {
                        await Task.Delay(10_000);
                        var updated = await MeetingService.GetMeetingAsync(_meeting.Id, _user!.Id);
                        if (updated == null) break;
                        if (updated.Status == MeetingStatus.Complete || updated.Status == MeetingStatus.Failed)
                        {
                            await InvokeAsync(() =>
                            {
                                _meeting = updated;
                                _retranscribing = false;
                                StateHasChanged();
                            });
                            if (updated.Status == MeetingStatus.Complete)
                                await InvokeAsync(() => Snackbar.Add("Retranscription complete!", Severity.Success));
                            else
                                await InvokeAsync(() => Snackbar.Add("Retranscription failed. Check logs.", Severity.Error));
                            return;
                        }
                    }
                    await InvokeAsync(() => { _retranscribing = false; StateHasChanged(); });
                });
            }
            else
            {
                _retranscribeError = $"Retranscribe failed: {error}";
                _retranscribing = false;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: RetranscribeAsync UI error for meeting {MeetingId}", _meeting?.Id);
            _retranscribeError = $"Error: {ex.Message}";
            _retranscribing = false;
        }
        finally
        {
            StateHasChanged();
        }
    }

    private bool TranscriptHasSelection() =>
        (_transcriptSelectPersonal && !_transcriptPushedTo.Contains("personal")) ||
        (_transcriptSelectTeam     && !_transcriptPushedTo.Contains("team"));

    private bool SummaryHasSelection() =>
        (_summarySelectPersonal && !_summaryPushedTo.Contains("personal")) ||
        (_summarySelectTeam     && !_summaryPushedTo.Contains("team"));

    private async Task PushTranscript()
    {
        if (_pushingTranscript || _meeting == null || _user == null) return;
        _pushingTranscript = true;
        try
        {
            var scopes = new List<string>();
            if (_transcriptSelectPersonal && !_transcriptPushedTo.Contains("personal")) scopes.Add("personal");
            if (_transcriptSelectTeam     && !_transcriptPushedTo.Contains("team"))     scopes.Add("team");
            if (!scopes.Any()) return;

            if (string.IsNullOrEmpty(_user.FaitUserId))
            {
                Snackbar.Add("KB push requires your FAIT account to be linked. Please sign out and sign back in.", Severity.Error);
                return;
            }

            await FirmKbService.PushDocumentAsync(_meeting.Id, _user.Id.ToString(), _user.FaitUserId, "transcript", scopes);
            foreach (var s in scopes) _transcriptPushedTo.Add(s);
            Snackbar.Add($"Transcript added to {string.Join(" + ", scopes.Select(s => s == "personal" ? "My KB" : "Team KB"))}!", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: PushTranscript failed for meeting {MeetingId}", _meeting?.Id);
            Snackbar.Add($"Error pushing transcript: {ex.Message}", Severity.Error);
        }
        finally { _pushingTranscript = false; StateHasChanged(); }
    }

    private async Task PushSummary()
    {
        if (_pushingSummary || _meeting == null || _user == null) return;
        _pushingSummary = true;
        try
        {
            var scopes = new List<string>();
            if (_summarySelectPersonal && !_summaryPushedTo.Contains("personal")) scopes.Add("personal");
            if (_summarySelectTeam     && !_summaryPushedTo.Contains("team"))     scopes.Add("team");
            if (!scopes.Any()) return;

            if (string.IsNullOrEmpty(_user.FaitUserId))
            {
                Snackbar.Add("KB push requires your FAIT account to be linked. Please sign out and sign back in.", Severity.Error);
                return;
            }

            await FirmKbService.PushDocumentAsync(_meeting.Id, _user.Id.ToString(), _user.FaitUserId, "summary", scopes);
            foreach (var s in scopes) _summaryPushedTo.Add(s);
            Snackbar.Add($"Summary added to {string.Join(" + ", scopes.Select(s => s == "personal" ? "My KB" : "Team KB"))}!", Severity.Success);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: PushSummary failed for meeting {MeetingId}", _meeting?.Id);
            Snackbar.Add($"Error pushing summary: {ex.Message}", Severity.Error);
        }
        finally { _pushingSummary = false; StateHasChanged(); }
    }

    private async Task SendToFaitV2()
    {
        if (_isSending || _meeting == null) return;
        _isSending = true;
        _sendResult = null;
        StateHasChanged();

        try
        {
            var summaryText = _meeting.Summary?.SummaryText ?? "No summary available";
            var transcriptExcerpt = _meeting.Transcripts.Any()
                ? string.Join("\n", _meeting.Transcripts
                    .OrderBy(t => t.StartTimeMs)
                    .Select(t => $"[{TimeSpan.FromMilliseconds(t.StartTimeMs ?? 0):hh\\:mm\\:ss}] {t.SpeakerName ?? t.SpeakerLabel ?? "Unknown"}: {t.Text}"))
                : null;

            if (transcriptExcerpt?.Length > 2000)
                transcriptExcerpt = transcriptExcerpt[..2000] + "...";

            var content = string.IsNullOrEmpty(transcriptExcerpt)
                ? summaryText
                : $"{summaryText}\n\n--- Transcript ---\n{transcriptExcerpt}";

            await FaitV2Service.SendTranscriptAsync(
                entraOid: _user?.EntraOid ?? "",
                meetingId: _meeting.Id.ToString(),
                transcript: content,
                title: _meeting.Title ?? $"Meeting {_meeting.Id}");

            Snackbar.Add("Meeting context sent to your assistant", Severity.Success);
            _sendResult = null;
            _sendSuccess = true;
        }
        catch (Exception ex)
        {
            _sendSuccess = false;
            _sendResult = "Failed to send to assistant";
            Snackbar.Add("Failed to send to assistant", Severity.Error);
            Logger.LogError(ex, "FIRM MeetingDetail: SendToFaitV2 failed for meeting {MeetingId}", _meeting?.Id);
        }
        finally
        {
            _isSending = false;
            StateHasChanged();
        }
    }

    private static string FormatDuration(int? seconds)
    {
        if (!seconds.HasValue) return "";
        var ts = TimeSpan.FromSeconds(seconds.Value);
        return ts.TotalHours >= 1 ? $"{(int)ts.TotalHours}h {ts.Minutes}m" : $"{ts.Minutes} min";
    }

    private static string FormatTimestamp(long? ms)
    {
        if (!ms.HasValue) return "00:00:00";
        return TimeSpan.FromMilliseconds(ms.Value).ToString(@"hh\:mm\:ss");
    }

    private static List<string> TryDeserializeStringList(string json)
    {
        try { return JsonSerializer.Deserialize<List<string>>(json) ?? new(); }
        catch { return new(); }
    }

    private static List<ActionItemDisplay> TryDeserializeActionItems(string json)
    {
        try { return JsonSerializer.Deserialize<List<ActionItemDisplay>>(json) ?? new(); }
        catch { return new(); }
    }

    private record ActionItemDisplay(
        [property: JsonPropertyName("description")] string? Description,
        [property: JsonPropertyName("owner")] string? Owner,
        [property: JsonPropertyName("deadline")] string? Deadline);

    private MarkupString RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrEmpty(markdown)) return new MarkupString("");
        var pipeline = new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .DisableHtml()
            .Build();
        var html = Markdown.ToHtml(markdown, pipeline);
        return new MarkupString(html);
    }

    private RenderFragment StatusBadge(MeetingStatus status) => builder =>
    {
        var (color, label) = status switch
        {
            MeetingStatus.Joining => ("#2196f3", "Joining"),
            MeetingStatus.Recording => ("#ff9800", "Recording"),
            MeetingStatus.Transcribing => ("#9c27b0", "Transcribing"),
            MeetingStatus.Summarizing => ("#00bcd4", "Summarizing"),
            MeetingStatus.Complete => ("#4caf50", "Complete"),
            MeetingStatus.Failed => ("#f44336", "Failed"),
            MeetingStatus.Scheduled => ("#607d8b", "Scheduled"),
            _ => ("#607d8b", status.ToString())
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "style",
            $"background: {color}22; color: {color}; border: 1px solid {color}44; " +
            "padding: 4px 14px; border-radius: 12px; font-size: 13px; font-weight: 500;");
        builder.AddContent(2, label);
        builder.CloseElement();
    };
    // ── Mind Map ─────────────────────────────────────────────────────────────

    private async Task OnMindMapTabSelected()
    {
        if (_mindmapTabOpened || _meeting?.Status != MeetingStatus.Complete) return;
        _mindmapTabOpened = true;
        await LoadMindmapAsync();
    }

    private async Task LoadMindmapAsync()
    {
        if (_meeting == null) return;
        _mindmapLoading = true;
        _mindmapError = null;
        StateHasChanged();
        try
        {
            var mindmap = await MindmapService.GenerateAsync(_meeting.Id);
            if (mindmap != null)
            {
                _mindmapJson = mindmap.MindmapJson;
                await InvokeAsync(StateHasChanged); // trigger re-render (unhides container)
                await Task.Delay(150); // allow DOM to flush
                await JS.InvokeVoidAsync("firmMindmap.render", "mindmap-container", _mindmapJson);
            }
            else
            {
                // Try to load existing from DB without regenerating
                // (GenerateAsync returns null only if already failed; check stored data)
                // For now, null means nothing generated yet
                _mindmapJson = null;
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM MeetingDetail: mind map load failed for meeting {Id}", _meeting.Id);
            _mindmapError = "Failed to load mind map. Try regenerating.";
        }
        finally
        {
            _mindmapLoading = false;
            StateHasChanged();
        }
    }

    private async Task RegenerateMindmap()
    {
        _mindmapJson = null;
        _mindmapError = null;
        _mindmapTabOpened = false; // force reload
        await LoadMindmapAsync();
        _mindmapTabOpened = true;
    }


