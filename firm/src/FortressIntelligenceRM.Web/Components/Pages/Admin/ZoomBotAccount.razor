@page "/admin/zoom"
@layout AdminLayout
@attribute [Authorize]
@inject IZoomBotAccountService ZoomBotAccountService
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject BrandingConfig Branding

<PageTitle>Zoom Bot Account — @Branding.ModuleName</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="pa-6">
    <MudText Typo="Typo.h5" Class="mb-2 org-context-title">Zoom Bot Account</MudText>
    <MudText Typo="Typo.body2" Class="mb-4 org-context-subtitle">
        The shared Zoom account the bot uses to join all Zoom meetings. Connecting signs in with Zoom and
        stores the account as the system bot account (not linked to any FIRM user); reconnecting replaces it.
    </MudText>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudPaper Class="pa-4 org-context-card" Elevation="0">
            @if (_connection != null)
            {
                <MudText Typo="Typo.subtitle1" Class="mb-1">Connected as @(_email ?? _connection.ZoomUserId)</MudText>
                <MudText Typo="Typo.caption" Class="d-block mb-3 org-context-timestamp">
                    Last connected / token refresh @_connection.ConnectedAt.ToString("MMM d, yyyy h:mm tt") UTC
                </MudText>

                <div class="d-flex align-center gap-2 mb-4">
                    <MudText Typo="Typo.body2">Token status:</MudText>
                    @if (_refreshTokenExpired)
                    {
                        <MudChip T="string" Color="Color.Error" Size="Size.Small">Expired — reconnect</MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Valid</MudChip>
                        <MudText Typo="Typo.caption">
                            Access token @(_connection.ExpiresAt > DateTime.UtcNow ? $"expires {_connection.ExpiresAt:MMM d, h:mm tt} UTC" : "expired (auto-refreshes on next use)");
                            refresh token valid until ~@_refreshTokenExpiresAt.ToString("MMM d, yyyy") UTC
                        </MudText>
                    }
                </div>

                <div class="d-flex gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/oauth/zoom/authorize?bot=true"
                               StartIcon="@Icons.Material.Filled.Sync">
                        Reconnect
                    </MudButton>
                    <form method="post" action="/oauth/zoom/disconnect">
                        <input type="hidden" name="bot" value="true" />
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" ButtonType="ButtonType.Submit"
                                   StartIcon="@Icons.Material.Filled.LinkOff">
                            Disconnect
                        </MudButton>
                    </form>
                </div>
            }
            else
            {
                <MudText Typo="Typo.subtitle1" Class="mb-1">Not connected</MudText>
                <MudText Typo="Typo.body2" Class="mb-4 org-context-subtitle">
                    Without a bot account, Zoom meetings cannot be recorded.
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/oauth/zoom/authorize?bot=true"
                           StartIcon="@Icons.Material.Filled.Link">
                    Connect Zoom Bot Account
                </MudButton>
            }
        </MudPaper>
    }
</MudContainer>

@code {
    // Zoom refresh tokens are valid for 90 days and are rotated on each refresh (ConnectedAt is
    // bumped by the DB's ON UPDATE on every token write).
    private static readonly TimeSpan RefreshTokenLifetime = TimeSpan.FromDays(90);

    private bool _loading = true;
    private FirmZoomBotAccount? _connection;
    private string? _email;
    private DateTime _refreshTokenExpiresAt;
    private bool _refreshTokenExpired;

    protected override async Task OnInitializedAsync()
    {
        _email = await ZoomBotAccountService.GetEmailAsync();
        _connection = await ZoomBotAccountService.GetAsync();
        if (_connection != null)
        {
            _refreshTokenExpiresAt = _connection.ConnectedAt + RefreshTokenLifetime;
            _refreshTokenExpired = _refreshTokenExpiresAt < DateTime.UtcNow;
        }
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender)
            return;

        var query = new Uri(Navigation.Uri).Query;
        if (query.Contains("zoomConnected=1"))
            Snackbar.Add("Zoom bot account connected.", Severity.Success);
        else if (query.Contains("zoomConnectError=1"))
            Snackbar.Add("Could not connect the Zoom account. Please try again.", Severity.Error);
        else if (query.Contains("zoomDisconnected=1"))
            Snackbar.Add("Zoom bot account disconnected.", Severity.Info);
    }
}
