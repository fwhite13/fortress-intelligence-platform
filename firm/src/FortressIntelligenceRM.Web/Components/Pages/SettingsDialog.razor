@using MudBlazor
@using FortressIntelligenceRM.Web.Services
@inject MeetingService MeetingService
@inject IZoomOAuthService ZoomOAuthService
@inject FortressIntelligenceRM.Web.Services.Plaud.IPlaudOAuthService PlaudOAuthService
@using FortressIntelligenceRM.Web.Services.Plaud
@inject PlaudSyncService PlaudSyncService
@inject ISnackbar Snackbar
@inject NavigationManager Nav

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6" Style="color: var(--color-text-primary);">Settings</MudText>
    </TitleContent>
    <DialogContent>
        @if (_loading)
        {
            <MudProgressLinear Color="Color.Warning" Indeterminate />
        }
        else
        {
            <MudTabs Elevation="0" Rounded="true" PanelClass="pt-4" Color="Color.Transparent" SliderColor="Color.Warning">
                <MudTabPanel Text="General">
                    <MudSwitch @bind-Value="_autoAddCalendarMeetings" Label="Auto-Add Calendar Meetings"
                               Color="Color.Warning" Class="mb-2" />
                    <MudSwitch @bind-Value="_autoEmailSummary" Label="Auto-Email Summary"
                               Color="Color.Warning" Class="mb-2" />
                    @* WI #8310 — disabled until the Calendars.ReadWrite incremental consent flow ships *@
                    <MudStack Row AlignItems="AlignItems.Center" Spacing="2">
                        <MudSwitch @bind-Value="_autoCreateSuggestedEvents" Label="Auto-Create Suggested Events"
                                   Color="Color.Warning" Disabled="true" />
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">Coming Soon</MudChip>
                    </MudStack>
                    <MudText Typo="Typo.caption" Style="font-style: italic; color: var(--color-text-secondary);">Enabling this feature will require you to re-authenticate through Microsoft.</MudText>
                </MudTabPanel>
                @* WI #8371 — per-user Zoom account link. Connect/Disconnect act immediately; Save only covers the General tab. *@
                <MudTabPanel Text="Zoom">
                    @if (_zoomConnection != null)
                    {
                        <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                            Connected as <strong>@(_zoomConnection.ZoomEmail ?? _zoomConnection.ZoomUserId)</strong>
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                            No Zoom account connected. Connect your Zoom account to enable recording of Zoom meetings.
                        </MudAlert>
                    }
                    <ZoomAccountGuidance />
                    <div class="d-flex gap-2 mt-4">
                        @if (_zoomConnection != null)
                        {
                            <MudButton Variant="Variant.Outlined" Style="border-color: #d4af37; color: #d4af37;"
                                       Href="/oauth/zoom/authorize" StartIcon="@Icons.Material.Filled.Sync">
                                Switch Account
                            </MudButton>
                            <form method="post" action="/oauth/zoom/disconnect">
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" ButtonType="ButtonType.Submit"
                                           StartIcon="@Icons.Material.Filled.LinkOff">
                                    Disconnect
                                </MudButton>
                            </form>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                                       Href="/oauth/zoom/authorize" StartIcon="@Icons.Material.Filled.VideoCall">
                                Connect Zoom Account
                            </MudButton>
                        }
                    </div>
                </MudTabPanel>
                @* WI #9133 — per-user Plaud account link; hidden unless Firm:Plaud:Enabled. Acts immediately like Zoom. *@
                @if (PlaudOAuthService.IsEnabled)
                {
                    <MudTabPanel Text="Plaud">
                        @if (_plaudStatus is { Connected: true, OtherEnvironment: true })
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                Connected on another FIRM environment. Reconnect here to sync from here.
                            </MudAlert>
                        }
                        else if (_plaudStatus is { Connected: true, NeedsReconnect: true })
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                                Plaud needs to be reconnected.
                            </MudAlert>
                        }
                        else if (_plaudStatus is { Connected: true })
                        {
                            <MudAlert Severity="Severity.Success" Dense="true" Class="mb-3">
                                Connected as <strong>@(_plaudStatus.Email ?? "your Plaud account")</strong>
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                                No Plaud account connected.
                            </MudAlert>
                        }
                        <PlaudAccountGuidance />
                        @* WI #9156 — Settings only sets the integration up. Picking recordings, auto-sync and "Check every"
                           live on the Plaud page (left nav); nothing here imports anything. *@
                        @if (_plaudStatus is { Connected: true, NeedsReconnect: false, OtherEnvironment: false } && _plaudSync != null)
                        {
                            <MudText Typo="Typo.body2" Class="mt-3" Style="color: var(--color-text-secondary);">
                                Auto-sync @(_plaudSync.AutoSync ? "on" : "off")
                                · @(_plaudSync.LastCheckedAt.HasValue ? $"last checked {_plaudSync.LastCheckedAt.Value.ToLocalTime():g}" : "not checked yet")
                                · imported @_plaudSync.Imported · @_plaudSync.Waiting waiting
                            </MudText>
                        }
                        @if (_plaudStatus is { Connected: true })
                        {
                            <div class="mt-2">
                                <MudLink Typo="Typo.body2" OnClick="OpenPlaudPage" Style="color: #d4af37; cursor: pointer;">
                                    Choose recordings to import
                                </MudLink>
                            </div>
                        }
                        <div class="d-flex flex-wrap gap-2 mt-4">
                            @if (_plaudStatus is { Connected: true })
                            {
                                @if (_plaudStatus.NeedsReconnect || _plaudStatus.OtherEnvironment)
                                {
                                    <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                                               Href="/oauth/plaud/authorize" StartIcon="@Icons.Material.Filled.Refresh">
                                        Reconnect Plaud
                                    </MudButton>
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Outlined" Style="border-color: #d4af37; color: #d4af37;"
                                               Href="/oauth/plaud/authorize" StartIcon="@Icons.Material.Filled.Sync">
                                        Switch Account
                                    </MudButton>
                                }
                                @if (!_plaudConfirmDisconnect)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                               OnClick="@(() => _plaudConfirmDisconnect = true)"
                                               StartIcon="@Icons.Material.Filled.LinkOff">
                                        Disconnect
                                    </MudButton>
                                }
                            }
                            else
                            {
                                <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                                           Href="/oauth/plaud/authorize" StartIcon="@Icons.Material.Filled.Mic">
                                    Connect Plaud Account
                                </MudButton>
                            }
                        </div>
                        @if (_plaudStatus is { Connected: true } && _plaudConfirmDisconnect)
                        {
                            @* In-page confirmation; confirm() is not used (spec §6.1). *@
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mt-3">
                                <MudText Typo="Typo.body2" Style="color: var(--color-text-primary);">
                                    Meetings already imported stay in FIRM. To revoke FIRM's access completely, also remove it in your Plaud account settings.
                                </MudText>
                                <div class="d-flex gap-2 mt-2">
                                    <form method="post" action="/oauth/plaud/disconnect">
                                        <MudButton Variant="Variant.Filled" Color="Color.Error" ButtonType="ButtonType.Submit"
                                                   StartIcon="@Icons.Material.Filled.LinkOff">
                                            Disconnect Plaud
                                        </MudButton>
                                    </form>
                                    <MudButton Variant="Variant.Text" OnClick="@(() => _plaudConfirmDisconnect = false)"
                                               Style="color: var(--color-text-secondary);">
                                        Keep connected
                                    </MudButton>
                                </div>
                            </MudPaper>
                        }
                    </MudTabPanel>
                }
                @if (!string.IsNullOrEmpty(_entraOid))
                {
                    @* WI #8298 — voice enrollment acts immediately; Save only covers the General tab. *@
                    <MudTabPanel Text="Voice">
                        <VoiceEnrollmentPanel EntraOid="@_entraOid" DisplayName="@_displayName" />
                    </MudTabPanel>
                }
            </MudTabs>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Style="color: var(--color-text-secondary);">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                   OnClick="Save" Disabled="@_loading">
            Save
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private MudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public Guid UserId { get; set; }

    private bool _loading = true;
    private bool _autoAddCalendarMeetings;
    private bool _autoEmailSummary;
    private bool _autoCreateSuggestedEvents;
    private string _entraOid = "";
    private string _displayName = "";
    private FirmZoomOAuth? _zoomConnection;
    private PlaudAccountStatus? _plaudStatus;
    private bool _plaudConfirmDisconnect;
    private PlaudSyncStatus? _plaudSync;

    private async Task LoadPlaudSyncStatusAsync()
    {
        try
        {
            _plaudSync = await PlaudSyncService.GetStatusAsync(UserId);
        }
        catch (Exception)
        {
            // Status display only (e.g. tables not created yet); never block the dialog.
            _plaudSync = null;
        }
    }

    /// <summary>WI #9156 — picking recordings and auto-sync live on the Plaud page; close Settings and go there.</summary>
    private void OpenPlaudPage()
    {
        MudDialog.Cancel();
        Nav.NavigateTo("/plaud");
    }

    protected override async Task OnInitializedAsync()
    {
        var user = await MeetingService.GetUserAsync(UserId);
        if (user != null)
        {
            _autoAddCalendarMeetings = user.AutoAddCalendarMeetings;
            _autoEmailSummary = user.AutoEmailSummary;
            _autoCreateSuggestedEvents = user.AutoCreateSuggestedEvents;
            _entraOid = user.EntraOid;
            _displayName = user.DisplayName;
        }
        _zoomConnection = await ZoomOAuthService.GetConnectionAsync(UserId);
        if (PlaudOAuthService.IsEnabled)
        {
            try
            {
                _plaudStatus = await PlaudOAuthService.GetStatusAsync(UserId);
                if (_plaudStatus is { Connected: true, NeedsReconnect: false, OtherEnvironment: false })
                {
                    // Lazily refresh an expiring token (one locked refresh), so a dead grant shows "Reconnect" here.
                    var token = await PlaudOAuthService.GetAccessTokenAsync(UserId);
                    if (token == null)
                        _plaudStatus = await PlaudOAuthService.GetStatusAsync(UserId);
                }
                if (_plaudStatus is { Connected: true, NeedsReconnect: false, OtherEnvironment: false })
                    await LoadPlaudSyncStatusAsync();
            }
            catch (Exception)
            {
                // Status display only; never block the dialog on Plaud.
                _plaudStatus ??= new PlaudAccountStatus(false, null, false, false);
            }
        }
        _loading = false;
    }

    private async Task Save()
    {
        await MeetingService.UpdateUserPreferencesAsync(UserId, _autoAddCalendarMeetings, _autoEmailSummary, _autoCreateSuggestedEvents);
        Snackbar.Add("Settings saved.", Severity.Success);
        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancel() => MudDialog.Cancel();
}
