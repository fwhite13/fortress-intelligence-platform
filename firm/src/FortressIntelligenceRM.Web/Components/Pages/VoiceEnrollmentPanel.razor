@using System.Globalization
@using MudBlazor
@using FortressIntelligenceRM.Web.Services
@implements IDisposable
@inject SpeakerEmbeddingService SpeakerEmbeddingService
@inject VoiceSampleProcessingService VoiceSampleProcessingService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject ILogger<VoiceEnrollmentPanel> Logger

@* WI #8298 — self-service voice enrollment (Settings → Voice). *@
@* WI #8828 — enrollment now comes from the user's own meeting audio (channel-matched with Teams); the
   browser-mic recording flow was removed here — POST /api/voiceprint/upload still accepts recordings. *@
@* WI #8306: min-height keeps the dialog from collapsing/flickering a scrollbar as phases swap content. *@
<div style="min-height: 160px;">
@if (_status == null)
{
    <MudProgressLinear Color="Color.Warning" Indeterminate />
}
else
{
    <MudSwitch T="bool" Value="_optedIn" ValueChanged="OnOptInChanged"
               Label="Improve speaker identification by enrolling your voice"
               Color="Color.Warning" Disabled="@(_busy || _status.IsPending)" />
    <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--color-text-secondary);">
        Your voice data is stored securely and used only to label your speech in meetings you attend. You can delete it at any time by unenrolling below.
    </MudText>

    <MudText Typo="Typo.subtitle2" Class="mb-3">Status: @StatusText</MudText>

    @if (_optedIn)
    {
        @* WI #8349: the Batch job runs for a few minutes after Submit — show that it's underway. *@
        @if (_status.IsPending)
        {
            <MudAlert Severity="Severity.Info" Class="mb-3">
                Enrollment submitted — processing. This typically takes a few minutes.
            </MudAlert>
        }
        else if (!_selecting)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.RecordVoiceOver"
                       OnClick="StartSelection" Disabled="@_busy">
                @(_status.IsEnrolled ? "Re-enroll from a meeting" : "Enroll from a meeting")
            </MudButton>
        }
        else if (_candidates == null)
        {
            <MudProgressLinear Color="Color.Warning" Indeterminate />
        }
        else if (_candidates.Count == 0)
        {
            <MudText Typo="Typo.body2">No meetings found with enough attributed audio. Attend a meeting first.</MudText>
        }
        else if (_selected != null)
        {
            <MudPaper Outlined Class="pa-3">
                <MudText Typo="Typo.body2" Class="mb-2" Style="color: var(--color-text-secondary);">
                    We'll learn your voice from a meeting you spoke in. Listen to the clip and confirm it's you.
                </MudText>
                <MudText Typo="Typo.subtitle2">Preview clip from @_selected.Title</MudText>
                <MudText Typo="Typo.caption" Class="mb-2" Style="color: var(--color-text-secondary);">
                    @_selected.Date.ToString("MMM d, yyyy") · @FormatSeconds(_selected.AttributedSeconds) of your speech
                </MudText>

                @if (_clipLoading)
                {
                    <MudProgressLinear Color="Color.Warning" Indeterminate Class="mb-3" />
                }
                else if (_clip != null)
                {
                    @* Media fragment seeks to the preview segment and stops at its end; it never reaches S3. *@
                    <audio @key="_selected.MeetingId" controls preload="metadata" style="width: 100%;" class="mb-3"
                           src="@ClipSource(_clip)"></audio>
                }
                else
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="mb-3">The preview couldn't be loaded.</MudText>
                }

                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudButton Variant="Variant.Filled" Style="background: #d4af37; color: #0f1923;"
                               OnClick="Submit" Disabled="@_busy">
                        Use this meeting
                    </MudButton>
                    @if (_candidates.Count > 1)
                    {
                        <MudLink OnClick="() => _showList = !_showList" Disabled="@_busy">Choose different meeting</MudLink>
                    }
                    <MudButton Variant="Variant.Text" OnClick="CancelSelection" Disabled="@_busy" Style="color: var(--color-text-secondary);">Cancel</MudButton>
                </div>

                @if (_showList)
                {
                    <MudList T="long" Dense Class="mt-2">
                        @foreach (var candidate in _candidates)
                        {
                            var c = candidate;
                            <MudListItem T="long" OnClick="() => SelectCandidate(c)" Disabled="@_busy"
                                         Icon="@(c.MeetingId == _selected.MeetingId ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)">
                                @c.Title — @c.Date.ToString("MMM d, yyyy") · @FormatSeconds(c.AttributedSeconds)
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        }
    }
}
</div>

@code {
    [Parameter, EditorRequired] public string EntraOid { get; set; } = "";
    [Parameter] public string DisplayName { get; set; } = "";

    private VoiceEnrollmentStatus? _status;
    private bool _optedIn;
    private bool _busy;
    private bool _selecting;
    private bool _showList;
    private bool _clipLoading;
    private List<EnrollmentCandidate>? _candidates;
    private EnrollmentCandidate? _selected;
    private EnrollmentClip? _clip;
    private readonly CancellationTokenSource _disposeCts = new();

    private string StatusText => _status switch
    {
        { IsEnrolled: true } s => $"Enrolled (recorded {s.VoiceSampleRecordedAt!.Value.ToLocalTime():MMM d, yyyy})",
        { AutoMeetingCount: > 0 } s => $"Auto-identified from {s.AutoMeetingCount} meeting(s)",
        _ => "Not enrolled"
    };

    protected override async Task OnInitializedAsync()
    {
        _status = await SpeakerEmbeddingService.GetEnrollmentStatusAsync(EntraOid, DisplayName);
        // WI #8349: a submitted-but-unprocessed sample still counts as opted in.
        _optedIn = _status.IsEnrolled || _status.IsPending;
        if (_optedIn && !_status.IsEnrolled && !_status.IsPending)
            await StartSelection();
    }

    private async Task OnOptInChanged(bool value)
    {
        if (value || _status is not { IsEnrolled: true })
        {
            _optedIn = value;
            if (value && _status is { IsPending: false })
                await StartSelection();
            else
                CancelSelection();
            return;
        }

        // WI #8307: unenrolling permanently deletes the voiceprint — confirm first; cancel leaves everything as-is.
        var confirmed = await DialogService.ShowMessageBox(
            "Remove voice enrollment?",
            "This will permanently delete your voice enrollment. To re-enroll, you'll need to choose a meeting again.",
            yesText: "Remove enrollment",
            cancelText: "Cancel");
        if (confirmed != true)
            return;

        _optedIn = false;
        _busy = true;
        try
        {
            await SpeakerEmbeddingService.DeactivateVoiceSamplesAsync(EntraOid);
            _status = await SpeakerEmbeddingService.GetEnrollmentStatusAsync(EntraOid, DisplayName);
            CancelSelection();
            Snackbar.Add("Your voice sample has been deleted.", Severity.Info);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "FIRM: Failed to delete voice samples for {EntraOid}", EntraOid);
            _optedIn = true;
            Snackbar.Add("Could not delete your voice sample. Please try again.", Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }

    // WI #8828: load the ranked candidates and preview the best one.
    private async Task StartSelection()
    {
        _selecting = true;
        _showList = false;
        _candidates = null;
        StateHasChanged();
        try
        {
            _candidates = await VoiceSampleProcessingService.GetEnrollmentCandidatesAsync(DisplayName, _disposeCts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "FIRM: Failed to load voice enrollment candidates for {EntraOid}", EntraOid);
            Snackbar.Add("Could not load your meetings. Please try again.", Severity.Error);
            _selecting = false;
            return;
        }
        if (_candidates.Count > 0)
            await SelectCandidate(_candidates[0]);
    }

    private async Task SelectCandidate(EnrollmentCandidate candidate)
    {
        _selected = candidate;
        _showList = false;
        _clip = null;
        _clipLoading = true;
        StateHasChanged();
        try
        {
            _clip = await VoiceSampleProcessingService.GetEnrollmentClipAsync(DisplayName, candidate.MeetingId, _disposeCts.Token);
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogWarning(ex, "FIRM: Failed to load enrollment preview for meeting {MeetingId}", candidate.MeetingId);
        }
        finally
        {
            _clipLoading = false;
        }
    }

    private void CancelSelection()
    {
        _selecting = false;
        _showList = false;
        _candidates = null;
        _selected = null;
        _clip = null;
    }

    private async Task Submit()
    {
        if (_selected == null)
            return;

        _busy = true;
        try
        {
            var jobId = await VoiceSampleProcessingService.SubmitFromMeetingAsync(EntraOid, DisplayName, _selected.MeetingId, _disposeCts.Token);
            if (jobId == null)
            {
                Snackbar.Add("That meeting can no longer be used for enrollment. Please choose another.", Severity.Warning);
                return;
            }
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            Logger.LogError(ex, "FIRM: Meeting-based voice enrollment failed for {EntraOid}", EntraOid);
            Snackbar.Add("Could not start enrollment. Please try again.", Severity.Error);
            return;
        }
        finally
        {
            _busy = false;
        }

        // WI #8306: fire-and-forget — the Batch job takes a few minutes, so return to idle instead of polling.
        CancelSelection();
        try
        {
            _status = await SpeakerEmbeddingService.GetEnrollmentStatusAsync(EntraOid, DisplayName);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "FIRM: Failed to refresh voice enrollment status for {EntraOid}", EntraOid);
            // WI #8349: the job was submitted either way — still show it as pending.
            _status = _status! with { IsPending = true };
        }
        StateHasChanged();
        Snackbar.Add("Your voice enrollment is processing. This takes a few minutes — your enrollment status will update the next time you open this dialog.", Severity.Info);
    }

    private static string ClipSource(EnrollmentClip clip) =>
        string.Create(CultureInfo.InvariantCulture, $"{clip.PresignedUrl}#t={clip.PreviewStartSec:0.#},{clip.PreviewEndSec:0.#}");

    private static string FormatSeconds(double seconds) => $"{(int)seconds / 60}:{(int)seconds % 60:00}";

    public void Dispose()
    {
        _disposeCts.Cancel();
        _disposeCts.Dispose();
    }
}
