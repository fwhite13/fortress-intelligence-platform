@inject FortressIntelligenceRM.Web.Services.BrandingConfig Branding

<MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-1 mb-1">Overview</MudText>
<MudText Typo="Typo.body2">
    This page shows everything captured for a single meeting: the AI-generated summary, the full
    transcript, and a visual mind map of the key topics discussed.
</MudText>

<MudDivider Class="my-2" />

<MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-3 mb-1">Summary tab</MudText>
<MudText Typo="Typo.body2">
    The AI summary includes a narrative recap, key decisions made, action items with owners and
    deadlines, follow-up items, and open questions. It's generated automatically when the meeting
    finishes processing.
</MudText>

<MudDivider Class="my-2" />

<MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-3 mb-1">Transcript tab</MudText>
<MudText Typo="Typo.body2">
    The full word-by-word transcript with timestamps and speaker labels. Scroll through the table
    to find specific moments in the conversation.
</MudText>

<MudDivider Class="my-2" />

<MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-3 mb-1">Mind Map tab</MudText>
<MudText Typo="Typo.body2">
    An interactive visual map of the key topics and their relationships from the meeting. Click
    <strong>Generate Mind Map</strong> if it hasn't been created yet, or <strong>Regenerate</strong>
    to refresh it. You can also export it as a <strong>.mm</strong> file for use in FreeMind or
    compatible tools.
</MudText>

<MudDivider Class="my-2" />

<MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-3 mb-1">Downloads</MudText>
<MudText Typo="Typo.body2">
    Use the download buttons at the top of the page to save the transcript or summary:
</MudText>
<MudText Typo="Typo.body2" Class="mt-1">
    <strong>Transcript</strong> — downloads as a plain text file with timestamps and speaker labels.
    Good for searching or archiving the raw conversation.
</MudText>
<MudText Typo="Typo.body2" Class="mt-1">
    <strong>Summary</strong> — choose <strong>Markdown (.md)</strong> for pasting into a knowledge
    base or wiki, or <strong>PDF</strong> for a formatted document you can share or print.
</MudText>
<MudText Typo="Typo.body2" Class="mt-1">
    <strong>Audio</strong> — downloads the original meeting recording if one was captured.
</MudText>

@if (Branding.SuiteName != "RISE")
{
    <MudDivider Class="my-2" />

    <MudText Typo="Typo.subtitle1" Color="Color.Primary" Class="mt-3 mb-1">Knowledge Base</MudText>
    <MudText Typo="Typo.body2">
        The Share panel lets you push the transcript or summary directly into your Personal KB or your
        Team KB in FAIT. Once pushed, the content becomes searchable and available for AI chat.
        A document can only be pushed to each KB once.
    </MudText>
}
