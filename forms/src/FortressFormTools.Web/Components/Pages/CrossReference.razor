@page "/question-sets/{Id:int}/cross-reference"
@using System.Net.Http.Json
@using System.Text.Json
@inject HttpClient Http
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<PageTitle>Cross-Reference Analysis — FORMS</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ArrowBack"
               OnClick="@(() => Nav.NavigateTo($"/question-sets/{Id}"))" Class="mb-3">
        Back to Question Set
    </MudButton>

    @if (_loadingInit)
    {
        <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-4" />
    }
    else
    {
        <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-4">
            <MudIcon Icon="@Icons.Material.Filled.CompareArrows" Size="Size.Large"
                     Style="color: var(--fortress-gold, #d4af37);" />
            <MudText Typo="Typo.h4" Style="font-weight: 600;">Cross-Reference Analysis</MudText>
        </MudStack>

        @if (_questionSetName != null)
        {
            <MudText Typo="Typo.subtitle1" Class="mb-4" Style="color: #6b7280;">
                Question Set: @_questionSetName
            </MudText>
        }

        @* Step 1: Select Forms *@
        <MudPaper Elevation="1" Class="pa-4 mb-4">
            <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                <MudText Typo="Typo.h6">
                    <MudIcon Icon="@Icons.Material.Filled.Checklist" Class="mr-2" />
                    Step 1: Select Forms to Analyze
                </MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Secondary"
                           StartIcon="@Icons.Material.Filled.Analytics"
                           Disabled="@(!_selectedFormIds.Any() || _analyzing)"
                           OnClick="RunAnalysis">
                    @if (_analyzing)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                        @:Analyzing...
                    }
                    else
                    {
                        @:Analyze Selected Forms
                    }
                </MudButton>
            </MudStack>

            @if (!_forms.Any())
            {
                <MudAlert Severity="Severity.Info" Variant="Variant.Text">
                    No forms available. Upload and review forms first.
                </MudAlert>
            }
            else
            {
                <MudStack Spacing="1">
                    @foreach (var form in _forms)
                    {
                        <MudCheckBox T="bool" Value="@_selectedFormIds.Contains(form.Id)"
                                     ValueChanged="@((bool v) => ToggleForm(form.Id, v))"
                                     Color="Color.Secondary" Dense="true">
                            <MudText>
                                @form.CarrierName — @form.FormName
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Class="ml-2">
                                    @form.FieldCount fields
                                </MudChip>
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(form.Status == "Reviewed" ? Color.Success : Color.Warning)"
                                         Variant="Variant.Filled" Class="ml-1">
                                    @form.Status
                                </MudChip>
                            </MudText>
                        </MudCheckBox>
                    }
                </MudStack>
            }
        </MudPaper>

        @* Loading indicator *@
        @if (_analyzing)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudProgressLinear Color="Color.Secondary" Indeterminate="true" Class="mb-2" />
                <MudText Align="Align.Center" Typo="Typo.body1">
                    Analyzing @_selectedFormIds.Count form(s)... This may take 10–30 seconds.
                </MudText>
            </MudPaper>
        }

        @* Step 2: Coverage Heatmap *@
        @if (_analysisResult != null && !_analyzing)
        {
            <MudPaper Elevation="1" Class="pa-4 mb-4">
                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-3">
                    <MudText Typo="Typo.h6">
                        <MudIcon Icon="@Icons.Material.Filled.GridOn" Class="mr-2" />
                        Step 2: Coverage Heatmap
                    </MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               Disabled="@(!_selectedGroups.Any() || _saving)"
                               OnClick="SaveSelectedFields">
                        @if (_saving)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            @:Saving...
                        }
                        else
                        {
                            @:Add @_selectedGroups.Count Selected to Question Set
                        }
                    </MudButton>
                </MudStack>

                <MudText Typo="Typo.body2" Class="mb-2" Style="color: #6b7280;">
                    @_analysisResult.FieldGroups.Count field group(s) found across @_analysisResult.FormsAnalyzed.Count form(s).
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ml-1">██ Present</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined" Class="ml-1">░░ Absent</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ml-2">Exact</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="Color.Tertiary" Variant="Variant.Filled" Class="ml-1">Synonym</MudChip>
                </MudText>

                <MudSimpleTable Dense="true" Striped="true" Hover="true" Style="overflow-x:auto;">
                    <thead>
                        <tr>
                            <th style="min-width:40px;">
                                <MudCheckBox T="bool" Value="@_allSelected"
                                             ValueChanged="ToggleAll" Color="Color.Secondary" Dense="true" />
                            </th>
                            <th style="min-width:200px;">Field</th>
                            <th style="min-width:80px;">Match</th>
                            <th style="min-width:80px;">Coverage</th>
                            @foreach (var formId in _analysisResult.FormsAnalyzed)
                            {
                                var form = _forms.FirstOrDefault(f => f.Id == formId);
                                <th style="min-width:120px; text-align:center;">
                                    @(form?.CarrierName ?? $"Form {formId}")
                                </th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var group in _analysisResult.FieldGroups)
                        {
                            <tr>
                                <td>
                                    <MudCheckBox T="bool" Value="@_selectedGroups.Contains(group.Id)"
                                                 ValueChanged="@((bool v) => ToggleGroup(group.Id, v))"
                                                 Color="Color.Secondary" Dense="true" />
                                </td>
                                <td>
                                    <MudText Typo="Typo.body2" Style="font-weight:500;">@group.CanonicalName</MudText>
                                    @if (group.DictionaryCode != null)
                                    {
                                        <MudText Typo="Typo.caption" Style="color:#6b7280;">@group.DictionaryCode</MudText>
                                    }
                                </td>
                                <td>
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                             Color="@GetMatchColor(group.MatchType)">
                                        @group.MatchType
                                    </MudChip>
                                </td>
                                <td>
                                    <MudText Typo="Typo.body2">@group.Coverage / @group.TotalForms</MudText>
                                </td>
                                @foreach (var formId in _analysisResult.FormsAnalyzed)
                                {
                                    var variant = group.Variants.FirstOrDefault(v => v.FormId == formId);
                                    <td style="text-align:center;">
                                        @if (variant != null)
                                        {
                                            <MudTooltip Text="@variant.FieldLabel">
                                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled"
                                                         Color="@GetMatchColor(group.MatchType)">
                                                    ██
                                                </MudChip>
                                            </MudTooltip>
                                        }
                                        else
                                        {
                                            <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                     Color="Color.Default">
                                                ░░
                                            </MudChip>
                                        }
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </MudSimpleTable>
            </MudPaper>
        }
    }
</MudContainer>

@code {
    [Parameter]
    public int Id { get; set; }

    private bool _loadingInit = true;
    private bool _analyzing = false;
    private bool _saving = false;
    private string? _questionSetName;

    private List<FormSummary> _forms = new();
    private HashSet<int> _selectedFormIds = new();
    private AnalysisResultDto? _analysisResult;
    private HashSet<string> _selectedGroups = new();
    private bool _allSelected = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Load question set name
            var qsResponse = await Http.GetAsync($"/api/question-sets/{Id}");
            if (qsResponse.IsSuccessStatusCode)
            {
                var qs = await qsResponse.Content.ReadFromJsonAsync<JsonElement>();
                _questionSetName = qs.GetProperty("name").GetString();
            }

            // Load all forms
            var formsResponse = await Http.GetAsync("/api/forms?pageSize=200");
            if (formsResponse.IsSuccessStatusCode)
            {
                var formsData = await formsResponse.Content.ReadFromJsonAsync<JsonElement>();
                if (formsData.TryGetProperty("items", out var items))
                {
                    _forms = JsonSerializer.Deserialize<List<FormSummary>>(items.GetRawText(),
                        new JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error loading data: {ex.Message}", Severity.Error);
        }
        finally
        {
            _loadingInit = false;
        }
    }

    private void ToggleForm(int formId, bool selected)
    {
        if (selected) _selectedFormIds.Add(formId);
        else _selectedFormIds.Remove(formId);
    }

    private void ToggleGroup(string groupId, bool selected)
    {
        if (selected) _selectedGroups.Add(groupId);
        else _selectedGroups.Remove(groupId);
        UpdateAllSelected();
    }

    private void ToggleAll(bool selectAll)
    {
        _allSelected = selectAll;
        if (selectAll && _analysisResult != null)
            _selectedGroups = _analysisResult.FieldGroups.Select(g => g.Id).ToHashSet();
        else
            _selectedGroups.Clear();
    }

    private void UpdateAllSelected()
    {
        _allSelected = _analysisResult != null &&
                       _analysisResult.FieldGroups.All(g => _selectedGroups.Contains(g.Id));
    }

    private async Task RunAnalysis()
    {
        _analyzing = true;
        _analysisResult = null;
        _selectedGroups.Clear();
        StateHasChanged();

        try
        {
            var response = await Http.PostAsJsonAsync($"/api/question-sets/{Id}/analyze",
                new { formIds = _selectedFormIds.ToArray() });

            if (response.IsSuccessStatusCode)
            {
                _analysisResult = await response.Content.ReadFromJsonAsync<AnalysisResultDto>();
                if (_analysisResult != null)
                {
                    // Auto-select all non-unique fields
                    _selectedGroups = _analysisResult.FieldGroups
                        .Where(g => g.MatchType != "unique")
                        .Select(g => g.Id)
                        .ToHashSet();
                    UpdateAllSelected();
                    Snackbar.Add($"Analysis complete: {_analysisResult.FieldGroups.Count} field groups found", Severity.Success);
                }
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Analysis failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Analysis error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _analyzing = false;
        }
    }

    private async Task SaveSelectedFields()
    {
        if (_analysisResult == null || !_selectedGroups.Any()) return;

        _saving = true;
        StateHasChanged();

        try
        {
            var fields = _analysisResult.FieldGroups
                .Where(g => _selectedGroups.Contains(g.Id))
                .Select(g => new
                {
                    canonicalName = g.CanonicalName,
                    dictionaryFieldId = (int?)null, // could resolve from dictionaryCode
                    fieldType = "text",
                    sectionName = (string?)null,
                    coverage = g.Coverage,
                    totalForms = g.TotalForms
                })
                .ToList();

            var response = await Http.PostAsJsonAsync($"/api/question-sets/{Id}/fields/bulk",
                new { fields });

            if (response.IsSuccessStatusCode)
            {
                Snackbar.Add($"Added {fields.Count} fields to question set!", Severity.Success);
                Nav.NavigateTo($"/question-sets/{Id}");
            }
            else
            {
                var error = await response.Content.ReadAsStringAsync();
                Snackbar.Add($"Save failed: {error}", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private static Color GetMatchColor(string matchType) => matchType switch
    {
        "exact" => Color.Success,
        "synonym" => Color.Tertiary,
        _ => Color.Error
    };

    // DTOs
    public class FormSummary
    {
        public int Id { get; set; }
        public string CarrierName { get; set; } = "";
        public string FormName { get; set; } = "";
        public string Status { get; set; } = "";
        public int FieldCount { get; set; }
    }

    public class AnalysisResultDto
    {
        public int QuestionSetId { get; set; }
        public List<int> FormsAnalyzed { get; set; } = new();
        public List<FieldGroupDto> FieldGroups { get; set; } = new();
    }

    public class FieldGroupDto
    {
        public string Id { get; set; } = "";
        public string CanonicalName { get; set; } = "";
        public string? DictionaryCode { get; set; }
        public string MatchType { get; set; } = "";
        public int Coverage { get; set; }
        public int TotalForms { get; set; }
        public List<VariantDto> Variants { get; set; } = new();
    }

    public class VariantDto
    {
        public int FormId { get; set; }
        public string FormName { get; set; } = "";
        public string FieldLabel { get; set; } = "";
        public int FieldId { get; set; }
        public double Confidence { get; set; }
    }
}
